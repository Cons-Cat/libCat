template <is_stepanov_iterable T>
[[nodiscard]]
constexpr auto
as_back_inserter(T& container) -> back_insert_stepanov_iterator<T> {
   return back_insert_stepanov_iterator<T>(container);
}

template <is_stepanov_iterable T>
[[nodiscard]]
constexpr auto
as_front_inserter(T& container) -> front_insert_stepanov_iterator<T> {
   return front_insert_stepanov_iterator<T>(container);
}

