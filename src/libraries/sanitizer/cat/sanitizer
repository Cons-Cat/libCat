#if __has_feature(thread_sanitizer)
extern "C" {
// `__tsan_release` establishes a happens-before relation with a later
// `__tsan_acquire` on the same address.
void
__tsan_acquire(void* _Nonnull p_address) noexcept;

void
__tsan_release(void* _Nonnull p_address) noexcept;

// Annotations for custom mutexes give better reports, detect mutex misuse,
// races between lock and unlock and destruction, and potential deadlocks.
// Accesses between a `pre` and its `post` are ignored, so a mutex's own atomics
// and fences do not need to be visible to TSan, but the mutex code itself is
// not checked for correctness.

// Annotate creation of a mutex. Takes mutex creation flags.
void
__tsan_mutex_create(void* _Nonnull p_address, uint4 flags) noexcept;

// Annotate destruction of a mutex. Takes `__tsan_mutex_linker_init` and
// `__tsan_mutex_not_static`.
void
__tsan_mutex_destroy(void* _Nonnull p_address, uint4 flags) noexcept;

// Annotate the start of a lock operation. Takes `__tsan_mutex_read_lock`,
// `__tsan_mutex_try_lock`, and mutex creation flags.
void
__tsan_mutex_pre_lock(void* _Nonnull p_address, uint4 flags) noexcept;

// Annotate the end of a lock operation. Takes `__tsan_mutex_read_lock` and
// `__tsan_mutex_try_lock` (matching `__tsan_mutex_pre_lock`),
// `__tsan_mutex_try_lock_failed`, `__tsan_mutex_recursive_lock`, and mutex
// creation flags.
void
__tsan_mutex_post_lock(
   void* _Nonnull p_address, uint4 flags, int4 recursion
) noexcept;

// Annotate the start of an unlock operation. Takes `__tsan_mutex_read_lock`
// and `__tsan_mutex_recursive_unlock`. Returns the number of recursion levels
// released.
auto
__tsan_mutex_pre_unlock(void* _Nonnull p_address, uint4 flags) noexcept -> int4;

// Annotate the end of an unlock operation. Takes `__tsan_mutex_read_lock`
// (matching `__tsan_mutex_pre_unlock`).
void
__tsan_mutex_post_unlock(void* _Nonnull p_address, uint4 flags) noexcept;

// Annotate the start and end of a notify, signal, or broadcast operation.
// These take no flags.
void
__tsan_mutex_pre_signal(void* _Nonnull p_address, uint4 flags) noexcept;

void
__tsan_mutex_post_signal(void* _Nonnull p_address, uint4 flags) noexcept;

// Annotate a region where a lock, unlock, or signal operation diverts to
// unrelated code, such as another annotated mutex. These must only be called
// inside a `pre` and `post` pair. These take no flags.
void
__tsan_mutex_pre_divert(void* _Nonnull p_address, uint4 flags) noexcept;

void
__tsan_mutex_post_divert(void* _Nonnull p_address, uint4 flags) noexcept;

// Report a bug if the current thread holds any mutexes.
void
__tsan_check_no_mutexes_held() noexcept;

