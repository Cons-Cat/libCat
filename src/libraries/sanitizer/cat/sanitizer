// Mutex creation flags are passed to `__tsan_mutex_create`. If a mutex has no
// constructor and `__tsan_mutex_create` is not called, they may be passed to
// `__tsan_mutex_pre_lock` and `__tsan_mutex_post_lock` instead.

// The mutex has static storage duration and no-op constructor and destructor.
// This makes TSan ignore `__tsan_mutex_destroy`.
inline constexpr uint4 __tsan_mutex_linker_init = 0b1u;
// The mutex is write reentrant.
inline constexpr uint4 __tsan_mutex_write_reentrant = 0b10u;
// The mutex is read reentrant.
inline constexpr uint4 __tsan_mutex_read_reentrant = 0b100u;
// The mutex does not have static storage duration, and must not be used after
// its destructor runs. This is the opposite of `__tsan_mutex_linker_init`. If
// this is passed to `__tsan_mutex_destroy`, the destruction is ignored unless
// this flag was previously set on the mutex.
inline constexpr uint4 __tsan_mutex_not_static = 0b1'0000'0000u;

// Mutex operation flags.

// A read lock operation.
inline constexpr uint4 __tsan_mutex_read_lock = 0b1000u;
// A try lock operation.
inline constexpr uint4 __tsan_mutex_try_lock = 0b1'0000u;
// A try lock operation failed to acquire the mutex.
inline constexpr uint4 __tsan_mutex_try_lock_failed = 0b10'0000u;
// The lock operation acquires as many recursion levels as its `recursion`
// argument.
inline constexpr uint4 __tsan_mutex_recursive_lock = 0b100'0000u;
// The unlock operation releases all recursion levels. The number released is
// returned, and must later be passed to the matching `__tsan_mutex_post_lock`.
inline constexpr uint4 __tsan_mutex_recursive_unlock = 0b1000'0000u;

inline constexpr uint4 __tsan_mutex_try_read_lock =
   __tsan_mutex_read_lock | __tsan_mutex_try_lock;
inline constexpr uint4 __tsan_mutex_try_read_lock_failed =
   __tsan_mutex_try_read_lock | __tsan_mutex_try_lock_failed;

// Do not establish a happens-before relation between fibers in
// `__tsan_switch_to_fiber`.
inline constexpr uint4 __tsan_switch_to_fiber_no_sync = 0b1u;

extern "C" {
