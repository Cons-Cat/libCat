#include <cat/arithmetic>
#include <cat/utility>

namespace cat {
namespace detail {

class infinity_type {
 public:
   template <is_floating_point Float>
   [[nodiscard]]
   constexpr
   operator Float() const {
      using raw_type = raw_arithmetic_type<Float>;
      raw_type const value = static_cast<raw_type>(__builtin_inf());
      return Float(m_negative ? -value : value);
   }

   constexpr auto
   operator==(infinity_type const& other) const -> bool = default;

   template <is_floating_point Float>
   constexpr auto
   operator==(Float value) const -> bool {
      auto const raw_value = make_raw_arithmetic(value);
      return !is_finite(raw_value) && !is_nan(raw_value)
             && (__builtin_signbit(raw_value) != 0) == m_negative;
   }

   constexpr auto
   operator<=>(infinity_type const& other) const -> strong_ordering {
      if (m_negative == other.m_negative) {
         return strong_ordering::equal;
      }
      return m_negative ? strong_ordering::less : strong_ordering::greater;
   }

   template <is_floating_point Float>
   constexpr auto
   operator<=>(Float value) const -> partial_ordering {
      auto const raw_value = make_raw_arithmetic(value);
      if (is_nan(raw_value)) {
         return partial_ordering::unordered;
      }
      if (
         !is_finite(raw_value)
         && m_negative == (__builtin_signbit(raw_value) != 0)
      ) {
         return partial_ordering::equivalent;
      }
      return m_negative ? partial_ordering::less : partial_ordering::greater;
   }

   friend constexpr auto
   operator-(infinity_type value) -> infinity_type {
      value.m_negative = !value.m_negative;
      return value;
   }

   friend constexpr auto
   operator+(infinity_type value) -> infinity_type {
      return value;
   }

 private:
   bool m_negative = false;
};

}  // namespace detail

template <typename T, typename CharT>
struct formatter;

// Implementing this here is a circular dependency. The implementation can be
// found in <cat/math/implementations/format_infinity_type.tpp>.
template <typename CharT>
struct formatter<detail::infinity_type, CharT>;

inline constexpr detail::infinity_type infinity;

template <is_arithmetic T = float8>
// NOLINTNEXTLINE We provide this magic number.
inline constexpr T pi = 0x1.921fb54442d18469898cc51701b8p+1L;

template <>
// NOLINTNEXTLINE We provide this magic number.
inline constexpr float pi<float> = 0x1.921fb6p+1f;

template <>
// NOLINTNEXTLINE We provide this magic number.
inline constexpr double pi<double> = 0x1.921fb54442d18p+1;

template <is_integral T>
inline constexpr T pi<T> = 0x3;

template <is_floating_point T>
   requires(!is_same<T, raw_arithmetic_type<T>>)
inline constexpr T pi<T> = pi<raw_arithmetic_type<T>>;

template <is_arithmetic T = float8>
// NOLINTNEXTLINE We provide this magic number.
inline constexpr T tau = 0x1.921fb54442d18469898cc51701b8p+2L;

template <>
inline constexpr float tau<float> = 0x1.921fb6p+2f;

template <>
inline constexpr double tau<double> = 0x1.921fb54442d18p+2;

template <is_integral T>
inline constexpr T tau<T> = 0x6;

// Unwrap `cat::basic_float<T>`s to access the constant.
template <is_floating_point T>
   requires(!is_same<T, raw_arithmetic_type<T>>)
inline constexpr T tau<T> = tau<raw_arithmetic_type<T>>;

