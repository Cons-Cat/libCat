// -*- mode: c++ -*-
// vim: set ft=cpp:
#pragma once

// `scan_str<T>()` is a general-purpose text parser. It reads a string and
// outputs a `maybe` which holds `T` iff the string was convertible or is
// empty otherwise. It's loosely based on `boost::lexical_cast()` and the
// proposed `std::scan()` described in P1729.
// https://www.open-std.org/jtc1/sc22/wg21/docs/papers/2024/p1729r5.html

#include <cat/allocator_parameters>
#include <cat/arithmetic>
#include <cat/from_chars>
#include <cat/maybe>
#include <cat/propagate>
#include <cat/string>

// TODO: Take a format string, like `fmt()`/`std::scan()`, to control how values
// are scanned and make this variadic.
// TODO: Scan floating point values and non-`char` strings.
// TODO: Input encoding and locale.

namespace cat {

// `cat::scanner` is a customization point object like `cat::formatter`.
// We make partial template specializations for supported and rejected data
// types.
template <typename T>
struct scanner;

// A `scanner` that never allocates also provides `.scan()` without an
// allocator.
template <typename T>
concept is_scannable_without_allocator =
   requires(str_view input) { scanner<T>{}.scan(input); };

// Decimal integers.
template <detail::is_parseable_integral T>
struct scanner<T> {
   [[nodiscard]]
   constexpr auto
   scan(str_view input) const -> maybe<T> {
      auto const [value, consumed] = $prop(from_chars<T>(input));
      if (consumed != input.size()) {
         return nullopt;
      }
      return value;
   }

   template <is_allocator Allocator>
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   scan(allocator_ref<Allocator> /*unused*/, str_view input) const -> maybe<T> {
      return scan(input);
   }
};

// Only `"true"` and `"false"` are booleans.
template <typename T>
   requires(is_same<T, bool> || is_same<T, bool2> || is_same<T, bool4>)
struct scanner<T> {
   [[nodiscard]]
   constexpr auto
   scan(str_view input) const -> maybe<T> {
      if (input == "true") {
         return T(true);
      }
      if (input == "false") {
         return T(false);
      }
      return nullopt;
   }

   template <is_allocator Allocator>
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   scan(allocator_ref<Allocator> /*unused*/, str_view input) const
      -> maybe<T> {
      return scan(input);
   }
};

template <idx inline_capacity, str_vec_flags flags>
   requires(!flags.vec.is_fixed_size)
struct scanner<basic_str_inplace<char, inline_capacity, flags>> {
   [[nodiscard]]
   constexpr auto
   scan(str_view input) const
      -> maybe<basic_str_inplace<char, inline_capacity, flags>> {
      basic_str_inplace<char, inline_capacity, flags> result;
      for (char const character : input) {
         if (result.push_back(character).is_empty()) {
            return nullopt;
         }
      }
      return result;
   }

   template <is_allocator Allocator>
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   scan(allocator_ref<Allocator> /*unused*/, str_view input) const
      -> maybe<basic_str_inplace<char, inline_capacity, flags>> {
      return scan(input);
   }
};

template <str_vec_flags flags>
struct scanner<basic_str_vec<char, flags>> {
   template <is_allocator Allocator>
   [[nodiscard]]
   constexpr auto
   scan(allocator_ref<Allocator> allocator, str_view input) const
      -> maybe<basic_str_vec<char, flags>> {
      basic_str_vec<char, flags> result;
      if (result.append(allocator, input).is_empty()) {
         result.free(allocator);
         return nullopt;
      }
      return result;
   }
};

template <str_vec_flags flags, is_allocator Allocator>
struct scanner<raii::basic_str_vec<char, flags, Allocator>> {
   [[nodiscard]]
   constexpr auto
   scan(
      allocator_ref<Allocator> allocator [[clang::lifetimebound]],
      str_view input
   ) const -> maybe<raii::basic_str_vec<char, flags, Allocator>> {
      raii::basic_str_vec<char, flags, Allocator> result(allocator);
      $prop(result.append(input));
      return result;
   }
};

template <typename CharT, str_flags flags>
struct scanner<basic_str_span<CharT, flags>> {
   auto
   scan(auto&&...) const -> maybe<basic_str_span<CharT, flags>> =
      delete ("`cat::scan_str()` cannot output a non-owning string! That would "
              "immediately dangle. Scan into `cat::str_vec` or "
              "`cat::str_inplace` instead.");
};

template <is_scannable_without_allocator T>
[[nodiscard]]
constexpr auto
scan_str(str_view input) -> maybe<T> {
   return scanner<T>{}.scan(input);
}

// The result may hold onto `allocator`, so it must not outlive it.
template <typename T, is_allocator Allocator>
[[nodiscard]]
constexpr auto
scan_str(
   allocator_ref<Allocator> allocator [[clang::lifetimebound]], str_view input
) -> maybe<T> {
   return scanner<T>{}.scan(allocator, input);
}

template <typename T>
[[nodiscard, gnu::always_inline, gnu::nodebug]]
constexpr auto
scan_str(allocator_dyn allocator [[clang::lifetimebound]], str_view input)
   -> maybe<T> {
   return scan_str<T, allocator_dyn>(allocator, input);
}

}  // namespace cat
