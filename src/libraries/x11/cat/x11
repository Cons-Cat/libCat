// The bitmask-selected list of values used by `create_window()`,
// `change_window_attributes()`, and `configure_window()`. `Field`'s
// enumerators index `values` and the bits of `mask`, so they must be below 32.
template <cat::is_scoped_enum Field>
struct value_list {
   cat::uint4 mask = 0u;
   cat::array<cat::uint4, 32u> values;

   constexpr auto
   set(Field field, cat::uint4 value) noexcept -> value_list& {
      mask |= cat::uint4(1u) << cat::to_underlying(field);
      values[cat::to_underlying(field)] = value;
      return *this;
   }

   // Signed values, such as coordinates, are sent as their 32-bit pattern.
   constexpr auto
   set_signed(Field field, cat::uint4 value) noexcept -> value_list& {
      return set(field, value);
   }

   [[nodiscard]]
   constexpr auto
   size() const noexcept -> cat::idx {
      return cat::popcount(mask);
   }
};

using window_attributes = value_list<window_attribute>;
using window_configurations = value_list<window_configuration>;

