// An event or an asynchronous `x11::error_packet` as received. This is a view
// into a `connection`'s buffers, valid until the next call on that
// `connection`.
struct event {
   cat::uint1 response_type;
   cat::uint1 detail;
   cat::uint2 sequence;
   cat::uint1 _[28];  // NOLINT

   // The event's code, without the bit which marks events from `send_event()`.
   [[nodiscard]]
   constexpr auto
   code() const noexcept -> event_code {
      return static_cast<event_code>(response_type & 0x7fu);
   }

   [[nodiscard]]
   constexpr auto
   is_sent() const noexcept -> bool {
      return (response_type & 0x80u) != 0u;
   }

   [[nodiscard]]
   constexpr auto
   is_error() const noexcept -> bool {
      return response_type == 0u;
   }

   // Reinterpret this as one of the event structs above, or
   // `x11::error_packet`.
   template <typename T>
   [[nodiscard]]
   auto
   as() const noexcept [[clang::lifetimebound]] -> T const& {
      static_assert(sizeof(T) == 32);
      return *__builtin_bit_cast(T const*, this);
   }

   // The window this event is about, or `window::none` for events that do not
   // have one. Use this to dispatch events between multiple windows.
   [[nodiscard]]
   auto
   window() const noexcept -> x11::window;
};

static_assert(sizeof(event) == 32);

