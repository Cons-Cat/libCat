namespace detail {
using namespace cat::bit_literals;

// A send, receive, or file registration for a connection's socket. It is
// complete whenever it is not in flight.
struct transfer_operation : nix::io_uring_operation {
   cat::int4 result = 0;
   bool is_complete = true;
};

// A poll for a connection's socket becoming readable.
struct watch_operation : nix::io_uring_operation {
   bool is_armed = false;
   bool is_readable = true;
};

// The header of a reply kept for a later wait. The reply's bytes follow it,
// padded to 8 bytes.
struct parked_reply {
   cat::uint8 sequence;
   cat::idx size;
};

// Everything a `connection` owns. This is trivially copyable, so moving a
// `connection` copies it and resets the source.
struct connection_state {
   explicit connection_state(cat::allocator_dyn allocator) noexcept
       : m_allocator(allocator) {
   }

   // Each buffer starts this large, and grows to fit larger messages. These
   // are small enough that heap allocators reuse memory for them rather than
   // mapping new pages.
   static constexpr cat::idx initial_send_capacity = 16_uki;
   static constexpr cat::idx initial_receive_capacity = 16_uki;
   static constexpr cat::idx initial_event_capacity = 4_uki;
   // In pending replies, not bytes.
   static constexpr cat::idx initial_pending_capacity = 64u;
   // Queued requests are sent without waiting whenever this many accumulate.
   static constexpr cat::idx chunk_size = 8_uki;

   // The thread's shared ring, and the socket's fixed file slot in it.
   nix::io_uring* _Nullable m_p_ring = nullptr;
   nix::file_descriptor m_socket = nix::invalid_file_descriptor;
   cat::uint4 m_socket_slot = 0u;
   bool m_has_socket_slot = false;
   // The first transfer also registers the socket in a fixed file slot.
   // Linux writes the slot's index over `m_slot_value`.
   transfer_operation m_slot_operation{};
   cat::int4 m_slot_value = 0;
   bool m_is_slot_pending = false;
   bool m_is_slot_unavailable = false;
   transfer_operation m_send_operation{};
   transfer_operation m_receive_operation{};
   // Once an idle `poll_event()` finds nothing, this watches the socket, so
   // later idle polls need no system call until it becomes readable.
   watch_operation m_watch_operation{};
   transfer_operation m_cancel_operation{};
   // `m_allocator` owns the send, receive, and event buffers.
   cat::allocator_dyn m_allocator;
   cat::byte* _Nullable m_p_send = nullptr;
   cat::byte* _Nullable m_p_receive = nullptr;
   cat::byte* _Nullable m_p_events = nullptr;
   cat::idx m_send_capacity = 0u;
   cat::idx m_receive_capacity = 0u;
   cat::idx m_event_capacity = 0u;
   cat::idx m_send_size = 0u;
   // The send buffer before this offset has been submitted by
   // `send_chunk()`.
   cat::idx m_send_submitted = 0u;
   cat::idx m_chunk_length = 0u;
   transfer_operation m_chunk_operation{};
   bool m_has_chunk = false;
   cat::idx m_receive_head = 0u;
   cat::idx m_receive_tail = 0u;
   cat::idx m_event_head = 0u;
   cat::idx m_event_tail = 0u;
   cat::idx m_maximum_request_size = 4'096u;

   // The sequence number of the last request queued.
   cat::uint8 m_sequence = 0u;
   cat::uint8 m_last_reply_sequence = 0u;
   // The widened sequence number of the last response received.
   cat::uint8 m_last_response_sequence = 0u;
   // `check()` diverts the error with this sequence number to `m_checked`.
   cat::uint8 m_check_sequence = 0u;
   error_packet m_checked{};
   bool m_has_checked = false;
   // A `transport` error for local misuse, which does not fail the connection.
   error_packet m_misuse{};
   // Why the last request that could not be queued was rejected.
   error_packet m_unsent{};

   // The sequence numbers of requests with replies whose reply or error has
   // not arrived, in request order. Responses arrive in request order too, so
   // a response is for such a request exactly when it matches the front.
   static constexpr cat::uint8 discarded_bit = 1ull << 63u;
   cat::uint8* _Nullable m_p_pending = nullptr;
   cat::idx m_pending_capacity = 0u;
   cat::idx m_pending_head = 0u;
   cat::idx m_pending_tail = 0u;

   // Replies and errors that arrived before their cookie was waited, each
   // after a `parked_reply`.
   cat::byte* _Nullable m_p_parked = nullptr;
   cat::idx m_parked_capacity = 0u;
   cat::idx m_parked_size = 0u;
   // The parked reply last returned by a wait, which the next call drops.
   cat::idx m_taken_parked = 0u;
   bool m_has_taken_parked = false;

   cat::uint4 m_id_base = 0u;
   cat::uint4 m_id_mask = 0u;
   cat::uint4 m_id_increment = 1u;
   cat::uint4 m_id_last = 0u;

   screen m_screen{};
   atom m_wm_protocols = atom::none;
   atom m_wm_delete_window = atom::none;
   atom m_net_wm_name = atom::none;
   atom m_utf8_string = atom::none;

   error_packet m_failure{};
   bool m_has_failed = false;
   // The ring failed with operations of this connection in flight, so their
   // buffers may still be written and must not be freed.
   bool m_is_ring_broken = false;
};
}  // namespace detail

class connection : detail::connection_state {
 public:
   connection(connection&& other) noexcept;
   connection(connection const&) = delete;
   ~connection();

   auto
   operator=(connection&& other) noexcept -> connection&;
   auto
   operator=(connection const&) -> connection& = delete;

   // Connect to `$DISPLAY`, authenticating with `$XAUTHORITY` or
   // `$HOME/.Xauthority`. `p_environment` is the null-terminated environment
   // array, which follows `argv`'s null terminator. This fails with
   // `nix::linux_error::badfd` unless the calling thread has called
   // `nix::alloc_io_uring_runtime()`. Buffers come from `allocator`, which
   // must outlive this connection.
   [[nodiscard]]
   static auto
   open(
      cat::allocator_dyn allocator,
      char const* _Nullable const* _Nonnull p_environment
   ) noexcept -> scaredy_x11<connection>;

   // Connect to `display`, authenticating with the Xauthority file at
   // `authority_path`. An empty path or a missing entry connects without
   // authorization, which servers may still accept from local users.
   [[nodiscard]]
   static auto
   open(
      cat::allocator_dyn allocator, cat::str_view display,
      cat::zstr_view authority_path
   ) noexcept -> scaredy_x11<connection>;

   [[nodiscard]]
   auto
   default_screen() const noexcept [[clang::lifetimebound]] -> screen const& {
      return m_screen;
   }

   // Allocate a new resource identifier for a window, pixmap, or other
   // resource. Once they run out this returns 0, and the server rejects
   // requests that create a resource with it.
   [[nodiscard]]
   auto
   generate_id() noexcept -> cat::uint4 {
      if (m_id_last + m_id_increment > m_id_mask) [[unlikely]] {
         return 0u;
      }
      m_id_last += m_id_increment;
      return m_id_base | m_id_last;
   }

   // Core requests.

   auto
   create_window(window_options const& options) noexcept -> window;

   auto
   change_window_attributes(
      window target, window_attributes const& attributes
   ) noexcept -> cookie<void> {
      struct {
         request_header header{
            .operation = operation_code::change_window_attributes,
         };
         x11::window target;
         cat::uint4 mask;
      } request{.target = target, .mask = attributes.mask};

      return push_with_values<void>(request, attributes);
   }

   auto
   destroy_window(window target) noexcept -> cookie<void> {
      return push<void>(window_request{
         .header = {.operation = operation_code::destroy_window},
         .target = target,
      });
   }

   auto
   map_window(window target) noexcept -> cookie<void> {
      return push<void>(window_request{
         .header = {.operation = operation_code::map_window},
         .target = target,
      });
   }

   auto
   unmap_window(window target) noexcept -> cookie<void> {
      return push<void>(window_request{
         .header = {.operation = operation_code::unmap_window},
         .target = target,
      });
   }

   auto
   configure_window(
      window target, window_configurations const& configurations
   ) noexcept -> cookie<void> {
      struct {
         request_header header{.operation = operation_code::configure_window};
         x11::window target;
         cat::uint2 mask;
         cat::uint2 _ = 0u;
      } request{
         .target = target,
      };

      // Configurations only have 7 fields, so their mask fits 16 bits.
      cat::maybe<cat::uint2> const mask =
         cat::narrow_cast<cat::uint2>(configurations.mask);
      if (!mask.has_value()) [[unlikely]] {
         return rejected<void>(error_code::value, configurations.mask);
      }
      request.mask = mask.value();
      return push_with_values<void>(request, configurations);
   }

   auto
   get_geometry(window target) noexcept -> cookie<geometry_reply> {
      return push<geometry_reply>(window_request{
         .header = {.operation = operation_code::get_geometry}, .target = target
      });
   }

   auto
   intern_atom(cat::str_view name, bool only_if_exists = false) noexcept
      -> cookie<intern_atom_reply> {
      cat::maybe<cat::uint2> const name_length =
         cat::narrow_cast<cat::uint2>(name.size());
      if (!name_length.has_value()) [[unlikely]] {
         return rejected<intern_atom_reply>(error_code::length, name.size());
      }

      struct {
         request_header header;
         cat::uint2 name_length;
         cat::uint2 _ = 0u;
      } request{
         .header =
            {.operation = operation_code::intern_atom,
                     .data = as_flag(only_if_exists)},
         .name_length = name_length.value(),
      };

      return push<intern_atom_reply>(request, as_bytes(name));
   }

   // `data` holds items of `format` bits each.
   auto
   change_property(
      window target, atom property, atom type, property_format format,
      cat::span<cat::byte const> data,
      property_mode mode = property_mode::replace
   ) noexcept -> cookie<void> {
      // Data must hold whole items, and their count must fit 32 bits.
      cat::idx const item_size = cat::to_underlying(format) / 8u;
      cat::maybe<cat::uint4> const items =
         cat::narrow_cast<cat::uint4>(data.size() / item_size);
      if (!items.has_value() || data.size() % item_size != 0u) [[unlikely]] {
         return rejected<void>(error_code::length, data.size());
      }

      struct {
         request_header header;
         x11::window target;
         x11::atom property, type;
         cat::uint1 format;
         cat::uint1 _[3] = {};  // NOLINT
         cat::uint4 length;
      } request{
         .header =
            {
                     .operation = operation_code::change_property,
                     .data = cat::to_underlying(mode),
                     },
         .target = target,
         .property = property,
         .type = type,
         .format = cat::to_underlying(format),
         .length = items.value(),
      };

      return push<void>(request, data);
   }

   auto
   delete_property(window target, atom property) noexcept -> cookie<void> {
      struct {
         request_header header{.operation = operation_code::delete_property};
         x11::window target;
         x11::atom property;
      } request{.target = target, .property = property};

      return push<void>(request);
   }

   // `offset` and `length` count 4-byte units. `type` may be `atom::none` to
   // accept any type.
   auto
   get_property(
      window target, atom property, atom type = atom::none,
      cat::uint4 offset = 0u, cat::uint4 length = 0x1fffffffu,
      bool delete_after = false
   ) noexcept -> cookie<property_reply> {
      struct {
         request_header header;
         x11::window target;
         x11::atom property, type;
         cat::uint4 offset, length;
      } request{
         .header =
            {
                     .operation = operation_code::get_property,
                     .data = as_flag(delete_after),
                     },
         .target = target,
         .property = property,
         .type = type,
         .offset = offset,
         .length = length,
      };

      return push<property_reply>(request);
   }

   // Send a 32-byte `event` packet to `destination`.
   auto
   send_event(
      window destination, event_mask mask, void const* _Nonnull p_event,
      bool propagate = false
   ) noexcept -> cookie<void> {
      struct {
         request_header header;
         x11::window destination;
         event_mask mask;
         cat::array<cat::byte, 32u> event;
      } request{
         .header =
            {
                     .operation = operation_code::send_event,
                     .data = as_flag(propagate),
                     },
         .destination = destination,
         .mask = mask,
         .event = {                                      },
      };

      __builtin_memcpy_inline(request.event.data(), p_event, 32u);
      return push<void>(request);
   }

   // `revert_to` is 0 for none, 1 for the pointer root, or 2 for the parent.
   auto
   set_input_focus(
      window focus, cat::uint1 revert_to = 2u, cat::uint4 time = 0u
   ) noexcept -> cookie<void> {
      struct {
         request_header header;
         x11::window focus;
         cat::uint4 time;
      } request{
         .header =
            {.operation = operation_code::set_input_focus, .data = revert_to},
         .focus = focus,
         .time = time,
      };

      return push<void>(request);
   }

   auto
   query_pointer(window target) noexcept -> cookie<pointer_reply> {
      return push<pointer_reply>(window_request{
         .header = {.operation = operation_code::query_pointer},
         .target = target,
      });
   }

   auto
   get_input_focus() noexcept -> cookie<input_focus_reply> {
      return push<input_focus_reply>(
         request_header{.operation = operation_code::get_input_focus}
      );
   }

   auto
   query_extension(cat::str_view name) noexcept
      -> cookie<query_extension_reply> {
      cat::maybe<cat::uint2> const name_length =
         cat::narrow_cast<cat::uint2>(name.size());
      if (!name_length.has_value()) [[unlikely]] {
         return rejected<query_extension_reply>(
            error_code::length, name.size()
         );
      }

      struct {
         request_header header{.operation = operation_code::query_extension};
         cat::uint2 name_length;
         cat::uint2 _ = 0u;
      } request{.name_length = name_length.value()};

      return push<query_extension_reply>(request, as_bytes(name));
   }

   // Queue an already encoded request, such as an extension request. Its
   // length field is filled in. `Reply` is `void` if it has no reply.
   template <typename Reply = void>
   auto
   send_request(cat::span<cat::byte const> request) noexcept -> cookie<Reply> {
      cat::idx const size = pad(request.size());
      cat::maybe<cat::uint2> const length = request_length(size);
      if (!length.has_value()) [[unlikely]] {
         return rejected<Reply>(error_code::length, size);
      }
      cat::byte* p_request = begin_request(size, !cat::is_void<Reply>);
      if (p_request == nullptr) [[unlikely]] {
         return {0u};
      }
      cat::idx const request_size = request.size();
      __builtin_memcpy(p_request, request.data(), request_size);
      __builtin_memset(
         p_request + request_size, 0, cat::idx(size - request_size)
      );
      set_length(p_request, length.value());
      return {m_sequence};
   }

   // Window manager conveniences.

   // Set `WM_NAME` and `_NET_WM_NAME` to the UTF-8 `title`.
   auto
   set_title(window target, cat::str_view title) noexcept -> cookie<void>;

   // Ask the window manager for a close request event instead of killing
   // this connection when the user closes `target`.
   auto
   enable_close_request(window target) noexcept -> cookie<void>;

   // Whether `event` asks to close its `.window()`.
   [[nodiscard]]
   auto
   is_close_request(event const& event) const noexcept -> bool;

   // Waiting.

   // Send any queued requests without waiting for a response.
   auto
   flush() noexcept -> scaredy_x11<void>;

   // Wait for a reply or its error. Cookies may be waited in any order, so
   // replies that arrive first are kept until their cookie is waited or
   // discarded. Waiting a cookie that was already waited or discarded fails
   // with `nix::linux_error::noent` instead of blocking.
   template <typename Reply>
   [[nodiscard]]
   auto
   wait(cookie<Reply> request) noexcept -> scaredy_x11<Reply> {
      static_assert(
         !cat::is_void<Reply>,
         "Requests without replies are verified with `check()`."
      );
      return to_reply<Reply>(wait_response(request.sequence));
   }

   // Wait for a reply, and copy up to `trailing.size()` bytes of the data that
   // follows it into `trailing`.
   template <typename Reply>
   [[nodiscard]]
   auto
   wait(cookie<Reply> request, cat::span<cat::byte> trailing) noexcept
      -> scaredy_x11<Reply> {
      static_assert(
         !cat::is_void<Reply>,
         "Requests without replies are verified with `check()`."
      );
      cat::byte const* p_response = wait_response(request.sequence);
      if (p_response[0] != 0u) {
         cat::idx const length = cat::idx(response_size(p_response) - 32u);
         cat::idx const capacity = trailing.size();
         __builtin_memcpy(
            trailing.data(), p_response + 32,
            length < capacity ? length : capacity
         );
      }
      return to_reply<Reply>(p_response);
   }

   // Round trip to the server to learn whether a request without a reply
   // failed. Its error is not also delivered as an event.
   [[nodiscard]]
   auto
   check(cookie<void> request) noexcept -> scaredy_x11<void>;

   // Drop the reply of a request whose cookie will never be waited.
   template <typename Reply>
   void
   discard(cookie<Reply> request) noexcept {
      if constexpr (!cat::is_void<Reply>) {
         discard_sequence(request.sequence);
      }
   }

   // Return the next event or asynchronous error, or `nullptr` if none have
   // arrived. This does not block.
   [[nodiscard]]
   auto
   poll_event() noexcept -> scaredy_x11<event const*>;

   // Return the next event or asynchronous error, blocking until one arrives.
   [[nodiscard]]
   auto
   wait_event() noexcept -> scaredy_x11<event const*>;

   // The error which ended this connection, if any. A failed connection fails
   // every later wait with this error.
   [[nodiscard]]
   auto
   failure() const noexcept -> cat::maybe<error_packet> {
      if (m_has_failed) {
         return m_failure;
      }
      return cat::nullopt;
   }

 private:
   // Every request begins with this.
   struct request_header {
      operation_code operation;
      cat::uint1 data = 0u;
      // The request's size in 4-byte units. `push()` fills this in.
      cat::uint2 length = 0u;
   };

   struct window_request {
      request_header header;
      x11::window target;
   };

   enum class transfer_mode : unsigned char {
      send,
      receive,
      poll,
   };

   [[nodiscard]]
   static constexpr auto
   pad(cat::idx size) noexcept -> cat::idx {
      return (size + 3u) / 4u * 4u;
   }

   // A request's length field, which counts 4-byte units in 16 bits.
   [[nodiscard]]
   static constexpr auto
   request_length(cat::idx size) noexcept -> cat::maybe<cat::uint2> {
      return cat::narrow_cast<cat::uint2>(size / 4u);
   }

   [[nodiscard]]
   static constexpr auto
   as_flag(bool flag) noexcept -> cat::uint1 {
      return flag ? cat::uint1(1u) : cat::uint1(0u);
   }

   [[nodiscard]]
   static auto
   as_bytes(cat::str_view string) noexcept -> cat::span<cat::byte const> {
      return {
         __builtin_bit_cast(cat::byte const*, string.data()), string.size()
      };
   }

   static void
   set_length(cat::byte* _Nonnull p_request, cat::uint2 length) noexcept {
      __builtin_memcpy_inline(p_request + 2, &length, 2u);
   }

   // The full size of a reply, error, or event, given its first 32 bytes.
   [[nodiscard]]
   static auto
   response_size(cat::byte const* _Nonnull p_response) noexcept -> cat::idx {
      if (
         p_response[0] == 1u
         || p_response[0] == cat::to_underlying(event_code::generic_event)
      ) {
         cat::uint4 length;
         __builtin_memcpy_inline(&length, p_response + 4, 4u);
         // Widen before multiplying, since this may exceed 32 bits.
         cat::idx const words = length;
         return words * 4u + 32u;
      }
      return 32u;
   }

   template <typename Reply>
   [[nodiscard]]
   static auto
   to_reply(cat::byte const* _Nonnull p_response) noexcept
      -> scaredy_x11<Reply> {
      if (p_response[0] == 0u) {
         error_packet failure;
         __builtin_memcpy_inline(&failure, p_response, 32u);
         return failure;
      }
      detail::x11_storage<Reply> reply;
      __builtin_memcpy_inline(&reply, p_response, sizeof(reply));
      return reply;
   }

   // Reserve `size` bytes for a request, and return them, or `nullptr` if this
   // connection failed.
   [[nodiscard]]
   auto
   begin_request(cat::idx size, bool has_reply) noexcept
      -> cat::byte* _Nullable {
      // Once earlier requests fill a chunk, start sending them, so that the
      // server works while later requests are encoded.
      if (m_send_size >= m_send_submitted + chunk_size) [[unlikely]] {
         send_chunk();
      }
      if (size > m_maximum_request_size || m_has_failed) [[unlikely]] {
         reject(error_code::length, size / 4u);
         return nullptr;
      }
      // Responses carry 16 bits of their request's sequence number. Ensure
      // that there is a response at least every 2^16 requests, so that each
      // can be widened from the last.
      if (!has_reply && m_sequence - m_last_reply_sequence >= 0xfffeu)
         [[unlikely]] {
         if (!reserve_pending() || !reserve_send(4u)) {
            return nullptr;
         }
         request_header const sync{
            .operation = operation_code::get_input_focus,
            .data = 0u,
            .length = 1u,
         };
         __builtin_memcpy_inline(m_p_send + m_send_size - 4u, &sync, 4u);
         m_last_reply_sequence = ++m_sequence;
         // Nothing waits for this reply.
         m_p_pending[m_pending_tail] = m_sequence | discarded_bit;
         ++m_pending_tail;
      }
      if (has_reply && !reserve_pending()) [[unlikely]] {
         return nullptr;
      }
      if (!reserve_send(size)) [[unlikely]] {
         return nullptr;
      }
      ++m_sequence;
      if (has_reply) {
         m_last_reply_sequence = m_sequence;
         m_p_pending[m_pending_tail] = m_sequence;
         ++m_pending_tail;
      }
      return m_p_send + (m_send_size - size);
   }

   // Ensure that one more pending reply can be recorded.
   [[nodiscard]]
   auto
   reserve_pending() noexcept -> bool {
      if (m_pending_tail == m_pending_capacity) [[unlikely]] {
         return make_pending_space();
      }
      return true;
   }

   [[nodiscard]]
   auto
   reserve_send(cat::idx size) noexcept -> bool {
      if (m_send_size + size > m_send_capacity) [[unlikely]] {
         if (!make_send_space(size)) {
            return false;
         }
      }
      m_send_size += size;
      return true;
   }

   template <typename Reply, typename Request>
   auto
   push(
      Request const& request, cat::span<cat::byte const> trailing = nullptr
   ) noexcept -> cookie<Reply> {
      constexpr cat::idx request_size = sizeof(Request);
      cat::idx const trailing_size = trailing.size();
      cat::idx const size = request_size + pad(trailing_size);
      cat::maybe<cat::uint2> const length = request_length(size);
      if (!length.has_value()) [[unlikely]] {
         return rejected<Reply>(error_code::length, size);
      }
      cat::byte* p_request = begin_request(size, !cat::is_void<Reply>);
      if (p_request == nullptr) [[unlikely]] {
         return {0u};
      }
      __builtin_memcpy_inline(p_request, &request, sizeof(Request));
      set_length(p_request, length.value());
      cat::byte* p_trailing = p_request + request_size;
      if (trailing_size != 0u) {
         __builtin_memcpy(p_trailing, trailing.data(), trailing_size);
      }
      __builtin_memset(
         p_trailing + trailing_size, 0,
         cat::idx(size - request_size - trailing_size)
      );
      return {m_sequence};
   }

   template <typename Reply, typename Request, typename Field>
   auto
   push_with_values(
      Request const& request, value_list<Field> const& values
   ) noexcept -> cookie<Reply> {
      constexpr cat::idx request_size = sizeof(Request);
      cat::idx const size = request_size + (values.size() * 4u);
      cat::maybe<cat::uint2> const length = request_length(size);
      if (!length.has_value()) [[unlikely]] {
         return rejected<Reply>(error_code::length, size);
      }
      cat::byte* p_request = begin_request(size, !cat::is_void<Reply>);
      if (p_request == nullptr) [[unlikely]] {
         return {0u};
      }
      __builtin_memcpy_inline(p_request, &request, sizeof(Request));
      set_length(p_request, length.value());
      cat::byte* p_value = p_request + request_size;
      // Values follow in the order of their bits in the mask.
      for (cat::uint4 mask = values.mask; mask != 0u;
           mask = mask & (mask - 1u)) {
         __builtin_memcpy_inline(
            p_value, &values.values[cat::countr_zero(mask)], 4u
         );
         p_value += 4;
      }
      return {m_sequence};
   }

   void
   fail(error_code code) noexcept;

   void
   discard_sequence(cat::uint8 sequence) noexcept;

   // Record why a request could not be queued, with the value which was out
   // of range.
   void
   reject(error_code code, cat::idx bad_value) noexcept;

   // Reject a request, and return its cookie.
   template <typename Reply>
   [[nodiscard]]
   auto
   rejected(error_code code, cat::idx bad_value) noexcept -> cookie<Reply> {
      reject(code, bad_value);
      return {0u};
   }

   [[nodiscard]]
   auto
   make_pending_space() noexcept -> bool;

   // The index of `sequence` among the pending replies, or `m_pending_tail`.
   [[nodiscard]]
   auto
   find_pending(cat::uint8 sequence) const noexcept -> cat::idx;

   // What `route()` did with a reply or error.
   enum class routed : unsigned char {
      // It is the response to the request being waited.
      target,
      // It was parked, captured by `check()`, or dropped for `discard()`.
      kept,
      // It is an error for a request without a reply, so it is an event.
      event,
      // Keeping it failed this connection.
      failed,
   };

   // Decide what to do with the reply or error last returned by
   // `next_response()`, while waiting for the request `target`.
   [[nodiscard]]
   auto
   route(cat::byte const* _Nonnull p_response, cat::uint8 target) noexcept
      -> routed;

   // Wait until no operation of this connection is in flight. This fails if
   // the ring breaks, and then the connection's buffers are never freed.
   [[nodiscard]]
   auto
   settle_operations() noexcept -> bool;

   // Park a reply or error which no wait asked for.
   [[nodiscard]]
   auto
   park(cat::byte const* _Nonnull p_response) noexcept -> bool;

   // The offset of the parked entry for `sequence`, or `m_parked_size`.
   [[nodiscard]]
   auto
   find_parked(cat::uint8 sequence) const noexcept -> cat::idx;

   void
   erase_parked(cat::idx offset) noexcept;

   // Drop the parked reply returned by the last wait.
   void
   release_taken() noexcept;

   void
   fail(nix::linux_error linux_error) noexcept;

   // Send everything queued, and grow the send buffer if it is still smaller
   // than `size`.
   [[nodiscard]]
   auto
   make_send_space(cat::idx size) noexcept -> bool;

   // Grow `p_buffer` to at least `minimum` bytes, keeping its contents.
   [[nodiscard]]
   auto
   grow(cat::byte*& p_buffer, cat::idx& capacity, cat::idx minimum) noexcept
      -> bool;

   // Submit the unsent part of the send buffer without waiting, unless an
   // earlier chunk is still being sent.
   void
   send_chunk() noexcept;

   // Wait for the chunk being sent, and fail if it was not sent.
   [[nodiscard]]
   auto
   finish_chunk() noexcept -> bool;

   // Cancel the watch and wait for its last completion.
   void
   stop_watching() noexcept;

   // Adopt the fixed file slot once its registration completes. With `wait`,
   // wait for that.
   void
   finish_slot(bool wait) noexcept;

   // Fill an SQE's file for the socket, using its fixed file slot if it has
   // one yet.
   void
   set_socket(nix::io_uring_sqe& submission) const noexcept;

   // Finish `other`'s chunk, so that no completion targets its old address.
   [[nodiscard]]
   static auto
   settled(connection& other) noexcept -> connection&;

   // Send queued requests, and for `receive` and `poll`, receive whatever
   // data is available. `poll` does not wait for data to arrive.
   [[nodiscard]]
   auto
   transfer(transfer_mode mode) noexcept -> bool;

   // Return the next complete response in the receive buffer, or `nullptr`.
   [[nodiscard]]
   auto
   next_response() noexcept -> cat::byte const* _Nullable;

   [[nodiscard]]
   auto
   queue_event(cat::byte const* _Nonnull p_response) noexcept -> bool;

   // Return the reply or error for `sequence`, or this connection's failure.
   [[nodiscard]]
   auto
   wait_response(cat::uint8 sequence) noexcept -> cat::byte const* _Nonnull;

   [[nodiscard]]
   auto
   next_event(transfer_mode mode) noexcept -> event const* _Nullable;

   [[nodiscard]]
   auto
   handshake(authorization authority, cat::uint4 screen_index) noexcept
      -> scaredy_x11<void>;

   explicit connection(cat::allocator_dyn allocator) noexcept
       : detail::connection_state(allocator) {
   }
};

}  // namespace x11
