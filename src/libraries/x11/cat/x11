// Error codes 1 through 17 are core protocol errors. Extensions allocate codes
// starting from their `query_extension_reply::first_error`.
enum class [[clang::enum_extensibility(open)]] error_code : unsigned char {
   // The X protocol never sends this code. `x11::connection` uses it for a
   // local failure, and stores its `nix::linux_error` in `bad_value`.
   transport = 0,
   request = 1,
   value = 2,
   window = 3,
   pixmap = 4,
   atom = 5,
   cursor = 6,
   font = 7,
   match = 8,
   drawable = 9,
   access = 10,
   alloc = 11,
   colormap = 12,
   graphics_context = 13,
   id_choice = 14,
   name = 15,
   length = 16,
   implementation = 17,
};

// This is the exact 32-byte error packet an X server sends.
struct error_packet {
   cat::uint1 response_type;
   error_code code;
   cat::uint2 sequence;
   cat::uint4 bad_value;
   cat::uint2 minor_operation;
   operation_code major_operation;
   cat::uint1 _[21];  // NOLINT

   [[nodiscard]]
   static constexpr auto
   from_linux(nix::linux_error linux_error) noexcept -> error_packet {
      error_packet result{};
      result.code = error_code::transport;
      result.bad_value = __builtin_bit_cast(cat::uint4, linux_error);
      return result;
   }

   [[nodiscard]]
   constexpr auto
   is_transport() const noexcept -> bool {
      return code == error_code::transport;
   }

   // This is only meaningful when `.is_transport()` holds.
   [[nodiscard]]
   constexpr auto
   linux_error() const noexcept -> nix::linux_error {
      return __builtin_bit_cast(nix::linux_error, bad_value);
   }
};

static_assert(sizeof(error_packet) == 32);

// The value of a successful `scaredy_x11<void>`. Like every reply, its first
// byte is non-zero, which distinguishes it from an `x11::error_packet`.
struct no_reply {
   cat::uint1 response_type = 1u;

   constexpr no_reply() = default;

   constexpr no_reply(cat::monostate_type /*unused*/) noexcept {
   }
};

namespace detail {
// Every reply and every error begins with a `response_type` byte, which is 0
// for errors and 1 for replies. Reading it through either member of a union is
// valid, because it is their common initial sequence.
template <typename T>
concept is_response = requires(T response) { response.response_type; };

template <typename Reply>
constexpr auto
holds_reply(Reply const& reply) noexcept -> bool {
   return reply.response_type != 0u;
}

template <typename T>
using x11_storage = cat::conditional<cat::is_void<T>, no_reply, T>;

template <typename T, bool = is_response<x11_storage<T>>>
struct x11_value {
   using type = T;
};

template <typename T>
struct x11_value<T, true> {
   using type =
      cat::compact_scaredy<x11_storage<T>, holds_reply<x11_storage<T>>>;
};
}  // namespace detail

// A reply or `x11::error_packet`. For replies, this is a union of the reply
// packet and error packet, discriminated by the packet's own first byte, so it
// has no storage or conversion cost over the bytes an X server sends. Other
// values are stored in a `cat::scaredy` variant.
template <typename T = void>
using scaredy_x11 =
   cat::scaredy<typename detail::x11_value<T>::type, error_packet>;

namespace detail {
// The low 16 bits of a sequence number, which responses carry.
[[nodiscard]]
constexpr auto
low_sequence(cat::uint8 sequence) noexcept -> cat::uint2 {
   // Masking leaves a value which always fits.
   return cat::narrow_cast<cat::uint2>(sequence & 0xffffu).value();
}
}  // namespace detail

// A handle to a pending request's response. `Reply` is `void` for requests
// without replies, which can be verified with `connection::check()`. A request
// that could not be queued gets sequence 0, and waiting or checking its cookie
// returns why.
template <typename Reply>
struct cookie {
   cat::uint8 sequence;

   // Whether `failure` is this request's error, such as an asynchronous error
   // from `connection::poll_event()`. Errors carry the low 16 bits of their
   // request's sequence number, so this holds within 2^16 requests.
   [[nodiscard]]
   constexpr auto
   is_for(error_packet const& failure) const noexcept -> bool {
      return failure.sequence == detail::low_sequence(sequence);
   }
};

