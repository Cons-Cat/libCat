namespace cat {

inline namespace manual {

struct thread {
 public:
   struct id {
      constexpr id() = default;

      constexpr explicit id(nix::process_id native) : m_native(native) {
      }

      [[nodiscard]]
      constexpr auto
      operator==(id const& other) const -> bool {
         return m_native.value == other.m_native.value;
      }

      [[nodiscard]]
      constexpr auto
      native_handle() const -> nix::process_id {
         return m_native;
      }

    private:
      nix::process_id m_native{0u};
   };

   thread() {
      m_handle.add_clone_flag(nix::clone_flags::thread);
      // `clone_flags::child_set_tid` pairs with `clone_flags::child_clear_tid`
      // (already in `nix::process::default_flags`) so the kernel publishes the
      // tid into `m_clone_child_clear_tid_for_kernel` before user code runs.
      // `join` waits on that word with `futex_command::wait`.
      m_handle.add_clone_flag(nix::clone_flags::child_set_tid);
   }

   thread(thread const&) = delete;

   // TODO: Default or delete a move constructor and assignment operator?

   template <typename... Args>
   auto
   spawn(
      is_allocator auto& allocator, idx stack_size,
      is_invocable<Args...> auto&& callback, Args&&... arguments
   ) -> maybe<void> {
      scaredy result = m_handle.spawn(
         allocator, stack_size, $fwd(callback), $fwd(arguments)...
      );
      if (result.has_value()) {
         return monostate;
      }
      return nullopt;
   }

   [[nodiscard]]
   auto
   join() const -> maybe<void> {
      scaredy result = m_handle.wait();
      if (result.has_value()) {
         return monostate;
      }
      return nullopt;
   }

   [[nodiscard]]
   constexpr auto
   has_stack() const -> bool {
      return m_handle.has_stack();
   }

   [[nodiscard]]
   constexpr auto
   get_id() const -> id {
      if (!m_handle.has_stack()) {
         return {};
      }
      return id(m_handle.id());
   }

   // Deallocate this `thread`'s stack from `allocator`. Call after `join()`.
   template <is_allocator Allocator>
   [[clang::reinitializes]]
   void
   free(allocator_ref<Allocator> allocator) {
      m_handle.free(allocator);
   }

   // Deallocate this `thread`'s stack from `allocator`. Call after `join()`.
   [[clang::reinitializes, gnu::always_inline, gnu::nodebug]]
   void
   free(dyn_allocator allocator) {
      free<dyn_allocator>(allocator);
   }

 private:
   // This is platform-specific hidden code.
   nix::process m_handle;
};

}  // namespace manual

namespace this_thread {
[[nodiscard]]
inline auto
get_id() -> thread::id {
   return thread::id(nix::sys_gettid());
}

inline void
yield() {
   nix::sys_sched_yield().verify();
}

template <is_duration Duration>
[[nodiscard]]
inline auto
sleep_for(Duration elapsed) -> maybe<void> {
   // TODO: Generalize this to other platforms.
   nix::timespec remaining = nix::make_timespec(elapsed);
   while (true) {
      auto result = nix::sys_nanosleep(remaining, &remaining);
      if (result.has_value()) {
         return monostate;
      }
      // A signal interrupts the sleep with the unslept time remaining.
      if (result.error() != nix::linux_error::intr) {
         return nullopt;
      }
   }
}

template <is_duration Duration>
[[nodiscard]]
auto
sleep_until(time_point<clock_system, Duration> const& point) -> maybe<void> {
   using timer = __typeof_unqual(clock_system::native_handle());
   return sleep_until(time_point<timer, Duration>(point.time_since_epoch()));
}

template <is_duration Duration>
[[nodiscard]]
auto
sleep_until(time_point<clock_steady, Duration> const& point) -> maybe<void> {
   using timer = __typeof_unqual(clock_steady::native_handle());
   return sleep_until(time_point<timer, Duration>(point.time_since_epoch()));
}

template <is_duration Duration>
[[nodiscard]]
auto
sleep_until(time_point<clock_unix, Duration> const& point) -> maybe<void> {
   using timer = __typeof_unqual(clock_unix::native_handle());
   return sleep_until(time_point<timer, Duration>(point.time_since_epoch()));
}

template <is_clock Clock, is_duration Duration>
[[nodiscard]]
auto
sleep_until(time_point<Clock, Duration> const& point) -> maybe<void> {
   using duration = Clock::duration;
   duration const deadline = point.time_since_epoch();
   duration elapsed = $prop(Clock::now()).time_since_epoch();

   if constexpr (Clock::is_steady) {
      // A steady clock never jumps, so one relative sleep reaches the deadline.
      if (elapsed < deadline) {
         $prop(sleep_for(deadline - elapsed));
      }
   } else {
      // An unsteady clock can jump either way, so it is read again every time.
      while (elapsed < deadline) {
         $prop(sleep_for(deadline - elapsed));
         elapsed = $prop(Clock::now()).time_since_epoch();
      }
   }

   return monostate;
}
}  // namespace this_thread

// TODO: Move this elsewhere.
inline void
relax_cpu() {
   asm volatile("pause" ::
                   : "memory");
}

template <typename CharT>
struct formatter<thread::id, CharT> : formatter_base<CharT> {
   auto
   format(thread::id const& value, format_context& context) const
      -> scaredy_format<void> {
      return formatter<uint4, CharT>{}.format(
         value.native_handle().value, context
      );
   }
};

template <typename CharT>
struct formatter<manual::thread, CharT> : formatter_base<CharT> {
   auto
   format(manual::thread const& value, format_context& context) const
      -> scaredy_format<void> {
      return formatter<thread::id, CharT>{}.format(value.get_id(), context);
   }
};

}  // namespace cat
