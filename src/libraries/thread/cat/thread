// -*- mode: c++ -*-
// vim: set ft=cpp:
#pragma once

#include <cat/allocator>
#include <cat/allocator_parameters>
#include <cat/chrono>
#include <cat/format>
#include <cat/linux>

// With `CAT_USE_PTHREAD`, a `cat::thread` is a POSIX thread rather than a
// `nix::process`.
#ifdef CAT_USE_PTHREAD
#include <cat/detail/pthread.hpp>
#endif

namespace cat {

inline namespace manual {

struct thread {
 public:
   struct id {
      using native_handle_type = nix::process_id;

      constexpr id() = default;

      constexpr explicit id(native_handle_type native) noexcept
          : m_native(native) {
      }

      [[nodiscard]]
      constexpr auto
      operator==(id const&) const noexcept -> bool = default;

      [[nodiscard]]
      constexpr auto
      native_handle() const noexcept -> native_handle_type {
         return m_native;
      }

    private:
      native_handle_type m_native{0u};
   };

#ifdef CAT_USE_PTHREAD
   using native_handle_type = nix::pthread_t;

   thread() = default;
#else
   using native_handle_type = nix::process;

   thread() noexcept {
      m_handle.add_clone_flag(nix::clone_flags::thread);
      // `clone_flags::child_set_tid` pairs with `clone_flags::child_clear_tid`
      // (already in `nix::process::default_flags`) so the kernel publishes the
      // tid into `m_clone_child_clear_tid_for_kernel` before user code runs.
      // `join` waits on that word with `futex_command::wait`.
      m_handle.add_clone_flag(nix::clone_flags::child_set_tid);
   }
#endif

   thread(thread const&) = delete;

   // TODO: Default or delete a move constructor and assignment operator?

   template <typename... Args>
   auto
   spawn(
      is_allocator auto& allocator, idx stack_size,
      is_invocable<Args...> auto&& callback, Args&&... arguments
   ) -> maybe<void> {
#ifdef CAT_USE_PTHREAD
      return $prop_as_or(
         nix::detail::pthread_spawn(
            allocator, stack_size, m_handle, $fwd(callback), $fwd(arguments)...
         ),
         nullopt, monostate
      );
#else
      return $prop_as_or(
         m_handle.spawn(
            allocator, stack_size, $fwd(callback), $fwd(arguments)...
         ),
         nullopt, monostate
      );
#endif
   }

   [[nodiscard]]
   auto
   join() const noexcept(!__has_feature(cxx_exceptions)) -> maybe<void> {
#ifdef CAT_USE_PTHREAD
      // Joining a POSIX thread twice is undefined, so `join()` clears the
      // handle to make joining again a no-op.
      if (m_handle.handle != 0u) {
         if (nix::pthread_join(m_handle.handle, nullptr) != 0) {
            return nullopt;
         }
         m_handle.handle = 0u;
      }
      return monostate;
#else
      return $prop_as_or(m_handle.wait(), nullopt, monostate);
#endif
   }

   [[nodiscard]]
   constexpr auto
   is_empty() const noexcept -> bool {
#ifdef CAT_USE_PTHREAD
      return m_handle.memory.data() == nullptr;
#else
      return m_handle.is_empty();
#endif
   }

#ifdef CAT_USE_PTHREAD
   [[nodiscard]]
   auto
   native_handle() const noexcept -> native_handle_type {
      return m_handle.handle;
   }
#else
   [[nodiscard]]
   auto
   native_handle() noexcept -> native_handle_type& {
      return m_handle;
   }

   [[nodiscard]]
   auto
   native_handle() const noexcept -> native_handle_type const& {
      return m_handle;
   }
#endif

   [[nodiscard]]
   constexpr auto
   get_id() const noexcept -> id {
      if (is_empty()) {
         return {};
      }
#ifdef CAT_USE_PTHREAD
      return id(m_handle.id);
#else
      return id(m_handle.id());
#endif
   }

   // Deallocate this `thread`'s stack from `allocator`. Call after `join()`.
   template <is_allocator Allocator>
   [[clang::reinitializes]]
   void
   free(allocator_ref<Allocator> allocator) noexcept(
      !__has_feature(cxx_exceptions)
   ) {
#ifdef CAT_USE_PTHREAD
      if (!is_empty()) {
         allocator.free_multi(m_handle.memory);
         m_handle = {};
      }
#else
      m_handle.free(allocator);
#endif
   }

   // Deallocate this `thread`'s stack from `allocator`. Call after `join()`.
   [[clang::reinitializes, gnu::always_inline, gnu::nodebug]]
   void
   free(allocator_dyn allocator) noexcept {
      free<allocator_dyn>(allocator);
   }

   // Deallocate this `thread`'s stack from `allocator`. Call after `join()`.
   template <is_allocator Allocator>
   [[clang::reinitializes]]
   void
   cfree(allocator_ref<Allocator> allocator) noexcept(
      !__has_feature(cxx_exceptions)
   ) {
#ifdef CAT_USE_PTHREAD
      if (!is_empty()) {
         allocator.cfree_multi(m_handle.memory);
         m_handle = {};
      }
#else
      m_handle.cfree(allocator);
#endif
   }

   // Deallocate this `thread`'s stack from `allocator`. Call after `join()`.
   [[clang::reinitializes, gnu::always_inline, gnu::nodebug]]
   void
   cfree(allocator_dyn allocator) noexcept {
      cfree<allocator_dyn>(allocator);
   }

 private:
   // This is platform-specific hidden code.
#ifdef CAT_USE_PTHREAD
   // `join()` clears the handle.
   mutable nix::detail::pthread_spawned m_handle{};
#else
   native_handle_type m_handle;
#endif
};

}  // namespace manual

namespace this_thread {
[[nodiscard]]
inline auto
get_id() noexcept(!__has_feature(cxx_exceptions)) -> thread::id {
   return thread::id(nix::sys_gettid());
}

inline void
yield() noexcept(!__has_feature(cxx_exceptions)) {
   nix::sys_sched_yield().verify();
}

template <is_duration Duration>
[[nodiscard]]
inline auto
sleep_for(Duration elapsed) noexcept(!__has_feature(cxx_exceptions))
   -> maybe<void> {
   // TODO: Generalize this to other platforms.
   nix::timespec remaining = nix::make_timespec(elapsed);
   while (true) {
      auto result = nix::sys_nanosleep(remaining, &remaining);
      if (result.has_value()) {
         return monostate;
      }
      // A signal interrupts the sleep with the unslept time remaining.
      if (result.error() != nix::linux_error::intr) {
         return nullopt;
      }
   }
}

template <is_duration Duration>
[[nodiscard]]
auto
sleep_until(time_point<clock_system, Duration> const& point) noexcept(
   !__has_feature(cxx_exceptions)
) -> maybe<void> {
   // Unwrap a `cat::clock_system` to use the optimized native implementation.
   using timer = clock_system::native_handle_type;
   return sleep_until(time_point<timer, Duration>(point.time_since_epoch()));
}

template <is_duration Duration>
[[nodiscard]]
auto
sleep_until(time_point<clock_steady, Duration> const& point) noexcept(
   !__has_feature(cxx_exceptions)
) -> maybe<void> {
   // Unwrap a `cat::clock_steady` to use the optimized native implementation.
   using timer = clock_steady::native_handle_type;
   return sleep_until(time_point<timer, Duration>(point.time_since_epoch()));
}

template <is_duration Duration>
[[nodiscard]]
auto
sleep_until(time_point<clock_unix, Duration> const& point) noexcept(
   !__has_feature(cxx_exceptions)
) -> maybe<void> {
   // Unwrap a `cat::clock_unix` to use the optimized native implementation.
   using timer = clock_unix::native_handle_type;
   return sleep_until(time_point<timer, Duration>(point.time_since_epoch()));
}

template <is_clock Clock, is_duration Duration>
[[nodiscard]]
auto
sleep_until(time_point<Clock, Duration> const& point) noexcept(
   !__has_feature(cxx_exceptions)
) -> maybe<void> {
   using duration = Clock::duration;
   duration const deadline = point.time_since_epoch();
   duration elapsed = $prop(Clock::now()).time_since_epoch();

   if constexpr (Clock::is_steady) {
      // A steady clock never jumps, so one relative sleep reaches the deadline.
      if (elapsed < deadline) {
         $prop(sleep_for(deadline - elapsed));
      }
   } else {
      // An unsteady clock can jump either way, so it is read again every time.
      while (elapsed < deadline) {
         $prop(sleep_for(deadline - elapsed));
         elapsed = $prop(Clock::now()).time_since_epoch();
      }
   }

   return monostate;
}
}  // namespace this_thread

template <typename CharT>
struct formatter<thread::id, CharT> : formatter_base<CharT> {
   auto
   format(thread::id const& value, format_context& context) const noexcept(
      !__has_feature(cxx_exceptions)
   ) -> scaredy_format<void> {
      return formatter<uint4, CharT>{}.format(
         value.native_handle().value, context
      );
   }
};

template <typename CharT>
struct formatter<manual::thread, CharT> : formatter_base<CharT> {
   auto
   format(manual::thread const& value, format_context& context) const noexcept
      -> scaredy_format<void> {
      return formatter<thread::id, CharT>{}.format(value.get_id(), context);
   }
};

}  // namespace cat
