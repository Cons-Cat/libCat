   [[nodiscard]]
   constexpr auto
   clone(
      allocator_ref<Allocator> allocator [[clang::lifetimebound]]
   ) const& -> maybe<basic_file_path> {
      auto storage = m_storage.clone(allocator);
      if (storage.is_empty()) {
         return nullopt;
      }

      basic_file_path result;
      result.m_storage = move(storage).value();
      return result;
