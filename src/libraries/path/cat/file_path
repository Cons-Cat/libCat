template <path_os os, str_vec_flags flags>
[[nodiscard]]
auto
path_scaredy_value(manual::basic_file_path<os, flags>&& value)
   -> scaredy<manual::basic_file_path<os, flags>, nix::linux_error> {
   scaredy<manual::basic_file_path<os, flags>, nix::linux_error> result =
      nix::linux_error::nomem;
   result = move(value);
   return result;
}

}  // namespace detail

template <
   path_os os = path_os::portable,
   str_vec_flags flags = detail::path_default_flags, is_allocator Allocator>
[[nodiscard]]
auto
make_file_path_current(allocator_ref<Allocator> allocator) noexcept(false)
   -> scaredy<manual::basic_file_path<os, flags>, nix::linux_error> {
   auto made = manual::make_file_path<Allocator, os, flags>(allocator);
   if (made.is_empty()) {
      return nix::linux_error::nomem;
   }

   manual::basic_file_path<os, flags> result = move(made).value();
   $defer {
      result.free(allocator);
   };
   while (true) {
      idx capacity = result.capacity();
      if (capacity == 0u) {
         capacity = detail::path_initial_capacity(flags);
      }

      if (result.resize(allocator, capacity).is_empty()) {
         return nix::linux_error::nomem;
      }

      auto cwd =
         nix::sys_getcwd(span<char>(result.data(), idx(result.size() + 1u)));
      if (cwd.has_value()) {
         result.resize(allocator, idx(cwd.value() - 1u)).verify();
         return detail::path_scaredy_value(move(result));
      }

      if (cwd.error() != nix::linux_error::range) {
         return cwd.error();
      }

      if (result.reserve(allocator, capacity * 2u).is_empty()) {
         return nix::linux_error::nomem;
      }
   }
}

template <
   path_os os = path_os::portable,
   str_vec_flags flags = detail::path_default_flags>
[[nodiscard]]
auto
make_file_path_current(allocator_dyn allocator) noexcept(
   !__has_feature(cxx_exceptions)
) -> scaredy<manual::basic_file_path<os, flags>, nix::linux_error> {
   return make_file_path_current<os, flags, allocator_dyn>(allocator);
}

template <
   path_os os = path_os::portable,
   str_vec_flags flags = detail::path_default_flags, is_path_segment Segment,
   is_path_segment Base, is_allocator Allocator>
[[nodiscard]]
auto
make_file_path_absolute(
   Segment const& segment, Base const& base, allocator_ref<Allocator> allocator
)
   -> scaredy<
      manual::basic_file_path<detail::path_deduce_os<os, Segment, Base>, flags>,
      nix::linux_error> {
   constexpr path_os result_os = detail::path_deduce_os<os, Segment, Base>;
   using path = manual::basic_file_path<result_os, flags>;
   str_view const value = detail::path_segment_view(segment);

   if (detail::path_parse_root<result_os>(value).is_absolute) {
      auto result =
         make_file_path<Allocator, result_os, flags>(allocator, value);
      if (result.is_empty()) {
         return nix::linux_error::nomem;
      }

      return detail::path_scaredy_value(move(result).value());
   }

   str_view const base_view = detail::path_segment_view(base);
   auto prefix = [&]() -> scaredy<path, nix::linux_error> {
      if (detail::path_parse_root<result_os>(base_view).is_absolute) {
         auto result =
            make_file_path<Allocator, result_os, flags>(allocator, base_view);
         if (result.is_empty()) {
            return nix::linux_error::nomem;
         }

         return detail::path_scaredy_value(move(result).value());
      }

      auto cwd = make_file_path_current<result_os, flags, Allocator>(allocator);
      if (cwd.is_empty()) {
         return cwd.error();
      }

      path result = move(cwd).value();
      $defer {
         result.free(allocator);
      };
      if (result.append(allocator, base_view).is_empty()) {
         return nix::linux_error::nomem;
      }

      return detail::path_scaredy_value(move(result));
   }();
   if (prefix.is_empty()) {
      return prefix.error();
   }

   path result = move(prefix).value();
   $defer {
      result.free(allocator);
   };
   if (result.append(allocator, value).is_empty()) {
      return nix::linux_error::nomem;
   }

   return detail::path_scaredy_value(move(result));
}

