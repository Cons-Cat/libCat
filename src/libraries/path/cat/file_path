// Resolve `segment` like `std::filesystem::canonical`. A relative `segment` is
// resolved from the current working directory. Every component must exist.
// Symbolic links are followed, then `.` and `..` components are removed.
template <
   path_os os = path_os::portable,
   str_vec_flags flags = detail::path_default_flags, is_path_segment Segment,
   is_allocator Allocator>
[[nodiscard]]
auto
make_file_path_canonical(
   Segment const& segment,
   allocator_ref<Allocator> allocator [[clang::lifetimebound]]
)
   -> scaredy<
      manual::basic_file_path<detail::path_deduce_os<os, Segment>, flags>,
      nix::linux_error> {
   constexpr path_os result_os = detail::path_deduce_os<os, Segment>;
   // TODO: Canonicalize `nt` paths with `GetFinalPathNameByHandleW`.
   static_assert(
      result_os != path_os::nt, "An `nt` path cannot be canonicalized yet!"
   );
   using path = manual::basic_file_path<result_os, flags>;
   // Linux's `MAXSYMLINKS`.
   constexpr idx max_links = 40u;

   auto absolute = make_file_path_absolute<os, flags, Segment, Allocator>(
      segment, allocator
   );
   if (absolute.is_empty()) {
      return absolute.error();
   }

   // `pending` holds the components left to resolve, and `target` holds the
   // last symbolic link that was read.
   path pending = move(absolute).value();
   auto made_resolved = make_file_path<Allocator, result_os, flags>(
      allocator, detail::path_view<result_os>("/")
   );
   auto made_target = make_file_path<Allocator, result_os, flags>(allocator);
   if (made_resolved.is_empty() || made_target.is_empty()) {
      return nix::linux_error::nomem;
   }

   path resolved = move(made_resolved).value();
   path target = move(made_target).value();
   $defer {
      pending.free(allocator);
      resolved.free(allocator);
      target.free(allocator);
   };

   auto const pop = [&] {
      maybe<idx> const separator =
         detail::path_find_last_equal(resolved.view(), '/');
      resolved.resize(allocator, max(separator.value(), 1u)).verify();
   };

   // A name followed by `.`, `..`, or a trailing separator must be a
   // directory. A following name is checked by the kernel instead.
   auto const require_directory = [&]() -> scaredy<void, nix::linux_error> {
      nix::file_status status;
      auto result = nix::sys_newfstatat(nix::at_fdcwd, resolved, status);
      if (result.is_empty()) {
         return result.error();
      }

      if (!status.is_directory()) {
         return nix::linux_error::notdir;
      }

      return {};
   };

   idx position = 0u;
   idx links = 0u;
   bool is_unchecked = false;
   while (true) {
      detail::path_view<result_os> const value = pending.view();
      while (position < value.size() && value[position] == '/') {
         ++position;
      }

      if (position == value.size()) {
         if (
            is_unchecked && value.size() != 0u
            && value[idx(value.size() - 1u)] == '/'
         ) {
            $prop(require_directory());
         }

         return detail::path_scaredy_value(move(resolved));
      }

      maybe<idx> const separator = detail::path_find_first_equal(
         detail::path_slice(value, position, value.size()), '/'
      );
      idx const end = separator.has_value() ? idx(position + separator.value())
                                            : value.size();
      detail::path_view<result_os> const name =
         detail::path_slice(value, position, end);
      position = end;

      if (detail::path_is_dot_or_dot_dot(name)) {
         if (is_unchecked) {
            $prop(require_directory());
            is_unchecked = false;
         }

         if (name.size() == 2u) {
            pop();
         }

         continue;
      }

      if (resolved.append(allocator, name).is_empty()) {
         return nix::linux_error::nomem;
      }

      idx length;
      while (true) {
         idx const capacity =
            max(target.capacity(), detail::path_initial_capacity(flags));
         if (target.resize(allocator, capacity).is_empty()) {
            return nix::linux_error::nomem;
         }

         auto read = nix::sys_readlink(
            resolved, span<char>(target.data(), target.size())
         );
         if (read.is_empty()) {
            if (read.error() != nix::linux_error::inval) {
               return read.error();
            }

            length = 0u;
            break;
         }

         // A full buffer may have truncated the link.
         if (read.value() < target.size()) {
            length = read.value();
            break;
         }

         if (target.reserve(allocator, capacity * 2u).is_empty()) {
            return nix::linux_error::nomem;
         }
      }

      // `inval` means that this name is not a symbolic link.
      if (length == 0u) {
         is_unchecked = true;
         continue;
      }

      if (++links > max_links) {
         return nix::linux_error::loop;
      }

      // Resolve the link's text followed by the unresolved remainder.
      detail::path_view<result_os> const rest =
         detail::path_slice(value, position, value.size());
      if (target.resize(allocator, length + rest.size()).is_empty()) {
         return nix::linux_error::nomem;
      }

      if (rest.size() != 0u) {
         copy_memory(rest.data(), target.data() + length, rest.size());
      }

      if (target.data()[0] == '/') {
         resolved.resize(allocator, 1u).verify();
      } else {
         pop();
      }

      swap(pending, target);
      position = 0u;
      is_unchecked = false;
   }
}

template <
   path_os os = path_os::portable,
   str_vec_flags flags = detail::path_default_flags, is_path_segment Segment>
[[nodiscard]]
auto
make_file_path_canonical(
   Segment const& segment, allocator_dyn allocator [[clang::lifetimebound]]
) noexcept(!__has_feature(cxx_exceptions))
   -> scaredy<
      manual::basic_file_path<detail::path_deduce_os<os, Segment>, flags>,
      nix::linux_error> {
   return make_file_path_canonical<os, flags, Segment, allocator_dyn>(
      segment, allocator
   );
}

template <
   path_os os = path_os::portable,
   str_vec_flags flags = detail::path_default_flags, is_allocator Allocator,
   is_path_segment Model>
[[nodiscard]]
auto
make_file_path_unique(
   allocator_ref<Allocator> allocator [[clang::lifetimebound]],
   Model const& model
)
   -> scaredy<
      manual::basic_file_path<detail::path_deduce_os<os, Model>, flags>,
      nix::linux_error> {
   auto made = make_file_path<Allocator, os, flags>(allocator, model);
   if (made.is_empty()) {
      return nix::linux_error::nomem;
   }

   manual::basic_file_path<detail::path_deduce_os<os, Model>, flags> result =
      move(made).value();
   $defer {
      result.free(allocator);
   };

   constexpr char hex[] = "0123456789abcdef";

   idx search_start = 0u;
   while (search_start < result.size()) {
      maybe<idx> const found = detail::path_find_first_equal(
         detail::path_slice(result.view(), search_start, result.size()), '%'
      );

      if (found.is_empty()) {
         break;
      }

      idx const index = search_start + found.value();
      unsigned char random;
      while (true) {
         auto generated = nix::sys_getrandom(span(&random, 1u));
         if (generated.has_value()) {
            if (generated.value() == 0u) {
               continue;
            }

            break;
         }

         if (generated.error() != nix::linux_error::intr) {
            return generated.error();
         }
      }

      result[index] = hex[random & 0x0fu];
      search_start = index + 1u;
   }

   return detail::path_scaredy_value(move(result));
}

template <
   path_os os = path_os::portable,
   str_vec_flags flags = detail::path_default_flags, is_allocator Allocator>
[[nodiscard]]
auto
make_file_path_unique(
   allocator_ref<Allocator> allocator [[clang::lifetimebound]]
) noexcept -> scaredy<manual::basic_file_path<os, flags>, nix::linux_error> {
   if constexpr (os == path_os::nt) {
      return make_file_path_unique<os, flags>(
         allocator, u"%%%%-%%%%-%%%%-%%%%"
      );
   } else {
      return make_file_path_unique<os, flags>(allocator, "%%%%-%%%%-%%%%-%%%%");
   }
}

template <
   path_os os = path_os::portable,
   str_vec_flags flags = detail::path_default_flags, is_path_segment Model>
[[nodiscard]]
auto
make_file_path_unique(
   allocator_dyn allocator [[clang::lifetimebound]], Model const& model
) noexcept(!__has_feature(cxx_exceptions))
   -> scaredy<
      manual::basic_file_path<detail::path_deduce_os<os, Model>, flags>,
      nix::linux_error> {
   return make_file_path_unique<os, flags, allocator_dyn>(allocator, model);
}

template <
   path_os os = path_os::portable,
   str_vec_flags flags = detail::path_default_flags>
[[nodiscard]]
auto
make_file_path_unique(allocator_dyn allocator [[clang::lifetimebound]]) noexcept
   -> scaredy<manual::basic_file_path<os, flags>, nix::linux_error> {
   return make_file_path_unique<os, flags, allocator_dyn>(allocator);
}

