inline namespace manual {

template <path_os os, str_vec_flags flags>
class [[clang::preferred_name(file_path), gsl::Owner]]
basic_file_path : public container_interface<basic_file_path<os, flags>, char>,
                  public random_access_stepanov_iterable_interface<char> {
 private:
   static constexpr str_vec_flags m_flags =
      str_flags::null_terminated
      | vec_flags::pointer_size_layout
      | container_flags::inline_storage(256u)
      | flags;

   static_assert(m_flags.str.is_null_terminated);
   static_assert(m_flags.vec.uses_pointer_size_layout);

   template <
      is_allocator Allocator, path_os other_os, str_vec_flags other_flags>
   friend class raii::basic_file_path;

 public:
   constexpr basic_file_path() = default;
   constexpr basic_file_path(basic_file_path&&) = default;
   constexpr basic_file_path(basic_file_path const&) =
      delete ("Implicit copying of `cat::basic_file_path` is forbidden. Call "
              "`.clone()` or move instead.");
   constexpr auto
   operator=(basic_file_path&&) -> basic_file_path& = default;
   auto
   operator=(basic_file_path const&) noexcept -> basic_file_path& =
      delete ("Implicit copying of `cat::basic_file_path` is forbidden. Call "
              "`.clone()` or move instead.");

   [[nodiscard]]
   constexpr auto
   operator==(basic_file_path const& other) const noexcept -> bool {
      return view() == other.view();
   }

   [[nodiscard]]
   constexpr auto
   data() noexcept [[clang::lifetimebound]] -> char* _Nullable {
      return m_storage.data();
   }

   [[nodiscard]]
   constexpr auto
   data() const noexcept [[clang::lifetimebound]] -> char const* _Nullable {
      return m_storage.data();
   }

   [[nodiscard]]
   constexpr auto
   size() const noexcept -> idx {
      return m_storage.size();
   }

   [[nodiscard]]
   constexpr auto
   capacity() const noexcept -> idx {
      return m_storage.capacity();
   }

   [[nodiscard]]
   constexpr auto
   is_null_terminated() const noexcept -> bool {
      return true;
   }

   [[nodiscard]]
   constexpr auto
   view() const noexcept [[clang::lifetimebound]] -> str_view {
      return m_storage.view();
   }

   [[nodiscard]]
   constexpr auto
   native_handle() noexcept [[clang::lifetimebound]] -> zstr_span {
      return m_storage.span();
   }

   [[nodiscard]]
   constexpr auto
   native_handle() const noexcept [[clang::lifetimebound]] -> zstr_view {
      return m_storage.span();
   }

   [[nodiscard]]
   constexpr
   operator zstr_span() noexcept [[clang::lifetimebound]] {
      return native_handle();
   }

   [[nodiscard]]
   constexpr
   operator zstr_view() const noexcept [[clang::lifetimebound]] {
      return native_handle();
   }

   template <is_allocator Allocator>
   [[nodiscard]]
   constexpr auto
   reserve(allocator_ref<Allocator> allocator, idx minimum_capacity) noexcept
      -> maybe<void>
      requires(!m_flags.vec.is_fixed_size)
   {
      return m_storage.reserve(allocator, minimum_capacity);
   }

   [[nodiscard]]
   constexpr auto
   reserve(allocator_dyn allocator, idx minimum_capacity) noexcept
      -> maybe<void>
      requires(!m_flags.vec.is_fixed_size)
   {
      return m_storage.reserve(allocator, minimum_capacity);
   }

   template <is_allocator Allocator>
   [[nodiscard]]
   constexpr auto
   resize(allocator_ref<Allocator> allocator, idx new_size) noexcept
      -> maybe<void> {
      return m_storage.resize(allocator, new_size);
   }

   [[nodiscard]]
   constexpr auto
   resize(allocator_dyn allocator, idx new_size) noexcept -> maybe<void> {
      return m_storage.resize(allocator, new_size);
   }

   constexpr void
   clear() noexcept {
      m_storage.clear();
   }

   template <is_allocator Allocator>
   constexpr void
   free(allocator_ref<Allocator> allocator) noexcept(
      !__has_feature(cxx_exceptions)
   ) {
      m_storage.free(allocator);
   }

   constexpr void
   free(allocator_dyn allocator) noexcept(!__has_feature(cxx_exceptions)) {
      m_storage.free(allocator);
   }

   template <is_allocator Allocator>
   constexpr void
   cfree(allocator_ref<Allocator> allocator) noexcept(
      !__has_feature(cxx_exceptions)
   ) {
      m_storage.cfree(allocator);
   }

   constexpr void
   cfree(allocator_dyn allocator) noexcept(!__has_feature(cxx_exceptions)) {
      m_storage.cfree(allocator);
   }

   template <is_allocator Allocator>
   [[nodiscard]]
   constexpr auto
   clone(allocator_ref<Allocator> allocator) const& -> maybe<basic_file_path> {
      auto storage = m_storage.clone(allocator);
      if (storage.is_empty()) {
         return nullopt;
      }

      basic_file_path result;
      result.m_storage = move(storage).value();
      return result;
   }

   [[nodiscard]]
   constexpr auto
   clone(allocator_dyn allocator) const& noexcept -> maybe<basic_file_path> {
      return clone<allocator_dyn>(allocator);
   }

   [[nodiscard]]
   constexpr auto
   is_absolute() const noexcept -> bool {
      return parse_root().is_absolute;
   }

   [[nodiscard]]
   constexpr auto
   is_relative() const noexcept -> bool {
      return !is_absolute();
   }

   [[nodiscard]]
   constexpr auto
   root_name() const noexcept -> str_view {
      return detail::path_slice(view(), 0u, parse_root().name_end);
   }

   [[nodiscard]]
   constexpr auto
   root_directory() const noexcept -> str_view {
      detail::path_root const root = parse_root();
      return detail::path_slice(view(), root.name_end, root.end);
   }

   [[nodiscard]]
   constexpr auto
   root_path() const noexcept -> str_view {
      return detail::path_slice(view(), 0u, parse_root().end);
   }

   [[nodiscard]]
   constexpr auto
   relative_path() const noexcept(!__has_feature(cxx_exceptions)) -> str_view {
      idx const first = detail::path_relative_start(view(), parse_root());
      return detail::path_slice(view(), first, size());
   }

   [[nodiscard]]
   constexpr auto
   parent_path() const -> str_view {
      return detail::path_parent(view(), parse_root());
   }

   [[nodiscard]]
   constexpr auto
   filename() const [[clang::lifetimebound]] -> str_view {
      return detail::path_filename(view(), parse_root());
   }

   [[nodiscard]]
   constexpr auto
   stem() const [[clang::lifetimebound]] -> str_view {
      str_view const name = filename();
      if (name == "." || name == "..") {
         return name;
      }

      maybe<idx> const dot = detail::path_find_last_equal(name, '.');
      if (dot.is_empty() || dot.value() == 0u) {
         return name;
      }

      return detail::path_slice(name, 0u, dot.value());
   }

   [[nodiscard]]
   constexpr auto
   extension() const -> str_view {
      str_view const name = filename();
      if (name == "." || name == "..") {
         return {};
      }

      maybe<idx> const dot = detail::path_find_last_equal(name, '.');
      if (dot.is_empty() || dot.value() == 0u) {
         return {};
      }

      return detail::path_slice(name, dot.value(), name.size());
   }

   [[nodiscard]]
   constexpr auto
   has_root_name() const noexcept -> bool {
      return parse_root().name_end != 0u;
   }

   [[nodiscard]]
   constexpr auto
   has_root_directory() const noexcept -> bool {
      detail::path_root const root = parse_root();
      return root.end != root.name_end;
   }

   [[nodiscard]]
   constexpr auto
   has_root_path() const noexcept -> bool {
      return parse_root().end != 0u;
   }

   [[nodiscard]]
   constexpr auto
   has_relative_path() const noexcept -> bool {
      return relative_path().size() != 0u;
   }

   [[nodiscard]]
   constexpr auto
   has_parent_path() const noexcept(!__has_feature(cxx_exceptions)) -> bool {
      return parent_path().size() != 0u;
   }

   [[nodiscard]]
   constexpr auto
   has_filename() const noexcept(!__has_feature(cxx_exceptions)) -> bool {
      return filename().size() != 0u;
   }

   [[nodiscard]]
   constexpr auto
   has_stem() const noexcept(!__has_feature(cxx_exceptions)) -> bool {
      return stem().size() != 0u;
   }

   [[nodiscard]]
   constexpr auto
   has_extension() const noexcept(!__has_feature(cxx_exceptions)) -> bool {
      return extension().size() != 0u;
   }

   [[nodiscard]]
   constexpr auto
   components() const noexcept [[clang::lifetimebound]] -> path_components {
      detail::path_root const root = parse_root();
      return {
         detail::path_slice(view(), root.name_end, size()),
         root.separators,
      };
   }

   // Join `segment` like `std::filesystem::path::operator/=`.
   template <is_allocator Allocator, is_path_segment Segment>
   [[nodiscard]]
   constexpr auto
   append(allocator_ref<Allocator> allocator, Segment const& segment)
      -> maybe<void> {
      static_assert(
         detail::path_segment_has_os<os, Segment>,
         "A path cannot be joined with a path of a different `cat::path_os`! "
         "Join its `.view()` instead."
      );
      str_view const right = detail::path_segment_view(segment);

      if (right.size() == 0u) {
         return monostate;
      }

      detail::path_root const left_root = parse_root();
      detail::path_root const right_root = detail::path_parse_root<os>(right);
      str_view const right_name =
         detail::path_slice(right, 0u, right_root.name_end);

      if (right_root.is_absolute
          || (right_name.size() != 0u
              && right_name
                    != detail::path_slice(view(), 0u, left_root.name_end))) {
         clear();
         return m_storage.append(allocator, right);
      }

      str_view const right_tail =
         detail::path_slice(right, right_root.name_end, right.size());
      if (right_root.end != right_root.name_end) {
         $prop(m_storage.resize(allocator, left_root.name_end));
         return m_storage.append(allocator, right_tail);
      }

      if (
         has_filename()
         || (left_root.end == left_root.name_end && left_root.is_absolute)
      ) {
         $prop(m_storage.push_back(allocator, os == path_os::nt ? '\\' : '/'));
      }

      return m_storage.append(allocator, right_tail);
   }

   template <is_path_segment Segment>
   [[nodiscard]]
   constexpr auto
   append(allocator_dyn allocator, Segment const& segment) noexcept(
      !__has_feature(cxx_exceptions)
   ) -> maybe<void> {
      return append<allocator_dyn>(allocator, segment);
   }

 private:
   [[nodiscard]]
   constexpr auto
   parse_root() const noexcept -> detail::path_root {
      return detail::path_parse_root<os>(view());
   }

   template <path_os other_os, str_vec_flags other_flags>
   friend constexpr auto
   detail::maybe_file_path_has_value(
      basic_file_path<other_os, other_flags> const&
   ) -> bool;

   template <path_os other_os, str_vec_flags other_flags>
   friend constexpr auto
   detail::maybe_file_path_nullopt() -> basic_file_path<other_os, other_flags>;

   basic_str_vec<char, m_flags> m_storage;
};

