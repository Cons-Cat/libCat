   constexpr path_os result_os = detail::path_deduce_os<os, Segment>;
   basic_file_path<result_os, flags> result =
      $prop((make_file_path<Allocator, os, flags>(allocator, segment)));
   $defer {
      result.free(allocator);
   };

   $prop(result.resize(
      allocator,
      detail::path_lexically_normalize<result_os>(result.data(), result.size())
   ));
