template <
   path_os os = path_os::portable,
   str_vec_flags flags = detail::path_default_flags, is_allocator Allocator>
[[nodiscard]]
auto
make_file_path_current(
   allocator_ref<Allocator> allocator [[clang::lifetimebound]]
) noexcept(false)
   -> scaredy<manual::basic_file_path<os, flags>, nix::linux_error> {
   // TODO: Transcode the working directory for `nt` paths.
   static_assert(
      os != path_os::nt, "The working directory cannot be an `nt` path yet!"
   );
   auto made = manual::make_file_path<Allocator, os, flags>(allocator);
   if (made.is_empty()) {
      return nix::linux_error::nomem;
   }

   manual::basic_file_path<os, flags> result = move(made).value();
   $defer {
      result.free(allocator);
   };
   while (true) {
      idx capacity = result.capacity();
      if (capacity == 0u) {
         capacity = detail::path_initial_capacity(flags);
      }

      if (result.resize(allocator, capacity).is_empty()) {
         return nix::linux_error::nomem;
      }

      auto cwd =
         nix::sys_getcwd(span<char>(result.data(), idx(result.size() + 1u)));
      if (cwd.has_value()) {
         result.resize(allocator, idx(cwd.value() - 1u)).verify();
         return detail::path_scaredy_value(move(result));
      }

      if (cwd.error() != nix::linux_error::range) {
         return cwd.error();
      }

      if (result.reserve(allocator, capacity * 2u).is_empty()) {
         return nix::linux_error::nomem;
      }
   }
}

