template <
   is_allocator Allocator, path_os os = path_os::portable,
   str_vec_flags flags = detail::path_default_flags, is_path_segment Segment>
[[nodiscard]]
constexpr auto
make_file_path(allocator_ref<Allocator> allocator, Segment const& segment)
   -> maybe<basic_file_path<detail::path_deduce_os<os, Segment>, flags>> {
   basic_file_path<detail::path_deduce_os<os, Segment>, flags> result;
   $defer {
      result.free(allocator);
   };

   str_view const value = detail::path_segment_view(segment);
   $prop(result.reserve(
      allocator, max(value.size(), detail::path_initial_capacity(flags))
   ));
   $prop(result.resize(allocator, 0u));
   $prop(result.append(allocator, segment));
   return move(result);
}

