// -*- mode: c++ -*-
// vim: set ft=cpp:
#pragma once

// `cat::basic_file_path` is a dynamically-sized owning file path container. It
// is inspired by `std::filesystem::path`, but a major distinction is that its
// only encoding is utf8 characters across all platforms.
// TODO: On Windows, this will mean the UTF-8 Active Code Page is used over `A`
// family syscalls.
//
// As this is a `manual` namespace container, its destructor does not deallocate
// storage. To deallocate storage, call `.free(allocator)` or
// `.cfree(allocator)`.
//
// The `cat::raii::basic_file_path` deallocates its own memory automatically.
//
// Path joining and decomposition are lexical. They do not access the
// filesystem, resolve symbolic links, or normalize `.` and `..` components.
// `make_file_path_lexically_normal` removes those components lexically.
// `make_file_path_absolute` accesses the current working directory only when
// its base path is relative. `make_file_path_canonical` reads the filesystem
// to follow symbolic links. `make_file_path_unique` replaces percent signs
// with random hexadecimal digits without creating a filesystem entry.
//
// It is parameterized by `cat::str_vec_flags`. Path storage is always
// null-terminated and uses the pointer-size vector layout. Those flags may
// toggle the following features:
//
//  `inline_storage(count)`
//     Store up to `count` characters inside the path, only allocating when its
//     inline capacity is exceeded.
//
//  `initial_growth(count)`
//     Grow to at least `count` characters on the first heap allocation, when
//     `inline_storage` is disabled.
//
//  `fixed_size`
//     The path has a fixed size upon allocation and no separate capacity.
//
// Convenience type aliases are provided:
//
//  `cat::file_path`, a `basic_file_path` with 256 inline characters.
//  `cat::file_path_fixed`, a `basic_file_path` with `fixed_size` flag.
//
// 256 inline characters is a size borrowed from LLVM. Their measurements found
// this tradeoff ideal.
// TODO: Furthor research that.
// TODO: Provide a `cat::file_path_small[_fixed]` alias.
// TODO: Document the `path_os` field here.
//
// When `inline_storage` is disabled, `file_path`s grow from 0 to a capacity of
// their `initial_growth` count in their initial allocation. Reallocations grow
// to double their current size from there.

#include <cat/detail/compact.hpp>

#include <cat/defer>
#include <cat/format>
#include <cat/linux>
#include <cat/propagate>
#include <cat/simd>
#include <cat/simd_switch>
#include <cat/string>

namespace cat {

// This tag determines a `file_path`'s encoding.
// NOLINTNEXTLINE
enum class [[clang::enum_extensibility(closed)]] path_os : unsigned char {
   portable,  // (UTF-8)
   nix,       // Linux/Unix (UTF-8)
   nt,        // Windows NT (UTF-16)
#ifdef _WIN32
   native = nt,
#else
   native = nix,
#endif
};

namespace detail {

inline constexpr str_vec_flags path_default_flags =
   str_flags::null_terminated
   | vec_flags::pointer_size_layout
   | container_flags::inline_storage(256u);

// Path storage always reserves one character for its null terminator.
[[nodiscard]]
constexpr auto
path_initial_capacity(str_vec_flags flags) noexcept -> idx {
   vec_flags const vector = (path_default_flags | flags).vec;
   return vector.container.inline_storage_count != 0u
             ? idx(vector.container.inline_storage_count - 1u)
             : vector.initial_growth_count;
}

// The character type that a `path_os` stores and accepts.
// TODO: Transcode between `char` and `char16_t` paths.
template <path_os os>
using path_char = conditional<os == path_os::nt, char16_t, char>;

template <path_os os>
using path_view = basic_str_span<path_char<os> const>;

template <path_os os>
using path_native_view =
   basic_str_span<path_char<os> const, str_flags::null_terminated>;

template <path_os os>
using path_native_span =
   basic_str_span<path_char<os>, str_flags::null_terminated>;

template <typename CharT>
concept is_path_char = is_same<CharT, char> || is_same<CharT, char16_t>;

template <typename Segment>
concept is_path_safe_string =
   is_safe_string<Segment>
   && is_path_char<__typeof_unqual(typename Segment::value_type)>;

template <typename Segment>
   requires(is_path_safe_string<Segment>)
[[nodiscard]]
constexpr auto
path_segment_view(Segment const& segment [[clang::lifetimebound]]) noexcept
   -> basic_str_span<__typeof_unqual(typename Segment::value_type) const> {
   return segment;
}

template <is_path_char CharT, idx extent>
[[nodiscard]]
constexpr auto
path_segment_view(CharT const (&segment)[extent]) noexcept
   -> basic_str_span<CharT const> {
   return {segment, idx(extent - 1u)};
}

template <is_path_char CharT, idx extent>
[[nodiscard]]
constexpr auto
path_segment_view(CharT (&segment)[extent]) noexcept
   -> basic_str_span<CharT const> {
   return {segment, idx(extent - 1u)};
}

template <typename Segment>
   requires(
      !is_path_safe_string<Segment> && !is_array<Segment>
      && requires(Segment const& segment) { str_view(segment); }
   )
[[nodiscard]]
constexpr auto
path_segment_view(Segment const& segment) noexcept -> str_view {
   return str_view(segment);
}

template <typename CharT>
[[nodiscard]]
constexpr auto
path_slice(basic_str_span<CharT const> value, idx first, idx last) noexcept
   -> basic_str_span<CharT const> {
   if (first == last) {
      return {};
   }

   return {value.data() + first, idx(last - first)};
}

// Find the first character that is (or isn't) either `first` or `second`.
template <bool equal, typename CharT>
[[nodiscard]]
constexpr auto
path_find_first(
   basic_str_span<CharT const> value, char first, char second
) noexcept(!__has_feature(cxx_exceptions)) -> maybe<idx> {
   // TODO: Vectorize `char16_t` paths.
   if !consteval {
      if constexpr (is_same<CharT, char>) {
         return $simd_switch($abi((avx2, sse2), {
            constexpr idx lanes = char1x_::size();
            idx position = 0u;
            char1x_ firsts;
            firsts.fill(first);
            char1x_ seconds;
            seconds.fill(second);

            while (value.size() - position >= lanes) {
               char1x_ chunk;
               chunk.load(value.data() + position);

               auto const matches =
                  chunk.equal_lanes(firsts) || chunk.equal_lanes(seconds);

               auto const mask = [&] {
                  if constexpr (equal) {
                     return matches;
                  } else {
                     return !matches;
                  }
               }();

               if (mask.any_of()) {
                  return maybe<idx>(position + mask.find_if_true());
               }

               position += lanes;
            }

            while (position < value.size()) {
               char const character = value[position];

               if ((character == first || character == second) == equal) {
                  return maybe<idx>(position);
               }

               ++position;
            }

            return maybe<idx>(nullopt);
         }));
      }
   }

   for (idx position = 0u; position < value.size(); ++position) {
      CharT const character = value[position];

      if ((character == first || character == second) == equal) {
         return position;
      }
   }

   return nullopt;
}

// Find the last character that is (or isn't) either `first` or `second`.
template <bool equal, typename CharT>
[[nodiscard]]
constexpr auto
path_find_last(
   basic_str_span<CharT const> value, char first, char second
) noexcept(!__has_feature(cxx_exceptions)) -> maybe<idx> {
   // TODO: Vectorize `char16_t` paths.
   if !consteval {
      if constexpr (is_same<CharT, char>) {
         return $simd_switch($abi((avx2, sse2), {
            constexpr idx lanes = char1x_::size();
            idx end = value.size();
            char1x_ firsts;
            firsts.fill(first);
            char1x_ seconds;
            seconds.fill(second);

            while (end >= lanes) {
               idx const position = idx(end - lanes);

               char1x_ chunk;
               chunk.load(value.data() + position);

               auto const matches =
                  chunk.equal_lanes(firsts) || chunk.equal_lanes(seconds);

               auto const mask = [&] {
                  if constexpr (equal) {
                     return matches;
                  } else {
                     return !matches;
                  }
               }();

               if (mask.any_of()) {
                  return maybe<idx>(position + mask.find_last_if_true());
               }

               end = position;
            }

            while (end > 0u) {
               end = idx(end - 1u);
               char const character = value[end];

               if ((character == first || character == second) == equal) {
                  return maybe<idx>(end);
               }
            }

            return maybe<idx>(nullopt);
         }));
      }
   }

   idx position = value.size();

   while (position > 0u) {
      position = idx(position - 1u);
      CharT const character = value[position];

      if ((character == first || character == second) == equal) {
         return position;
      }
   }

   return nullopt;
}

template <typename Segment>
[[nodiscard]]
constexpr auto
path_find_first_equal(Segment const& value, char character) noexcept
   -> maybe<idx> {
   return path_find_first<true>(path_segment_view(value), character, character);
}

template <typename Segment>
[[nodiscard]]
constexpr auto
path_find_last_equal(Segment const& value, char character) noexcept
   -> maybe<idx> {
   return path_find_last<true>(path_segment_view(value), character, character);
}

// On most platforms, paths are separated by `/`, but Windows also accepts `\`.
struct path_separators {
   char first;
   char second;
};

inline constexpr path_separators path_slash_separators = {
   .first = '/',
   .second = '/',
};
inline constexpr path_separators path_nt_separators = {
   .first = '\\',
   .second = '/',
};
inline constexpr path_separators path_nt_verbatim_separators = {
   .first = '\\',
   .second = '\\',
};

template <typename CharT>
[[nodiscard]]
constexpr auto
path_is_separator(path_separators separators, CharT character) noexcept
   -> bool {
   return character == separators.first || character == separators.second;
}

template <typename Segment>
[[nodiscard]]
constexpr auto
path_find_first_separator(
   Segment const& value, path_separators separators
) noexcept -> maybe<idx> {
   return path_find_first<true>(
      path_segment_view(value), separators.first, separators.second
   );
}

template <typename Segment>
[[nodiscard]]
constexpr auto
path_find_first_not_separator(
   Segment const& value, path_separators separators
) noexcept -> maybe<idx> {
   return path_find_first<false>(
      path_segment_view(value), separators.first, separators.second
   );
}

template <typename Segment>
[[nodiscard]]
constexpr auto
path_find_last_separator(
   Segment const& value, path_separators separators
) noexcept -> maybe<idx> {
   return path_find_last<true>(
      path_segment_view(value), separators.first, separators.second
   );
}

template <typename Segment>
[[nodiscard]]
constexpr auto
path_find_last_not_separator(
   Segment const& value, path_separators separators
) noexcept -> maybe<idx> {
   return path_find_last<false>(
      path_segment_view(value), separators.first, separators.second
   );
}

struct path_root {
   idx name_end;
   idx end;
   path_separators separators;
   bool is_absolute;
};

[[nodiscard]]
constexpr auto
path_starts_with(u16str_view value, idx position, u16str_view prefix) noexcept
   -> bool {
   return value.size() >= position + prefix.size()
          && path_slice(value, position, position + prefix.size()) == prefix;
}

[[nodiscard]]
constexpr auto
path_is_drive(u16str_view value, idx position) noexcept -> bool {
   if (position + 1u >= value.size()) {
      return false;
   }

   char16_t const letter = value[position];
   return ((letter >= u'a' && letter <= u'z')
           || (letter >= u'A' && letter <= u'Z'))
          && value[position + 1u] == u':';
}

// The end of the component that begins at `position`.
[[nodiscard]]
constexpr auto
path_component_end(
   u16str_view value, idx position, path_separators separators
) noexcept -> idx {
   if (position >= value.size()) {
      return value.size();
   }

   maybe<idx> const found = path_find_first_separator(
      path_slice(value, position, value.size()), separators
   );

   if (found.has_value()) {
      return position + found.value();
   }

   return value.size();
}

// Parse an `nt` root name like Rust's `std::path::Prefix`.
[[nodiscard]]
constexpr auto
path_parse_nt_root(u16str_view value) noexcept -> path_root {
   idx const size = value.size();
   auto const make_root = [&](
                             idx name_end, path_separators separators,
                             bool has_implicit_root
                          ) -> path_root {
      bool const has_directory =
         name_end < size && path_is_separator(separators, value[name_end]);
      return {
         .name_end = name_end,
         .end = has_directory ? idx(name_end + 1u) : name_end,
         .separators = separators,
         .is_absolute = has_implicit_root || (has_directory && name_end != 0u),
      };
   };

   if (
      size >= 2u && path_is_separator(path_nt_separators, value[0])
      && path_is_separator(path_nt_separators, value[1])
   ) {
      if (path_starts_with(value, 0u, uR"(\\?\)")) {
         if (path_starts_with(value, 4u, u"UNC\\")) {
            idx const server_end =
               path_component_end(value, 8u, path_nt_verbatim_separators);
            return make_root(
               path_component_end(
                  value, server_end + 1u, path_nt_verbatim_separators
               ),
               path_nt_verbatim_separators, true
            );
         }

         if (path_is_drive(value, 4u) && (size == 6u || value[6] == u'\\')) {
            return make_root(6u, path_nt_verbatim_separators, true);
         }

         return make_root(
            path_component_end(value, 4u, path_nt_verbatim_separators),
            path_nt_verbatim_separators, true
         );
      }

      if (
         size >= 4u && value[2] == u'.'
         && path_is_separator(path_nt_separators, value[3])
      ) {
         return make_root(
            path_component_end(value, 4u, path_nt_separators),
            path_nt_separators, true
         );
      }

      // A share needs both a server and a share name.
      idx const server_end = path_component_end(value, 2u, path_nt_separators);
      if (server_end != 2u && server_end < size) {
         idx const share_end =
            path_component_end(value, server_end + 1u, path_nt_separators);
         if (share_end != server_end + 1u) {
            return make_root(share_end, path_nt_separators, true);
         }
      }

      return make_root(0u, path_nt_separators, false);
   }

   if (path_is_drive(value, 0u)) {
      return make_root(2u, path_nt_separators, false);
   }

   return make_root(0u, path_nt_separators, false);
}

template <path_os os>
[[nodiscard]]
constexpr auto
path_parse_root(path_view<os> value) noexcept -> path_root {
   if constexpr (os == path_os::nt) {
      return path_parse_nt_root(value);
   } else {
      bool const has_directory = value.size() != 0u && value[0] == '/';
      return {
         .name_end = 0u,
         .end = has_directory ? 1u : 0u,
         .separators = path_slash_separators,
         .is_absolute = has_directory,
      };
   }
}

template <typename CharT>
[[nodiscard]]
constexpr auto
path_relative_start(basic_str_span<CharT const> value, path_root root) noexcept
   -> idx {
   maybe<idx> const found = path_find_first_not_separator(
      path_slice(value, root.name_end, value.size()), root.separators
   );

   if (found.has_value()) {
      return root.name_end + found.value();
   }

   return value.size();
}

template <typename CharT>
[[nodiscard]]
constexpr auto
path_parent(basic_str_span<CharT const> value, path_root root) noexcept
   -> basic_str_span<CharT const> {
   basic_str_span<CharT const> const root_path =
      path_slice(value, 0u, root.end);
   maybe<idx> const last = path_find_last_not_separator(
      path_slice(value, root.end, value.size()), root.separators
   );

   if (last.is_empty()) {
      return root_path;
   }

   idx const end = root.end + last.value() + 1u;
   maybe<idx> const separator = path_find_last_separator(
      path_slice(value, root.end, end), root.separators
   );

   if (separator.is_empty()) {
      return root_path;
   }

   maybe<idx> const parent_end = path_find_last_not_separator(
      path_slice(value, root.end, root.end + separator.value()), root.separators
   );

   if (parent_end.is_empty()) {
      return root_path;
   }

   return path_slice(value, 0u, root.end + parent_end.value() + 1u);
}

template <typename CharT>
[[nodiscard]]
constexpr auto
path_filename(basic_str_span<CharT const> value, path_root root) noexcept
   -> basic_str_span<CharT const> {
   basic_str_span<CharT const> const relative =
      path_slice(value, root.name_end, value.size());
   if (
      relative.size() == 0u
      || path_is_separator(root.separators, relative[idx(relative.size() - 1u)])
   ) {
      return {};
   }

   maybe<idx> const separator =
      path_find_last_separator(relative, root.separators);
   if (separator.has_value()) {
      return path_slice(relative, separator.value() + 1u, relative.size());
   }

   return relative;
}

// Whether `name` is `.` or `..`, which have no stem or extension.
template <typename CharT>
[[nodiscard]]
constexpr auto
path_is_dot_or_dot_dot(basic_str_span<CharT const> name) noexcept -> bool {
   return (name.size() == 1u || name.size() == 2u)
          && path_find_first<false>(name, '.', '.').is_empty();
}

template <path_os os>
inline constexpr path_char<os> path_preferred_separator =
   os == path_os::nt ? '\\' : '/';

// Identifies `basic_file_path` types and their `path_os`.
template <typename T>
struct path_os_trait {
   static constexpr bool is_file_path = false;
   static constexpr path_os value = path_os::portable;
};

// The `path_os` that a factory produces. That is `os` when it is given,
// otherwise the `path_os` of `Segment` or `Base`, if either is a path.
template <path_os os, typename Segment, typename Base = void>
inline constexpr path_os path_deduce_os =
   os != path_os::portable                ? os
   : path_os_trait<Segment>::is_file_path ? path_os_trait<Segment>::value
                                          : path_os_trait<Base>::value;

}  // namespace detail

template <typename Segment>
concept is_path_segment =
   requires(Segment const& segment) { detail::path_segment_view(segment); };

namespace detail {

// Strings of a character type that paths of `os` do not store.
template <typename Segment, path_os os>
concept is_foreign_encoding_segment =
   is_path_segment<Segment>
   && !is_same<
      __typeof_unqual(path_segment_view(declval<Segment const&>())),
      path_view<os>>;

// Paths of a different `path_os` that store the same character type as `os`.
template <typename Segment, path_os os>
concept is_foreign_os_path = !is_foreign_encoding_segment<Segment, os>
                             && path_os_trait<Segment>::is_file_path
                             && path_os_trait<Segment>::value != os;

// Strings and paths that a path of `os` can join.
template <typename Segment, path_os os>
concept is_path_segment_for =
   is_path_segment<Segment> && !is_foreign_encoding_segment<Segment, os>
   && !is_foreign_os_path<Segment, os>;

// View `segment` as a string of `os`'s characters.
template <path_os os, is_path_segment_for<os> Segment>
[[nodiscard]]
constexpr auto
path_segment_view_for(Segment const& segment [[clang::lifetimebound]]) noexcept
   -> path_view<os> {
   return path_segment_view(segment);
}

template <path_os os, is_foreign_encoding_segment<os> Segment>
constexpr auto
path_segment_view_for(Segment const&) -> path_view<os> = delete (
   "A `cat::path_os::nt` path only joins `char16_t` strings, and other paths "
   "only join `char` strings!"
);

template <path_os os, is_foreign_os_path<os> Segment>
constexpr auto
path_segment_view_for(Segment const&) -> path_view<os> = delete (
   "A path cannot be joined with a path of a different `cat::path_os`! Join "
   "its `.view()` instead."
);

// Joining a segment like `std::filesystem::path::operator/=` keeps the first
// `keep` characters of the left path, then appends an optional separator and
// `tail`.
template <path_os os>
struct path_join {
   idx keep;
   bool needs_separator;
   path_view<os> tail;
};

template <path_os os>
[[nodiscard]]
constexpr auto
path_plan_join(path_view<os> left, path_view<os> right) noexcept
   -> path_join<os> {
   if (right.size() == 0u) {
      return {.keep = left.size(), .needs_separator = false, .tail = {}};
   }

   path_root const left_root = path_parse_root<os>(left);
   path_root const right_root = path_parse_root<os>(right);
   path_view<os> const right_name = path_slice(right, 0u, right_root.name_end);

   if (right_root.is_absolute
       || (right_name.size() != 0u
           && right_name != path_slice(left, 0u, left_root.name_end))) {
      return {.keep = 0u, .needs_separator = false, .tail = right};
   }

   path_view<os> const tail =
      path_slice(right, right_root.name_end, right.size());
   if (right_root.end != right_root.name_end) {
      return {
         .keep = left_root.name_end, .needs_separator = false, .tail = tail
      };
   }

   return {
      .keep = left.size(),
      .needs_separator =
         path_filename(left, left_root).size() != 0u
         || (left_root.end == left_root.name_end && left_root.is_absolute),
      .tail = tail,
   };
}

// Order two filenames like `std::char_traits` does. One-byte characters are
// compared as unsigned bytes, so `find_disjoint_memory` orders them. That is
// not true of `char16_t` on a little-endian machine.
template <typename CharT>
[[nodiscard]]
constexpr auto
path_compare_name(
   basic_str_span<CharT const> left, basic_str_span<CharT const> right
) noexcept -> std::strong_ordering {
   idx const size = min(left.size(), right.size());
   if constexpr (sizeof(CharT) == 1u) {
      if (size != 0u) {
         idx const offset =
            find_disjoint_memory(left.data(), right.data(), size);
         if (offset != size) {
            return static_cast<unsigned char>(left[offset])
                   <=> static_cast<unsigned char>(right[offset]);
         }
      }
   } else {
      for (idx i = 0u; i < size; ++i) {
         if (left[i] != right[i]) {
            return left[i] < right[i] ? std::strong_ordering::less
                                      : std::strong_ordering::greater;
         }
      }
   }

   if (left.size() == right.size()) {
      return std::strong_ordering::equal;
   }

   return left.size() < right.size() ? std::strong_ordering::less
                                     : std::strong_ordering::greater;
}

// Walks the filenames of a relative path like `std::filesystem::path`'s
// iterator. Separator runs divide filenames, and a trailing separator is
// followed by one empty filename.
template <typename CharT>
struct path_filename_cursor {
   basic_str_span<CharT const> value;
   path_separators separators;
   idx position = 0u;
   bool is_done = value.size() == 0u;

   constexpr auto
   next() noexcept -> basic_str_span<CharT const> {
      idx const start = position;
      basic_str_span<CharT const> const rest =
         path_slice(value, start, value.size());
      maybe<idx> const separator = path_find_first_separator(rest, separators);
      if (separator.is_empty()) {
         is_done = true;
         position = value.size();
         return rest;
      }

      idx const end = start + separator.value();
      maybe<idx> const following = path_find_first_not_separator(
         path_slice(value, end, value.size()), separators
      );
      position =
         following.has_value() ? idx(end + following.value()) : value.size();
      return path_slice(value, start, end);
   }
};

// Normalize the path at `p_value` in place like
// `std::filesystem::path::lexically_normal`, and return its new size, which is
// never larger. Verbatim `nt` paths are unchanged, because `.` and `..` are
// ordinary names in them.
template <path_os os>
constexpr auto
path_lexically_normalize(path_char<os>* _Nullable p_value, idx size) noexcept(
   !__has_feature(cxx_exceptions)
) -> idx {
   path_view<os> const value = {p_value, size};
   path_root const root = path_parse_root<os>(value);
   if (size == 0u || (os == path_os::nt && root.separators.second == '\\')) {
      return size;
   }

   constexpr path_char<os> separator = path_preferred_separator<os>;
   bool const has_root_directory = root.end != root.name_end;
   bool const ends_in_separator =
      size > root.end
      && path_is_separator(root.separators, value[idx(size - 1u)]);
   for (idx i = 0u; i < root.name_end; ++i) {
      if (path_is_separator(root.separators, p_value[i])) {
         p_value[i] = separator;
      }
   }

   idx end = root.name_end;
   if (has_root_directory) {
      p_value[end] = separator;
      ++end;
   }

   // Output is written behind the input that is still being read, so this
   // never overwrites an unread character. `[base, dot_dot_end)` holds only
   // `..` components, which cannot be removed.
   idx const base = end;
   idx dot_dot_end = base;
   bool ends_in_dot = false;
   auto const push = [&](path_view<os> component) {
      if (end != base) {
         p_value[end] = separator;
         ++end;
      }

      for (path_char<os> const character : component) {
         p_value[end] = character;
         ++end;
      }
   };

   path_filename_cursor<path_char<os>> cursor = {
      .value = path_slice(value, path_relative_start(value, root), size),
      .separators = root.separators,
   };
   while (!cursor.is_done) {
      path_view<os> const component = cursor.next();
      // Skip the empty filename after a trailing separator.
      if (component.size() == 0u) {
         continue;
      }

      ends_in_dot = path_is_dot_or_dot_dot(component);
      if (!ends_in_dot) {
         push(component);
      } else if (component.size() == 2u) {
         if (end != dot_dot_end) {
            maybe<idx> const previous = path_find_last_separator(
               path_slice(value, dot_dot_end, end), root.separators
            );
            end = previous.has_value() ? idx(dot_dot_end + previous.value())
                                       : dot_dot_end;
         } else if (!has_root_directory) {
            push(component);
            dot_dot_end = end;
         }
      }
   }

   // A trailing `..` loses its separator. Any other last filename keeps one if
   // it was followed by a separator, `.`, or a removed `..`.
   if (end != dot_dot_end && (ends_in_dot || ends_in_separator)) {
      p_value[end] = separator;
      ++end;
   }

   if (end == 0u) {
      p_value[0] = '.';
      end = 1u;
   }

   return end;
}

}  // namespace detail

// The kinds of `basic_path_component`, like Rust's `std::path::Component`.
// NOLINTNEXTLINE
enum class [[clang::enum_extensibility(
   closed
)]] path_component_kind : unsigned char {
   // A root name such as `C:` or `\\server\share`, like Rust's `Prefix`.
   root_name,
   // The root directory, even when an `nt` root name implies it.
   root_directory,
   // A `.` at the start of a relative path. A `.` elsewhere is skipped,
   // except in verbatim `nt` paths, where it is an ordinary name.
   current_directory,
   // A `..`.
   parent_directory,
   // A filename.
   normal,
};

// One component of a path. `text` views its spelling in the path. It is empty
// for a root directory that an `nt` root name implies.
template <typename CharT>
struct basic_path_component {
   path_component_kind kind;
   basic_str_span<CharT const> text;

   // Directory components are equal whatever separator spells them.
   [[nodiscard]]
   constexpr auto
   operator==(basic_path_component const& other) const noexcept -> bool {
      if (kind != other.kind) {
         return false;
      }

      return (kind != path_component_kind::root_name
              && kind != path_component_kind::normal)
             || text == other.text;
   }

   // Order by kind in declaration order, then by spelling, like Rust's
   // `std::path::Component`.
   [[nodiscard]]
   constexpr auto
   operator<=>(basic_path_component const& other) const noexcept
      -> std::strong_ordering {
      if (kind != other.kind) {
         return kind < other.kind ? std::strong_ordering::less
                                  : std::strong_ordering::greater;
      }

      if (
         kind == path_component_kind::root_name
         || kind == path_component_kind::normal
      ) {
         return detail::path_compare_name(text, other.text);
      }

      return std::strong_ordering::equal;
   }
};

using path_component = basic_path_component<char>;

// Iterates a path's components like Rust's `std::path::Components`. Repeated
// separators, a trailing separator, and `.` after the start are skipped.
template <typename CharT>
class [[gsl::Pointer(CharT const)]] path_component_stepanov_iterator
    : public proxy_stepanov_iterator_interface<
         forward_iterator_tag, basic_path_component<CharT>,
         basic_path_component<CharT>> {
 public:
   using value_type = basic_path_component<CharT>;
   using reference = value_type;
   using const_reference = value_type;

   constexpr path_component_stepanov_iterator() = default;

   // Begin iterating `value`, whose root is `root`.
   constexpr path_component_stepanov_iterator(
      basic_str_span<CharT const> value [[clang::lifetimebound]],
      detail::path_root root
   ) noexcept(!__has_feature(cxx_exceptions))
       : m_value(value), m_root(root) {
      seek();
   }

   // Resume iterating `value` at the filename that starts at `position`.
   [[nodiscard]]
   static constexpr auto
   resume_at(
      basic_str_span<CharT const> value, detail::path_root root, idx position
   ) noexcept(!__has_feature(cxx_exceptions))
      -> path_component_stepanov_iterator {
      path_component_stepanov_iterator result;
      result.m_value = value;
      result.m_root = root;
      result.m_position = position;
      result.m_state = state::body;
      result.seek();
      return result;
   }

   // The end of iterating `value`.
   [[nodiscard]]
   static constexpr auto
   end_of(basic_str_span<CharT const> value, detail::path_root root) noexcept
      -> path_component_stepanov_iterator {
      path_component_stepanov_iterator result;
      result.m_value = value;
      result.m_root = root;
      result.m_position = value.size();
      result.m_state = state::done;
      return result;
   }

   [[nodiscard]]
   constexpr auto
   dereference() const noexcept -> value_type {
      return m_current;
   }

   constexpr auto
   increment() noexcept(!__has_feature(cxx_exceptions)) [[clang::lifetimebound]]
   -> path_component_stepanov_iterator& {
      seek();
      return *this;
   }

   [[nodiscard]]
   constexpr auto
   equal_to(path_component_stepanov_iterator const& other) const noexcept
      -> bool {
      return m_value.data() == other.m_value.data()
             && m_value.size() == other.m_value.size()
             && m_position == other.m_position && m_state == other.m_state;
   }

 private:
   enum class state : unsigned char {
      root_name,
      root_directory,
      body,
      done,
   };

   [[nodiscard]]
   constexpr auto
   is_verbatim() const noexcept -> bool {
      return m_root.separators.second == '\\';
   }

   // Read the component after the current one.
   constexpr void
   seek() {
      if (m_state == state::root_name) {
         m_state = state::root_directory;
         if (m_root.name_end != 0u) {
            m_current = {
               path_component_kind::root_name,
               detail::path_slice(m_value, 0u, m_root.name_end),
            };
            return;
         }
      }

      if (m_state == state::root_directory) {
         m_state = state::body;
         m_position = m_root.end;
         if (m_root.is_absolute || m_root.end != m_root.name_end) {
            m_current = {
               path_component_kind::root_directory,
               detail::path_slice(m_value, m_root.name_end, m_root.end),
            };
            return;
         }

         // Only a leading `.` of a relative path is kept.
         idx const dot = m_root.name_end;
         if (
            dot < m_value.size() && m_value[dot] == '.'
            && (dot + 1u == m_value.size() || detail::path_is_separator(m_root.separators, m_value[dot + 1u]))
         ) {
            m_position = dot + 1u;
            m_current = {
               path_component_kind::current_directory,
               detail::path_slice(m_value, dot, m_position),
            };
            return;
         }
      }

      while (m_state == state::body) {
         basic_str_span<CharT const> const rest =
            detail::path_slice(m_value, m_position, m_value.size());
         maybe<idx> const start =
            detail::path_find_first_not_separator(rest, m_root.separators);
         if (start.is_empty()) {
            m_state = state::done;
            m_position = m_value.size();
            m_current = {};
            return;
         }

         idx const first = m_position + start.value();
         maybe<idx> const end = detail::path_find_first_separator(
            detail::path_slice(m_value, first, m_value.size()),
            m_root.separators
         );
         m_position =
            end.has_value() ? idx(first + end.value()) : m_value.size();
         basic_str_span<CharT const> const text =
            detail::path_slice(m_value, first, m_position);

         if (!detail::path_is_dot_or_dot_dot(text)) {
            m_current = {path_component_kind::normal, text};
            return;
         }

         if (text.size() == 2u) {
            m_current = {path_component_kind::parent_directory, text};
            return;
         }

         if (is_verbatim()) {
            m_current = {path_component_kind::current_directory, text};
            return;
         }
      }
   }

   basic_str_span<CharT const> m_value;
   detail::path_root m_root = {
      .name_end = 0u,
      .end = 0u,
      .separators = detail::path_slash_separators,
      .is_absolute = false,
   };
   idx m_position;
   state m_state = state::root_name;
   value_type m_current = {};
};

template <typename CharT>
class path_component_iteration_context {
 public:
   using element_type = basic_path_component<CharT>;

   constexpr path_component_iteration_context(
      path_component_stepanov_iterator<CharT> current [[clang::lifetimebound]],
      path_component_stepanov_iterator<CharT> end [[clang::lifetimebound]]
   ) noexcept
       : m_current(current), m_end(end) {
   }

   path_component_iteration_context(path_component_iteration_context const&) =
      delete;
   path_component_iteration_context(path_component_iteration_context&&) =
      delete;
   auto
   operator=(path_component_iteration_context const&) noexcept
      -> path_component_iteration_context& = delete;
   auto
   operator=(path_component_iteration_context&&) noexcept
      -> path_component_iteration_context& = delete;

   template <is_predicate<element_type> LoopBody>
   constexpr auto
   run_while(LoopBody&& loop_body) noexcept(!__has_feature(cxx_exceptions))
      -> iteration_result {
      while (m_current != m_end) {
         if (!loop_body(*m_current)) {
            return iteration_result::incomplete;
         }

         ++m_current;
      }

      return iteration_result::complete;
   }

 private:
   path_component_stepanov_iterator<CharT> m_current;
   path_component_stepanov_iterator<CharT> m_end;
};

// The components of a path, like Rust's `std::path::Components`.
template <typename CharT>
class basic_path_components
    : public iterable_interface<basic_path_components<CharT>> {
 public:
   using value_type = basic_path_component<CharT>;
   using iterator = path_component_stepanov_iterator<CharT>;
   using const_iterator = iterator;

   constexpr basic_path_components() = default;

   constexpr basic_path_components(
      basic_str_span<CharT const> value [[clang::lifetimebound]],
      detail::path_root root
   ) noexcept
       : m_value(value), m_root(root) {
   }

   [[nodiscard]]
   constexpr auto
   begin() const noexcept -> iterator {
      return {m_value, m_root};
   }

   [[nodiscard]]
   constexpr auto
   end() const noexcept -> iterator {
      return iterator::end_of(m_value, m_root);
   }

   [[nodiscard]]
   constexpr auto
   cbegin() const noexcept -> const_iterator {
      return begin();
   }

   [[nodiscard]]
   constexpr auto
   cend() const noexcept -> const_iterator {
      return end();
   }

   [[nodiscard]]
   constexpr auto
   iterate() const noexcept -> path_component_iteration_context<CharT> {
      return {begin(), end()};
   }

 private:
   basic_str_span<CharT const> m_value;
   detail::path_root m_root = {
      .name_end = 0u,
      .end = 0u,
      .separators = detail::path_slash_separators,
      .is_absolute = false,
   };
};

using path_components = basic_path_components<char>;

namespace detail {

// Order two paths by their components like Rust's `std::path::Path`, so
// redundant separators, a trailing separator, and `.` after the start do not
// matter.
template <path_os os>
[[nodiscard]]
constexpr auto
path_compare(path_view<os> left, path_view<os> right) noexcept
   -> std::strong_ordering {
   using iterator = path_component_stepanov_iterator<path_char<os>>;
   path_root const left_root = path_parse_root<os>(left);
   path_root const right_root = path_parse_root<os>(right);
   basic_path_components<path_char<os>> const left_components(left, left_root);
   basic_path_components<path_char<os>> const right_components(
      right, right_root
   );
   iterator left_it = left_components.begin();
   iterator right_it = right_components.begin();
   iterator const left_end = left_components.end();
   iterator const right_end = right_components.end();

   // Like Rust, skip a shared spelling when neither path has a root name. Its
   // components up to the last separator before the first difference are
   // equal, so comparing resumes at the filename after that separator.
   idx const shared = min(left.size(), right.size());
   if (left_root.name_end == 0u && right_root.name_end == 0u && shared != 0u) {
      idx const first_difference =
         find_disjoint_memory(
            left.data(), right.data(), shared * sizeof(path_char<os>)
         )
         / sizeof(path_char<os>);
      if (first_difference == shared && left.size() == right.size()) {
         return std::strong_ordering::equal;
      }

      maybe<idx> const separator = path_find_last_separator(
         path_slice(left, 0u, first_difference), left_root.separators
      );
      if (separator.has_value()) {
         idx const resume = separator.value() + 1u;
         left_it = iterator::resume_at(left, left_root, resume);
         right_it = iterator::resume_at(right, right_root, resume);
      }
   } else if (
      left.size() == right.size() && shared != 0u
      && is_memory_equal(
         left.data(), right.data(), shared * sizeof(path_char<os>)
      )
   ) {
      return std::strong_ordering::equal;
   }

   while (left_it != left_end && right_it != right_end) {
      std::strong_ordering const order = *left_it <=> *right_it;
      if (order != 0) {
         return order;
      }

      ++left_it;
      ++right_it;
   }

   bool const is_left_done = left_it == left_end;
   bool const is_right_done = right_it == right_end;
   if (is_left_done == is_right_done) {
      return std::strong_ordering::equal;
   }

   return is_left_done ? std::strong_ordering::less
                       : std::strong_ordering::greater;
}

}  // namespace detail

// Lexical path queries shared by every file path type. They only read
// `.view()` of the derived path.
template <path_os os>
class file_path_interface {
 public:
   // Order paths by their components, like Rust's `std::path::Path`.
   template <detail::is_path_segment_for<os> Other>
   [[nodiscard]]
   constexpr auto
   compare(this auto const& self, Other const& other) noexcept
      -> std::strong_ordering {
      return detail::path_compare<os>(
         self.view(), detail::path_segment_view_for<os>(other)
      );
   }

   template <detail::is_path_segment_for<os> Other>
   [[nodiscard]]
   constexpr auto
   operator==(this auto const& self, Other const& other) noexcept -> bool {
      return self.compare(other) == 0;
   }

   template <detail::is_path_segment_for<os> Other>
   [[nodiscard]]
   constexpr auto
   operator<=>(this auto const& self, Other const& other) noexcept
      -> std::strong_ordering {
      return self.compare(other);
   }

   [[nodiscard]]
   constexpr auto
   is_absolute(this auto const& self) noexcept -> bool {
      return detail::path_parse_root<os>(self.view()).is_absolute;
   }

   [[nodiscard]]
   constexpr auto
   is_relative(this auto const& self) noexcept -> bool {
      return !self.is_absolute();
   }

   [[nodiscard]]
   constexpr auto
   root_name(this auto const& self [[clang::lifetimebound]]) noexcept
      -> detail::path_view<os> {
      detail::path_view<os> const value = self.view();
      return detail::path_slice(
         value, 0u, detail::path_parse_root<os>(value).name_end
      );
   }

   [[nodiscard]]
   constexpr auto
   root_directory(this auto const& self [[clang::lifetimebound]]) noexcept
      -> detail::path_view<os> {
      detail::path_view<os> const value = self.view();
      detail::path_root const root = detail::path_parse_root<os>(value);
      return detail::path_slice(value, root.name_end, root.end);
   }

   [[nodiscard]]
   constexpr auto
   root_path(this auto const& self [[clang::lifetimebound]]) noexcept
      -> detail::path_view<os> {
      detail::path_view<os> const value = self.view();
      return detail::path_slice(
         value, 0u, detail::path_parse_root<os>(value).end
      );
   }

   [[nodiscard]]
   constexpr auto
   relative_path(this auto const& self [[clang::lifetimebound]]) noexcept(
      !__has_feature(cxx_exceptions)
   ) -> detail::path_view<os> {
      detail::path_view<os> const value = self.view();
      idx const first =
         detail::path_relative_start(value, detail::path_parse_root<os>(value));
      return detail::path_slice(value, first, value.size());
   }

   [[nodiscard]]
   constexpr auto
   parent_path(this auto const& self [[clang::lifetimebound]])
      -> detail::path_view<os> {
      detail::path_view<os> const value = self.view();
      return detail::path_parent(value, detail::path_parse_root<os>(value));
   }

   [[nodiscard]]
   constexpr auto
   filename(this auto const& self [[clang::lifetimebound]])
      -> detail::path_view<os> {
      detail::path_view<os> const value = self.view();
      return detail::path_filename(value, detail::path_parse_root<os>(value));
   }

   [[nodiscard]]
   constexpr auto
   stem(this auto const& self [[clang::lifetimebound]])
      -> detail::path_view<os> {
      detail::path_view<os> const name = self.filename();
      if (detail::path_is_dot_or_dot_dot(name)) {
         return name;
      }

      maybe<idx> const dot = detail::path_find_last_equal(name, '.');
      if (dot.is_empty() || dot.value() == 0u) {
         return name;
      }

      return detail::path_slice(name, 0u, dot.value());
   }

   [[nodiscard]]
   constexpr auto
   extension(this auto const& self [[clang::lifetimebound]])
      -> detail::path_view<os> {
      detail::path_view<os> const name = self.filename();
      if (detail::path_is_dot_or_dot_dot(name)) {
         return {};
      }

      maybe<idx> const dot = detail::path_find_last_equal(name, '.');
      if (dot.is_empty() || dot.value() == 0u) {
         return {};
      }

      return detail::path_slice(name, dot.value(), name.size());
   }

   [[nodiscard]]
   constexpr auto
   has_root_name(this auto const& self) noexcept -> bool {
      return detail::path_parse_root<os>(self.view()).name_end != 0u;
   }

   [[nodiscard]]
   constexpr auto
   has_root_directory(this auto const& self) noexcept -> bool {
      detail::path_root const root = detail::path_parse_root<os>(self.view());
      return root.end != root.name_end;
   }

   [[nodiscard]]
   constexpr auto
   has_root_path(this auto const& self) noexcept -> bool {
      return detail::path_parse_root<os>(self.view()).end != 0u;
   }

   [[nodiscard]]
   constexpr auto
   has_relative_path(this auto const& self) noexcept -> bool {
      return self.relative_path().size() != 0u;
   }

   [[nodiscard]]
   constexpr auto
   has_parent_path(this auto const& self) noexcept(
      !__has_feature(cxx_exceptions)
   ) -> bool {
      return self.parent_path().size() != 0u;
   }

   [[nodiscard]]
   constexpr auto
   has_filename(this auto const& self) noexcept(!__has_feature(cxx_exceptions))
      -> bool {
      return self.filename().size() != 0u;
   }

   [[nodiscard]]
   constexpr auto
   has_stem(this auto const& self) noexcept(!__has_feature(cxx_exceptions))
      -> bool {
      return self.stem().size() != 0u;
   }

   [[nodiscard]]
   constexpr auto
   has_extension(this auto const& self) noexcept(!__has_feature(cxx_exceptions))
      -> bool {
      return self.extension().size() != 0u;
   }

   [[nodiscard]]
   constexpr auto
   components(this auto const& self [[clang::lifetimebound]]) noexcept
      -> basic_path_components<detail::path_char<os>> {
      detail::path_view<os> const value = self.view();
      detail::path_root const root = detail::path_parse_root<os>(value);
      return {value, root};
   }
};

