   template <is_allocator Allocator, detail::is_path_segment_for<os> Segment>
   [[nodiscard]]
   constexpr auto
   append(allocator_ref<Allocator> allocator, Segment const& segment)
      -> maybe<void> {
      detail::path_join const join =
         detail::path_plan_join<os>(view(), detail::path_segment_view(segment));

      if (join.keep != size()) {
         $prop(m_storage.resize(allocator, join.keep));
      }

      if (join.needs_separator) {
         $prop(
            m_storage.push_back(allocator, detail::path_preferred_separator<os>)
         );
      }

      return m_storage.append(allocator, join.tail);
   }

