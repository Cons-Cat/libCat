template <path_os os>
class basic_file_path_view;

namespace detail {

template <path_os os, typename CharT>
struct path_formatter : formatter_base<CharT> {
   bool debug = false;

   constexpr void
   set_debug_format(bool set = true) noexcept {
      debug = set;
   }

   constexpr auto
   parse(format_parse_context& context) noexcept
      -> scaredy_format<format_parse_context::const_iterator> {
      format_parse_context::const_iterator p_it = context.begin();
      if (p_it == context.end()) {
         return format_errors::unmatched_open_brace;
      }

      if (*p_it == '?') {
         set_debug_format();
         ++p_it;
      }

      if (p_it != context.end() && *p_it == 'g') {
         ++p_it;
      }

      if (p_it == context.end() || *p_it != '}') {
         return format_errors::unknown_format_specifier;
      }

      return p_it;
   }

   template <is_allocator Allocator>
   auto
   format(
      allocator_ref<Allocator> /*unused*/, basic_file_path_view<os> value,
      format_context context
   ) const noexcept(!__has_feature(cxx_exceptions)) -> scaredy_format<void> {
      if (debug) {
         return append_escaped(context, value.view(), '"');
      }

      return context.append(value.view());
   }

   auto
   format(
      allocator_dyn allocator, basic_file_path_view<os> value,
      format_context context
   ) const noexcept(!__has_feature(cxx_exceptions)) -> scaredy_format<void> {
      return format<allocator_dyn>(allocator, value, context);
   }
};

