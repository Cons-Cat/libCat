template <path_os os, str_vec_flags flags>
[[nodiscard]]
auto
path_scaredy_value(manual::basic_file_path<os, flags>&& value)
   -> scaredy<manual::basic_file_path<os, flags>, nix::linux_error> {
   scaredy<manual::basic_file_path<os, flags>, nix::linux_error> result =
      nix::linux_error::nomem;
