template <str_vec_flags flags>
constexpr auto
maybe_path_has_value(basic_path<flags> const& value) -> bool {
   return maybe_str_vec_has_value(value.m_storage);
}

template <str_vec_flags flags>
constexpr auto
maybe_path_nullopt() -> basic_path<flags> {
   basic_path<flags> value;
   value.m_storage = maybe_str_vec_nullopt<char, basic_path<flags>::flags>();
   return value;
}
