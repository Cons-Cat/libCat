namespace cat {
namespace detail {

template <typename CharT>
struct path_formatter : formatter_base<CharT> {
   bool debug = false;

   constexpr void
   set_debug_format(bool set = true) {
      debug = set;
   }

   constexpr auto
   parse(format_parse_context& context)
      -> scaredy_format<format_parse_context::const_iterator> {
      format_parse_context::const_iterator p_it = context.begin();
      if (p_it == context.end()) {
         return format_errors::unmatched_open_brace;
      }
      if (*p_it == '?') {
         set_debug_format();
         ++p_it;
      }
      if (p_it != context.end() && *p_it == 'g') {
         ++p_it;
      }
      if (p_it == context.end() || *p_it != '}') {
         return format_errors::unknown_format_specifier;
      }
      return p_it;
   }

   template <typename Path>
   auto
   format(Path const& value, format_context& context) const
      -> scaredy_format<void> {
      if (debug) {
         return append_escaped(context, value.view(), '"');
      }
      return context.append(value.view());
   }
};

}  // namespace detail

template <str_vec_flags flags, typename CharT>
   requires(is_same<CharT, char>)
struct formatter<manual::basic_path<flags>, CharT>
    : detail::path_formatter<CharT> {};

