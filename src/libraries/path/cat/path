inline namespace manual {

template <str_vec_flags configuration>
class [[clang::preferred_name(path), gsl::Owner]]
basic_path : public container_interface<basic_path<configuration>, char>,
             public random_access_stepanov_iterable_interface<char> {
 public:
   static constexpr str_vec_flags flags = str_flags::null_terminated
                                          | vec_flags::pointer_size_layout
                                          | vec_flags::initial_growth(48u)
                                          | configuration;

 private:
   static_assert(flags.str.is_null_terminated);
   static_assert(flags.vec.uses_pointer_size_layout);

   template <is_allocator Allocator, str_vec_flags other_flags>
   friend class raii::basic_path;

 public:
   constexpr basic_path() = default;
   constexpr basic_path(basic_path&&) = default;
   constexpr basic_path(basic_path const&) =
      delete ("Implicit copying of `cat::basic_path` is forbidden. Call "
              "`.clone()` or move instead.");
   constexpr auto
   operator=(basic_path&&) -> basic_path& = default;
   auto
   operator=(basic_path const&) -> basic_path& =
      delete ("Implicit copying of `cat::basic_path` is forbidden. Call "
              "`.clone()` or move instead.");

   [[nodiscard]]
   constexpr auto
   operator==(basic_path const& other) const -> bool {
      return view() == other.view();
   }

   [[nodiscard]]
   constexpr auto
   data() [[clang::lifetimebound]] -> char* _Nullable {
      return m_storage.data();
   }

   [[nodiscard]]
   constexpr auto
   data() const [[clang::lifetimebound]] -> char const* _Nullable {
      return m_storage.data();
   }

   [[nodiscard]]
   constexpr auto
   size() const -> idx {
      return m_storage.size();
   }

   [[nodiscard]]
   constexpr auto
   capacity() const -> idx {
      return m_storage.capacity();
   }

   [[nodiscard]]
   constexpr auto
   empty() const -> bool {
      return size() == 0u;
   }

   [[nodiscard]]
   constexpr auto
   is_null_terminated() const -> bool {
      return true;
   }

   [[nodiscard]]
   constexpr auto
   view() const [[clang::lifetimebound]] -> str_view {
      return m_storage.view();
   }

   [[nodiscard]]
   constexpr auto
   native() [[clang::lifetimebound]] -> zstr_span {
      return m_storage.span();
   }

   [[nodiscard]]
   constexpr auto
   native() const [[clang::lifetimebound]] -> zstr_view {
      return m_storage.span();
   }

   [[nodiscard]]
   constexpr
   operator zstr_span() [[clang::lifetimebound]] {
      return native();
   }

   [[nodiscard]]
   constexpr
   operator zstr_view() const [[clang::lifetimebound]] {
      return native();
   }

   template <is_allocator Allocator>
   [[nodiscard]]
   constexpr auto
   reserve(allocator_ref<Allocator> allocator, idx minimum_capacity)
      -> maybe<void>
      requires(!flags.vec.is_fixed_size)
   {
      return m_storage.reserve(allocator, minimum_capacity);
   }

   [[nodiscard]]
   constexpr auto
   reserve(dyn_allocator allocator, idx minimum_capacity) -> maybe<void>
      requires(!flags.vec.is_fixed_size)
   {
      return m_storage.reserve(allocator, minimum_capacity);
   }

   template <is_allocator Allocator>
   [[nodiscard]]
   constexpr auto
   resize(allocator_ref<Allocator> allocator, idx new_size) -> maybe<void> {
      return m_storage.resize(allocator, new_size);
   }

   [[nodiscard]]
   constexpr auto
   resize(dyn_allocator allocator, idx new_size) -> maybe<void> {
      return m_storage.resize(allocator, new_size);
   }

   constexpr void
   clear() {
      m_storage.clear();
   }

   constexpr void
   reset() {
      m_storage.reset();
   }

   template <is_allocator Allocator>
   constexpr void
   free(allocator_ref<Allocator> allocator) {
      m_storage.free(allocator);
   }

   constexpr void
   free(dyn_allocator allocator) {
      m_storage.free(allocator);
   }

   template <is_allocator Allocator>
   constexpr void
   cfree(allocator_ref<Allocator> allocator) {
      m_storage.cfree(allocator);
   }

   constexpr void
   cfree(dyn_allocator allocator) {
      m_storage.cfree(allocator);
   }

   template <is_allocator Allocator>
   [[nodiscard]]
   constexpr auto
   clone(allocator_ref<Allocator> allocator) const& -> maybe<basic_path> {
      auto storage = m_storage.clone(allocator);
      if (storage.is_empty()) {
         return nullopt;
      }
      basic_path result;
      result.m_storage = move(storage).value();
      return result;
   }

   [[nodiscard]]
   constexpr auto
   clone(dyn_allocator allocator) const& -> maybe<basic_path> {
      return clone<dyn_allocator>(allocator);
   }

   [[nodiscard]]
   constexpr auto
   is_absolute() const -> bool {
      return !empty() && data()[0] == '/';
   }

   [[nodiscard]]
   constexpr auto
   is_relative() const -> bool {
      return !is_absolute();
   }

   [[nodiscard]]
   constexpr auto
   root_name() const -> str_view {
      return {};
   }

   [[nodiscard]]
   constexpr auto
   root_directory() const -> str_view {
      if (!is_absolute()) {
         return {};
      }
      return {data(), 1u};
   }

   [[nodiscard]]
   constexpr auto
   root_path() const -> str_view {
      return root_directory();
   }

   [[nodiscard]]
   constexpr auto
   relative_path() const -> str_view {
      idx const first = detail::path_root_end(view());
      return detail::path_slice(view(), first, size());
   }

   [[nodiscard]]
   constexpr auto
   parent_path() const -> str_view {
      str_view const value = view();
      idx const end = detail::path_trimmed_end(value);
      if (end == 0u) {
         return {};
      }
      if (end == 1u && value[0] == '/') {
         return detail::path_slice(value, 0u, 1u);
      }

      maybe<idx> const found =
         detail::path_find_last_equal(detail::path_slice(value, 0u, end), '/');
      if (found.is_empty()) {
         return {};
      }
      idx const slash = found.value() + 1u;
      if (slash == 1u) {
         return detail::path_slice(value, 0u, slash);
      }
      maybe<idx> const parent_end = detail::path_find_last_not_equal(
         detail::path_slice(value, 1u, slash), '/'
      );
      if (parent_end.has_value()) {
         return detail::path_slice(value, 0u, parent_end.value() + 2u);
      }
      return detail::path_slice(value, 0u, 1u);
   }

   [[nodiscard]]
   constexpr auto
   filename() const -> str_view {
      str_view const value = view();
      if (value.size() == 0u || value[idx(value.size() - 1u)] == '/') {
         return {};
      }
      maybe<idx> const slash = detail::path_find_last_equal(value, '/');
      if (slash.has_value()) {
         return detail::path_slice(value, slash.value() + 1u, value.size());
      }
      return value;
   }

   [[nodiscard]]
   constexpr auto
   stem() const -> str_view {
      str_view const name = filename();
      if (name == "." || name == "..") {
         return name;
      }
      maybe<idx> const dot = detail::path_find_last_equal(name, '.');
      if (dot.is_empty() || dot.value() == 0u) {
         return name;
      }
      return detail::path_slice(name, 0u, dot.value());
   }

   [[nodiscard]]
   constexpr auto
   extension() const -> str_view {
      str_view const name = filename();
      if (name == "." || name == "..") {
         return {};
      }
      maybe<idx> const dot = detail::path_find_last_equal(name, '.');
      if (dot.is_empty() || dot.value() == 0u) {
         return {};
      }
      return detail::path_slice(name, dot.value(), name.size());
   }

   [[nodiscard]]
   constexpr auto
   has_root_name() const -> bool {
      return false;
   }

   [[nodiscard]]
   constexpr auto
   has_root_directory() const -> bool {
      return is_absolute();
   }

   [[nodiscard]]
   constexpr auto
   has_root_path() const -> bool {
      return is_absolute();
   }

   [[nodiscard]]
   constexpr auto
   has_relative_path() const -> bool {
      return relative_path().size() != 0u;
   }

   [[nodiscard]]
   constexpr auto
   has_parent_path() const -> bool {
      return parent_path().size() != 0u;
   }

   [[nodiscard]]
   constexpr auto
   has_filename() const -> bool {
      return filename().size() != 0u;
   }

   [[nodiscard]]
   constexpr auto
   has_stem() const -> bool {
      return stem().size() != 0u;
   }

   [[nodiscard]]
   constexpr auto
   has_extension() const -> bool {
      return extension().size() != 0u;
   }

   [[nodiscard]]
   constexpr auto
   components() const -> path_components {
      return view();
   }

   template <is_allocator Allocator, is_path_segment Segment>
   [[nodiscard]]
   constexpr auto
   append(allocator_ref<Allocator> allocator, Segment const& segment)
      -> maybe<void> {
      str_view const right = detail::path_segment_view(segment);
      if (right.size() == 0u) {
         return monostate;
      }
      if (right[0] == '/') {
         clear();
         return m_storage.append(allocator, right);
      }
      if (!empty() && data()[idx(size() - 1u).raw] != '/') {
         $prop(m_storage.push_back(allocator, '/'));
      }
      return m_storage.append(allocator, right);
   }

   template <is_path_segment Segment>
   [[nodiscard]]
   constexpr auto
   append(dyn_allocator allocator, Segment const& segment) -> maybe<void> {
      return append<dyn_allocator>(allocator, segment);
   }

 private:
   template <str_vec_flags other_flags>
   friend constexpr auto
   detail::maybe_path_has_value(basic_path<other_flags> const&) -> bool;

   template <str_vec_flags other_flags>
   friend constexpr auto
   detail::maybe_path_nullopt() -> basic_path<other_flags>;

   basic_str_vec<char, flags> m_storage;
};

