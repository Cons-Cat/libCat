template <str_vec_flags flags>
[[nodiscard]]
auto
path_scaredy_value(manual::basic_path<flags>&& value)
   -> scaredy<manual::basic_path<flags>, nix::linux_error> {
   scaredy<manual::basic_path<flags>, nix::linux_error> result =
      nix::linux_error::nomem;
   result = move(value);
   return result;
}

}  // namespace detail

template <
   str_vec_flags flags = detail::path_default_flags, is_allocator Allocator>
[[nodiscard]]
auto
make_path_current(allocator_ref<Allocator> allocator)
   -> scaredy<manual::basic_path<flags>, nix::linux_error> {
   auto made = manual::make_path<Allocator, flags>(allocator);
   if (made.is_empty()) {
      return nix::linux_error::nomem;
   }
   manual::basic_path<flags> result = move(made).value();
   $defer {
      result.free(allocator);
   };

   while (true) {
      idx capacity = result.capacity();
      if (capacity == 0u) {
         capacity = result.flags.vec.initial_growth_count;
      }
      if (result.resize(allocator, capacity).is_empty()) {
         return nix::linux_error::nomem;
      }

      auto cwd =
         nix::sys_getcwd(span<char>(result.data(), idx(result.size() + 1u)));
      if (cwd.has_value()) {
         result.resize(allocator, idx(cwd.value() - 1u)).verify();
         return detail::path_scaredy_value(move(result));
      }
      if (cwd.error() != nix::linux_error::range) {
         return cwd.error();
      }
      if (result.reserve(allocator, capacity * 2u).is_empty()) {
         return nix::linux_error::nomem;
      }
   }
}

template <str_vec_flags flags = detail::path_default_flags>
[[nodiscard]]
auto
make_path_current(dyn_allocator allocator)
   -> scaredy<manual::basic_path<flags>, nix::linux_error> {
   return make_path_current<flags, dyn_allocator>(allocator);
}

template <
   str_vec_flags flags = detail::path_default_flags, is_path_segment Segment,
   is_path_segment Base, is_allocator Allocator>
[[nodiscard]]
auto
make_path_absolute(
   Segment const& segment, Base const& base, allocator_ref<Allocator> allocator
) -> scaredy<manual::basic_path<flags>, nix::linux_error> {
   str_view const value = detail::path_segment_view(segment);
   if (value.size() != 0u && value[0] == '/') {
      auto result = make_path<Allocator, flags>(allocator, value);
      if (result.is_empty()) {
         return nix::linux_error::nomem;
      }
      return detail::path_scaredy_value(move(result).value());
   }

   str_view const base_view = detail::path_segment_view(base);
   auto prefix = [&]() -> scaredy<manual::basic_path<flags>, nix::linux_error> {
      if (base_view.size() != 0u && base_view[0] == '/') {
         auto result = make_path<Allocator, flags>(allocator, base_view);
         if (result.is_empty()) {
            return nix::linux_error::nomem;
         }
         return detail::path_scaredy_value(move(result).value());
      }

      auto cwd = make_path_current<flags, Allocator>(allocator);
      if (cwd.is_empty()) {
         return cwd.error();
      }
      manual::basic_path<flags> result = move(cwd).value();
      $defer {
         result.free(allocator);
      };
      if (result.append(allocator, base_view).is_empty()) {
         return nix::linux_error::nomem;
      }
      return detail::path_scaredy_value(move(result));
   }();

   if (prefix.is_empty()) {
      return prefix.error();
   }
   manual::basic_path<flags> result = move(prefix).value();
   $defer {
      result.free(allocator);
   };
   if (result.append(allocator, value).is_empty()) {
      return nix::linux_error::nomem;
   }
   return detail::path_scaredy_value(move(result));
}

template <
   str_vec_flags flags = detail::path_default_flags, is_path_segment Segment,
   is_path_segment Base>
[[nodiscard]]
auto
make_path_absolute(
   Segment const& segment, Base const& base, dyn_allocator allocator
) -> scaredy<manual::basic_path<flags>, nix::linux_error> {
   return make_path_absolute<flags, Segment, Base, dyn_allocator>(
      segment, base, allocator
   );
}

template <
   str_vec_flags flags = detail::path_default_flags, is_path_segment Segment,
   is_allocator Allocator>
[[nodiscard]]
auto
make_path_absolute(Segment const& segment, allocator_ref<Allocator> allocator)
   -> scaredy<manual::basic_path<flags>, nix::linux_error> {
   return make_path_absolute<flags, Segment, str_view, Allocator>(
      segment, str_view{}, allocator
   );
}

template <
   str_vec_flags flags = detail::path_default_flags, is_path_segment Segment>
[[nodiscard]]
auto
make_path_absolute(Segment const& segment, dyn_allocator allocator)
   -> scaredy<manual::basic_path<flags>, nix::linux_error> {
   return make_path_absolute<flags, Segment, dyn_allocator>(segment, allocator);
}

template <
   str_vec_flags flags = detail::path_default_flags, is_allocator Allocator,
   is_path_segment Model>
[[nodiscard]]
auto
make_path_unique(allocator_ref<Allocator> allocator, Model const& model)
   -> scaredy<manual::basic_path<flags>, nix::linux_error> {
   auto made = make_path<Allocator, flags>(allocator, model);
   if (made.is_empty()) {
      return nix::linux_error::nomem;
   }
   manual::basic_path<flags> result = move(made).value();
   $defer {
      result.free(allocator);
   };
   constexpr char hex[] = "0123456789abcdef";

   idx search_start = 0u;
   while (search_start < result.size()) {
      maybe<idx> const found = detail::path_find_first_equal(
         str_view(
            result.data() + search_start, idx(result.size() - search_start)
         ),
         '%'
      );
      if (found.is_empty()) {
         break;
      }
      idx const index = search_start + found.value();
      unsigned char random;
      while (true) {
         auto generated = nix::sys_getrandom(span(&random, 1u));
         if (generated.has_value()) {
            if (generated.value() == 0u) {
               continue;
            }
            break;
         }
         if (generated.error() != nix::linux_error::intr) {
            return generated.error();
         }
      }
      result.data()[index.raw] = hex[random & 0x0fu];
      search_start = index + 1u;
   }
   return detail::path_scaredy_value(move(result));
}

template <
   str_vec_flags flags = detail::path_default_flags, is_allocator Allocator>
[[nodiscard]]
auto
make_path_unique(allocator_ref<Allocator> allocator)
   -> scaredy<manual::basic_path<flags>, nix::linux_error> {
   return make_path_unique<flags>(allocator, "%%%%-%%%%-%%%%-%%%%");
}

template <
   str_vec_flags flags = detail::path_default_flags, is_path_segment Model>
[[nodiscard]]
auto
make_path_unique(dyn_allocator allocator, Model const& model)
   -> scaredy<manual::basic_path<flags>, nix::linux_error> {
   return make_path_unique<flags, dyn_allocator>(allocator, model);
}

template <str_vec_flags flags = detail::path_default_flags>
[[nodiscard]]
auto
make_path_unique(dyn_allocator allocator)
   -> scaredy<manual::basic_path<flags>, nix::linux_error> {
   return make_path_unique<flags, dyn_allocator>(allocator);
}

