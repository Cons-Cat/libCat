template <str_vec_flags flags>
struct default_compact_trait<basic_path<flags>>
    : identity_trait<compact<
         basic_path<flags>, detail::maybe_path_has_value<flags>,
         detail::maybe_path_nullopt<flags>>> {};

inline namespace manual {

template <
   is_allocator Allocator, str_vec_flags flags = detail::path_default_flags,
   is_path_segment Segment>
[[nodiscard]]
constexpr auto
make_path(allocator_ref<Allocator> allocator, Segment const& segment)
   -> maybe<basic_path<flags>> {
   basic_path<flags> result;
   $defer {
      result.free(allocator);
   };
   str_view const value = detail::path_segment_view(segment);
   $prop(result.reserve(
      allocator, max(value.size(), result.flags.vec.initial_growth_count)
   ));
   $prop(result.resize(allocator, 0u));
   $prop(result.append(allocator, value));
   return move(result);
}

template <
   str_vec_flags flags = detail::path_default_flags, is_path_segment Segment>
[[nodiscard]]
constexpr auto
make_path(dyn_allocator allocator, Segment const& segment)
   -> maybe<basic_path<flags>> {
   return manual::make_path<dyn_allocator, flags>(allocator, segment);
}

template <
   is_allocator Allocator, str_vec_flags flags = detail::path_default_flags>
[[nodiscard]]
constexpr auto
make_path(allocator_ref<Allocator> allocator) -> maybe<basic_path<flags>> {
   return make_path<Allocator, flags>(allocator, str_view{});
}

template <str_vec_flags flags = detail::path_default_flags>
[[nodiscard]]
constexpr auto
make_path(dyn_allocator allocator) -> maybe<basic_path<flags>> {
   return make_path<dyn_allocator, flags>(allocator);
}

template <is_allocator Allocator, str_vec_flags flags, is_path_segment Segment>
[[nodiscard]]
constexpr auto
make_path_joined(
   allocator_ref<Allocator> allocator, basic_path<flags> const& left,
   Segment const& right
) -> maybe<basic_path<flags>> {
   basic_path<flags> result = $prop(left.clone(allocator));
   $defer {
      result.free(allocator);
   };
   $prop(result.append(allocator, right));
   return move(result);
}

template <str_vec_flags flags, is_path_segment Segment>
[[nodiscard]]
constexpr auto
make_path_joined(
   dyn_allocator allocator, basic_path<flags> const& left, Segment const& right
) -> maybe<basic_path<flags>> {
   return make_path_joined<dyn_allocator>(allocator, left, right);
}

