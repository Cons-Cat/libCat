// -*- mode: c++ -*-
// vim: set ft=cpp:
#pragma once

// `cat::basic_path` is a dynamically-sized owning file path container. It is
// inspired by `std::filesystem::path`, but a major distinction is that its only
// encoding is 1-byte characters across all platforms. Upon construction, the
// path is empty. Its first allocation grows to a capacity of 48 characters by
// default.
//
// As this is a `manual` namespace container, its destructor does not deallocate
// storage. To deallocate storage, call `.free(allocator)` or
// `.cfree(allocator)`.
//
// The `cat::raii::basic_path` deallocates its own memory automatically.
//
// Path joining and decomposition are lexical. They do not access the
// filesystem, resolve symbolic links, or normalize `.` and `..` components.
// `make_path_absolute` accesses the current working directory only when its
// base path is relative. `make_path_unique` replaces percent signs with random
// hexadecimal digits without creating a filesystem entry.
//
// It is parameterized by `cat::str_vec_flags`. Path storage is always
// null-terminated and uses the pointer-size vector layout.
//
// Convenience type aliases are provided:
//
//  `cat::path`, a default `basic_path`.
//  `cat::path_fixed`, a fixed-size `basic_path`.

#include <cat/format>
#include <cat/linux>
#include <cat/simd>
#include <cat/simd_switch>
#include <cat/string>

namespace cat {

namespace detail {

inline constexpr str_vec_flags path_default_flags =
   str_flags::null_terminated
   | vec_flags::pointer_size_layout
   | vec_flags::initial_growth(48u);

template <typename Segment>
concept is_char_basic_string =
   is_basic_string<Segment>
   && is_same<remove_const<typename remove_cvref<Segment>::value_type>, char>;

template <typename Segment>
   requires(is_char_basic_string<Segment>)
[[nodiscard]]
constexpr auto
path_segment_view(Segment const& segment) -> str_view {
   return str_view(segment);
}

template <idx extent>
[[nodiscard]]
constexpr auto
path_segment_view(char const (&segment)[extent]) -> str_view {
   return {segment, idx(extent - 1u)};
}

template <idx extent>
[[nodiscard]]
constexpr auto
path_segment_view(char (&segment)[extent]) -> str_view {
   return {segment, idx(extent - 1u)};
}

template <typename Segment>
   requires(
      !is_char_basic_string<Segment> && !is_array<Segment>
      && requires(Segment const& segment) { str_view(segment); }
   )
[[nodiscard]]
constexpr auto
path_segment_view(Segment const& segment) -> str_view {
   return str_view(segment);
}

[[nodiscard]]
constexpr auto
path_slice(str_view value, idx first, idx last) -> str_view {
   if (first == last) {
      return {};
   }
   return {value.data() + first, idx(last - first)};
}

template <bool equal>
[[nodiscard]]
constexpr auto
path_find_first(str_view value, char character) -> maybe<idx> {
   if consteval {
      for (idx position = 0u; position < value.size(); ++position) {
         if ((value[position] == character) == equal) {
            return position;
         }
      }
      return nullopt;
   } else {
      return $simd_switch($abi((avx2, sse2), {
         constexpr idx lanes = char1x_::size();
         idx position = 0u;
         char1x_ characters;
         characters.fill(character);
         while (value.size() - position >= lanes) {
            char1x_ chunk;
            chunk.load_unaligned(value.data() + position);
            auto const mask = [&] {
               if constexpr (equal) {
                  return chunk.equal_lanes(characters);
               } else {
                  return !chunk.equal_lanes(characters);
               }
            }();
            if (mask.any_of()) {
               return maybe<idx>(position + mask.find_if_true());
            }
            position += lanes;
         }
         while (position < value.size()) {
            if ((value[position] == character) == equal) {
               return maybe<idx>(position);
            }
            ++position;
         }
         return maybe<idx>(nullopt);
      }));
   }
}

template <bool equal>
[[nodiscard]]
constexpr auto
path_find_last(str_view value, char character) -> maybe<idx> {
   if consteval {
      idx position = value.size();
      while (position > 0u) {
         position = idx(position - 1u);
         if ((value[position] == character) == equal) {
            return position;
         }
      }
      return nullopt;
   } else {
      return $simd_switch($abi((avx2, sse2), {
         constexpr idx lanes = char1x_::size();
         idx end = value.size();
         char1x_ characters;
         characters.fill(character);
         while (end >= lanes) {
            idx const position = idx(end - lanes);
            char1x_ chunk;
            chunk.load_unaligned(value.data() + position);
            auto const mask = [&] {
               if constexpr (equal) {
                  return chunk.equal_lanes(characters);
               } else {
                  return !chunk.equal_lanes(characters);
               }
            }();
            if (mask.any_of()) {
               return maybe<idx>(position + mask.find_last_if_true());
            }
            end = position;
         }
         while (end > 0u) {
            end = idx(end - 1u);
            if ((value[end] == character) == equal) {
               return maybe<idx>(end);
            }
         }
         return maybe<idx>(nullopt);
      }));
   }
}

[[nodiscard]]
constexpr auto
path_find_first_equal(str_view value, char character) -> maybe<idx> {
   return path_find_first<true>(value, character);
}

[[nodiscard]]
constexpr auto
path_find_first_not_equal(str_view value, char character) -> maybe<idx> {
   return path_find_first<false>(value, character);
}

[[nodiscard]]
constexpr auto
path_find_last_equal(str_view value, char character) -> maybe<idx> {
   return path_find_last<true>(value, character);
}

[[nodiscard]]
constexpr auto
path_find_last_not_equal(str_view value, char character) -> maybe<idx> {
   return path_find_last<false>(value, character);
}

[[nodiscard]]
constexpr auto
path_root_end(str_view value) -> idx {
   maybe<idx> const end = path_find_first_not_equal(value, '/');
   if (end.has_value()) {
      return end.value();
   }
   return value.size();
}

[[nodiscard]]
constexpr auto
path_trimmed_end(str_view value) -> idx {
   if (value.size() <= 1u) {
      return value.size();
   }
   maybe<idx> const end =
      path_find_last_not_equal(path_slice(value, 1u, value.size()), '/');
   if (end.has_value()) {
      return end.value() + 2u;
   }
   return 1u;
}

}  // namespace detail

template <typename Segment>
concept is_path_segment =
   requires(Segment const& segment) { detail::path_segment_view(segment); };

class path_component_stepanov_iterator
    : public proxy_stepanov_iterator_interface<
         forward_iterator_tag, str_view, str_view> {
 public:
   using value_type = str_view;
   using reference = str_view;
   using const_reference = str_view;

   constexpr path_component_stepanov_iterator() = default;

   constexpr path_component_stepanov_iterator(str_view value, idx position)
       : m_value(value), m_start(position), m_end(position) {
      seek();
   }

   [[nodiscard]]
   constexpr auto
   dereference() const -> str_view {
      return detail::path_slice(m_value, m_start, m_end);
   }

   constexpr auto
   increment() -> path_component_stepanov_iterator& {
      m_start = m_end;
      seek();
      return *this;
   }

   [[nodiscard]]
   constexpr auto
   equal_to(path_component_stepanov_iterator const& other) const -> bool {
      return m_value.data() == other.m_value.data()
             && m_value.size() == other.m_value.size()
             && m_start == other.m_start;
   }

 private:
   constexpr void
   seek() {
      str_view remaining = detail::path_slice(m_value, m_start, m_value.size());
      maybe<idx> const start =
         detail::path_find_first_not_equal(remaining, '/');
      if (start.is_empty()) {
         m_start = m_value.size();
         m_end = m_start;
         return;
      }
      m_start += start.value();
      remaining = detail::path_slice(m_value, m_start, m_value.size());
      maybe<idx> const end = detail::path_find_first_equal(remaining, '/');
      if (end.has_value()) {
         m_end = m_start + end.value();
      } else {
         m_end = m_value.size();
      }
   }

   str_view m_value;
   idx m_start;
   idx m_end;
};

class path_component_iteration_context {
 public:
   using element_type = str_view;

   constexpr path_component_iteration_context(
      path_component_stepanov_iterator current,
      path_component_stepanov_iterator end
   )
       : m_current(current), m_end(end) {
   }

   path_component_iteration_context(path_component_iteration_context const&) =
      delete;
   path_component_iteration_context(path_component_iteration_context&&) =
      delete;
   auto
   operator=(path_component_iteration_context const&)
      -> path_component_iteration_context& = delete;
   auto
   operator=(path_component_iteration_context&&)
      -> path_component_iteration_context& = delete;

   template <is_predicate<element_type> LoopBody>
   constexpr auto
   run_while(LoopBody&& loop_body) -> iteration_result {
      while (m_current != m_end) {
         if (!loop_body(*m_current)) {
            return iteration_result::incomplete;
         }
         ++m_current;
      }
      return iteration_result::complete;
   }

 private:
   path_component_stepanov_iterator m_current;
   path_component_stepanov_iterator m_end;
};

class path_components : public iterable_interface<path_components> {
 public:
   using value_type = str_view;
   using iterator = path_component_stepanov_iterator;
   using const_iterator = path_component_stepanov_iterator;

   constexpr path_components() = default;

   constexpr path_components(str_view value) : m_value(value) {
   }

   [[nodiscard]]
   constexpr auto
   begin() const -> iterator {
      return {m_value, 0u};
   }

   [[nodiscard]]
   constexpr auto
   end() const -> iterator {
      return {m_value, m_value.size()};
   }

   [[nodiscard]]
   constexpr auto
   cbegin() const -> const_iterator {
      return begin();
   }

   [[nodiscard]]
   constexpr auto
   cend() const -> const_iterator {
      return end();
   }

   constexpr auto
   iterate() const -> path_component_iteration_context {
      return {begin(), end()};
   }

 private:
   str_view m_value;
};

