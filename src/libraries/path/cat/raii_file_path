// -*- mode: c++ -*-
// vim: set ft=cpp:
#pragma once

// `cat::raii::basic_file_path` is a dynamically-sized owning file path
// container backed by a `cat::manual::basic_file_path`. It is inspired by
// `std::filesystem::path`, but a major distinction is that its only encoding is
// 1-byte characters across all platforms. It binds an allocator for the
// lifetime of the container. Upon construction, the path is empty.
//
// As this is an `raii` namespace container, its destructor deallocates storage
// automatically through the bound allocator.
//
// The `cat::manual::basic_file_path` does not deallocate its own memory.
//
// Path joining and decomposition are lexical. They do not access the
// filesystem, resolve symbolic links, or normalize `.` and `..` components.
//
// It is parameterized by an allocator and `cat::str_vec_flags`. Path storage
// is always null-terminated and uses the pointer-size vector layout. Those
// flags may toggle the following features:
//
//  `inline_storage(count)`
//     Store up to `count` characters inside the path, only allocating when its
//     inline capacity is exceeded.
//
//  `initial_growth(count)`
//     Grow to at least `count` characters on the first heap allocation, when
//     `inline_storage` is disabled.
//
//  `fixed_size`
//     The path has a fixed size upon allocation and no separate capacity.
//
// A convenience type alias is provided:
//
//  `cat::raii::file_path<Allocator>`, a `raii::basic_file_path` with 256
//     inline characters.
//
// 256 inline characters is a size borrowed from LLVM. Their measurements found
// this tradeoff ideal.
// TODO: Furthor research that.
// TODO: Provide a `cat::file_path_small[_fixed]` alias.
//
// When `inline_storage` is disabled, `file_path`s grow from 0 to a capacity of
// their `initial_growth` count in their initial allocation. Reallocations grow
// to double their current size from there.

#include <cat/detail/compact.hpp>

#include <cat/file_path>
#include <cat/propagate>

namespace cat::detail {
template <path_os os, str_vec_flags flags>
constexpr auto
raii_file_path_has_value(
   raii::basic_file_path<allocator_dyn, os, flags> const& value
) noexcept(false) -> bool;

template <path_os os, str_vec_flags flags>
constexpr auto
raii_file_path_nullopt() noexcept(false)
   -> raii::basic_file_path<allocator_dyn, os, flags>;

template <is_allocator Allocator, path_os os, str_vec_flags flags>
struct path_os_trait<raii::basic_file_path<Allocator, os, flags>> {
   static constexpr bool is_file_path = true;
   static constexpr path_os value = os;
};
}  // namespace cat::detail

namespace cat::raii {

template <
   is_allocator Allocator = allocator_dyn,
   str_vec_flags flags = detail::path_default_flags>
using file_path = basic_file_path<Allocator, path_os::portable, flags>;

template <is_allocator Allocator, path_os os, str_vec_flags flags>
class [[clang::preferred_name(file_path<Allocator>), gsl::Owner]]
basic_file_path
    : public container_interface<
         basic_file_path<Allocator, os, flags>, detail::path_char<os>>,
      public random_access_stepanov_iterable_interface<detail::path_char<os>>,
      public file_path_interface<os> {
   static constexpr str_vec_flags m_flags = detail::path_default_flags | flags;

 public:
   constexpr basic_file_path() =
      delete ("`cat::raii::basic_file_path` requires an allocator.");

   constexpr basic_file_path(
      allocator_ref<Allocator> allocator [[clang::lifetimebound]]
   ) noexcept
       : m_path(), m_allocator(allocator) {
   }

   constexpr basic_file_path(basic_file_path&&) = default;
   constexpr basic_file_path(basic_file_path const&) = delete (
      "Implicit copying of `cat::raii::basic_file_path` is forbidden. Call "
      "`.clone()` or move instead."
   );
   auto
   operator=(basic_file_path const&) noexcept(false)
      -> basic_file_path& = delete (
         "Implicit copying of `cat::raii::basic_file_path` is forbidden. Call "
         "`.clone()` or move instead."
      );

   constexpr auto
   operator=(basic_file_path&& other) noexcept(false) -> basic_file_path& {
      if (this == __builtin_addressof(other)) {
         return *this;
      }

      m_path.free(m_allocator);
      cat::assert(m_allocator == other.m_allocator);
      m_path = move(other.m_path);
      return *this;
   }

   constexpr ~basic_file_path() noexcept {
      m_path.free(m_allocator);
   }

   [[nodiscard]]
   constexpr auto
   data() noexcept [[clang::lifetimebound]]
   -> detail::path_char<os>* _Nullable {
      return m_path.data();
   }

   [[nodiscard]]
   constexpr auto
   data() const noexcept [[clang::lifetimebound]]
   -> detail::path_char<os> const* _Nullable {
      return m_path.data();
   }

   [[nodiscard]]
   constexpr auto
   size() const noexcept -> idx {
      return m_path.size();
   }

   [[nodiscard]]
   constexpr auto
   capacity() const noexcept -> idx {
      return m_path.capacity();
   }

   [[nodiscard]]
   constexpr auto
   is_null_terminated() const noexcept -> bool {
      return true;
   }

   [[nodiscard]]
   constexpr auto
   view() const noexcept [[clang::lifetimebound]] -> detail::path_view<os> {
      return m_path.view();
   }

   [[nodiscard]]
   constexpr
   operator detail::path_native_span<os>() noexcept [[clang::lifetimebound]] {
      return m_path;
   }

   [[nodiscard]]
   constexpr
   operator detail::path_native_view<os>() const noexcept
      [[clang::lifetimebound]] {
      return m_path;
   }

   [[nodiscard]]
   constexpr auto
   reserve(idx minimum_capacity) noexcept -> maybe<void>
      requires(!m_flags.vec.is_fixed_size)
   {
      return m_path.reserve(m_allocator, minimum_capacity);
   }

   [[nodiscard]]
   constexpr auto
   resize(idx new_size) noexcept -> maybe<void> {
      return m_path.resize(m_allocator, new_size);
   }

   constexpr void
   clear() noexcept {
      m_path.clear();
   }

   // Get the allocator backing this `cat::raii::basic_file_path`.
   [[nodiscard]]
   constexpr auto
   get_allocator(this auto&& self) noexcept -> allocator_ref<Allocator> {
      return self.m_allocator;
   }

   [[nodiscard]]
   constexpr auto
   clone() const& noexcept(!__has_feature(cxx_exceptions))
      -> maybe<basic_file_path> {
      return clone(m_allocator);
   }

   template <is_allocator NewAllocator>
   [[nodiscard]]
   constexpr auto
   clone(
      allocator_ref<NewAllocator> allocator [[clang::lifetimebound]]
   ) const& -> maybe<basic_file_path<NewAllocator, os, flags>> {
      auto path = m_path.clone(allocator);
      if (path.is_empty()) {
         return nullopt;
      }

      basic_file_path<NewAllocator, os, flags> result(allocator);
      result.m_path = move(path).value();
      return result;
   }

   [[nodiscard]]
   constexpr auto
   clone(allocator_dyn allocator [[clang::lifetimebound]]) const& noexcept
      -> maybe<basic_file_path<allocator_dyn, os, flags>> {
      return clone<allocator_dyn>(allocator);
   }

   [[nodiscard]]
   constexpr auto
   release() -> manual::basic_file_path<os, flags> {
      return move(m_path);
   }

   template <detail::is_path_segment_for<os> Segment>
   [[nodiscard]]
   constexpr auto
   append(Segment const& segment) noexcept(!__has_feature(cxx_exceptions))
      -> maybe<void> {
      return m_path.append(m_allocator, segment);
   }

   template <detail::is_foreign_encoding_segment<os> Segment>
   constexpr auto
   append(Segment const&) -> maybe<void> = delete (
      "A `cat::path_os::nt` path only joins `char16_t` strings, and other "
      "paths only join `char` strings!"
   );

   template <detail::is_foreign_os_path<os> Segment>
   constexpr auto
   append(Segment const&) -> maybe<void> = delete (
      "A path cannot be joined with a path of a different `cat::path_os`! "
      "Join its `.view()` instead."
   );

 private:
   template <
      is_allocator OtherAllocator, path_os other_os, str_vec_flags other_flags>
   friend class basic_file_path;

   template <path_os other_os, str_vec_flags other_flags>
   friend constexpr auto
   detail::raii_file_path_has_value(
      basic_file_path<allocator_dyn, other_os, other_flags> const&
   ) -> bool;

   template <path_os other_os, str_vec_flags other_flags>
   friend constexpr auto
   detail::raii_file_path_nullopt()
      -> basic_file_path<allocator_dyn, other_os, other_flags>;

   manual::basic_file_path<os, flags> m_path;
   [[no_unique_address]]
   allocator_ref<Allocator> m_allocator;
};

}  // namespace cat::raii

namespace cat::detail {

template <path_os os, str_vec_flags flags>
constexpr auto
raii_file_path_has_value(
   raii::basic_file_path<allocator_dyn, os, flags> const& value
) -> bool {
   return maybe_file_path_has_value(value.m_path);
}

inline constexpr allocator_null raii_file_path_niche_allocator_null{};

template <path_os os, str_vec_flags flags>
constexpr auto
raii_file_path_nullopt() -> raii::basic_file_path<allocator_dyn, os, flags> {
   raii::basic_file_path<allocator_dyn, os, flags> value(
      allocator_ref<allocator_dyn>(allocator_dyn(
         const_cast<allocator_null&>(raii_file_path_niche_allocator_null)
      ))
   );
   value.m_path = maybe_file_path_nullopt<os, flags>();
   return value;
}

}  // namespace cat::detail

namespace cat {

template <path_os os, str_vec_flags flags>
struct default_compact_trait<raii::basic_file_path<allocator_dyn, os, flags>>
    : identity_trait<compact<
         raii::basic_file_path<allocator_dyn, os, flags>,
         detail::raii_file_path_has_value<os, flags>,
         detail::raii_file_path_nullopt<os, flags>>> {};

}  // namespace cat

namespace cat::raii {

template <
   is_allocator Allocator, path_os os = path_os::portable,
   str_vec_flags flags = detail::path_default_flags, is_path_segment Segment>
[[nodiscard]]
constexpr auto
make_file_path(
   allocator_ref<Allocator> allocator [[clang::lifetimebound]],
   Segment const& segment
) noexcept(!__has_feature(cxx_exceptions))
   -> maybe<
      basic_file_path<Allocator, detail::path_deduce_os<os, Segment>, flags>> {
   basic_file_path<Allocator, detail::path_deduce_os<os, Segment>, flags>
      result(allocator);
   auto const value = detail::path_segment_view(segment);
   $prop(
      result.reserve(max(value.size(), detail::path_initial_capacity(flags)))
   );
   $prop(result.resize(0u));
   $prop(result.append(
      detail::path_segment_view_for<detail::path_deduce_os<os, Segment>>(
         segment
      )
   ));
   return result;
}

template <
   path_os os = path_os::portable,
   str_vec_flags flags = detail::path_default_flags, is_path_segment Segment>
[[nodiscard]]
constexpr auto
make_file_path(
   allocator_dyn allocator [[clang::lifetimebound]], Segment const& segment
) noexcept
   -> maybe<basic_file_path<
      allocator_dyn, detail::path_deduce_os<os, Segment>, flags>> {
   return raii::make_file_path<allocator_dyn, os, flags>(allocator, segment);
}

template <
   is_allocator Allocator, path_os os = path_os::portable,
   str_vec_flags flags = detail::path_default_flags>
[[nodiscard]]
constexpr auto
make_file_path(
   allocator_ref<Allocator> allocator [[clang::lifetimebound]]
) noexcept -> maybe<basic_file_path<Allocator, os, flags>> {
   return raii::make_file_path<Allocator, os, flags>(
      allocator, detail::path_view<os>{}
   );
}

template <
   path_os os = path_os::portable,
   str_vec_flags flags = detail::path_default_flags>
[[nodiscard]]
constexpr auto
make_file_path(allocator_dyn allocator [[clang::lifetimebound]]) noexcept
   -> maybe<basic_file_path<allocator_dyn, os, flags>> {
   return raii::make_file_path<allocator_dyn, os, flags>(allocator);
}

template <
   is_allocator Allocator, path_os os = path_os::portable,
   str_vec_flags flags = detail::path_default_flags, is_path_segment Segment>
[[nodiscard]]
constexpr auto
make_file_path_lexically_normal(
   allocator_ref<Allocator> allocator [[clang::lifetimebound]],
   Segment const& segment
) noexcept(!__has_feature(cxx_exceptions))
   -> maybe<
      basic_file_path<Allocator, detail::path_deduce_os<os, Segment>, flags>> {
   constexpr path_os result_os = detail::path_deduce_os<os, Segment>;
   basic_file_path<Allocator, result_os, flags> result =
      $prop((raii::make_file_path<Allocator, os, flags>(allocator, segment)));
   $prop(result.resize(
      detail::path_lexically_normalize<result_os>(result.data(), result.size())
   ));
   return result;
}

template <
   path_os os = path_os::portable,
   str_vec_flags flags = detail::path_default_flags, is_path_segment Segment>
[[nodiscard]]
constexpr auto
make_file_path_lexically_normal(
   allocator_dyn allocator [[clang::lifetimebound]], Segment const& segment
) noexcept
   -> maybe<basic_file_path<
      allocator_dyn, detail::path_deduce_os<os, Segment>, flags>> {
   return raii::make_file_path_lexically_normal<allocator_dyn, os, flags>(
      allocator, segment
   );
}

template <
   is_allocator Allocator, path_os os, str_vec_flags flags,
   detail::is_path_segment_for<os> Segment>
[[nodiscard]]
constexpr auto
operator/(
   basic_file_path<Allocator, os, flags> const& left, Segment const& right
) noexcept(!__has_feature(cxx_exceptions))
   -> maybe<basic_file_path<Allocator, os, flags>> {
   basic_file_path<Allocator, os, flags> result = $prop(left.clone());
   $prop(result.append(right));
   return result;
}

template <
   is_allocator Allocator, path_os os, str_vec_flags flags,
   detail::is_foreign_encoding_segment<os> Segment>
constexpr auto
operator/(basic_file_path<Allocator, os, flags> const&, Segment const&)
   -> maybe<basic_file_path<Allocator, os, flags>> = delete (
      "A `cat::path_os::nt` path only joins `char16_t` strings, and other "
      "paths only join `char` strings!"
   );

template <
   is_allocator Allocator, path_os os, str_vec_flags flags,
   detail::is_foreign_os_path<os> Segment>
constexpr auto
operator/(basic_file_path<Allocator, os, flags> const&, Segment const&)
   -> maybe<basic_file_path<Allocator, os, flags>> = delete (
      "A path cannot be joined with a path of a different `cat::path_os`! "
      "Join its `.view()` instead."
   );

}  // namespace cat::raii

