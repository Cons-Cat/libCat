template <typename T>
struct allocator {
   using value_type = T;

   constexpr allocator() = default;

   template <typename U>
   constexpr allocator([[maybe_unused]] allocator<U> const& other) {
   }

   [[nodiscard]]
   constexpr auto
   allocate(__SIZE_TYPE__ count) -> T* _Nonnull {
      return static_cast<T* _Nonnull>(::operator new(count * sizeof(T)));
   }

   constexpr void
   deallocate(T* _Nonnull p_memory, [[maybe_unused]] __SIZE_TYPE__ count) {
      ::operator delete(p_memory);
   }
};

