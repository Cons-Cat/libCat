#pragma once

#include <cat/allocator>
#include <cat/allocator_parameters>

namespace cat {

// Call before throwing. The allocator must outlive thrown exceptions.
// A throw with no registered allocator terminates.
template <is_allocator Allocator>
void
alloc_exception_runtime(allocator_ref<Allocator> allocator);

void
alloc_exception_runtime(allocator_dyn allocator);

namespace detail {
void
register_exception_allocator(allocator_dyn allocator);
}  // namespace detail

template <is_allocator Allocator>
void
alloc_exception_runtime(allocator_ref<Allocator> allocator) {
   if constexpr (requires { typename Allocator::basic_allocator_dyn_tag; }) {
      detail::register_exception_allocator(allocator.get_allocator());
   } else {
      detail::register_exception_allocator(
         allocator_dyn(allocator.get_allocator())
      );
   }
}

inline void
alloc_exception_runtime(allocator_dyn allocator) {
   alloc_exception_runtime<allocator_dyn>(allocator);
}

}  // namespace cat
