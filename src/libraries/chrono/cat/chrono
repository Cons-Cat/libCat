struct clock_tai {
   using duration = units::nanosecond_int8;
   using time_point = cat::time_point<clock_tai, duration>;

   static constexpr bool is_steady = false;

   [[nodiscard]]
   static auto
   now() -> maybe<time_point> {
      nix::timespec value;
      $prop_as(nix::sys_clock_gettime(nix::clock_id::tai, value), nullopt);
      return time_point(value.to_nanoseconds() + 378'691'200 * units::second);
   }
};

