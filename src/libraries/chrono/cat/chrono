#pragma once

// `cat/chrono` is an adaptation of the `chrono` standard library. It makes
// several notable changes to better fit the libCat programming model.
//
// Top among them is that time is represented as `cat::unit::` quantities. These
// are defined in the more generalized `cat/time_units` header. By extension,
// there is no `duration_cast` so `cat::basic_int` type-safe conversions should
// be used instead. Note that there are no `rep`, `period`, or `.count()`
// members in duration quantities.
//
// The following clocks are provided:
//
//   `cat::clock_system`
//      A portable abstraction over OS-specific nanosecond clocks WITHOUT a
//      monotonic guarantee. Unlike `std::chrono::system_clock`, it provides a
//      `.native()` method to access the underlying clock
//
//   `cat::clock_steady`
//      A portable abstraction over OS-specific nanosecond clocks WITH a
//      monotonic guarantee. Unlike `std::chrono::steady_clock`, it provides a
//      `.native()` method to access the underlying clock.
//
//   `cat::clock_unix`
//      A clock that is based on the Unix epoch.
//
//   `cat::clock_tai`
//      A clock that is based on the International Atomic Time (TAI) epoch.
//
//   `cat::clock_utc`
//      A clock that is based on the Coordinated Universal Time (UTC) epoch.
//
//   `cat::clock_gps`
//      A clock that is based on the Global Positioning System (GPS) epoch.
//
//   `cat::clock_scaled`
//      A clock adaptor that scales its time elapsed by a constant.
//
// There is no `cat::clock_high_resolution`, because
// `std::chrono::high_resolution_clock` is poorly defined. `cat::clock_steady`
// should be used instead.
//
// For these clocks, nanoseconds are the common duration type. This is the
// correct choice, as it is platform native to every targeted operating system,
// despite being inconsistent with libc++ (although libstdc++ agrees with
// nanoseconds). The use of microseconds in libc++ clocks is a historical error
// frozen in ABI.
//
// Platform-specific clocks can be found in
// `src/linux/implementations/clock_timerfd.tpp`.
//
// TODO: Introduce calendar abstractions.
// https://www.benjoffe.com/fast-day-of-week
// https://forum.orekit.org/t/revamping-dates-handling/3850

#include <cat/linux>
#include <cat/maybe>
#include <cat/propagate>
#include <cat/time_units>

namespace cat {

template <typename Clock>
concept is_clock = requires {
                      requires is_duration<typename Clock::duration>;
                      typename Clock::time_point;
                      { Clock::is_steady } -> is_convertible<bool>;
                      {
                         Clock::now()
                      } -> is_same<maybe<typename Clock::time_point>>;
                   };

struct clock_system {
 private:
   // TODO: Generalize this to other platforms.
   using timer = nix::clock_timerfd<nix::clock_id::realtime>;

 public:
   using duration = timer::duration;
   using time_point = cat::time_point<clock_system, duration>;

   static constexpr bool is_steady = timer::is_steady;

   [[nodiscard]]
   static auto
   now() -> maybe<time_point> {
      return time_point($prop(m_timer.now()).time_since_epoch());
   }

   [[nodiscard]]
   static auto
   native() -> timer& {
      return m_timer;
   }

 private:
   // An unarmed `timerfd` still reads the kernel clock it names.
   static inline timer m_timer{nix::invalid_file_descriptor};
};

