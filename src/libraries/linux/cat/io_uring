// -*- mode: c++ -*-
// vim: set ft=cpp:
#pragma once

// `nix::io_uring` is a lightweight interface to a Linux `io_uring` instance. It
// leverages many optimizations from modern Linux, and it is recommended to use
// with at least Linux 6.13.
//
// It is NOT thread-safe, and for performance and safety reasons it is
// recommended that all instances are `thread_local` if in a multi-threaded
// application.
//
// As this is a `manual` namespace type, its destructor does not deallocate
// storage. To deallocate it and release from the kernel, call
// `.free(allocator)` or
// `.cfree(allocator)`.
//
// The `nix::raii::io_uring` deallocates its own memory automatically.
//
// Queue references and pointers to Submission Queue Events and Completion Queue
// Events borrow storage from their `io_uring`. They must not outlive the owner
// or be retained across its `move`, `swap`, or `free`. An SQE must not be used
// after submission, and a CQE must not be used after the completion queue
// advances past it.

#include <cat/allocator_parameters>
#include <cat/linux>

namespace nix {

inline namespace manual {
class io_uring;
}  // namespace manual

// An operation submitted to a ring that other code shares. An SQE's
// `user_data` holds the address of one of these, and `.dispatch()`
// passes that SQE's CQE to `p_complete`. Embed this in a larger struct to keep
// per-operation state.
struct io_uring_operation {
   void (*_Nonnull p_complete)(
      io_uring_operation& operation, io_uring_cqe const& completion
   ) noexcept;
};

class io_uring_submission_queue {
 public:
   // Construct an unbound queue view. An owning ring binds it before access.
   io_uring_submission_queue() = default;

   // Reserve and zero the next configured SQE slot. Returns `nullptr` when the
   // ring is full. Fill the mapped entry before `.flush()` publishes its slot.
   [[nodiscard]]
   auto
   get_sqe() noexcept(!__has_feature(cxx_exceptions)) [[clang::lifetimebound]]
   -> io_uring_sqe* _Nullable {
      cat::uint4 const head =
         cat::atomic<cat::uint4&>(*m_p_head).load(cat::memory_order::acquire);
      if (m_sqe_tail.wrap() - head >= m_ring_entries) {
         return nullptr;
      }

      cat::idx const index = m_sqe_tail & m_ring_mask;
      auto* p_sqe = __builtin_bit_cast(
         io_uring_sqe* _Nonnull, m_p_sqes + index * m_sqe_stride
      );

      // Constant sizes let the zeroing inline.
      if (m_sqe_stride == sizeof(io_uring_sqe)) {
         __builtin_memset_inline(p_sqe, 0, sizeof(io_uring_sqe));
      } else {
         __builtin_memset_inline(p_sqe, 0, sizeof(io_uring_sqe) * 2u);
      }

      m_sqe_tail = m_sqe_tail.wrap() + 1u;
      return p_sqe;
   }

   // Reserve and zero one 128-byte SQE. Returns `nullptr` when this format is
   // unsupported or lacks space. Mixed mode may also reserve a padding slot.
   [[nodiscard]]
   auto
   get_sqe_128() noexcept(!__has_feature(cxx_exceptions))
      [[clang::lifetimebound]] -> io_uring_sqe* _Nullable {
      if (
         m_sqe_stride == sizeof(io_uring_sqe) * 2u
         && (m_setup_flags & io_uring_setup_flags::sqe_128)
               != io_uring_setup_flags::none
      ) {
         return get_sqe();
      }

      if (
         (m_setup_flags & io_uring_setup_flags::sqe_mixed)
         == io_uring_setup_flags::none
      ) {
         return nullptr;
      }

      cat::uint4 const head =
         cat::atomic<cat::uint4&>(*m_p_head).load(cat::memory_order::acquire);
      cat::uint4 const index = m_sqe_tail & m_ring_mask;
      if (index == m_ring_mask) {
         if (m_sqe_tail.wrap() + 2u - head >= m_ring_entries) {
            return nullptr;
         }

         io_uring_sqe* p_padding = get_sqe();
         p_padding->opcode = io_uring_opcode::nop;
         p_padding->flags = io_uring_sqe_flags::cqe_skip_success;
      } else if (m_sqe_tail.wrap() + 1u - head >= m_ring_entries) {
         return nullptr;
      }

      cat::idx const large_index = m_sqe_tail & m_ring_mask;
      auto* p_sqe = __builtin_bit_cast(
         io_uring_sqe* _Nonnull, m_p_sqes + large_index * sizeof(io_uring_sqe)
      );
      __builtin_memset_inline(p_sqe, 0, sizeof(io_uring_sqe) * 2u);
      m_sqe_tail = m_sqe_tail.wrap() + 2u;
      return p_sqe;
   }

   // Return the number of SQ ring slots reserved locally since the last flush.
   // A mixed 128-byte SQE and its padding may account for multiple slots.
   [[nodiscard]]
   auto
   ready_count() const noexcept -> cat::uint4 {
      return m_sqe_tail.wrap() - m_sqe_head;
   }

   // Return reservable SQ ring slots using an acquired kernel head and the
   // local reservation tail.
   [[nodiscard]]
   auto
   space_left() const noexcept(!__has_feature(cxx_exceptions)) -> cat::uint4 {
      cat::uint4 const head =
         cat::atomic<cat::uint4&>(*m_p_head).load(cat::memory_order::acquire);
      return m_ring_entries.wrap() - (m_sqe_tail.wrap() - head);
   }

   // Publish all locally reserved SQ slots with release ordering and return
   // their count. Publication follows the setup mode and does not enter Linux.
   [[nodiscard]]
   auto
   flush() noexcept(!__has_feature(cxx_exceptions)) -> cat::uint4 {
      cat::uint4 const submitted = ready_count();
      if (submitted == 0u) {
         return 0u;
      }

      if (
         (m_setup_flags & io_uring_setup_flags::sq_rewind)
         != io_uring_setup_flags::none
      ) {
         __atomic_thread_fence(cat::memory_order::release);
         m_sqe_head = 0u;
         m_sqe_tail = 0u;
         return submitted;
      }

      if (m_p_array != nullptr) {
         for (cat::uint4 tail = m_sqe_head; tail != m_sqe_tail;
              tail = tail.wrap() + 1u) {
            cat::uint4 const index = tail & m_ring_mask;
            m_p_array[index.raw] = index;
         }
      }

      cat::atomic<cat::uint4&>(*m_p_tail).store(
         m_sqe_tail, cat::memory_order::release
      );
      m_sqe_head = m_sqe_tail;
      return submitted;
   }

   // Return the SQ slots published by `.flush()` that Linux has not consumed
   // yet. A failed `io_uring_enter` leaves them for the next one.
   [[nodiscard]]
   auto
   unconsumed_count() const noexcept(!__has_feature(cxx_exceptions))
      -> cat::uint4 {
      cat::uint4 const head =
         cat::atomic<cat::uint4&>(*m_p_head).load(cat::memory_order::acquire);
      return m_sqe_head.wrap() - head;
   }

   // Report whether completions wait for this thread to enter the ring. Linux
   // only reports this for rings set up with `taskrun_flag`.
   [[nodiscard]]
   auto
   has_task_work() const noexcept(!__has_feature(cxx_exceptions)) -> bool {
      cat::uint4 const flags =
         cat::atomic<cat::uint4&>(*m_p_flags).load(cat::memory_order::relaxed);
      return (flags & cat::to_underlying(io_uring_sq_flags::taskrun)) != 0u;
   }

   // Report whether the kernel currently requests an SQ polling thread wakeup.
   [[nodiscard]]
   auto
   needs_wakeup() const noexcept(!__has_feature(cxx_exceptions)) -> bool {
      cat::uint4 const flags =
         cat::atomic<cat::uint4&>(*m_p_flags).load(cat::memory_order::relaxed);
      return (flags & cat::to_underlying(io_uring_sq_flags::need_wakeup)) != 0u;
   }

   // Return a snapshot of the kernel-maintained dropped submission count.
   [[nodiscard]]
   auto
   dropped_count() const noexcept(!__has_feature(cxx_exceptions))
      -> cat::uint4 {
      return cat::atomic<cat::uint4&>(*m_p_dropped)
         .load(cat::memory_order::relaxed);
   }

 private:
   friend class manual::io_uring;

   cat::uint4* _Nullable m_p_head = nullptr;
   cat::uint4* _Nullable m_p_tail = nullptr;
   cat::uint4* _Nullable m_p_flags = nullptr;
   cat::uint4* _Nullable m_p_dropped = nullptr;
   cat::uint4* _Nullable m_p_array = nullptr;
   cat::byte* _Nullable m_p_sqes = nullptr;
   cat::idx m_sqe_stride = 0u;
   cat::uint4 m_ring_mask = 0u;
   cat::uint4 m_ring_entries = 0u;
   cat::uint4 m_sqe_head = 0u;
   cat::uint4 m_sqe_tail = 0u;
   io_uring_setup_flags m_setup_flags = io_uring_setup_flags::none;
};

class io_uring_completion_queue {
 public:
   // Construct an unbound queue view. An owning ring binds it before access.
   io_uring_completion_queue() = default;

   // Return the current CQE or `nullptr` when no user CQE is ready. Mixed-mode
   // skip entries are released while searching. The pointer is current until
   // `.advance()` or invalidation of the owning ring.
   [[nodiscard]]
   auto
   peek() noexcept(!__has_feature(cxx_exceptions)) [[clang::lifetimebound]]
   -> io_uring_cqe const* _Nullable {
      for (;;) {
         cat::uint4 const tail = cat::atomic<cat::uint4&>(*m_p_tail).load(
            cat::memory_order::acquire
         );
         if (m_cqe_head == tail) {
            return nullptr;
         }

         io_uring_cqe const* p_cqe = current();
         if (
            (m_setup_flags & io_uring_setup_flags::cqe_mixed)
               == io_uring_setup_flags::none
            || (p_cqe->flags & io_uring_cqe_flags::skip)
                  == io_uring_cqe_flags::none
         ) {
            return p_cqe;
         }

         advance();
      }
   }

   // Release the current CQE to the kernel with a release store. This requires
   // a prior `.peek()` result that was not `nullptr`. A mixed extended CQE
   // releases two ring slots.
   void
   advance() noexcept(!__has_feature(cxx_exceptions)) {
      io_uring_cqe const* p_cqe = current();
      cat::uint4 step = 1u;

      if (
         (m_setup_flags & io_uring_setup_flags::cqe_mixed)
            != io_uring_setup_flags::none
         && (p_cqe->flags & io_uring_cqe_flags::extended_32)
               != io_uring_cqe_flags::none
      ) {
         step = 2u;
      }

      m_cqe_head = m_cqe_head.wrap() + step;
      cat::atomic<cat::uint4&>(*m_p_head).store(
         m_cqe_head, cat::memory_order::release
      );
   }

   // Return CQ ring slots between the local head and acquired kernel tail.
   // Mixed extended and skipped entries mean this is not a user CQE count.
   [[nodiscard]]
   auto
   ready_count() const noexcept(!__has_feature(cxx_exceptions)) -> cat::uint4 {
      cat::uint4 const tail =
         cat::atomic<cat::uint4&>(*m_p_tail).load(cat::memory_order::acquire);
      return tail.wrap() - m_cqe_head;
   }

   // Return a snapshot of the kernel-maintained completion overflow count.
   [[nodiscard]]
   auto
   overflow() const noexcept(!__has_feature(cxx_exceptions)) -> cat::uint4 {
      return cat::atomic<cat::uint4&>(*m_p_overflow)
         .load(cat::memory_order::relaxed);
   }

 private:
   friend class manual::io_uring;

   [[nodiscard]]
   auto
   current() const noexcept -> io_uring_cqe const* _Nonnull {
      cat::idx const index = m_cqe_head & m_ring_mask;
      return __builtin_bit_cast(
         io_uring_cqe const* _Nonnull, m_p_cqes + index * m_cqe_stride
      );
   }

   cat::uint4* _Nullable m_p_head = nullptr;
   cat::uint4* _Nullable m_p_tail = nullptr;
   cat::uint4* _Nullable m_p_overflow = nullptr;
   cat::byte* _Nullable m_p_cqes = nullptr;
   cat::idx m_cqe_stride = 0u;
   cat::uint4 m_ring_mask = 0u;
   cat::uint4 m_cqe_head = 0u;
   io_uring_setup_flags m_setup_flags = io_uring_setup_flags::none;
};

inline namespace manual {

class [[gsl::Owner]] io_uring {
 public:
   // Construct an empty owner. `make_io_uring()` creates a ring.
   io_uring() = default;

   // Transfer the complete ring into this owner and leave `other` empty.
   io_uring(io_uring&& other);

   // Ring ownership cannot be copied.
   io_uring(io_uring const&) = delete;

   // This does not release the ring, so call `.free(allocator)` first.
   ~io_uring() = default;

   // Ring ownership cannot be copied.
   auto
   operator=(io_uring const&) noexcept -> io_uring& = delete;

   // Transfer `other` and leave it empty. This must not own a ring, so call
   // `.free(allocator)` first. Self-assignment leaves the ring unchanged.
   [[clang::reinitializes]]
   auto
   operator=(io_uring&& other) noexcept -> io_uring&;

   // Return the mutable non-owning SQ view. The reference remains valid only
   // while this owner retains the same initialized ring state.
   [[nodiscard]]
   auto
   submission_queue() noexcept [[clang::lifetimebound]]
   -> io_uring_submission_queue& {
      return m_submission_queue;
   }

   // Return the mutable non-owning CQ view. The reference remains valid only
   // while this owner retains the same initialized ring state.
   [[nodiscard]]
   auto
   completion_queue() noexcept [[clang::lifetimebound]]
   -> io_uring_completion_queue& {
      return m_completion_queue;
   }

   // Return the kernel-filled setup parameters. They reset on free. The
   // reference requires unchanged ring state.
   [[nodiscard]]
   auto
   params() const noexcept [[clang::lifetimebound]] -> io_uring_params const& {
      return m_params;
   }

   // Enter Linux with the supplied counts and flags without flushing local SQ
   // reservations. Returns the kernel-reported submitted count or an error.
   [[nodiscard]]
   auto
   enter(
      cat::uint4 to_submit, cat::uint4 minimum_complete,
      io_uring_enter_flags flags = io_uring_enter_flags::none
   ) noexcept -> scaredy_nix<cat::idx>;

   // Flush pending SQ slots without adding a completion request. Returns the
   // submitted count, or the published slot count when SQ polling avoids the
   // system call.
   [[nodiscard]]
   auto
   submit(io_uring_enter_flags flags = io_uring_enter_flags::none) noexcept
      -> scaredy_nix<cat::idx>;

   // Flush pending SQ slots and request at least `minimum_complete`
   // completions. Returns the submitted count, or the published slot count
   // when SQ polling avoids the system call.
   [[nodiscard]]
   auto
   submit_and_wait(
      cat::uint4 minimum_complete,
      io_uring_enter_flags flags = io_uring_enter_flags::none
   ) noexcept -> scaredy_nix<cat::idx>;

   // Submit pending SQEs, wait until at least `minimum_complete` CQEs are
   // ready, then pass every ready CQE to the `io_uring_operation` that its
   // `user_data` points to. Interruptions and a full completion queue are not
   // errors here, because collecting completions is how they are resolved, so
   // callers wait again until their operations complete. An error means the
   // ring cannot be used, and its operations may never complete.
   [[nodiscard]]
   auto
   dispatch(cat::uint4 minimum_complete) noexcept -> scaredy_nix<void>;

   // Register a fixed file table of `count` empty slots, which
   // `.register_file()` or a `files_update` operation fills.
   [[nodiscard]]
   auto
   register_file_table(cat::uint4 count) noexcept -> scaredy_nix<void>;

   // Put `descriptor` in a free fixed file slot, and return that slot's index
   // for SQEs flagged with `io_uring_sqe_flags::fixed_file`.
   [[nodiscard]]
   auto
   register_file(file_descriptor descriptor) noexcept
      -> scaredy_nix<cat::uint4>;

   // Empty a slot filled by `.register_file()`. This drops the ring's
   // reference to that file once no submitted operation uses it.
   [[nodiscard]]
   auto
   unregister_file(cat::uint4 index) noexcept -> scaredy_nix<void>;

   // Destroy the ring, then deallocate its memory from `allocator`. Every
   // submitted operation must have completed first, because Linux writes their
   // completions into this memory. This leaves the owner empty, and does
   // nothing if it already is. Queue references must not be retained.
   template <cat::is_allocator Allocator>
   [[clang::reinitializes]]
   void
   free(cat::allocator_ref<Allocator> allocator) noexcept(
      !__has_feature(cxx_exceptions)
   ) {
      cat::span<cat::byte> const memory = destroy();
      if (memory.data() != nullptr) {
         allocator.free_multi(memory);
      }
   }

   // Destroy the ring, then deallocate its memory from `allocator`.
   [[clang::reinitializes, gnu::always_inline, gnu::nodebug]]
   void
   free(cat::allocator_dyn allocator) noexcept(!__has_feature(cxx_exceptions)) {
      free<cat::allocator_dyn>(allocator);
   }

   // Destroy the ring, then zero and deallocate its memory from `allocator`.
   // The same requirements as `.free()` apply.
   template <cat::is_allocator Allocator>
   [[clang::reinitializes]]
   void
   cfree(cat::allocator_ref<Allocator> allocator) noexcept(
      !__has_feature(cxx_exceptions)
   ) {
      cat::span<cat::byte> const memory = destroy();
      if (memory.data() != nullptr) {
         allocator.cfree_multi(memory);
      }
   }

   // Destroy the ring, then zero and deallocate its memory from `allocator`.
   [[clang::reinitializes, gnu::always_inline, gnu::nodebug]]
   void
   cfree(cat::allocator_dyn allocator) noexcept(
      !__has_feature(cxx_exceptions)
   ) {
      cfree<cat::allocator_dyn>(allocator);
   }

   // Exchange complete ring ownership and queue state. Existing queue
   // references and mapped entry pointers must not be retained.
   void
   swap(io_uring& other);

 private:
   template <cat::is_allocator Allocator>
   friend auto
   make_io_uring(
      cat::allocator_ref<Allocator> allocator, cat::uint4 entries,
      io_uring_params params
   ) noexcept(!__has_feature(cxx_exceptions))
      -> cat::scaredy<io_uring, linux_error>;

   // The SQE array comes first, then the rings, each starting on a page.
   struct memory_layout {
      cat::idx sqe_size;
      cat::idx ring_size;
   };

   // Mirror Linux's sizing of the queues that `make_io_uring()` requests.
   [[nodiscard]]
   static auto
   layout(cat::uint4 entries, io_uring_params const& params) noexcept
      -> cat::scaredy<memory_layout, linux_error>;

   [[nodiscard, clang::reinitializes]]
   auto
   setup(
      cat::span<cat::byte> memory, memory_layout layout, cat::uint4 entries,
      io_uring_params params
   ) noexcept(!__has_feature(cxx_exceptions)) -> scaredy_nix<void>;

   // Destroy the ring and empty this owner, returning its memory.
   [[nodiscard, clang::reinitializes]]
   auto
   destroy() noexcept(!__has_feature(cxx_exceptions)) -> cat::span<cat::byte>;

   // Call `io_uring_register` on this ring, however it is identified.
   [[nodiscard]]
   auto
   register_with_ring(
      io_uring_register_op operation, void* _Nullable p_argument,
      cat::uint4 count
   ) noexcept -> scaredy_nix<cat::idx>;

   // A registered ring index, unless `m_enter_flags` is `none`, in which case
   // this is a plain descriptor.
   file_descriptor m_ring = invalid_file_descriptor;
   io_uring_enter_flags m_enter_flags = io_uring_enter_flags::none;
   io_uring_params m_params{};
   io_uring_submission_queue m_submission_queue;
   io_uring_completion_queue m_completion_queue;
   cat::span<cat::byte> m_memory = nullptr;
};

// Create an owning ring using `entries` and the supplied parameters, with its
// queues in memory from `allocator`. Failure releases everything acquired.
template <cat::is_allocator Allocator>
[[nodiscard]]
auto
make_io_uring(
   cat::allocator_ref<Allocator> allocator, cat::uint4 entries,
   io_uring_params params = {}
) noexcept(!__has_feature(cxx_exceptions))
   -> cat::scaredy<io_uring, linux_error> {
   io_uring::memory_layout const layout =
      $prop(io_uring::layout(entries, params));
   cat::span<cat::byte> const memory = $prop_as(
      allocator.template align_alloc_multi<cat::byte>(
         cat::page_size, layout.sqe_size + layout.ring_size
      ),
      linux_error::nomem
   );
   io_uring ring;
   scaredy_nix<void> const set_up = ring.setup(memory, layout, entries, params);
   if (set_up.is_empty()) {
      allocator.free_multi(memory);
      return set_up.error();
   }
   return cat::move(ring);
}

// Create an owning ring with its queues in memory from `allocator`.
[[nodiscard, gnu::always_inline, gnu::nodebug]]
inline auto
make_io_uring(
   cat::allocator_dyn allocator, cat::uint4 entries, io_uring_params params = {}
) noexcept(!__has_feature(cxx_exceptions))
   -> cat::scaredy<io_uring, linux_error> {
   return manual::make_io_uring<cat::allocator_dyn>(allocator, entries, params);
}

}  // namespace manual

}  // namespace nix
