class seed_sequence {
 public:
   using result_type = uint4;

   constexpr seed_sequence() = default;

   template <is_iterable Range>
   constexpr seed_sequence(Range&& range) {
      assign(range);
   }

   constexpr seed_sequence(initializer_list<uint4> values) {
      assign(values);
   }

   [[nodiscard]]
   constexpr auto
   size() const -> idx {
      return m_size;
   }

   template <is_random_access_collection Output>
      requires requires(Output& output, position_type<Output> const& position) {
                  read_at_unchecked(output, position) = uint4{};
               }
   constexpr void
   generate(Output& output) const {
      auto const first = begin_pos(output);
      auto const last = end_pos(output);
      idx const output_size = distance(output, first, last);
      if (output_size == 0u) {
         return;
      }
      for (idx index = 0u; index < output_size; ++index) {
         auto position = first;
         offset_pos(output, position, index);
         read_at_unchecked(output, position) = 0x8b8b8b8bu;
      }
      idx mix_count = idx(output_size - 1u) / 2u;
      if (output_size >= 623u) {
         mix_count = 11u;
      } else if (output_size >= 68u) {
         mix_count = 7u;
      } else if (output_size >= 39u) {
         mix_count = 5u;
      } else if (output_size >= 7u) {
         mix_count = 3u;
      }
      idx const left = idx(output_size - mix_count) / 2u;
      idx const right = left + mix_count;
      idx const rounds = output_size > m_size + 1u ? output_size : m_size + 1u;
      auto word = [&](idx index) {
         auto position = first;
         offset_pos(output, position, index % output_size);
         return static_cast<__UINT32_TYPE__>(
            make_raw_arithmetic(read_at_unchecked(output, position))
         );
      };
      auto store = [&](idx index, __UINT32_TYPE__ value) {
         auto position = first;
         offset_pos(output, position, index % output_size);
         read_at_unchecked(output, position) = value;
      };
      auto first_mix = [](__UINT32_TYPE__ value) {
         value ^= value >> 27u;
         return value * 1'664'525u;
      };
      auto second_mix = [](__UINT32_TYPE__ value) {
         value ^= value >> 27u;
         return value * 1'566'083'941u;
      };

      __UINT32_TYPE__ mixed =
         first_mix(word(0u) ^ word(left) ^ word(idx(output_size - 1u)));
      __UINT32_TYPE__ added = mixed + make_raw_arithmetic(m_size);
      store(left, word(left) + mixed);
      store(right, word(right) + added);
      store(0u, added);

      for (idx index = 1u; index < rounds; ++index) {
         mixed =
            first_mix(word(index) ^ word(index + left) ^ word(idx(index - 1u)));
         added = mixed + make_raw_arithmetic(index);
         if (index <= m_size) {
            added += make_raw_arithmetic(m_values[idx(index - 1u)]);
         }
         store(index + left, word(index + left) + mixed);
         store(index + right, word(index + right) + added);
         store(index, added);
      }
      for (idx index = rounds; index < rounds + output_size; ++index) {
         mixed = second_mix(
            word(index) + word(index + left) + word(idx(index - 1u))
         );
         added = mixed - make_raw_arithmetic(index);
         store(index + left, word(index + left) ^ mixed);
         store(index + right, word(index + right) ^ added);
         store(index, added);
      }
   }

   [[nodiscard]]
   constexpr auto
   values() const -> span<uint4 const> {
      return {m_values.data(), m_size};
   }

 private:
   template <is_iterable Range>
   constexpr void
   assign(Range&& range) {
      iterate(range).run_while([&](auto&& value) -> bool {
         if (m_size == m_values.size()) {
            return false;
         }
         m_values[m_size] = uint4(value);
         ++m_size;
         return true;
      });
   }

   array<uint4, 64u> m_values;
   idx m_size = 0u;
};

