using convenience_random_engine = pcg_dxsm_engine<uint8>;

// https://open-std.org/jtc1/sc22/wg21/docs/papers/2024/p1068r11.pdf
template <is_iterable Range, typename Generator>
constexpr auto
generate_random(Range&& range, Generator&& generator) -> iteration_result {
   if constexpr (requires { generator.generate_random($fwd(range)); }) {
      generator.generate_random($fwd(range));
   } else if constexpr (is_simd_random_bit_generator<remove_cvref<Generator>>) {
      using simd_result = remove_cvref<Generator>::result_type;
      simd_result values;
      idx lane = simd_result::abi_type::lanes;
      auto context = iterate(range);
      context.run_while([&](auto&& value) -> bool {
         if (lane == simd_result::abi_type::lanes) {
            values = generator();
            lane = 0u;
         }
         value = values[lane];
         ++lane;
         return true;
      });
   } else {
      auto context = iterate(range);
      context.run_while([&](auto&& value) -> bool {
         value = generator();
         return true;
      });
   }
   return iteration_result::complete;
}

template <is_iterable Range, typename Generator, typename Distribution>
constexpr auto
generate_random(
   Range&& range, Generator&& generator, Distribution&& distribution
) -> iteration_result {
   if constexpr (requires {
                    distribution.generate_random($fwd(range), generator);
                 }) {
      distribution.generate_random($fwd(range), generator);
   } else if constexpr (is_simd<decltype(distribution(generator))>) {
      using simd_result = decltype(distribution(generator));
      simd_result values;
      idx lane = simd_result::abi_type::lanes;
      auto context = iterate(range);
      context.run_while([&](auto&& value) -> bool {
         if (lane == simd_result::abi_type::lanes) {
            values = distribution(generator);
            lane = 0u;
         }
         value = values[lane];
         ++lane;
         return true;
      });
   } else {
      auto context = iterate(range);
      context.run_while([&](auto&& value) -> bool {
         value = distribution(generator);
         return true;
      });
   }
   return iteration_result::complete;
}

