template <typename Engine>
auto
convenience_engine() -> Engine& {
   static thread_local Engine engine(nix::linux_urandom_engine{}());
   return engine;
}

template <typename Distribution, typename Engine>
auto
random_bool() -> bool {
   return Distribution{}(convenience_engine<Engine>());
}

template <is_simd Simd, typename Function>
constexpr auto
random_simd_from_lanes(Function&& function) -> Simd {
   Simd result;
   for (idx lane = 0u; lane < Simd::abi_type::lanes; ++lane) {
      result[lane] = function(lane);
   }
   return result;
}

template <is_simd Simd>
struct random_narrow_simd_engine {
   using type = xoshiro128_plusplus;
};

template <is_simd Simd, typename Engine>
   requires is_integral<typename Simd::value_type>
auto
random_simd_integral_with_engine(
   Simd lower_bound, Simd upper_bound, Engine& engine
) -> Simd {
   using lane_type = Simd::value_type;
   using unsigned_lane = uint_fixed<sizeof(lane_type)>;
   using unsigned_abi = Simd::abi_type::template make_abi_type<unsigned_lane>;
   using unsigned_simd = simd<unsigned_lane, unsigned_abi>;
   Simd result;
   array<bool, Simd::abi_type::lanes> complete;
   complete.fill(false);
   idx remaining = Simd::abi_type::lanes;
   while (remaining != 0u) {
      unsigned_simd const values = engine();
      for (idx lane = 0u; lane < Simd::abi_type::lanes; ++lane) {
         if (complete[lane]) {
            continue;
         }
         using raw_lane = raw_arithmetic_type<lane_type>;
         lane_type const lower_value = lower_bound[lane];
         lane_type const upper_value = upper_bound[lane];
         // TODO: Support a `cat::int128` type.
         __int128 const lower =
            static_cast<__int128>(make_raw_arithmetic(lower_value));
         __int128 const upper =
            static_cast<__int128>(make_raw_arithmetic(upper_value));
         __UINT64_TYPE__ const width = static_cast<__UINT64_TYPE__>(
            static_cast<unsigned __int128>(upper - lower) + 1u
         );
         __UINT64_TYPE__ const threshold = width == 0u ? 0u : -width % width;
         __UINT64_TYPE__ const value = make_raw_arithmetic(values[lane]);
         if (value < threshold) {
            continue;
         }
         __int128 const selected =
            lower + static_cast<__int128>(width == 0u ? value : value % width);
         result.set_lane(lane, lane_type(static_cast<raw_lane>(selected)));
         complete[lane] = true;
         remaining = idx(remaining - 1u);
      }
   }
   return result;
}

template <is_simd Simd>
   requires is_integral<typename Simd::value_type>
auto
random_simd_integral(Simd lower_bound, Simd upper_bound) -> Simd {
   using lane_type = Simd::value_type;
   using unsigned_lane = uint_fixed<sizeof(lane_type)>;
   using unsigned_abi = Simd::abi_type::template make_abi_type<unsigned_lane>;
   if constexpr (sizeof(lane_type) < 4u) {
      using engine_type = random_narrow_simd_engine<Simd>::type;
      static thread_local engine_type engine(
         uint4(random_seed(nix::linux_urandom_engine{}()))
      );
      return random_simd_from_lanes<Simd>([&](idx lane) {
         return uniform_int_distribution<
            lane_type>(lower_bound[lane], upper_bound[lane])(engine);
      });
   } else if constexpr (sizeof(lane_type) == 4u) {
      using engine_type = simd_xoshiro128_plusplus<unsigned_abi>;
      static thread_local engine_type engine(
         uint4(random_seed(nix::linux_urandom_engine{}()))
      );
      return random_simd_integral_with_engine(lower_bound, upper_bound, engine);
   } else {
      using engine_type = simd_xoshiro256_plusplus<unsigned_abi>;
      static thread_local engine_type engine(nix::linux_urandom_engine{}());
      return random_simd_integral_with_engine(lower_bound, upper_bound, engine);
   }
}

template <is_simd Simd>
   requires is_floating_point<typename Simd::value_type>
auto
random_simd_float(Simd lower_bound, Simd upper_bound) -> Simd {
   using lane_type = Simd::value_type;
   using unsigned_lane = uint_fixed<sizeof(lane_type)>;
   using unsigned_abi = Simd::abi_type::template make_abi_type<unsigned_lane>;
   Simd result;
   if constexpr (sizeof(lane_type) == 4u) {
      using engine_type = simd_xoshiro128_plusplus<unsigned_abi>;
      static thread_local engine_type engine(
         uint4(random_seed(nix::linux_urandom_engine{}()))
      );
      auto const values = engine();
      for (idx lane = 0u; lane < Simd::abi_type::lanes; ++lane) {
         lane_type const unit =
            lane_type(
               static_cast<float>(make_raw_arithmetic(values[lane]) >> 8u)
            )
            * 0x1p-24f;
         result.set_lane(
            lane,
            lower_bound[lane] + (upper_bound[lane] - lower_bound[lane]) * unit
         );
      }
   } else {
      using engine_type = simd_xoshiro256_plusplus<unsigned_abi>;
      static thread_local engine_type engine(nix::linux_urandom_engine{}());
      auto const values = engine();
      for (idx lane = 0u; lane < Simd::abi_type::lanes; ++lane) {
         lane_type const unit =
            lane_type(
               static_cast<double>(make_raw_arithmetic(values[lane]) >> 11u)
            )
            * 0x1p-53;
         result.set_lane(
            lane,
            lower_bound[lane] + (upper_bound[lane] - lower_bound[lane]) * unit
         );
      }
   }
   return result;
}

