template <
   is_floating_point Float, idx bits, is_uniform_random_bit_generator Generator>
constexpr auto
generate_canonical(Generator& generator) -> Float {
   using raw_float = raw_arithmetic_type<Float>;
   using raw_result = raw_arithmetic_type<typename Generator::result_type>;
   using unsigned_type = make_unsigned_type<raw_result>;
   constexpr idx float_bits =
      bits < limits<Float>::digits ? bits : limits<Float>::digits;
   constexpr idx engine_bits = limits<unsigned_type>::digits;
   constexpr idx calls = idx(float_bits + engine_bits - 1u) / engine_bits;
   raw_float value = 0;
   raw_float factor = 1;
   raw_float const radix = raw_float(unsigned_type(
                              make_raw_arithmetic(Generator::max())
                              - make_raw_arithmetic(Generator::min())
                           ))
                           + raw_float(1);
   for (idx index = 0u; index < calls; ++index) {
      value += raw_float(detail::random_engine_word(generator)) * factor;
      factor *= radix;
   }
   return Float(value / factor);
}

template <is_floating_point Float, is_uniform_random_bit_generator Generator>
constexpr auto
generate_canonical(Generator& generator) -> Float {
   return generate_canonical<Float, limits<Float>::digits>(generator);
}

