namespace cat {

namespace detail {

template <typename Engine>
auto
convenience_engine() -> Engine& {
   static thread_local Engine engine(nix::sys_urandom_engine{}());
   return engine;
}

template <typename Distribution, typename Engine>
auto
random_bool() -> bool {
   return Distribution{}(convenience_engine<Engine>());
}

template <typename T>
struct default_random_engine_type {
   using type = pcg_dxsm_engine<uint8>;
};

template <typename T, typename Abi>
struct default_random_engine_type<simd<T, Abi>> {
   using unsigned_type = simd<
      uint_fixed<sizeof(T)>,
      typename Abi::template make_abi_type<uint_fixed<sizeof(T)>>>;
   using type = xoshiro_engine<unsigned_type>;
};

template <typename T>
using default_random_engine = default_random_engine_type<T>::type;

}  // namespace detail

// https://open-std.org/jtc1/sc22/wg21/docs/papers/2025/p3689r0.pdf
template <typename T, typename Engine = detail::default_random_engine<T>>
   requires(is_arithmetic<T> || is_simd_arithmetic<T>)
auto
random(T lower_bound, T upper_bound) -> T {
   if constexpr (is_integral<T> || is_simd_integral<T>) {
      return uniform_int_distribution<T>(lower_bound, upper_bound)(
         detail::convenience_engine<Engine>()
      );
   } else {
      return uniform_float_distribution<T>(lower_bound, upper_bound)(
         detail::convenience_engine<Engine>()
      );
   }
}

template <typename T, typename Engine = detail::default_random_engine<T>>
   requires(is_arithmetic<T> || is_simd_arithmetic<T>)
auto
random() -> T {
   if constexpr (is_simd<T>) {
      using lane_type = T::value_type;
      if constexpr (is_integral<lane_type>) {
         return random<T, Engine>(
            T(limits<lane_type>::min()), T(limits<lane_type>::max())
         );
      } else {
         return random<T, Engine>(T(0), T(1));
      }
   } else if constexpr (is_integral<T>) {
      return random<T, Engine>(limits<T>::min(), limits<T>::max());
   } else {
      return random<T, Engine>(0, 1);
   }
}

template <typename Engine = convenience_random_engine>
auto
random() -> bool {
   return detail::random_bool<bernoulli_distribution<float8>, Engine>();
}

template <
   typename Probability,
   typename Engine = detail::default_random_engine<Probability>>
   requires(
      is_floating_point<Probability> || is_simd_floating_point<Probability>
   )
auto
random(Probability probability) {
   return bernoulli_distribution<Probability>(probability)(
      detail::convenience_engine<Engine>()
   );
}

template <
   is_random_access_collection Range,
   typename Engine = convenience_random_engine>
auto
random(Range&& range) -> decltype(auto) {
   auto position = begin_pos(range);
   auto const stop = end_pos(range);
   iword const count = distance(range, position, stop);
   assert(count > 0);
   iword const offset = random<iword, Engine>(0, count - 1);
   offset_pos(range, position, offset);
   return read_at_unchecked(range, position);
}

template <typename T, typename Engine = convenience_random_engine>
auto
random(initializer_list<T> values) -> T {
   auto position = begin_pos(values);
   auto const stop = end_pos(values);
   iword const count = distance(values, position, stop);
   assert(count > 0);
   offset_pos(values, position, random<iword, Engine>(0, count - 1));
   return read_at_unchecked(values, position);
}

template <typename T, typename Engine = detail::default_random_engine<T>>
   requires(is_arithmetic<T> || is_simd_arithmetic<T>)
auto
randn(T mean = 0, T standard_deviation = 1) -> T {
   return normal_distribution<T>(mean, standard_deviation)(
      detail::convenience_engine<Engine>()
   );
}

template <typename Engine = convenience_random_engine>
void
seed(random_seed value) {
   detail::convenience_engine<Engine>().seed(value);
}

template <typename Engine = convenience_random_engine>
void
seed() {
   detail::convenience_engine<Engine>().seed(nix::sys_urandom_engine{}());
}

