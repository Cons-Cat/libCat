template <typename Generator>
concept is_simd_random_bit_generator =
   is_uniform_random_bit_generator<Generator>
   && is_simd_integral<typename Generator::result_type>;

namespace detail {

template <is_uniform_random_bit_generator Generator>
constexpr auto
random_engine_word(Generator& generator) {
   auto const value = generator();
   auto const minimum = Generator::min();
   return make_unsigned(value - minimum);
}

// Lemire nearly-divisionless mapping of a word into `[0, bound)`.
// The words still come from the caller engine.
//    https://arxiv.org/abs/1805.10941
//    https://dotat.at/@/2020-10-29-nearly-divisionless-random-numbers.html
//    https://dotat.at/@/2023-06-21-pcg64-dxsm.html
template <is_unsigned_integral T, typename Next>
constexpr auto
lemire_bounded(T bound, Next&& next) -> T {
   using raw_type = raw_arithmetic_type<T>;
   raw_type const limit = make_raw_arithmetic(bound);
   raw_type raw = make_raw_arithmetic(next());
   __uint128_t sample = __uint128_t(raw) * __uint128_t(limit);
   uword const shift = sizeof(T) * 8u;
   raw_type frac = raw_type(sample);
   raw_type high = raw_type(sample >> shift);
   if (frac < limit) {
      raw_type const residue = (raw_type(0u) - limit) % limit;
      while (frac < residue) {
         raw = make_raw_arithmetic(next());
         sample = __uint128_t(raw) * __uint128_t(limit);
         frac = raw_type(sample);
         high = raw_type(sample >> shift);
      }
   }
   return T(high);
}

template <is_uniform_random_bit_generator Generator, is_unsigned_integral T>
constexpr auto
random_bounded(Generator& generator, T bound) -> T {
   using unsigned_type = make_unsigned_type<T>;
   unsigned_type const raw_bound = bound;
   if (raw_bound == 0u) {
      return T(random_engine_word(generator));
   }
   return lemire_bounded(raw_bound, [&] {
      return unsigned_type(random_engine_word(generator));
   });
}

template <is_unsigned_integral T>
constexpr auto
random_mix_seed(T value) -> T {
   using raw = raw_arithmetic_type<T>;
   using unsigned_type = make_unsigned_type<raw>;
   unsigned_type mixed = make_raw_arithmetic(value);
   if constexpr (sizeof(unsigned_type) == 8u) {
      mixed += 0x9e3779b9'7f4a7c15ull;
      mixed = (mixed ^ (mixed >> 30u)) * 0xbf58476d'1ce4e5b9ull;
      mixed = (mixed ^ (mixed >> 27u)) * 0x94d049bb'133111ebull;
      mixed ^= mixed >> 31u;
   } else {
      mixed += 0x9e3779b9u;
      mixed = (mixed ^ (mixed >> 16u)) * 0x21f0aaadu;
      mixed = (mixed ^ (mixed >> 15u)) * 0x735a2d97u;
      mixed ^= mixed >> 15u;
   }
   return T(mixed);
}

