template <typename Generator>
concept simd_random_bit_generator =
   is_simd<typename remove_cvref<Generator>::result_type>
   && is_integral<typename remove_cvref<Generator>::result_type::value_type>
   && requires(Generator& generator) { generator(); };

namespace detail {

template <uniform_random_bit_generator Generator>
constexpr auto
random_engine_word(Generator& generator) {
   auto const value = generator();
   auto const minimum = Generator::min();
   return make_unsigned(value - minimum);
}

template <uniform_random_bit_generator Generator, is_unsigned_integral T>
constexpr auto
random_bounded(Generator& generator, T bound) -> T {
   using raw = raw_arithmetic_type<T>;
   using unsigned_type = make_unsigned_type<raw>;
   unsigned_type const raw_bound = make_raw_arithmetic(bound);
   if (raw_bound == 0) {
      return T(random_engine_word(generator));
   }
   unsigned_type const threshold =
      static_cast<unsigned_type>(-raw_bound) % raw_bound;
   while (true) {
      unsigned_type const value =
         static_cast<unsigned_type>(random_engine_word(generator));
      if (value >= threshold) {
         return T(value % raw_bound);
      }
   }
}

template <is_unsigned_integral T>
constexpr auto
random_mix_seed(T value) -> T {
   using raw = raw_arithmetic_type<T>;
   using unsigned_type = make_unsigned_type<raw>;
   unsigned_type mixed = make_raw_arithmetic(value);
   if constexpr (sizeof(unsigned_type) == 8u) {
      mixed += 0x9e3779b9'7f4a7c15ull;
      mixed = (mixed ^ (mixed >> 30u)) * 0xbf58476d'1ce4e5b9ull;
      mixed = (mixed ^ (mixed >> 27u)) * 0x94d049bb'133111ebull;
      mixed ^= mixed >> 31u;
   } else {
      mixed += 0x9e3779b9u;
      mixed = (mixed ^ (mixed >> 16u)) * 0x21f0aaadu;
      mixed = (mixed ^ (mixed >> 15u)) * 0x735a2d97u;
      mixed ^= mixed >> 15u;
   }
   return T(mixed);
}

