#pragma once

#include <cat/bit>
#include <cat/debug>
#include <cat/iterable>
#include <cat/maybe>
#include <cat/span>
#include <cat/vec>

namespace cat {
namespace raii {
template <is_allocator, vec_flags>
class basic_bitvec;
}  // namespace raii

inline namespace manual {

template <vec_flags flags = {}>
class basic_bitvec;

}  // namespace manual

namespace detail {
template <vec_flags flags>
constexpr auto
maybe_bitvec_has_value(basic_bitvec<flags> const& value) -> bool;

template <vec_flags flags>
constexpr auto
maybe_bitvec_nullopt() -> basic_bitvec<flags>;
}  // namespace detail

inline namespace manual {

using bitvec = basic_bitvec<>;

template <idx inline_count = 4u, vec_flags flags = {}>
using small_bitvec = basic_bitvec<
   flags | vec_flags::inline_storage(div_ceil(inline_count, word_bits))>;

template <vec_flags flags>
class [[clang::preferred_name(bitvec), gsl::Owner]]
basic_bitvec : public bit_collection_interface<basic_bitvec<flags>> {
   template <is_allocator, vec_flags>
   friend class cat::raii::basic_bitvec;

 public:
   using storage_type = uword;
   using value_type = bit_value;
   using const_value_type = bit_value const;
   using reference = bit_reference<uword>;
   using const_reference = bit_reference<uword const>;
   using pointer = bit_ptr<uword>;
   using const_pointer = bit_ptr<uword const>;
   using size_type = idx;
   using difference_type = iword;
   using iterator = bit_span<uword>::iterator;
   using const_iterator = bit_span<uword const>::iterator;
   using reverse_iterator = bit_span<uword>::reverse_iterator;
   using const_reverse_iterator = bit_span<uword const>::reverse_iterator;

   // Create an empty manual bit vector without storage.
   constexpr basic_bitvec() = default;
   constexpr basic_bitvec(basic_bitvec&&) = default;
   constexpr basic_bitvec(basic_bitvec const&) = delete (
      "Implicit copying of `cat::basic_bitvec` is forbidden. Call `.clone()` "
      "or move instead!"
   );

   constexpr auto
   operator=(basic_bitvec&&) -> basic_bitvec& = default;
   auto
   operator=(basic_bitvec const&) -> basic_bitvec& =
      delete ("Implicit copying of `cat::basic_bitvec` is forbidden. "
              "Call `.clone()` or move instead!");

   // Return the number of logical bits.
   [[nodiscard]]
   constexpr auto
   size() const -> idx {
      return m_bit_size;
   }

   // Return the number of bits that fit in allocated storage.
   [[nodiscard]]
   constexpr auto
   capacity() const -> idx {
      return m_words.capacity() * word_bits;
   }

   // Return the number of storage words that hold logical bits.
   [[nodiscard]]
   constexpr auto
   word_count() const -> idx {
      return words_for_bits(m_bit_size);
   }

   // Return mutable access to the backing words.
   [[nodiscard]]
   constexpr auto
   data() [[clang::lifetimebound]] -> uword* _Nullable {
      return m_words.data();
   }

   // Return const access to the backing words.
   [[nodiscard]]
   constexpr auto
   data() const [[clang::lifetimebound]] -> uword const* _Nullable {
      return m_words.data();
   }

   // Return a bit iterator to the first logical bit.
   [[nodiscard]]
   constexpr auto
   begin() [[clang::lifetimebound]] {
      return bit_span(*this).begin();
   }

   // Return a bit iterator past the last logical bit.
   [[nodiscard]]
   constexpr auto
   end() [[clang::lifetimebound]] {
      return bit_span(*this).end();
   }

   // Return a const bit iterator to the first logical bit.
   [[nodiscard]]
   constexpr auto
   begin() const [[clang::lifetimebound]] {
      return bit_span<uword const>(data(), 0u, m_bit_size).begin();
   }

   // Return a const bit iterator past the last logical bit.
   [[nodiscard]]
   constexpr auto
   end() const [[clang::lifetimebound]] {
      return bit_span<uword const>(data(), 0u, m_bit_size).end();
   }

   // Return a const bit iterator to the first logical bit.
   [[nodiscard]]
   constexpr auto
   cbegin() const [[clang::lifetimebound]] {
      return begin();
   }

   // Return a const bit iterator past the last logical bit.
   [[nodiscard]]
   constexpr auto
   cend() const [[clang::lifetimebound]] {
      return end();
   }

   // Return a reverse bit iterator to the last logical bit.
   [[nodiscard]]
   constexpr auto
   rbegin() [[clang::lifetimebound]] {
      return bit_span(*this).rbegin();
   }

   // Return a reverse bit iterator before the first logical bit.
   [[nodiscard]]
   constexpr auto
   rend() [[clang::lifetimebound]] {
      return bit_span(*this).rend();
   }

   // Return a const reverse bit iterator to the last logical bit.
   [[nodiscard]]
   constexpr auto
   rbegin() const [[clang::lifetimebound]] {
      return bit_span<uword const>(data(), 0u, m_bit_size).rbegin();
   }

   // Return a const reverse bit iterator before the first logical bit.
   [[nodiscard]]
   constexpr auto
   rend() const [[clang::lifetimebound]] {
      return bit_span<uword const>(data(), 0u, m_bit_size).rend();
   }

   // Return a const reverse bit iterator to the last logical bit.
   [[nodiscard]]
   constexpr auto
   crbegin() const [[clang::lifetimebound]] {
      return bit_span<uword const>(data(), 0u, m_bit_size).crbegin();
   }

   // Return a const reverse bit iterator before the first logical bit.
   [[nodiscard]]
   constexpr auto
   crend() const [[clang::lifetimebound]] {
      return bit_span<uword const>(data(), 0u, m_bit_size).crend();
   }

   constexpr void
   reverse_inplace() {
      bit_span(*this).reverse_inplace();
   }

   // Count the set bits in the vector.
   [[nodiscard]]
   constexpr auto
   popcount() const -> idx {
      return cat::popcount(bit_span<uword const>(data(), 0u, m_bit_size));
   }

   // Return whether exactly one logical bit is set.
   [[nodiscard]]
   constexpr auto
   has_single_bit() const -> bool {
      return popcount() == 1u;
   }

   // Return the number of bits needed to represent the vector.
   [[nodiscard]]
   constexpr auto
   bit_width() const -> idx {
      return idx(m_bit_size - countl_zero());
   }

   // Count clear bits from the first logical bit.
   [[nodiscard]]
   constexpr auto
   countl_zero() const -> idx {
      idx count = 0u;
      for (idx bit_index = 0u; bit_index < m_bit_size; ++bit_index) {
         if ((*this)[bit_index]) {
            break;
         }
         ++count;
      }
      return count;
   }

   // Count set bits from the first logical bit.
   [[nodiscard]]
   constexpr auto
   countl_one() const -> idx {
      idx count = 0u;
      for (idx bit_index = 0u; bit_index < m_bit_size; ++bit_index) {
         if (!(*this)[bit_index]) {
            break;
         }
         ++count;
      }
      return count;
   }

   // Count clear bits from the last logical bit.
   [[nodiscard]]
   constexpr auto
   countr_zero() const -> idx {
      idx count = 0u;
      for (idx bit_index = m_bit_size; bit_index > 0u;) {
         bit_index = idx(bit_index - 1u);
         if ((*this)[bit_index]) {
            break;
         }
         ++count;
      }
      return count;
   }

   // Count set bits from the last logical bit.
   [[nodiscard]]
   constexpr auto
   countr_one() const -> idx {
      idx count = 0u;
      for (idx bit_index = m_bit_size; bit_index > 0u;) {
         bit_index = idx(bit_index - 1u);
         if (!(*this)[bit_index]) {
            break;
         }
         ++count;
      }
      return count;
   }

   // Return whether any logical bit is set.
   [[nodiscard]]
   constexpr auto
   any() const -> bool {
      return popcount() != 0u;
   }

   // Return whether no logical bits are set.
   [[nodiscard]]
   constexpr auto
   none() const -> bool {
      return !any();
   }

   // Return whether every logical bit is set.
   [[nodiscard]]
   constexpr auto
   all() const -> bool {
      return popcount() == m_bit_size;
   }

   // Return a mutable proxy reference to one bit.
   [[nodiscard]]
   constexpr auto
   operator[](idx bit_index) [[clang::lifetimebound]] -> bit_reference<uword> {
      if !consteval {
         assert(bit_index < m_bit_size);
      }
      return make_bit_reference_from_offset(
         m_words[bit_index / word_bits], bit_index % word_bits
      );
   }

   // Return a const proxy reference to one bit.
   [[nodiscard]]
   constexpr auto
   operator[](idx bit_index) const [[clang::lifetimebound]]
   -> bit_reference<uword> {
      return (*unconst(this))[bit_index];
   }

   // Reserve storage for at least the requested bit capacity.
   template <is_allocator Allocator>
   [[nodiscard]]
   constexpr auto
   reserve(allocator_ref<Allocator> allocator, idx bit_capacity)
      -> maybe<void> {
      return m_words.reserve(allocator, words_for_bits(bit_capacity));
   }

   // Reserve storage through a type-erased allocator.
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   reserve(dyn_allocator allocator, idx bit_capacity) -> maybe<void> {
      return reserve<dyn_allocator>(allocator, bit_capacity);
   }

   // Resize the vector and initialize new bits with the requested value.
   template <is_allocator Allocator>
   [[nodiscard]]
   constexpr auto
   resize(
      allocator_ref<Allocator> allocator, idx bit_count, bit_value value = false
   ) -> maybe<void> {
      idx const old_size = m_bit_size;
      idx const old_words = word_count();
      idx const new_words = words_for_bits(bit_count);
      $prop(m_words.resize(allocator, new_words, 0u));
      m_bit_size = bit_count;

      if (value && bit_count > old_size) {
         for (idx bit_index = old_size; bit_index < bit_count; ++bit_index) {
            (*this)[bit_index].set();
         }
      } else if (new_words > old_words) {
         for (idx word_index = old_words; word_index < new_words;
              ++word_index) {
            m_words[word_index] = 0u;
         }
      }

      clear_tail_bits();
      return monostate;
   }

   // Resize the vector through a type-erased allocator.
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   resize(dyn_allocator allocator, idx bit_count, bit_value value = false)
      -> maybe<void> {
      return resize<dyn_allocator>(allocator, bit_count, value);
   }

   // Append one bit to the end.
   template <is_allocator Allocator>
   [[nodiscard]]
   constexpr auto
   push_back(allocator_ref<Allocator> allocator, bit_value value)
      -> maybe<void> {
      idx const bit_index = m_bit_size;
      $prop(resize(allocator, m_bit_size + 1u));
      (*this)[bit_index].assign(value);
      return monostate;
   }

   // Append one bit through a type-erased allocator.
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   push_back(dyn_allocator allocator, bit_value value) -> maybe<void> {
      return push_back<dyn_allocator>(allocator, value);
   }

   template <
      is_allocator Allocator, typename First, typename Second,
      typename... Remaining>
   constexpr auto
   push_back(allocator_ref<Allocator>, First&&, Second&&, Remaining&&...)
      -> maybe<void> = delete (
         "`push_back()` is not variadic! Consider either `emplace_back()` "
         "to construct an element or `append_range()` to "
         "append a range."
      );

   template <typename First, typename Second, typename... Remaining>
   constexpr auto
   push_back(dyn_allocator, First&&, Second&&, Remaining&&...) -> maybe<void> =
      delete ("`push_back()` is not variadic! Consider either `emplace_back()` "
              "to construct an element or `append_range()` to "
              "append a range.");

   // Append every bit-like value of `range` to the end of this bit vector.
   template <is_allocator Allocator, typename Range>
      requires(is_contiguous_iterable<Range> && is_contiguous_bits<Range>)
   [[nodiscard]]
   constexpr auto
   append_range(allocator_ref<Allocator> allocator, Range&& range)
      -> maybe<void> {
      idx const count = idx(range.size());
      if (count == 0u) {
         return monostate;
      }

      idx const old_size = m_bit_size;
      $prop(resize(allocator, old_size + count));

      // Copy `range` to the end.
      for (idx i = 0u; i < count; ++i) {
         bit_value bit;
         bit = range[i];
         (*this)[old_size + i].assign(bit);
      }
      return monostate;
   }

   // Append every bit-like value of `range` to the end of this bit vector.
   template <is_allocator Allocator, is_iterable Iterable>
      requires(!is_contiguous_bits<Iterable> && has_size<Iterable>)
   [[nodiscard]]
   constexpr auto
   append_range(allocator_ref<Allocator> allocator, Iterable&& range)
      -> maybe<void> {
      $prop(reserve(allocator, m_bit_size + idx(range.size())));

      // Append each bit.
      maybe<void> result = monostate;
      auto append = [&](auto&& value) {
         if (!result.has_value()) {
            return;
         }
         bit_value bit;
         bit = value;
         result = push_back(allocator, bit);
      };
      auto context = cat::iterate(range);
      context.run_while([&](auto&& value) -> bool {
         append($fwd(value));
         return true;
      });
      return result;
   }

   // Append every bit-like value of `range` to the end of this bit vector.
   template <is_allocator Allocator, is_iterable Iterable>
      requires(!is_contiguous_bits<Iterable> && !has_size<Iterable>)
   [[nodiscard]]
   constexpr auto
   append_range(allocator_ref<Allocator> allocator, Iterable&& range)
      -> maybe<void> {
      // Append each bit.
      maybe<void> result = monostate;
      auto append = [&](auto&& value) {
         if (!result.has_value()) {
            return;
         }
         bit_value bit;
         bit = value;
         result = push_back(allocator, bit);
      };
      auto context = cat::iterate(range);
      context.run_while([&](auto&& value) -> bool {
         append($fwd(value));
         return true;
      });
      return result;
   }

   // Append every bit-like value of `range` through a type-erased allocator.
   template <is_iterable Iterable>
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   append_range(dyn_allocator allocator, Iterable&& range) -> maybe<void> {
      return append_range<dyn_allocator>(allocator, $fwd(range));
   }

   // Insert every bit-like value of `range` before `position`.
   template <is_allocator Allocator, typename Range>
      requires(is_contiguous_iterable<Range> && is_contiguous_bits<Range>)
   [[nodiscard]]
   constexpr auto
   insert_range(allocator_ref<Allocator> allocator, idx position, Range&& range)
      -> maybe<void> {
      if !consteval {
         assert(position <= m_bit_size);
      }

      idx const count = idx(range.size());
      if (count == 0u) {
         return monostate;
      }

      idx const old_size = m_bit_size;
      $prop(resize(allocator, old_size + count));

      // Move the existing tail.
      for (idx i = old_size; i > position; i = idx(i - 1u)) {
         (*this)[idx(i + count - 1u)].assign((*this)[idx(i - 1u)]);
      }

      // Copy `range` into the gap.
      for (idx i = 0u; i < count; ++i) {
         bit_value bit;
         bit = range[i];
         (*this)[position + i].assign(bit);
      }
      return monostate;
   }

   // Insert every bit-like value of `range` before `position`.
   template <is_allocator Allocator, is_iterable Iterable>
      requires(!is_contiguous_bits<Iterable> && has_size<Iterable>)
   [[nodiscard]]
   constexpr auto
   insert_range(
      allocator_ref<Allocator> allocator, idx position, Iterable&& range
   ) -> maybe<void> {
      if !consteval {
         assert(position <= m_bit_size);
      }

      idx const count = idx(range.size());
      if (count == 0u) {
         return monostate;
      }

      idx const old_size = m_bit_size;
      $prop(resize(allocator, old_size + count));

      // Move the existing tail.
      for (idx i = old_size; i > position; i = idx(i - 1u)) {
         (*this)[idx(i + count - 1u)].assign((*this)[idx(i - 1u)]);
      }

      // Write `range` into the gap.
      idx i = position;
      auto insert = [&](auto&& value) {
         bit_value bit;
         bit = value;
         (*this)[i].assign(bit);
         ++i;
      };
      auto context = cat::iterate(range);
      context.run_while([&](auto&& value) -> bool {
         insert($fwd(value));
         return true;
      });
      return monostate;
   }

   // Insert every bit-like value of `range` before `position`.
   template <is_allocator Allocator, is_iterable Iterable>
      requires(!is_contiguous_bits<Iterable> && !has_size<Iterable>)
   [[nodiscard]]
   constexpr auto
   insert_range(
      allocator_ref<Allocator> allocator, idx position, Iterable&& range
   ) -> maybe<void> {
      if !consteval {
         assert(position <= m_bit_size);
      }
      idx insertion_position = position;
      maybe<void> result = monostate;

      // Insert each bit and grow as needed.
      auto insert = [&](auto&& value) {
         if (!result.has_value()) {
            return;
         }
         idx const old_size = m_bit_size;
         result = resize(allocator, old_size + 1u);
         if (!result.has_value()) {
            return;
         }
         for (idx i = old_size; i > insertion_position; i = idx(i - 1u)) {
            (*this)[i].assign((*this)[idx(i - 1u)]);
         }
         bit_value bit;
         bit = value;
         (*this)[insertion_position].assign(bit);
         ++insertion_position;
      };
      auto context = cat::iterate(range);
      context.run_while([&](auto&& value) -> bool {
         insert($fwd(value));
         return true;
      });
      return result;
   }

   // Insert every bit-like value of `range` before `position`.
   template <is_iterable Iterable>
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   insert_range(dyn_allocator allocator, idx position, Iterable&& range)
      -> maybe<void> {
      return insert_range<dyn_allocator>(allocator, position, $fwd(range));
   }

   // Replace `[first, last)` with every bit-like value of `range`.
   template <is_allocator Allocator, typename Range>
      requires(is_contiguous_iterable<Range> && is_contiguous_bits<Range>)
   [[nodiscard]]
   constexpr auto
   replace_with_range(
      allocator_ref<Allocator> allocator, idx first, idx last, Range&& range
   ) -> maybe<void> {
      if !consteval {
         assert(first <= last);
         assert(last <= m_bit_size);
      }
      idx const count = idx(range.size());
      idx const old_size = m_bit_size;
      idx const removed = idx(last - first);
      idx const new_size = idx(old_size - removed + count);
      idx const tail_size = idx(old_size - last);

      // Move the existing tail.
      if (new_size > old_size) {
         $prop(resize(allocator, new_size));
         for (idx i = tail_size; i > 0u; i = idx(i - 1u)) {
            (*this)[idx(first + count + i - 1u)].assign(
               (*this)[idx(last + i - 1u)]
            );
         }
      } else {
         for (idx i = 0u; i < tail_size; ++i) {
            (*this)[first + count + i].assign((*this)[last + i]);
         }
      }

      // Copy `range` into the gap.
      for (idx i = 0u; i < count; ++i) {
         bit_value bit;
         bit = range[i];
         (*this)[first + i].assign(bit);
      }

      // Resize last when the replacement shrinks.
      if (new_size < old_size) {
         $prop(resize(allocator, new_size));
      }
      return monostate;
   }

   // Replace `[first, last)` with every bit-like value of `range`.
   template <is_allocator Allocator, is_iterable Iterable>
      requires(!is_contiguous_bits<Iterable>)
   [[nodiscard]]
   constexpr auto
   replace_with_range(
      allocator_ref<Allocator> allocator, idx first, idx last, Iterable&& range
   ) -> maybe<void> {
      if !consteval {
         assert(first <= last);
         assert(last <= m_bit_size);
      }

      // Erase the replaced bits.
      idx const old_size = m_bit_size;
      idx const removed = idx(last - first);
      for (idx i = last; i < old_size; ++i) {
         (*this)[idx(i - removed)].assign((*this)[i]);
      }
      $prop(resize(allocator, idx(old_size - removed)));
      return insert_range(allocator, first, $fwd(range));
   }

   // Replace `[first, last)` with every bit-like value of `range`.
   template <is_iterable Iterable>
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   replace_with_range(
      dyn_allocator allocator, idx first, idx last, Iterable&& range
   ) -> maybe<void> {
      return replace_with_range<dyn_allocator>(
         allocator, first, last, $fwd(range)
      );
   }

   // Remove and return the last bit if one exists.
   [[nodiscard]]
   constexpr auto
   pop_back() -> maybe<bit_value> {
      if (m_bit_size == 0u) {
         return nullopt;
      }
      idx const last_bit = idx(m_bit_size - 1u);
      bit_value value;
      value = (*this)[last_bit];
      (*this)[last_bit].assign(false);
      m_bit_size = last_bit;
      clear_tail_bits();
      return value;
   }

   // Free all storage through the supplied allocator.
   template <is_allocator Allocator>
   [[clang::reinitializes]]
   constexpr void
   free(allocator_ref<Allocator> allocator) {
      m_words.free(allocator);
      m_bit_size = 0u;
   }

   // Free all storage through a type-erased allocator.
   [[clang::reinitializes, gnu::always_inline, gnu::nodebug]]
   constexpr void
   free(dyn_allocator allocator) {
      free<dyn_allocator>(allocator);
   }

   // Clear all logical bits while keeping storage.
   constexpr void
   clear() {
      for (idx word_index = 0u; word_index < word_count(); ++word_index) {
         m_words[word_index] = 0u;
      }
   }

   // Set every logical bit to the requested value.
   constexpr auto
   fill(bit_value value = true) -> basic_bitvec& {
      uword const word_value = value ? uword::max() : 0u;
      for (idx word_index = 0u; word_index < word_count(); ++word_index) {
         m_words[word_index] = word_value;
      }
      clear_tail_bits();
      return *this;
   }

   // Set one bit to the requested value.
   constexpr auto
   set(idx bit_index, bit_value value = true) -> basic_bitvec& {
      (*this)[bit_index].assign(value);
      return *this;
   }

   // Reset one bit to false.
   constexpr auto
   reset(idx bit_index) -> basic_bitvec& {
      (*this)[bit_index] = false;
      return *this;
   }

   // Flip one bit in place.
   constexpr auto
   flip(idx bit_index) -> basic_bitvec& {
      (*this)[bit_index].flip();
      return *this;
   }

   // Return whether every set bit is also set in `other`.
   [[nodiscard]]
   constexpr auto
   is_subset_of(basic_bitvec const& other) const -> bool {
      if !consteval {
         assert(m_bit_size == other.m_bit_size);
      }
      for (idx word_index = 0u; word_index < word_count(); ++word_index) {
         uword const extra_bits =
            m_words[word_index] & ~other.m_words[word_index];
         if (extra_bits != 0u) {
            return false;
         }
      }
      return true;
   }

   // Return whether this vector shares any set bit with `other`.
   [[nodiscard]]
   constexpr auto
   intersects(basic_bitvec const& other) const -> bool {
      if !consteval {
         assert(m_bit_size == other.m_bit_size);
      }
      for (idx word_index = 0u; word_index < word_count(); ++word_index) {
         if ((m_words[word_index] & other.m_words[word_index]) != 0u) {
            return true;
         }
      }
      return false;
   }

   // Return whether this vector shares no set bits with `other`.
   [[nodiscard]]
   constexpr auto
   disjoint(basic_bitvec const& other) const -> bool {
      return !intersects(other);
   }

 private:
   template <vec_flags other_flags>
   friend constexpr auto
   detail::maybe_bitvec_has_value(basic_bitvec<other_flags> const&) -> bool;

   template <vec_flags other_flags>
   friend constexpr auto
   detail::maybe_bitvec_nullopt() -> basic_bitvec<other_flags>;

   // Store the bitwise and of two vectors in `result`.
   constexpr auto
   bit_and_into(basic_bitvec const& other, basic_bitvec& result) const
      -> basic_bitvec& {
      if !consteval {
         assert(m_bit_size == other.m_bit_size);
         assert(result.m_bit_size == m_bit_size);
      }
      for (idx word_index = 0u; word_index < word_count(); ++word_index) {
         result.m_words[word_index] =
            m_words[word_index] & other.m_words[word_index];
      }
      return result;
   }

   // Store the bitwise or of two vectors in `result`.
   constexpr auto
   bit_or_into(basic_bitvec const& other, basic_bitvec& result) const
      -> basic_bitvec& {
      if !consteval {
         assert(m_bit_size == other.m_bit_size);
         assert(result.m_bit_size == m_bit_size);
      }
      for (idx word_index = 0u; word_index < word_count(); ++word_index) {
         result.m_words[word_index] =
            m_words[word_index] | other.m_words[word_index];
      }
      result.clear_tail_bits();
      return result;
   }

   // Store the bitwise xor of two vectors in `result`.
   constexpr auto
   bit_xor_into(basic_bitvec const& other, basic_bitvec& result) const
      -> basic_bitvec& {
      if !consteval {
         assert(m_bit_size == other.m_bit_size);
         assert(result.m_bit_size == m_bit_size);
      }
      for (idx word_index = 0u; word_index < word_count(); ++word_index) {
         result.m_words[word_index] =
            m_words[word_index] ^ other.m_words[word_index];
      }
      result.clear_tail_bits();
      return result;
   }

   // Store the bitwise complement of this vector in `result`.
   constexpr auto
   bit_complement_into(basic_bitvec& result) const -> basic_bitvec& {
      if !consteval {
         assert(result.m_bit_size == m_bit_size);
      }
      for (idx word_index = 0u; word_index < word_count(); ++word_index) {
         result.m_words[word_index] = ~m_words[word_index];
      }
      result.clear_tail_bits();
      return result;
   }

   // Return the number of words needed for a bit count.
   [[nodiscard]]
   static constexpr auto
   words_for_bits(idx bit_count) -> idx {
      return div_ceil(bit_count, word_bits);
   }

   // Clear unused bits in the final storage word.
   constexpr void
   clear_tail_bits() {
      idx const words = word_count();
      if (words != 0u) {
         idx const used_bits = m_bit_size % word_bits;
         if (used_bits != 0u) {
            m_words[idx(words - 1u)] &= (1_uz << used_bits) - 1_uz;
         }
      }
   }

   basic_vec<uword, flags> m_words;
   idx m_bit_size = 0u;
};

}  // namespace manual

namespace detail {

template <vec_flags flags>
constexpr auto
maybe_bitvec_has_value(basic_bitvec<flags> const& value) -> bool {
   return maybe_vec_has_value<uword, flags>(value.m_words);
}

template <vec_flags flags>
constexpr auto
maybe_bitvec_nullopt() -> basic_bitvec<flags> {
   basic_bitvec<flags> value;
   value.m_words = maybe_vec_nullopt<uword, flags>();
   return value;
}

}  // namespace detail

template <vec_flags flags>
struct default_compact_trait<basic_bitvec<flags>>
    : identity_trait<compact<
         basic_bitvec<flags>, detail::maybe_bitvec_has_value<flags>,
         detail::maybe_bitvec_nullopt<flags>>> {};

}  // namespace cat
