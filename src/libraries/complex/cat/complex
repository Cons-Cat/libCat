inline namespace arithmetic {
// `cat::complex<T>` is the integer or floating complex of `T`. `T` may be a
// raw component or a `basic_int` / `basic_float`, including one that carries a
// quantity. The policy defaults to that type's overflow or precision policy
// and can be overridden.
template <
   typename T, auto policy = detail::default_complex_policy<remove_cvref<T>>>
using complex = detail::complex_alias<remove_cvref<T>, policy>::type;
