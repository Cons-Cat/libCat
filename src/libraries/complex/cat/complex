namespace detail {

// Default policy for `cat::complex<T>`: the overflow policy `T` already
// carries, or `undefined` for a raw integer; the precision policy `T` already
// carries, or `precise` for a raw float. These are `make_overflow_policy` and
// `make_precision_policy`.
template <typename T>
inline constexpr auto default_complex_policy = [] {
   if constexpr (is_integral<T>) {
      return make_overflow_policy<T>;
   } else {
      return make_precision_policy<T>;
   }
}();

// Quantity embedded in a `basic_int` or `basic_float`, otherwise `scalar`.
template <typename T>
consteval auto
complex_quantity_of() noexcept {
   if constexpr (requires { T::quantity_reference; }) {
      return T::quantity_reference;
   } else {
      return scalar;
   }
}

template <typename T, auto policy>
struct complex_alias {};

template <typename T, auto policy>
   requires(is_integral<T> && is_complex_int_component<raw_arithmetic_type<T>>)
