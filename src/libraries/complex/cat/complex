      raw_arithmetic_type<T>, policy, complex_quantity_of<T>()>;
};

template <typename T, auto policy>
   requires(
      is_floating_point<T> && is_complex_float_component<raw_arithmetic_type<T>>
   )
struct complex_alias<T, policy> {
   using type = basic_complex_float<
      raw_arithmetic_type<T>, policy, complex_quantity_of<T>()>;
