// `cat::basic_complex_int` and `cat::basic_complex_float` are functionally
// equivalent to `std::complex`. They interoperates with C `_Complex` types,
// support both integer and floating-point representation, and provide the
// same overflow and precision policies as `basic_int`/`basic_float`.

namespace cat {

namespace detail {

// Unfortunately, in a template, `_Complex T` is ill-formed, so we have to
// manually spell out every type alternative here.

template <typename T>
struct complex_raw_trait;

template <>
struct complex_raw_trait<__INT8_TYPE__> {
   using type = _Complex __INT8_TYPE__;
};

template <>
struct complex_raw_trait<__UINT8_TYPE__> {
   using type = _Complex __UINT8_TYPE__;
};

template <>
struct complex_raw_trait<__INT16_TYPE__> {
   using type = _Complex __INT16_TYPE__;
};

template <>
struct complex_raw_trait<__UINT16_TYPE__> {
   using type = _Complex __UINT16_TYPE__;
};

template <>
struct complex_raw_trait<__INT32_TYPE__> {
   using type = _Complex __INT32_TYPE__;
};

template <>
struct complex_raw_trait<__UINT32_TYPE__> {
   using type = _Complex __UINT32_TYPE__;
};

template <>
struct complex_raw_trait<__INT64_TYPE__> {
   using type = _Complex __INT64_TYPE__;
};

template <>
struct complex_raw_trait<__UINT64_TYPE__> {
   using type = _Complex __UINT64_TYPE__;
};

template <>
struct complex_raw_trait<float> {
   using type = _Complex float;
};

template <>
struct complex_raw_trait<double> {
   using type = _Complex double;
};

// `_Complex T` for a supported component type `T`.
template <typename T>
using complex_raw = complex_raw_trait<T>::type;

template <typename T>
concept is_complex_int_component = is_either<
   T, __INT8_TYPE__, __UINT8_TYPE__, __INT16_TYPE__, __UINT16_TYPE__,
   __INT32_TYPE__, __UINT32_TYPE__, __INT64_TYPE__, __UINT64_TYPE__>;

template <typename T>
concept is_complex_float_component = is_either<T, float, double>;

template <typename T>
concept is_complex_component =
   is_complex_int_component<T> || is_complex_float_component<T>;

}  // namespace detail

template <
   typename T, overflow_policies = overflow_policies::undefined,
   auto quantity = scalar>
   requires(detail::is_complex_int_component<T>)
class basic_complex_int;

template <
   typename T,
   precision_policies precision_policy = precision_policies::precise,
   auto quantity = scalar>
   requires(detail::is_complex_float_component<T>)
class basic_complex_float;

// Proxy references returned by the policy accessors of `basic_complex_float`
// and `basic_complex_int`, defined in
// <cat/detail/complex_precision_reference.hpp> and
// <cat/detail/complex_overflow_reference.hpp>.
template <typename Complex, precision_policies precision>
class complex_precision_reference;

template <typename Complex, overflow_policies overflow_policy>
class complex_overflow_reference;

namespace detail {
template <typename T>
inline constexpr bool is_complex_reference = false;

// The value a complex proxy reference refers to, with the reference's policy.
// Each reference specializes this.
template <typename T>
struct complex_reference_view_trait;

template <typename T>
using complex_reference_view = complex_reference_view_trait<T>::type;

// Complex proxy references are complex numbers to `cat::is_complex` and the
// `<cat/math>` functions.
template <typename Complex, precision_policies precision>
inline constexpr bool
   is_complex_detail<complex_precision_reference<Complex, precision>> = true;

template <typename Complex, overflow_policies overflow_policy>
inline constexpr bool
   is_complex_detail<complex_overflow_reference<Complex, overflow_policy>> =
      true;
}  // namespace detail

