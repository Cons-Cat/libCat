// Tuple protocol:
// `std::tuple_size`/`tuple_element` for generic code, index access via
// `cat::get()`. Index 0 is the real part and 1 is the imaginary part.
namespace cat::detail {
// A complex proxy reference's elements are its parts' values with the
// reference's policy.
template <typename T>
concept is_complex_tuple = is_basic_complex<__typeof_unqual(T)>
                           || is_complex_reference<__typeof_unqual(T)>;
}  // namespace cat::detail

namespace std {

template <typename T>
   requires(::cat::detail::is_complex_tuple<T>)
// NOLINTNEXTLINE
struct tuple_size<T> : ::cat::constant<2uz> {};

template <__SIZE_TYPE__ index, typename T>
   requires(::cat::detail::is_complex_tuple<T>)
// NOLINTNEXTLINE
struct tuple_element<index, T> {
   static_assert(index < 2u, "Index in a libCat complex is out of bounds!");
   using type =
      ::cat::copy_cv_from<T, typename ::cat::remove_cv<T>::value_type>;
};

