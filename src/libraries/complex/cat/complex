// Structured bindings find this `get` by ADL. The reference category follows
// the argument: lvalue, const lvalue, rvalue, and const rvalue.
template <idx index, typename Complex>
   requires(
      (detail::is_basic_complex<remove_cvref<Complex>>
       || detail::is_complex_reference<remove_cvref<Complex>>)
      && index.raw < 2u
   )
[[nodiscard, gnu::always_inline, gnu::nodebug]]
constexpr auto
get(Complex&& object [[clang::lifetimebound]]) noexcept -> decltype(auto) {
   return $fwd(object).template get<index>();
}

