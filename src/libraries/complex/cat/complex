   using result_quantity = detail::complex_sum_quantity<Left, Right>;
   using raw = detail::complex_common_raw<Left, Right>;
   return detail::complex_in_quantity<raw, result_quantity>(lhs)
          == detail::complex_in_quantity<raw, result_quantity>(rhs);
