// -*- mode: c++ -*-
// vim: set ft=cpp:
#pragma once

// `cat::stacktrace` captures a snapshot of the current thread's call stack by
// walking frame pointers. It is inspired by `std::basic_stacktrace`, but its
// allocator is always explicit. Frames are stored inside the trace until its
// inline storage is exceeded, at which point the trace grows through its
// allocator.
//
// It is primarily useful for printing to users. The default formatter prints it
// in the form:
//    Stack trace:
//    #1 meow.cpp:8 main()
//    #2 _start.cpp:143 _start()
//
// When compiled with debug symbols, it can be formatted with contextual details
// using the `{:?}` format specifier in the form:
// clang-format off
//
// Stack trace:
//    #1 Object "/home/exe/path/meow", at 0x5879ee8880e4, in main()
//       Source "your/src/meow.cpp", line 8, in main()
//          6: main() -> int {
//          7:    cat::page_allocator allocator;
//       >  8:    cat::stacktrace const trace = cat::stacktrace::current(allocator).value();
//          9:    auto _ = cat::print_fmt(allocator, "{:?}\n", trace);
//         10:    // Meow meow meow meow? (transl. Tum ko kya mila?)
//    #2 Object "/home/executable/path/meow", at 0x5879ee892771, in _start()
//       Source "src/libraries/runtime/implementations/_start.cpp", line 143, in _start()
//         141: #endif
//         142: #ifdef CAT_NO_ARGC_ARGV
//       > 143:    int const exit_code = main();
//         144: #else
//         145:    int const argc = static_cast<int>(p_stack[0]);
//
// clang-format on

#include <cat/container>
#include <cat/format>
#include <cat/propagate>
#include <cat/raii_vec>

namespace cat {

class stacktrace_entry {
 public:
   using native_handle_type = void* _Nullable;

   constexpr stacktrace_entry() = default;

   explicit constexpr stacktrace_entry(native_handle_type p_native)
       : m_p_native(p_native) {
   }

   [[nodiscard]]
   constexpr auto
   native_handle() const -> native_handle_type {
      return m_p_native;
   }

   [[nodiscard]]
   constexpr auto
   is_empty() const -> bool {
      return m_p_native == nullptr;
   }

   [[nodiscard]]
   constexpr auto
   operator==(stacktrace_entry const& other) const -> bool = default;

   [[nodiscard]]
   constexpr auto
   operator<=>(stacktrace_entry const&) const = default;

 private:
   native_handle_type m_p_native = nullptr;
};

class stacktrace
    : public container_interface<stacktrace, stacktrace_entry>,
      public random_access_stepanov_iterable_interface<stacktrace_entry> {
 private:
   // Traces this shallow are captured without allocating. Deeper traces grow
   // through the allocator, so this is not a bound on depth.
   static constexpr idx inline_frames = 64u;

   using storage =
      raii::vec_small<stacktrace_entry, dyn_allocator, inline_frames>;

 public:
   constexpr stacktrace() =
      delete ("`cat::stacktrace` cannot be created without an allocator!");

   constexpr explicit stacktrace(dyn_allocator allocator)
       : m_frames(allocator) {
   }

   constexpr stacktrace(stacktrace&&) = default;

   constexpr auto
   operator=(stacktrace&&) -> stacktrace& = default;

   constexpr stacktrace(stacktrace const&) =
      delete ("Implicit copying of `cat::stacktrace` is forbidden. Call "
              "`.clone()` or move instead!");

   auto
   operator=(stacktrace const&)
      -> stacktrace& = delete ("Implicit copying of `cat::stacktrace` is "
                               "forbidden. Call `.clone()` or move instead!");

   // Capture the callers of this function, dropping the innermost `skip`
   // frames and stopping after `max_depth` frames have been stored. By
   // default the whole walkable stack is captured. This fails only when
   // `allocator` cannot store a trace deeper than `inline_frames`.
   [[nodiscard, gnu::noinline, clang::disable_tail_calls]]
   static auto
   current(dyn_allocator allocator, idx skip = 0u, idx max_depth = idx::max())
      -> maybe<stacktrace>;

   [[nodiscard]]
   constexpr auto
   size() const -> idx {
      return m_frames.size();
   }

   // Number of frames this trace can hold before it grows again.
   [[nodiscard]]
   constexpr auto
   capacity() const -> idx {
      return m_frames.capacity();
   }

   // Number of frames a trace can theoretically hold, bounded by the address
   // space rather than any allocator's actual ceiling.
   [[nodiscard]]
   static constexpr auto
   max_size() -> idx {
      return storage::max_size();
   }

   [[nodiscard]]
   constexpr auto
   operator[](idx index) const [[clang::lifetimebound]]
   -> stacktrace_entry const& {
      assert(index < size());
      return m_frames[index];
   }

   [[nodiscard]]
   constexpr auto
   data() [[clang::lifetimebound]] -> stacktrace_entry* _Nullable {
      return m_frames.data();
   }

   [[nodiscard]]
   constexpr auto
   data() const [[clang::lifetimebound]] -> stacktrace_entry const* _Nullable {
      return m_frames.data();
   }

   constexpr void
   swap(stacktrace& other) {
      m_frames.swap(other.m_frames);
   }

   // Deep-copy this trace through its own allocator.
   [[nodiscard]]
   constexpr auto
   clone() const -> maybe<stacktrace> {
      return stacktrace($prop(m_frames.clone()));
   }

   [[nodiscard]]
   constexpr auto
   operator==(stacktrace const& other) const -> bool {
      return m_frames == other.m_frames;
   }

 private:
   constexpr explicit stacktrace(storage&& frames) : m_frames(move(frames)) {
   }

   storage m_frames;
};

namespace detail {

// Mapped executable used to resolve symbols and source lines.
struct symbolizer;

[[nodiscard]]
auto
load_symbolizer() -> symbolizer* _Nullable;

void
unload_symbolizer(symbolizer* _Nullable p_symbolizer);

// What the ELF lookup knows about one frame. `p_function` is the entry point
// of the function that contains the frame, which identifies the frame even
// in a build that carries no DWARF. The strings borrow the mapping, so they
// last only until it is unloaded.
struct frame_origin {
   str_view file;
   uint8 line = 0u;
   str_view symbol;
   void* _Nullable p_function = nullptr;
};

[[nodiscard]]
auto
resolve_stacktrace_frame(
   symbolizer const* _Nullable p_symbolizer, stacktrace_entry entry
) -> frame_origin;

[[nodiscard]]
auto
format_stacktrace_frame(
   symbolizer const* _Nullable p_symbolizer, idx number, stacktrace_entry entry,
   format_context& context, bool debug
) -> scaredy_format<void>;

[[nodiscard]]
auto
format_stacktrace_entry_context(stacktrace_entry entry, format_context& context)
   -> scaredy_format<void>;

[[nodiscard]]
inline auto
format_stacktrace_entry(
   stacktrace_entry entry, format_context& context, bool debug
) -> scaredy_format<void> {
   if (!debug) {
      return format_nested(context, entry.native_handle());
   }
   return format_stacktrace_entry_context(entry, context);
}
}  // namespace detail

template <typename CharT>
   requires(is_same<CharT, char>)
struct formatter<stacktrace_entry, CharT> : debug_formatter<CharT> {
   auto
   format(stacktrace_entry value, format_context& context) const
      -> scaredy_format<void> {
      return detail::format_stacktrace_entry(value, context, this->debug);
   }
};

// Frames are numbered from `#1`, most recent first, across whatever the
// sequence yields, so trimming frames before formatting renumbers the rest.
template <typename Frames>
   requires(
      is_iterable<Frames const>
      && is_same<iterable_value_type<Frames const>, stacktrace_entry>
   )
struct formatter<Frames, char> : debug_formatter<char> {
   auto
   format(Frames const& value, format_context& context) const
      -> scaredy_format<void> {
      scaredy_format<void> result = context.append("Stack trace:\n");
      if (result.is_empty()) {
         return result;
      }

      detail::symbolizer* _Nullable const p_symbolizer =
         detail::load_symbolizer();
      idx number = 0u;
      iterate(value).run_while([&](stacktrace_entry const& entry) -> bool {
         ++number;
         result = detail::format_stacktrace_frame(
            p_symbolizer, number, entry, context, this->debug
         );
         return result.has_value();
      });
      detail::unload_symbolizer(p_symbolizer);
      return result;
   }
};

}  // namespace cat
