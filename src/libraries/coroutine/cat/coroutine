#pragma once

// This file provides low-level standard coroutine support. Coroutines can be
// allocated by `cat::make_coroutine()`, which hooks `operator new` into cat
// allocator machinery. This permits HALO to participate.

#include <cat/allocator>
#include <cat/allocator_parameters>
#include <cat/compare>

// Clang looks up `std::coroutine_traits` and `std::coroutine_handle` by name
// to lower `co_await`, `co_yield`, and `co_return`, so they must live in `std`.
// NOLINTBEGIN(bugprone-std-namespace-modification)

namespace std {

// Find a coroutine's `promise_type` from its signature.
template <typename Return, typename... Args>
struct coroutine_traits {};

template <typename Return, typename... Args>
   requires(requires { typename Return::promise_type; })
struct coroutine_traits<Return, Args...> {
   using promise_type = Return::promise_type;
};

template <typename Promise = void>
struct coroutine_handle;

// A type-erased handle to a coroutine frame.
template <>
struct coroutine_handle<void> {
   constexpr coroutine_handle() noexcept = default;

   constexpr coroutine_handle(typeof(nullptr)) noexcept {
   }

   constexpr auto
   operator=(typeof(nullptr)) noexcept -> coroutine_handle& {
      m_p_frame = nullptr;
      return *this;
   }

   [[nodiscard]]
   constexpr auto
   address() const noexcept -> void* _Nullable {
      return m_p_frame;
   }

   [[nodiscard]]
   static constexpr auto
   from_address(void* _Nullable p_address) noexcept -> coroutine_handle {
      coroutine_handle handle;
      handle.m_p_frame = p_address;
      return handle;
   }

   constexpr explicit
   operator bool() const noexcept {
      return m_p_frame != nullptr;
   }

   // A coroutine is done once it suspends at its final suspend point.
   [[nodiscard]]
   auto
   done() const noexcept -> bool {
      return __builtin_coro_done(m_p_frame);
   }

   void
   operator()() const {
      resume();
   }

   void
   resume() const {
      __builtin_coro_resume(m_p_frame);
   }

   void
   destroy() const {
      __builtin_coro_destroy(m_p_frame);
   }

 private:
   void* _Nullable m_p_frame = nullptr;
};

// Every `coroutine_handle` converts to `coroutine_handle<>`, so these compare
// any two handles by their frames, including `nullptr`.
[[nodiscard]]
constexpr auto
operator==(coroutine_handle<> lhs, coroutine_handle<> rhs) noexcept -> bool {
   return lhs.address() == rhs.address();
}

[[nodiscard]]
constexpr auto
operator<=>(coroutine_handle<> lhs, coroutine_handle<> rhs) noexcept
   -> strong_ordering {
   return lhs.address() <=> rhs.address();
}

// A handle to a coroutine frame whose promise is `Promise`.
template <typename Promise>
struct coroutine_handle {
   constexpr coroutine_handle() noexcept = default;

   constexpr coroutine_handle(typeof(nullptr)) noexcept {
   }

   constexpr auto
   operator=(typeof(nullptr)) noexcept -> coroutine_handle& {
      m_p_frame = nullptr;
      return *this;
   }

   // The promise lives at a fixed offset in its frame.
   [[nodiscard]]
   static auto
   from_promise(Promise& promise) noexcept -> coroutine_handle {
      coroutine_handle handle;
      handle.m_p_frame = __builtin_coro_promise(
         __builtin_addressof(promise), alignof(Promise), true
      );
      return handle;
   }

   [[nodiscard]]
   constexpr auto
   address() const noexcept -> void* _Nullable {
      return m_p_frame;
   }

   [[nodiscard]]
   static constexpr auto
   from_address(void* _Nullable p_address) noexcept -> coroutine_handle {
      coroutine_handle handle;
      handle.m_p_frame = p_address;
      return handle;
   }

   constexpr
   operator coroutine_handle<>() const noexcept {
      return coroutine_handle<>::from_address(m_p_frame);
   }

   constexpr explicit
   operator bool() const noexcept {
      return m_p_frame != nullptr;
   }

   [[nodiscard]]
   auto
   done() const noexcept -> bool {
      return __builtin_coro_done(m_p_frame);
   }

   void
   operator()() const {
      resume();
   }

   void
   resume() const {
      __builtin_coro_resume(m_p_frame);
   }

   void
   destroy() const {
      __builtin_coro_destroy(m_p_frame);
   }

   [[nodiscard]]
   auto
   promise() const -> Promise& {
      return *static_cast<Promise*>(
         __builtin_coro_promise(m_p_frame, alignof(Promise), false)
      );
   }

 private:
   void* _Nullable m_p_frame = nullptr;
};

// The promise of a coroutine that does nothing when resumed or destroyed.
struct noop_coroutine_promise {};

// A noop coroutine is never done, and resuming or destroying it is a no-op.
template <>
struct coroutine_handle<noop_coroutine_promise> {
   constexpr explicit
   operator bool() const noexcept {
      return true;
   }

   [[nodiscard]]
   constexpr auto
   done() const noexcept -> bool {
      return false;
   }

   constexpr void
   operator()() const noexcept {
   }

   constexpr void
   resume() const noexcept {
   }

   constexpr void
   destroy() const noexcept {
   }

   // `__builtin_coro_noop()`'s frame has no storage for a promise, so this
   // returns a promise which lives outside of it. Every noop promise is
   // stateless.
   [[nodiscard]]
   auto
   promise() const noexcept -> noop_coroutine_promise& {
      static constinit noop_coroutine_promise promise;
      return promise;
   }

   [[nodiscard]]
   constexpr auto
   address() const noexcept -> void* _Nonnull {
      return m_p_frame;
   }

   constexpr
   operator coroutine_handle<>() const noexcept {
      return coroutine_handle<>::from_address(m_p_frame);
   }

 private:
   friend auto
   noop_coroutine() noexcept -> coroutine_handle<noop_coroutine_promise>;

   coroutine_handle() noexcept = default;

   void* _Nonnull m_p_frame = __builtin_coro_noop();
};

using noop_coroutine_handle = coroutine_handle<noop_coroutine_promise>;

[[nodiscard]]
inline auto
noop_coroutine() noexcept -> noop_coroutine_handle {
   return {};
}

struct suspend_never {
   [[nodiscard]]
   constexpr auto
   await_ready() const noexcept -> bool {
      return true;
   }

   constexpr void
   await_suspend(coroutine_handle<> /*unused*/) const noexcept {
   }

   constexpr void
   await_resume() const noexcept {
   }
};

struct suspend_always {
   [[nodiscard]]
   constexpr auto
   await_ready() const noexcept -> bool {
      return false;
   }

   constexpr void
   await_suspend(coroutine_handle<> /*unused*/) const noexcept {
   }

   constexpr void
   await_resume() const noexcept {
   }
};

}  // namespace std

