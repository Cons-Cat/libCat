namespace cat {

class native_handle {
 public:
   constexpr native_handle() = default;

   constexpr native_handle(native_handle const&) = default;

   constexpr native_handle(native_handle&& other)
       : m_value(other.m_value), m_disposition(other.m_disposition) {
      other.reset();
   }

   constexpr auto
   operator=(native_handle const&) -> native_handle& = default;

   constexpr auto
   operator=(native_handle&& other) -> native_handle& {
      if (this == __builtin_addressof(other)) {
         return *this;
      }
      m_value = other.m_value;
      m_disposition = other.m_disposition;
      other.reset();
      return *this;
   }

   constexpr auto
   operator==(native_handle const&) const -> bool = default;

   [[nodiscard]]
   explicit constexpr
   operator bool() const {
      return is_valid();
   }

   [[nodiscard]]
   constexpr auto
   is_valid() const -> bool {
      return m_value != -1 && m_disposition != native_handle_disposition::none;
   }

   [[nodiscard]]
   constexpr auto
   is_readable() const -> bool {
      return has(native_handle_disposition::readable);
   }

   [[nodiscard]]
   constexpr auto
   is_writable() const -> bool {
      return has(native_handle_disposition::writable);
   }

   [[nodiscard]]
   constexpr auto
   is_append_only() const -> bool {
      return has(native_handle_disposition::append_only);
   }

   [[nodiscard]]
   constexpr auto
   is_nonblocking() const -> bool {
      return has(native_handle_disposition::nonblocking);
   }

   [[nodiscard]]
   constexpr auto
   is_seekable() const -> bool {
      return has(native_handle_disposition::seekable);
   }

   [[nodiscard]]
   constexpr auto
   is_kernel_handle() const -> bool {
      return has(native_handle_disposition::kernel_handle);
   }

   [[nodiscard]]
   constexpr auto
   is_file() const -> bool {
      return has(native_handle_disposition::file);
   }

   [[nodiscard]]
   constexpr auto
   is_socket() const -> bool {
      return has(native_handle_disposition::socket);
   }

   [[nodiscard]]
   constexpr auto
   disposition() const -> native_handle_disposition {
      return m_disposition;
   }

   constexpr void
   reset() {
      m_value = -1;
      m_disposition = native_handle_disposition::none;
   }

 private:
   friend struct detail::native_handle_access;

   constexpr native_handle(iword value, native_handle_disposition disposition)
       : m_value(value), m_disposition(disposition) {
   }

   [[nodiscard]]
   constexpr auto
   has(native_handle_disposition disposition) const -> bool {
      return (m_disposition & disposition) != native_handle_disposition::none;
   }

   iword m_value = -1;
   native_handle_disposition m_disposition = native_handle_disposition::none;
};

namespace detail {

struct native_handle_access {
   [[nodiscard]]
   static constexpr auto
   make(iword value, native_handle_disposition disposition) -> native_handle {
      return native_handle(value, disposition);
   }

   [[nodiscard]]
   static constexpr auto
   value(native_handle const& handle) -> iword {
      return handle.m_value;
   }
};

}  // namespace detail

}  // namespace cat
