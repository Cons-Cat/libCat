namespace detail {

// The state a flush callback needs to push a chunk into an output iterator.
template <is_allocator Allocator, typename Outputter>
struct format_sink {
   allocator_ref<Allocator> allocator;
   Outputter& output_iterator;
};

// Push one chunk into the output iterator, in bulk where the destination
// supports it.
template <is_allocator Allocator, typename Outputter>
auto
flush_to_outputter(void* _Nonnull p_sink, str_view chunk) -> maybe<void> {
   format_sink<Allocator, Outputter>& sink =
      *static_cast<format_sink<Allocator, Outputter>*>(p_sink);

   if constexpr (requires {
                    get_container(sink.output_iterator)
                       .append_range(sink.allocator, chunk);
                 }) {
      return get_container(sink.output_iterator)
         .append_range(sink.allocator, chunk);
   } else {
      for (char const character : chunk) {
         $prop(sink.output_iterator.insert(sink.allocator, character));
      }
      return monostate;
   }
}
}  // namespace detail

// Format into an output iterator. A contiguous container is formatted into
// in place. Any other output is staged and drained into it in pieces.
template <is_allocator Allocator, typename Outputter>
[[nodiscard]]
auto
vfmt_to(
   allocator_ref<Allocator> allocator [[clang::lifetimebound]],
   Outputter output_iterator, str_view const format,
   detail::format_args<Allocator> arguments
) -> scaredy_format<Outputter> {
   if constexpr (detail::is_format_contiguous_outputter<Outputter, Allocator>) {
      detail::format_container_buffer<
         Allocator, typename Outputter::container_type>
         buffer(allocator, detail::get_container(output_iterator));

      scaredy_format<void> const result =
         vfmt_to_buffer(allocator, buffer, format, arguments);

      maybe<void> const trimmed = buffer.finish();

      if (result.is_empty()) {
         return result.error<format_errors>();
      }

      if (trimmed.is_empty()) {
         return format_errors::out_of_memory;
      }
   } else {
      detail::format_sink<Allocator, Outputter> sink{
         allocator,
         output_iterator,
      };

      scaredy_format<void> const result = vfmt_to_sink(
         allocator, __builtin_addressof(sink),
         &detail::flush_to_outputter<Allocator, Outputter>, format, arguments
      );

      if (result.is_empty()) {
         return result.error<format_errors>();
      }
   }

   return output_iterator;
}

// Format into a `str_vec`, writing straight into its storage.
template <is_allocator Allocator>
[[nodiscard]]
auto
vfmt(
   allocator_ref<Allocator> allocator [[clang::lifetimebound]],
   str_view const format, detail::format_args<Allocator> arguments
) -> scaredy_format<str_vec> {
   str_vec result;
   auto const formatted =
      vfmt_to(allocator, as_back_inserter(result), format, arguments);

   if (formatted.is_empty()) {
      result.free(allocator);
      return formatted.template error<format_errors>();
   }

   return result;
}

template <is_allocator Allocator, typename Outputter, typename... Args>
[[nodiscard]]
