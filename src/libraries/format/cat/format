   basic_dyn_allocator<dyn_reallocate> allocator, Outputter output_iterator,
   str_view const format, detail::format_args arguments
) -> scaredy_format<Outputter> {
   return vfmt_to(allocator_ref(allocator), output_iterator, format, arguments);
}

// Store `arguments` in a compacted variant object. Then format a sequence of
// `char` with those arguments, and push the result into some container.
template <
   is_allocator Allocator, is_output_stepanov_iterator<str_view> Outputter,
   typename... Args>
[[nodiscard]]
auto
fmt_to(
   allocator_ref<Allocator> allocator, Outputter output_iterator,
   str_view const format, Args&&... arguments
) -> scaredy_format<Outputter> {
   (detail::maybe_pull_format_support<Args>(), ...);
   return vfmt_to(
      allocator, output_iterator, format,
      detail::format_args(
         detail::format_args_compact_storage<Args...>($fwd(arguments)...)
      )
   );
}

