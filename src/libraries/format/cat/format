// This represents precisely 16 alternatives to fill 4 bits in
// `format_argument_compact_index`.
enum class [[clang::enum_extensibility(
   closed
)]] format_discriminant : unsigned char {
   automatic_type = 0,  // This type is deduced from a variadic argument.
   // These types are sorted for fast alternative checking.
   int1_type = 1,
   uint1_type = 2,
   int2_type = 3,
   uint2_type = 4,
   int4_type = 5,
   uint4_type = 6,
   int8_type = 7,
   uint8_type = 8,
   idx_type = uint8_type,
   bool_type = 9,
   integer_sentinel = bool_type,  // types less than this are integers.
   float_type = 10,
   double_type = 11,
   float_sentinel = double_type,  // types less than this are floats.
   raw_string_type = 12,
   cat_string_type = 13,
   pointer_type = 14,
   other_type = 15,
};

// Specializations of `format_type_constant` map a type to a
// `format_discriminant`.
struct format_type_constant {
   format_discriminant m_discriminant;

   // Get the discriminant value that represents `T`.
   template <typename T>
   static consteval auto
   alternative() -> format_discriminant {
      format_type_constant type;
      type.template set_alternative<T>();
      return type.m_discriminant;
   }

   // Set this variant to represent `T`.
   template <typename T>
   constexpr void
   set_alternative() {
      using U = remove_cvref<T>;
      if constexpr (is_same<U, int1>) {
         m_discriminant = format_discriminant::int1_type;
      } else if constexpr (is_same<U, int1::raw_type>) {
         m_discriminant = format_discriminant::int1_type;
      } else if constexpr (is_same<U, int2>) {
         m_discriminant = format_discriminant::int2_type;
      } else if constexpr (is_same<U, int2::raw_type>) {
         m_discriminant = format_discriminant::int2_type;
      } else if constexpr (is_same<U, int4>) {
         m_discriminant = format_discriminant::int4_type;
      } else if constexpr (is_same<U, int4::raw_type>) {
         m_discriminant = format_discriminant::int4_type;
      } else if constexpr (is_same<U, int8>) {
         m_discriminant = format_discriminant::int8_type;
      } else if constexpr (is_same<U, int8::raw_type>) {
         m_discriminant = format_discriminant::int8_type;
      } else if constexpr (is_same<U, uint1>) {
         m_discriminant = format_discriminant::uint1_type;
      } else if constexpr (is_same<U, uint1::raw_type>) {
         m_discriminant = format_discriminant::uint1_type;
      } else if constexpr (is_same<U, uint2>) {
         m_discriminant = format_discriminant::uint2_type;
      } else if constexpr (is_same<U, uint2::raw_type>) {
         m_discriminant = format_discriminant::uint2_type;
      } else if constexpr (is_same<U, uint4>) {
         m_discriminant = format_discriminant::uint4_type;
      } else if constexpr (is_same<U, uint4::raw_type>) {
         m_discriminant = format_discriminant::uint4_type;
      } else if constexpr (is_same<U, uint8>) {
         m_discriminant = format_discriminant::uint8_type;
      } else if constexpr (is_same<U, uint8::raw_type>) {
         m_discriminant = format_discriminant::uint8_type;
      } else if constexpr (is_same<U, idx>) {
         m_discriminant = format_discriminant::uint8_type;
      } else if constexpr (is_same<U, bool>) {
         m_discriminant = format_discriminant::bool_type;
      } else if constexpr (is_same<U, float4>) {
         m_discriminant = format_discriminant::float_type;
      } else if constexpr (is_same<U, float4::raw_type>) {
         m_discriminant = format_discriminant::float_type;
      } else if constexpr (is_same<U, float8>) {
         m_discriminant = format_discriminant::double_type;
      } else if constexpr (is_same<U, float8::raw_type>) {
         m_discriminant = format_discriminant::double_type;
      } else if constexpr (is_same<U, char const*>) {
         m_discriminant = format_discriminant::raw_string_type;
      } else if constexpr (is_same<U, str_view>) {
         m_discriminant = format_discriminant::cat_string_type;
      } else if constexpr (is_pointer<U>) {
         m_discriminant = format_discriminant::pointer_type;
      } else {
         m_discriminant = format_discriminant::other_type;
      }
   }
};

// An index into the packed `format_arg_storage`.
struct format_argument_compact_index {
   iword::raw_type m_byte_index               : 60;
   detail::format_discriminant m_discriminant : 4;
};

// This only exists to be passed into the constructor of `format_args`.
template <typename... Types>
class format_args_compact_storage {
 private:
   // For every type passed into the constructor, pack it into the arrays
   // in-order.
   template <typename T>
   void
   store_argument(idx& argument_index, T&& value) {
      iword const storage_index =
         m_arguments_indices[argument_index.raw].m_byte_index;

      void const* const p_value = __builtin_addressof(value);
      copy_memory_scalar(
         __builtin_addressof(p_value),
         &(m_packed_args_storage[0]) + storage_index, sizeof(p_value)
      );
      m_formatters[argument_index.raw] = &format_custom_arg<remove_cvref<T>>;

      // Assign `T` to that storage.
      m_arguments_indices[argument_index.raw].m_discriminant =
         detail::format_type_constant::alternative<T>();

      // Set the byte offset for the next argument if there is another.
      if (argument_index + 1u < sizeof...(Types)) {  // TODO: Explore whether
                                                     // `[[likely]]` improves
                                                     // performance here.
         m_arguments_indices[argument_index.raw + 1].m_byte_index =
            storage_index.raw + sizeof(p_value);
      }

      ++argument_index;
   }

 public:
   static constexpr uword::raw_type argument_count = sizeof...(Types);
   static constexpr uword::raw_type storage_count =
      argument_count == 0 ? 1 : argument_count;

   template <typename... Us>
      requires(sizeof...(Types) == sizeof...(Us))
   format_args_compact_storage(Us&&... arguments) {
      if constexpr (sizeof...(Types) > 0) {
         m_packed_args_storage[0] = {};
         m_arguments_indices[0] = {};
         m_arguments_indices[0].m_byte_index = 0u;
         idx argument_index;
         // `store_argument()` increments `argument_index`.
         (store_argument(argument_index, $fwd(arguments)), ...);
      }
   }

   format_argument_compact_index m_arguments_indices[storage_count];
   format_arg_fn m_formatters[storage_count];
   byte m_packed_args_storage[storage_count * sizeof(void*)];
};

// Formatting arguments are packed into a small type-erased array to conserve
// storage.
struct format_args {
   template <typename... Types>
   explicit constexpr format_args(
      format_args_compact_storage<Types...> const& storage
   )
       : m_p_args_indices(
            sizeof...(Types) > 0 ? &(storage.m_arguments_indices[0]) : nullptr
         ),
         m_p_formatters(
            sizeof...(Types) > 0 ? &(storage.m_formatters[0]) : nullptr
         ),
         m_p_storage(
            sizeof...(Types) > 0 ? &(storage.m_packed_args_storage[0]) : nullptr
         ),
         m_argument_count(storage.argument_count) {
   }

   // Get a formatting argument through its borrowed address.
   template <typename T>
   auto
   get(idx argument_index) const -> T const& {
      // Get the storage index out from the indices array.
      iword const storage_index =
         (m_p_args_indices + argument_index)->m_byte_index;

      byte const* p_data = m_p_storage + storage_index;
      void const* p_argument;
      // NOLINTNEXTLINE `memcpy()` to type pun these pointers.
      __builtin_memcpy_inline(&p_argument, p_data, sizeof(p_argument));
      return *static_cast<T const*>(p_argument);
   }

   format_argument_compact_index const* _Nullable m_p_args_indices;
   format_arg_fn const* _Nullable m_p_formatters;
   byte const* _Nullable m_p_storage;
   uword const m_argument_count;
};

// Drain `chunk` into a type-erased output sink.
using format_flush_fn = auto (*)(void* _Nonnull p_sink, str_view chunk)
   -> maybe<void>;

// The fixed staging buffer used when formatting straight into a sink. It must
// hold the widest single value any formatter reserves contiguously.
constexpr idx format_sink_buffer_size = 256u;

template <is_allocator Allocator>
struct format_buffer : container_interface<format_buffer<Allocator>, char>,
                       random_access_stepanov_iterable_interface<char> {
   format_buffer(
      allocator_ref<Allocator> in_allocator [[clang::lifetimebound]]
      ,
      char* _Nonnull p_in_string, idx in_length, idx in_max_length
   )
       : m_allocator(in_allocator),
         m_p_string(p_in_string),
         m_length(in_length),
         m_max_length(in_max_length) {
   }

   // Construct a buffer that stages into fixed storage and drains into a sink
   // instead of reallocating.
   format_buffer(
      allocator_ref<Allocator> in_allocator [[clang::lifetimebound]]
      ,
      char* _Nonnull p_in_string, idx in_max_length, void* _Nonnull p_in_sink,
      format_flush_fn _Nonnull p_in_flush
   )
       : m_allocator(in_allocator),
         m_p_string(p_in_string),
         m_length(0u),
         m_max_length(in_max_length),
         m_p_sink(p_in_sink),
         m_flush(p_in_flush) {
   }

   [[nodiscard, gnu::returns_nonnull]]
   auto
   data() const -> char* _Nonnull {
      return m_p_string;
   }

   [[nodiscard]]
   auto
   size() const -> idx {
      return m_length;
   }

   [[nodiscard]]
   auto
   capacity() const -> idx {
      return m_max_length;
   }

   [[clang::reinitializes]]
   void
   clear() {
      m_length = 0u;
   }

   // Whether this buffer stages into a sink rather than owning its output.
   [[nodiscard]]
   auto
   has_sink() const -> bool {
      return m_flush != nullptr;
   }

   // Drain staged chars into the sink and reuse the staging storage.
   auto
   flush() -> maybe<void> {
      if (m_length > 0u) {
         $prop(m_flush(m_p_sink, str_view(m_p_string, m_length)));
         m_length = 0u;
      }
      return monostate;
   }

   // Make room for at least `minimum_capacity` chars. A sink-backed buffer
   // drains instead of growing, otherwise the storage doubles to keep
   // amortized appends cheap.
   auto
   reserve(allocator_ref<Allocator>, idx minimum_capacity) -> maybe<void> {
      if (minimum_capacity <= m_max_length) {
         return monostate;
      }
      if (this->has_sink()) {
         $prop(this->flush());
         if (minimum_capacity > m_max_length) {
            return nullopt;
         }
         return monostate;
      }
      idx const doubled_length = m_max_length * 2u;
      idx const new_length =
         minimum_capacity > doubled_length ? minimum_capacity : doubled_length;
      span<char> new_string =
         $prop(m_allocator.template realloc_multi_uninit<char>(
            m_p_string, m_max_length, new_length
         ));
      m_p_string = new_string.data();
      m_max_length = new_length;
      return monostate;
   }

   // Reserve room for `count` more chars and return a pointer to the write
   // position. Digits or bytes can be written directly, then committed.
   auto
   prepare_append(allocator_ref<Allocator> allocator, idx count)
      -> maybe<char*> {
      $prop(reserve(allocator, m_length + count));
      return m_p_string + m_length.raw;
   }

   void
   commit(idx count) {
      m_length += count;
   }

   auto
   push_back(allocator_ref<Allocator> allocator, char character)
      -> maybe<void> {
      $prop(reserve(allocator, m_length + 1u));
      m_p_string[m_length.raw] = character;
      ++m_length;
      return monostate;
   }

   auto
   append(allocator_ref<Allocator> allocator, str_view string) -> maybe<void> {
      if (!this->has_sink()) {
         $prop(reserve(allocator, m_length + string.size()));
         copy_memory(string.data(), m_p_string + m_length.raw, string.size());
         m_length += string.size();
         return monostate;
      }

      // Stage as much as fits, draining whenever the storage fills up, so a
      // string longer than the staging buffer still streams through.
      char const* p_source = string.data();
      idx remaining = string.size();
      while (remaining > 0u) {
         if (m_length == m_max_length) {
            $prop(this->flush());
         }
         idx const free_capacity = idx(m_max_length - m_length);
         idx const count =
            remaining < free_capacity ? remaining : free_capacity;
         copy_memory(p_source, m_p_string + m_length.raw, count);
         m_length += count;
         p_source += count.raw;
         remaining = idx(remaining - count);
      }
      return monostate;
   }

   allocator_ref<Allocator> m_allocator;
   char* _Nonnull m_p_string;
   idx m_length;
   idx m_max_length;
   void* _Nullable m_p_sink = nullptr;
   format_flush_fn _Nullable m_flush = nullptr;
};

