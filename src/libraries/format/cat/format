auto
append_escaped(format_context& context, str_view string, char quote)
   -> scaredy_format<void>;

template <typename Formatter>
constexpr void
maybe_set_debug_format(Formatter& nested, bool set = true) {
   if constexpr (requires { nested.set_debug_format(set); }) {
      nested.set_debug_format(set);
   }
}

template <typename T>
auto
format_nested(format_context& context, T const& value) -> scaredy_format<void> {
   return formatter<remove_cvref<T>>{}.format(value, context);
}

template <typename String>
auto
format_char_string(bool debug, String const& value, format_context& context)
   -> scaredy_format<void> {
   char const* p_data = value.data();
   str_view const string =
      p_data == nullptr ? str_view() : str_view(p_data, value.size());
   if (debug) {
      return append_escaped(context, string, '"');
   }
   return context.append(string);
}

// Format an arithmetic value straight into the output buffer, avoiding a
// temporary allocation and an extra copy. This mirrors `{fmt}`, which writes
// digits directly into its output.
template <typename T>
auto
append_arithmetic(format_context& context, T value) -> scaredy_format<void> {
   format_buffer<basic_dyn_allocator<dyn_reallocate>>& buffer =
      context.buffer();

   idx max_size;
   if constexpr (is_floating_point<T>) {
      max_size = float_to_chars_max_size<T>();
   } else {
      // Room for every decimal digit, a sign, and slack.
      max_size = idx(limits<T>::digits10) + 3u;
   }

   maybe<char*> tail = buffer.prepare_append(context.allocator, max_size);
   if (tail.is_empty()) {
      return format_errors::out_of_memory;
   }

   char* const p_begin = tail.value();
   char* p_end;
   if constexpr (is_floating_point<T>) {
      p_end = dragonbox::to_chars(value, p_begin);
   } else if constexpr (is_same<T, int4::raw_type>) {
      p_end = i32toa_jeaiii(value, p_begin);
   } else if constexpr (is_same<T, uint4::raw_type>) {
      p_end = u32toa_jeaiii(value, p_begin);
   } else if constexpr (is_same<T, int8::raw_type>) {
      p_end = i64toa_jeaiii(value, p_begin);
   } else if constexpr (is_same<T, uint8::raw_type>) {
      p_end = u64toa_jeaiii(value, p_begin);
   } else {
      __builtin_unreachable();
   }

   buffer.commit(idx(p_end - p_begin));
   return monostate;
}
}  // namespace detail

template <typename T, typename CharT>
struct formatter : formatter_base<CharT> {
   auto
   format(T const&, format_context&) const -> scaredy_format<void> {
      return format_errors::cannot_format_argument;
   }
};

template <typename T, typename CharT>
   requires(
      is_integral<T> && !is_same<remove_cvref<T>, bool>
      && !is_same<remove_cvref<T>, char> && is_same<CharT, char>
   )
struct formatter<T, CharT> : formatter_base<CharT> {
   auto
   format(T const& value, format_context& context) const
      -> scaredy_format<void> {
      detail::pull_integer_format_support();
      auto const raw = make_raw_arithmetic(value);
      using raw_type = remove_cvref<decltype(raw)>;
      if constexpr (sizeof(raw_type) < sizeof(int4::raw_type)) {
         if constexpr (is_signed<raw_type>) {
            return detail::append_arithmetic(
               context, static_cast<int4::raw_type>(raw)
            );
         } else {
            return detail::append_arithmetic(
               context, static_cast<uint4::raw_type>(raw)
            );
         }
      } else {
         return detail::append_arithmetic(context, raw);
      }
   }
};

