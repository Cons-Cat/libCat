template <typename T, typename CharT>
struct formatter : formatter_base<CharT> {
   template <is_allocator Allocator>
   auto
   format(
      allocator_ref<Allocator> /*unused*/, T const& /*unused*/,
      format_context /*unused*/
   ) const -> scaredy_format<void> {
      return format_errors::cannot_format_argument;
   }

   auto
   format(allocator_dyn allocator, T const& value, format_context context) const
      -> scaredy_format<void> {
      return format<allocator_dyn>(allocator, value, context);
   }
};

namespace detail {

template <is_allocator Allocator, typename T>
auto
format_custom_arg(
   allocator_ref<Allocator> allocator, format_context context,
   format_args<Allocator> const& arguments, idx argument_index,
   format_parse_context& parse_context
) -> scaredy_format<void> {
   formatter<T> value_formatter{};

   if constexpr (requires { value_formatter.parse(parse_context); }) {
      scaredy_format<format_parse_context::const_iterator> const parse_result =
         value_formatter.parse(parse_context);
      if (parse_result.is_empty()) {
         return parse_result.template error<format_errors>();
      }

      parse_context.advance_to(parse_result.value());
   } else {
      format_parse_context::const_iterator const p_it = parse_context.begin();

      if (p_it == parse_context.end() || *p_it != '}') {
         return format_errors::unknown_format_specifier;
      }
   }

   return value_formatter.format(
      allocator, arguments.template get<T>(argument_index), context
   );
}

