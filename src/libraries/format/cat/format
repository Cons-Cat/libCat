// This represents precisely 16 alternatives to fill 4 bits in
// `format_argument_compact_index`.
enum class [[clang::enum_extensibility(
   closed
)]] format_discriminant : unsigned char {
   automatic_type = 0,  // This type is deduced from a variadic argument.
   // These types are sorted for fast alternative checking.
   int1_type = 1,
   uint1_type = 2,
   int2_type = 3,
   uint2_type = 4,
   int4_type = 5,
   uint4_type = 6,
   int8_type = 7,
   uint8_type = 8,
   idx_type = uint8_type,
   bool_type = 9,
   integer_sentinel = bool_type,  // types less than this are integers.
   float_type = 10,
   double_type = 11,
   float_sentinel = double_type,  // types less than this are floats.
   raw_string_type = 12,
   cat_string_type = 13,
   pointer_type = 14,
   other_type = 15,
};

// Specializations of `format_type_constant` map a type to a
// `format_discriminant`.
struct format_type_constant {
   format_discriminant m_discriminant;

   // Get the discriminant value that represents `T`.
   template <typename T>
   static consteval auto
   alternative() -> format_discriminant {
      format_type_constant type;
      type.template set_alternative<T>();
      return type.m_discriminant;
   }

   // Set this variant to represent `T`.
   template <typename T>
   constexpr void
   set_alternative() {
      using unqualified = remove_cvref<T>;
      if constexpr (is_same<unqualified, int1>) {
         m_discriminant = format_discriminant::int1_type;
      } else if constexpr (is_same<unqualified, int1::raw_type>) {
         m_discriminant = format_discriminant::int1_type;
      } else if constexpr (is_same<unqualified, int2>) {
         m_discriminant = format_discriminant::int2_type;
      } else if constexpr (is_same<unqualified, int2::raw_type>) {
         m_discriminant = format_discriminant::int2_type;
      } else if constexpr (is_same<unqualified, int4>) {
         m_discriminant = format_discriminant::int4_type;
      } else if constexpr (is_same<unqualified, int4::raw_type>) {
         m_discriminant = format_discriminant::int4_type;
      } else if constexpr (is_same<unqualified, int8>) {
         m_discriminant = format_discriminant::int8_type;
      } else if constexpr (is_same<unqualified, int8::raw_type>) {
         m_discriminant = format_discriminant::int8_type;
      } else if constexpr (is_same<unqualified, uint1>) {
         m_discriminant = format_discriminant::uint1_type;
      } else if constexpr (is_same<unqualified, uint1::raw_type>) {
         m_discriminant = format_discriminant::uint1_type;
      } else if constexpr (is_same<unqualified, uint2>) {
         m_discriminant = format_discriminant::uint2_type;
      } else if constexpr (is_same<unqualified, uint2::raw_type>) {
         m_discriminant = format_discriminant::uint2_type;
      } else if constexpr (is_same<unqualified, uint4>) {
         m_discriminant = format_discriminant::uint4_type;
      } else if constexpr (is_same<unqualified, uint4::raw_type>) {
         m_discriminant = format_discriminant::uint4_type;
      } else if constexpr (is_same<unqualified, uint8>) {
         m_discriminant = format_discriminant::uint8_type;
      } else if constexpr (is_same<unqualified, uint8::raw_type>) {
         m_discriminant = format_discriminant::uint8_type;
      } else if constexpr (is_same<unqualified, idx>) {
         m_discriminant = format_discriminant::uint8_type;
      } else if constexpr (is_same<unqualified, bool>) {
         m_discriminant = format_discriminant::bool_type;
      } else if constexpr (is_same<unqualified, float4>) {
         m_discriminant = format_discriminant::float_type;
      } else if constexpr (is_same<unqualified, float4::raw_type>) {
         m_discriminant = format_discriminant::float_type;
      } else if constexpr (is_same<unqualified, float8>) {
         m_discriminant = format_discriminant::double_type;
      } else if constexpr (is_same<unqualified, float8::raw_type>) {
         m_discriminant = format_discriminant::double_type;
      } else if constexpr (is_same<unqualified, char const*>) {
         m_discriminant = format_discriminant::raw_string_type;
      } else if constexpr (is_same<unqualified, char8_t const*>) {
         m_discriminant = format_discriminant::raw_string_type;
      } else if constexpr (
         is_same<unqualified, str_view> || is_same<unqualified, u8str_view>
      ) {
         m_discriminant = format_discriminant::cat_string_type;
      } else if constexpr (is_pointer<unqualified>) {
         m_discriminant = format_discriminant::pointer_type;
      } else {
         m_discriminant = format_discriminant::other_type;
      }
   }
};

// An index into the packed `format_arg_storage`.
struct [[gnu::gcc_struct]] format_argument_compact_index {
   iword::raw_type m_byte_index               : 60;
   detail::format_discriminant m_discriminant : 4;
};

static_assert(sizeof(format_argument_compact_index) == 8);

// This only exists to be passed into the constructor of `format_args`.
template <is_allocator Allocator, typename... Types>
class format_args_compact_storage {
 private:
   // For every type passed into the constructor, pack it into the arrays
   // in-order.
   template <typename T>
   void
   store_argument(idx& argument_index, T&& value) {
      iword const storage_index =
         m_arguments_indices[argument_index.raw].m_byte_index;

      void const* const p_value = __builtin_addressof(value);
      copy_memory_scalar(
         __builtin_addressof(p_value),
         &(m_packed_args_storage[0]) + storage_index, sizeof(p_value)
      );
      m_formatters[argument_index.raw] =
         &format_custom_arg<Allocator, remove_cvref<T>>;

      // Assign `T` to that storage.
      m_arguments_indices[argument_index.raw].m_discriminant =
         detail::format_type_constant::alternative<T>();

      // Set the byte offset for the next argument if there is another.
      if (argument_index + 1u < sizeof...(Types)) {  // TODO: Explore whether
                                                     // `[[likely]]` improves
                                                     // performance here.
         m_arguments_indices[argument_index.raw + 1].m_byte_index =
            storage_index.raw + sizeof(p_value);
      }

      ++argument_index;
   }

 public:
   static constexpr uword::raw_type argument_count = sizeof...(Types);
   static constexpr uword::raw_type storage_count =
      argument_count == 0 ? 1 : argument_count;

   template <typename... Us>
      requires(sizeof...(Types) == sizeof...(Us))
   format_args_compact_storage(Us&&... arguments [[clang::lifetimebound]]) {
      if constexpr (sizeof...(Types) > 0) {
         m_packed_args_storage[0] = {};
         m_arguments_indices[0] = {};
         m_arguments_indices[0].m_byte_index = 0u;
         idx argument_index;
         // `store_argument()` increments `argument_index`.
         (store_argument(argument_index, $fwd(arguments)), ...);
      }
   }

   format_argument_compact_index m_arguments_indices[storage_count];
   format_arg_fn<Allocator> m_formatters[storage_count];
   byte m_packed_args_storage[storage_count * sizeof(void*)];
};

// Formatting arguments are packed into a small type-erased array to conserve
// storage.
template <is_allocator Allocator>
struct format_args {
   template <typename... Types>
   explicit constexpr format_args(
      format_args_compact_storage<Allocator, Types...> const& storage
      [[clang::lifetimebound]]
   )
       : m_p_args_indices(
            sizeof...(Types) > 0 ? &(storage.m_arguments_indices[0]) : nullptr
         ),
         m_p_formatters(
            sizeof...(Types) > 0 ? &(storage.m_formatters[0]) : nullptr
         ),
         m_p_storage(
            sizeof...(Types) > 0 ? &(storage.m_packed_args_storage[0]) : nullptr
         ),
         m_argument_count(storage.argument_count) {
   }

   // Get a formatting argument through its borrowed address.
   template <typename T>
   auto
   get(idx argument_index) const -> T const& {
      // Get the storage index out from the indices array.
      iword const storage_index =
         (m_p_args_indices + argument_index)->m_byte_index;

      byte const* p_data = m_p_storage + storage_index;
      void const* p_argument;
      // NOLINTNEXTLINE `memcpy()` to type pun these pointers.
      __builtin_memcpy_inline(&p_argument, p_data, sizeof(p_argument));

      return *static_cast<T const*>(p_argument);
   }

   format_argument_compact_index const* _Nullable m_p_args_indices;
   format_arg_fn<Allocator> const* _Nullable m_p_formatters;
   byte const* _Nullable m_p_storage;
   uword const m_argument_count;
};

// Drain `chunk` into a type-erased output sink.
using format_flush_fn = auto (*)(void* _Nonnull p_sink, str_view chunk)
   -> maybe<void>;

using format_grow_fn = auto (*)(format_buffer& buffer, idx minimum_capacity)
   -> maybe<void>;

struct format_buffer : container_interface<format_buffer, char>,
                       random_access_stepanov_iterable_interface<char> {
#pragma clang diagnostic push
   // Functions have static lifetime, so `p_in_grow` cannot dangle.
#pragma clang diagnostic ignored \
   "-Wlifetime-safety-intra-tu-constructor-suggestions"

   format_buffer(
      char* _Nullable p_in_string [[clang::lifetimebound]]
      ,
      idx in_length, idx in_max_length, format_grow_fn _Nonnull p_in_grow
   )
       : m_p_string(p_in_string),
         m_length(in_length),
         m_max_length(in_max_length),
         m_grow(p_in_grow) {
   }

#pragma clang diagnostic pop

   format_buffer(format_buffer const&) = delete;
   auto
   operator=(format_buffer const&) -> format_buffer& = delete;

   [[nodiscard]]
   auto
   data() const [[clang::lifetimebound]] -> char* _Nullable {
      return m_p_string;
   }

   [[nodiscard]]
   auto
   size() const -> idx {
      return m_length;
   }

   [[nodiscard]]
   auto
   capacity() const -> idx {
      return m_max_length;
   }

   [[clang::reinitializes]]
   void
   clear() {
      m_length = 0u;
   }

   // Make room for `count` more contiguous chars.
   auto
   make_room(idx count) -> maybe<void> {
      if (count > idx(m_max_length - m_length)) {
         $prop(m_grow(*this, m_length + count));
         if (count > idx(m_max_length - m_length)) {
            return nullopt;
         }
      }
      return monostate;
   }

   // Reserve room for `count` more chars and return a pointer to the write
   // position. Digits or bytes can be written directly, then committed.
   auto
   prepare_append(idx count) [[clang::lifetimebound]] -> maybe<char*> {
      $prop(make_room(count));
      return m_p_string + m_length.raw;
   }

   void
   commit(idx count) {
      m_length += count;
   }

   auto
   push_back(char character) -> maybe<void> {
      $prop(make_room(1u));
      m_p_string[m_length.raw] = character;
      ++m_length;
      return monostate;
   }

   auto
   append(str_view string) -> maybe<void> {
      char const* p_source = string.data();
      idx remaining = string.size();

      while (remaining > 0u) {
         if (remaining > idx(m_max_length - m_length)) {
            $prop(m_grow(*this, m_length + remaining));
         }

         idx const free_capacity = idx(m_max_length - m_length);
         if (free_capacity == 0u) {
            return nullopt;
         }

         idx const count =
            remaining < free_capacity ? remaining : free_capacity;

         copy_memory(p_source, m_p_string + m_length, count);

         m_length += count;
         p_source += count;
         remaining = idx(remaining - count);
      }

      return monostate;
   }

   char* _Nullable m_p_string;
   idx m_length;
   idx m_max_length;
   format_grow_fn _Nonnull m_grow;
};

struct format_sink_buffer : format_buffer {
#pragma clang diagnostic push
   // Functions have static lifetime, so `p_in_flush` cannot dangle.
#pragma clang diagnostic ignored \
   "-Wlifetime-safety-intra-tu-constructor-suggestions"

   format_sink_buffer(
      void* _Nonnull p_in_sink [[clang::lifetimebound]],
      format_flush_fn _Nonnull p_in_flush
   )
       : format_buffer(m_storage, 0u, 256u, &format_sink_buffer::grow),
         m_p_sink(p_in_sink),
         m_flush(p_in_flush) {
   }

#pragma clang diagnostic pop

   auto
   flush() -> maybe<void> {
      if (m_length > 0u) {
         $prop(m_flush(m_p_sink, str_view(m_storage, m_length)));
         m_length = 0u;
      }
      return monostate;
   }

   // The size 256 bytes is borrowed from libfmt. Their number came from much
   // experimentation.
   char m_storage[256];
   void* _Nonnull m_p_sink;
   format_flush_fn _Nonnull m_flush;

 private:
   static auto
   grow(format_buffer& buffer, idx /*unused*/) -> maybe<void> {
      return static_cast<format_sink_buffer&>(buffer).flush();
   }
};

template <is_allocator Allocator>
struct format_memory_buffer : format_buffer {
   explicit format_memory_buffer(
      allocator_ref<Allocator> in_allocator [[clang::lifetimebound]]
   )
       : format_buffer(m_storage, 0u, 500u, &format_memory_buffer::grow),
         m_allocator(in_allocator) {
   }

   ~format_memory_buffer() {
      if (m_p_string != m_storage) {
         m_allocator.free(span(m_p_string, m_max_length));
      }
   }

   // The size 500 bytes is borrowed from libfmt. Their number came from much
   // experimentation.
   char m_storage[500];
   allocator_ref<Allocator> m_allocator;

 private:
   static auto
   grow(format_buffer& buffer, idx minimum_capacity) -> maybe<void> {
      format_memory_buffer& self = static_cast<format_memory_buffer&>(buffer);
      idx const doubled_capacity = self.m_max_length * 2u;
      idx const new_capacity = minimum_capacity > doubled_capacity
                                  ? minimum_capacity
                                  : doubled_capacity;

      char* p_new_string;
      if (self.m_p_string == self.m_storage) {
         p_new_string =
            $prop(
               self.m_allocator.template alloc_multi_uninit<char>(new_capacity)
            )
               .data();

         copy_memory(self.m_storage, p_new_string, self.m_length);
      } else {
         p_new_string =
            $prop(self.m_allocator.template realloc_multi_uninit<char>(
                     self.m_p_string, self.m_max_length, new_capacity
                  ))
               .data();
      }

      self.m_p_string = p_new_string;
      self.m_max_length = new_capacity;
      return monostate;
   }
};

template <is_allocator Allocator, typename Container>
struct format_container_buffer : format_buffer {
   format_container_buffer(
      allocator_ref<Allocator> in_allocator [[clang::lifetimebound]],
      Container& in_container [[clang::lifetimebound]]
   )
       : format_buffer(
            in_container.data(), in_container.size(), in_container.size(),
            &format_container_buffer::grow
         ),
         m_allocator(in_allocator),
         m_container(in_container) {
   }

   // Trim `Container` to the chars written.
   [[nodiscard]]
   auto
   finish() -> maybe<void> {
      return m_container.resize(m_allocator, m_length);
   }

   allocator_ref<Allocator> m_allocator;
   Container& m_container;

 private:
   static auto
   grow(format_buffer& buffer, idx minimum_capacity) -> maybe<void> {
      format_container_buffer& self =
         static_cast<format_container_buffer&>(buffer);

      // TODO: These need a `resize_uninit()` that does not fill the chars
      // that formatting overwrites.
      $prop(self.m_container.resize(self.m_allocator, minimum_capacity));
      $prop(
         self.m_container.resize(self.m_allocator, self.m_container.capacity())
      );

      self.m_p_string = self.m_container.data();
      self.m_max_length = self.m_container.size();
      return monostate;
   }
};

// Whether `Outputter` appends to a contiguous container of `char` that
// `format_container_buffer` can format into directly.
template <typename Outputter, typename Allocator>
concept is_format_contiguous_outputter =
   is_same<
      Outputter,
      back_insert_stepanov_iterator<typename Outputter::container_type>>
   && is_same<typename Outputter::container_type::value_type, char>
   && requires(
      Outputter::container_type& container,
      allocator_ref<Allocator> allocator [[clang::lifetimebound]]
   ) {
         container.resize(allocator, idx());
         container.data();
         container.capacity();
      };

