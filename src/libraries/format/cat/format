struct format_context {
   detail::format_buffer& output;

   [[nodiscard]]
   auto
   buffer() const -> detail::format_buffer& {
      return output;
   }

   auto
   append(char character) const -> scaredy_format<void> {
      if (output.push_back(character).is_empty()) {
         return format_errors::out_of_memory;
      }
      return monostate;
   }

   auto
   append(str_view string) const -> scaredy_format<void> {
      if (output.append(string).is_empty()) {
         return format_errors::out_of_memory;
      }
      return monostate;
   }
};

