template <is_allocator Allocator>
[[nodiscard]]
auto
vfmt_to_buffer(
   allocator_ref<Allocator> allocator, detail::format_buffer& buffer,
   str_view format, detail::format_args<Allocator> arguments
) -> scaredy_format<void> {
   return detail::parse_format_string(
      allocator, format_context{.output = buffer}, format, arguments
   );
}

// Format straight into a sink, staged through a fixed buffer.
template <is_allocator Allocator>
[[nodiscard]]
auto
vfmt_to_sink(
   allocator_ref<Allocator> allocator, void* _Nonnull p_sink,
   detail::format_flush_fn _Nonnull p_flush, str_view format,
   detail::format_args<Allocator> arguments
) -> scaredy_format<void> {
   detail::format_sink_buffer buffer(p_sink, p_flush);
   scaredy_format<void> result =
      vfmt_to_buffer(allocator, buffer, format, arguments);

   if (result.is_empty()) {
      return result;
   }

   if (buffer.flush().is_empty()) {
      return format_errors::out_of_memory;
   }

   return monostate;
}

// Format to `stdout` through one buffer, so that it prints with a single
// write.
template <is_allocator Allocator>
[[nodiscard]]
auto
vprint_fmt(
   allocator_ref<Allocator> allocator [[clang::lifetimebound]], str_view format,
   detail::format_args<Allocator> arguments
) -> maybe<idx> {
   detail::format_memory_buffer<Allocator> buffer{allocator};
   if (vfmt_to_buffer(allocator, buffer, format, arguments).is_empty()) {
      return nullopt;
   }
   return print(str_view(buffer.m_p_string, buffer.size()));
}

