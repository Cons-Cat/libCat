};

template <typename... Types, typename CharT>
struct formatter<tuple<Types...>, CharT> : formatter_base<CharT> {
 private:
   tuple<formatter<Types>...> m_underlying;

   template <idx... indices>
   constexpr void
   set_element_debug_format(index_list_type<indices...> /*unused*/, bool set) {
      auto set_one = [&]<idx index> {
         detail::maybe_set_debug_format(
            m_underlying.template get<index>(), set
         );
      };
      (set_one.template operator()<indices>(), ...);
   }

   template <idx... indices>
   auto
   format_elements(
      tuple<Types...> const& value, format_context& context,
      index_list_type<indices...>
      /*unused*/
   ) const -> scaredy_format<void> {
      scaredy_format<void> result = monostate;
      auto format_one = [&]<idx index> {
         if (result.is_empty()) {
            return;
         }
         if constexpr (index != 0u) {
            result = context.append(", ");
         }
         if (!result.is_empty()) {
            result = m_underlying.template get<index>().format(
               value.template get<index>(), context
            );
         }
      };
      (format_one.template operator()<indices>(), ...);
      return result;
   }

 public:
   constexpr void
   set_debug_format(bool set = true) {
      set_element_debug_format(index_sequence_over_types<Types...>{}, set);
   }

   constexpr auto
   parse(format_parse_context& context)
      -> scaredy_format<format_parse_context::const_iterator> {
      scaredy_format<format_parse_context::const_iterator> result =
         formatter_base<CharT>::parse(context);
      if (result.is_empty()) {
         return result;
      }
      set_debug_format();
      return result;
   }

   auto
   format(tuple<Types...> const& value, format_context& context) const
      -> scaredy_format<void> {
      scaredy_format<void> result = context.append('(');
      if (result.is_empty()) {
         return result;
      }
      result =
         format_elements(value, context, index_sequence_over_types<Types...>{});
      if (result.is_empty()) {
         return result;
      }
      return context.append(')');
   }
};

template <typename... Types, typename CharT>
struct formatter<variant<Types...>, CharT> : formatter_base<CharT> {
 private:
   template <idx index = 0u>
   static auto
   format_active(variant<Types...> const& value, format_context& context)
      -> scaredy_format<void> {
      if constexpr (index < sizeof...(Types)) {
         if (value.holds_alternative(index)) {
            return detail::format_nested(context, value.template get<index>());
         }
         return format_active<index + 1u>(value, context);
      } else {
         return format_errors::cannot_format_argument;
      }
   }

 public:
   auto
   format(variant<Types...> const& value, format_context& context) const
      -> scaredy_format<void> {
      if (value.is_empty()) {
         return context.append("<empty>");
      }
      return format_active(value, context);
   }
};

namespace detail {
template <typename T>
auto
format_custom_arg(
   allocator_ref<basic_dyn_allocator<dyn_reallocate>> allocator,
   format_contiguous_output_iterator<basic_dyn_allocator<dyn_reallocate>>&
      output,
   format_args const& arguments, idx argument_index,
   format_parse_context& parse_context
) -> scaredy_format<void> {
   formatter<T> value_formatter{};
   if constexpr (requires { value_formatter.parse(parse_context); }) {
      scaredy_format<format_parse_context::const_iterator> const parse_result =
         value_formatter.parse(parse_context);
      if (parse_result.is_empty()) {
         return parse_result.template error<format_errors>();
      }
      parse_context.advance_to(parse_result.value());
   } else {
      format_parse_context::const_iterator const it = parse_context.begin();
      if (it == parse_context.end() || *it != '}') {
         return format_errors::unknown_format_specifier;
      }
   }

   format_context context{.allocator = allocator, .output = output};
   return value_formatter.format(
      arguments.template get<T>(argument_index), context
   );
}
