// Get the upper bound buffer size for a stringified floating point type.
namespace detail {
template <typename T>
   requires(is_floating_point<T>)
[[nodiscard]]
constexpr auto
float_to_chars_max_size() -> idx {
   if constexpr (sizeof(T) == 4u) {
      return 16u;
   } else {
      return 25u;
   }
}
}  // namespace detail

// Erase the type of `cat::basic_int` from redundant template instantiations.
template <is_allocator Allocator, is_integral T, overflow_policies policy>
[[nodiscard]]
auto
to_chars(allocator_ref<Allocator> allocator, basic_int<T, policy> numeral)
   -> maybe<str_view> {
   return to_chars(allocator, make_raw_arithmetic(numeral));
}

template <is_integral T, overflow_policies policy>
[[nodiscard, gnu::always_inline, gnu::nodebug]]
inline auto
to_chars(dyn_allocator allocator, basic_int<T, policy> numeral)
   -> maybe<str_view> {
   return to_chars<dyn_allocator>(allocator, numeral);
}

// TODO: Zero-allocation `str_inplace` version?
// Dynamically allocate an `is_integral` value converted to `string`.
template <is_allocator Allocator, is_integral T>
[[nodiscard]]
auto
to_chars(allocator_ref<Allocator> allocator, T integer) -> maybe<str_view> {
   span string =
      $prop(allocator.template alloc_multi<char>(limits<T>::digits10));
   char* p_string = string.data();

   // Modify the allocated string in-place.
   if constexpr (is_same<T, int4::raw_type>) {
      detail::i32toa_jeaiii(integer, p_string);
   } else if constexpr (is_same<T, uint4::raw_type>) {
      detail::u32toa_jeaiii(integer, p_string);
   } else if constexpr (is_same<T, int8::raw_type>) {
      detail::i64toa_jeaiii(integer, p_string);
   } else if constexpr (is_same<T, uint8::raw_type>) {
      detail::u64toa_jeaiii(integer, p_string);
   } else {
      // TODO: Format 1 and 2-byte integers.
      __builtin_unreachable();
   }

   return str_view(p_string);
}

template <is_integral T>
[[nodiscard, gnu::always_inline, gnu::nodebug]]
inline auto
to_chars(dyn_allocator allocator, T integer) -> maybe<str_view> {
   return to_chars<dyn_allocator>(allocator, integer);
}

// Dynamically allocate a floating point value converted to `string`.
template <is_allocator Allocator, typename T>
   requires(is_floating_point<T>)
[[nodiscard]]
auto
to_chars(allocator_ref<Allocator> allocator, T value) -> maybe<str_view> {
   span string = $prop(
      allocator.template alloc_multi<char>(detail::float_to_chars_max_size<T>())
   );
   char* p_string = string.data();

   detail::dragonbox::to_chars(value, p_string);

   return str_view(p_string);
}

template <typename T>
   requires(is_floating_point<T>)
[[nodiscard, gnu::always_inline, gnu::nodebug]]
inline auto
to_chars(dyn_allocator allocator, T value) -> maybe<str_view> {
   return to_chars<dyn_allocator>(allocator, value);
}

namespace detail {
template <auto value>
consteval auto
make_const_string() {
   constexpr auto signed_remainder = value % 10;
   constexpr auto remainder =
      signed_remainder < 0 ? -signed_remainder : signed_remainder;
   constexpr char digit =
      (remainder > 9) ? (remainder - 10) + 'a' : remainder + '0';
   constexpr auto new_value = value / 10;

   if constexpr (new_value == 0) {
      return basic_str_literal(digit);
   } else {
      return make_const_string<new_value>() + digit;
   }
}
}  // namespace detail

// Convert a `constexpr` `is_integral` to `str_literal`.
template <auto value>
   requires(is_integral<decltype(value)>)
[[nodiscard]]
consteval auto
to_chars() {
   if constexpr (value == 0) {
      return str_literal("0");
   } else if constexpr (is_signed<decltype(value)> && value < 0) {
      return '-' + detail::make_const_string<value>();
   } else {
      return detail::make_const_string<value>();
   }
}

template <is_integral T>
[[nodiscard]]
constexpr auto
to_string_at(
   basic_int<T> value, span<char> output_buffer [[clang::lifetimebound]]
) -> maybe<str_view> {
   // Add 1 for a negative sign - character.
   constexpr iword max_length = to_chars<basic_int<T>::max()>().size() + 1;
   char buffer[max_length.raw];
   if consteval {
      iword i = 0;
      if (is_signed<T> && value < 0) {
         buffer[0] = '-';
         i = 1;
      }
      for (; i < max_length; ++i) {
         if (value > 0) {
            basic_int<T> const remainder = value % 10;
            buffer[i.raw] = remainder.raw + '0';
            value /= 10;
         } else {
            buffer[i.raw] = '\0';
         }
      }
   } else {
      detail::i32toa_jeaiii(value.raw, buffer);
   }

   // TODO: Get the length of this integer faster.
   idx length = string_length(buffer);
   if (length > output_buffer.size()) {
      return nullopt;
   }

   if consteval {
      for (idx i; i < length; ++i) {
         output_buffer[i] = buffer[i.raw];
      }
   } else {
      copy_memory(buffer, output_buffer.data(), length);
   }

   return str_view(output_buffer.data(), length);
}

// Formatting.
enum class [[clang::enum_extensibility(closed)]] format_errors : unsigned char {
   out_of_memory,
   cannot_format_argument,
   argument_type_mismatch,
   inconsistent_argument_indexing,
   unknown_format_specifier,
   unmatched_open_brace,
   // TODO: This list is incomplete.
};

