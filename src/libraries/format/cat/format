// Get the upper bound buffer size for a stringified floating point type.
namespace detail {
template <typename T>
   requires(is_floating_point<T>)
[[nodiscard]]
constexpr auto
float_to_chars_max_size() -> idx {
   if constexpr (sizeof(T) == 4u) {
      return 16u;
   } else {
      return 25u;
   }
}
}  // namespace detail

namespace detail {
// Room for every decimal digit of `T` and a sign.
template <typename T>
inline constexpr idx to_chars_integer_capacity =
   limits<decltype(make_raw_arithmetic(declval<T>()))>::digits10 + 2u;
}  // namespace detail

// Convert an integer to decimal characters, like `std::to_chars()`.
template <is_integral T>
   requires(!is_bool<T>)
[[nodiscard]]
constexpr auto
to_chars(T value) -> str_inplace<detail::to_chars_integer_capacity<T>>;

// Formatting.
enum class [[clang::enum_extensibility(closed)]] format_errors : unsigned char {
   out_of_memory,
   cannot_format_argument,
   argument_type_mismatch,
   inconsistent_argument_indexing,
   unknown_format_specifier,
   unmatched_open_brace,
   // TODO: This list is incomplete.
};

// TODO: Union this with allocator `scaredy`.
template <typename T = void>
using scaredy_format = scaredy<T, format_errors>;

// Parse context for a replacement field's format-spec. `begin()` points at the
// first format-spec character (after `:`) or at `}` when the spec is empty.
class format_parse_context {
 private:
   char const* _Nonnull m_begin;
   char const* _Nonnull m_end;

   // Iff `m_argument_index` is less than 0, the format string has manually
   // indexed an argument. Otherwise, all arguments are automatically indexed.
   iword m_argument_index = 0;

 public:
   uword const m_arguments_count;

   using iterator = char const* _Nonnull;
   using const_iterator = char const* _Nonnull;

   constexpr format_parse_context(
      str_view const in_format [[clang::lifetimebound]],
      uword in_args_count = 0u
   )
       : m_begin(in_format.data()),
         m_end(in_format.data() + in_format.size().raw),
         m_arguments_count(in_args_count) {
   }

   [[nodiscard]]
   constexpr auto
   begin() const -> const_iterator {
      return m_begin;
   }

   [[nodiscard]]
   constexpr auto
   end() const -> const_iterator {
      return m_end;
   }

   constexpr void
   advance_to(const_iterator p_position) {
      m_begin = p_position;
   }

   constexpr auto
   next_argument_index() -> iword {
      return ++m_argument_index;
   }

   // Check if a manually indexed argument is within reasonable bounds, and
   // check that this context is not using automatic indexing.
   constexpr auto
   check_argument_index(iword index) -> maybe<void> {
      if consteval {
         if (index >= make_signed(m_arguments_count)) {
            return nullopt;
         }
      }

      if (m_argument_index > 0) {
         return nullopt;
      }

      m_argument_index = -1;
      return monostate;
   }
};

// Default parse accepts only empty format-specs (`{}` and `{:}`).
template <typename CharT = char>
struct formatter_base {
   constexpr auto
   parse(format_parse_context& context)
      -> scaredy_format<format_parse_context::const_iterator> {
      static_assert(
         is_same<CharT, char>, "Only `char` formatters are supported!"
      );
      format_parse_context::const_iterator const it = context.begin();
      if (it == context.end()) {
         return format_errors::unmatched_open_brace;
      }
      if (*it != '}') {
         return format_errors::unknown_format_specifier;
      }
      return it;
   }
};

// Debug format for `char` and strings: `{:?}` and `set_debug_format()`. Range
// and tuple formatters call this on nested element formatters so strings print
// quoted.
template <typename CharT = char>
struct debug_formatter : formatter_base<CharT> {
   bool debug = false;

   constexpr void
   set_debug_format(bool set = true) {
      debug = set;
   }

   constexpr auto
   parse(format_parse_context& context)
      -> scaredy_format<format_parse_context::const_iterator> {
      format_parse_context::const_iterator p_it = context.begin();
      if (p_it == context.end()) {
         return format_errors::unmatched_open_brace;
      }
      if (*p_it == '?') {
         set_debug_format();
         ++p_it;
      }
      if (p_it == context.end() || *p_it != '}') {
         return format_errors::unknown_format_specifier;
      }
      return p_it;
   }
};

