template <typename T>
auto
append_arithmetic(format_context context, T value) -> scaredy_format<void> {
   if constexpr (!is_floating_point<T>) {
      str_inplace const text = to_chars(value);
      return context.append(str_view(text.data(), text.size()));
   } else {
      format_buffer& buffer = context.buffer();
      maybe<char*> tail = buffer.prepare_append(float_to_chars_max_size<T>());
      if (tail.is_empty()) {
         return format_errors::out_of_memory;
      }

      char* const p_begin = tail.value();
      char* const p_end = dragonbox::to_chars(value, p_begin);
      buffer.commit(idx(p_end - p_begin));
      return monostate;
   }
}

