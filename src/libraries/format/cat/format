// Format a string and print it to `stdout`, followed by a newline.
template <is_allocator Allocator, typename... Args>
[[nodiscard]]
auto
println_fmt(
   allocator_ref<Allocator> allocator, str_view const format,
   Args&&... arguments
) -> maybe<idx> {
   str_view const string =
      $prop_as(fmt(allocator, format, $fwd(arguments)...), nullopt);
   maybe const result = println(string);
   allocator.free(string);
