template <typename T, typename CharT>
   requires(
      is_pointer<T> && is_same<remove_const<remove_pointer<T>>, char>
      && is_same<CharT, char>
   )
struct formatter<T, CharT> : debug_formatter<CharT> {
   auto
   format(T value, format_context& context) const -> scaredy_format<void> {
      if (value == nullptr) {
         return context.append("(null)");
      }
      str_view const string(value);
      if (this->debug) {
         return detail::append_escaped(context, string, '"');
      }
      return context.append(string);
   }
};

template <typename T, typename CharT>
   requires(
      is_pointer<T> && !is_same<remove_const<remove_pointer<T>>, char>
      && is_same<CharT, char>
   )
struct formatter<T, CharT> : formatter_base<CharT> {
   auto
   format(T value, format_context& context) const -> scaredy_format<void> {
      __UINTPTR_TYPE__ integer = reinterpret_cast<__UINTPTR_TYPE__>(value);
      char digits[sizeof(integer) * 2u];
      idx length;
      do {
         auto const digit = integer & 0xfu;
         digits[length.raw] =
            static_cast<char>(digit < 10u ? digit + '0' : digit - 10u + 'a');
         ++length;
         integer >>= 4u;
      } while (integer != 0u);

      scaredy_format<void> result = context.append("0x");
      if (result.is_empty()) {
         return result;
      }
      iword position = make_signed(length);
      while (position > 0) {
         --position;
         result = context.append(digits[position.raw]);
         if (result.is_empty()) {
            return result;
         }
      }
      return monostate;
   }
};

