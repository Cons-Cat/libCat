// Erase any `allocator_ref` into the format allocator method prefix.
template <is_allocator Allocator>
[[nodiscard, gnu::always_inline, gnu::nodebug]]
constexpr auto
erase_allocator(allocator_ref<Allocator> allocator)
   -> basic_dyn_allocator<dyn_reallocate> {
   if constexpr (is_same<Allocator, basic_dyn_allocator<dyn_reallocate>>) {
      return allocator.get_allocator();
   } else {
      return basic_dyn_allocator<dyn_reallocate>(allocator.get_allocator());
   }
}
}  // namespace detail

struct format_context {
   allocator_ref<basic_dyn_allocator<dyn_reallocate>> allocator;
   detail::format_contiguous_output_iterator<
      basic_dyn_allocator<dyn_reallocate>>& output;

   [[nodiscard]]
   auto
   buffer() const
      -> detail::format_buffer<basic_dyn_allocator<dyn_reallocate>>& {
      return detail::get_container(output);
   }

   auto
   append(char character) const -> scaredy_format<void> {
      if (buffer().push_back(allocator, character).is_empty()) {
         return format_errors::out_of_memory;
      }
      return monostate;
   }

   auto
   append(str_view string) const -> scaredy_format<void> {
      if (buffer().append(allocator, string).is_empty()) {
         return format_errors::out_of_memory;
      }
      return monostate;
   }
};

