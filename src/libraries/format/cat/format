namespace detail {
// The state a flush callback needs to push a chunk into an output iterator.
template <is_allocator Allocator, typename Outputter>
struct format_sink {
   allocator_ref<Allocator> allocator;
   Outputter& output_iterator;
};

// Push one chunk into the output iterator, in bulk where the destination
// supports it.
template <is_allocator Allocator, typename Outputter>
auto
flush_to_outputter(void* _Nonnull p_sink, str_view chunk) -> maybe<void> {
   format_sink<Allocator, Outputter>& sink =
      *static_cast<format_sink<Allocator, Outputter>*>(p_sink);

   if constexpr (requires {
                    get_container(sink.output_iterator)
                       .append_range(sink.allocator, chunk);
                 }) {
      return get_container(sink.output_iterator)
         .append_range(sink.allocator, chunk);
   } else {
      for (char const character : chunk) {
         $prop(sink.output_iterator.insert(sink.allocator, character));
      }
      return monostate;
   }
}
}  // namespace detail

// Format directly into an output iterator without staging the whole result.
template <is_allocator Allocator, typename Outputter>
[[nodiscard]]
auto
vfmt_to(
   allocator_ref<Allocator> allocator, Outputter output_iterator,
   str_view const format, detail::format_args arguments
) -> scaredy_format<Outputter> {
   detail::format_sink<Allocator, Outputter> sink{allocator, output_iterator};
   scaredy_format<void> const result = vfmt_to_sink(
      detail::erase_allocator(allocator), __builtin_addressof(sink),
      &detail::flush_to_outputter<Allocator, Outputter>, format, arguments
   );
   if (result.is_empty()) {
      return result.error<format_errors>();
   }
   return output_iterator;
}

// Store `arguments` in a compacted variant object. Then format a sequence of
// `char` with those arguments, and push the result into some container. The
// allocator keeps its concrete type so the destination container can grow
// through its full allocation interface, matching libfmt's `format_to`.
template <typename AllocatorLike, typename Outputter, typename... Args>
   requires(is_allocator<remove_cvref<AllocatorLike>>)
[[nodiscard]]
auto
fmt_to(
   AllocatorLike&& allocator, Outputter output_iterator, str_view const format,
   Args&&... arguments
) -> scaredy_format<Outputter> {
   (detail::maybe_pull_format_support<Args>(), ...);
   return vfmt_to(
      allocator_ref(allocator), output_iterator, format,
      detail::format_args(
         detail::format_args_compact_storage<Args...>($fwd(arguments)...)
      )
   );
}

