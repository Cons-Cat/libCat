// Format into an output iterator by type-erasing through `vfmt`.
template <is_allocator Allocator, typename Outputter>
[[nodiscard]]
auto
vfmt_to(
   allocator_ref<Allocator> allocator, Outputter output_iterator,
   str_view const format, detail::format_args arguments
) -> scaredy_format<Outputter> {
   auto result = vfmt(detail::erase_allocator(allocator), format, arguments);
   if (result.is_empty()) {
      return result.template error<format_errors>();
   }
   str_view const string = result.value();
   for (idx i; i < string.size(); ++i) {
      maybe insert_result = output_iterator.insert(allocator, string[i]);
      if (insert_result.is_empty()) {
         allocator.free(string);
         return format_errors::out_of_memory;
      }
   }
   allocator.free(string);
   return output_iterator;
}

