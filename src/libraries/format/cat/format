// Format a string and print it to `stdout`.
template <is_allocator Allocator, typename... Args>
[[nodiscard]]
auto
print_fmt(
   allocator_ref<Allocator> allocator, str_view const format,
   Args&&... arguments
) -> maybe<idx> {
   (detail::maybe_pull_format_support<Args>(), ...);
