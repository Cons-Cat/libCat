#pragma once

#include <cat/string>

namespace cat {

template <typename T>
consteval auto
type_name() -> cat::str_view {
   char const* _Nonnull p_string = __PRETTY_FUNCTION__;
   iword size = iword(sizeof(__PRETTY_FUNCTION__) - 2);

   // Scan backwards from the function signature to find whitespace that
   // delimits the beginning of this type name.
   for (iword i = size - 1; i >= 0; --i) {
      if (p_string[idx(i)] == '=') {
         // There is a whitespace after the = in this signature, so we add 1 to
         // the string pointer to compensate.
         p_string = p_string + cat::idx(i) + 2u;
         size -= i + 2;
         return {p_string, cat::idx(size)};
      }
   }
   __builtin_unreachable();
}

consteval auto
nameof(auto&& value) -> cat::str_view {
   return type_name<cat::remove_reference<decltype(value)>>();
}

template <auto enum_value>
   requires(cat::is_enum<decltype(enum_value)>)
consteval auto
enum_name_from_nttp() -> cat::str_view {
   char const* _Nonnull p_string = __PRETTY_FUNCTION__ + 34u;
   iword size = iword(sizeof(__PRETTY_FUNCTION__) - 38u);
   // Scan backwards from the function signature to find `enum_value`'s word
   // boundary, and trim everything else from the string. This boundary is
   // either a scope-resolution operator or whitespace for scoped and unscoped
   // enums respectively.
   for (cat::iword i = size - 1; i >= 0; --i) {
      if (p_string[cat::idx(i)] == ':' || p_string[cat::idx(i)] == ' ') {
         p_string = p_string + cat::idx(i) + 1u;
         size -= i - 1;
         return {p_string, idx{size}};
      }
   }
   __builtin_unreachable();
}

}  // namespace cat
