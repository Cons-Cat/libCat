// -*- mode: c++ -*-
// vim: set ft=cpp:
#pragma once

// `cat::basic_vec` is a dynamically-sized contiguous owning container inspired
// by `std::vector`. Upon construction, the `vec` is empty. Unlike
// `std::vector`, when it initially allocates, it grows from 0 to a capacity of
// 4 elements. From there, exceeding capacity reallocates to double its current
// size.
//
// As this is a `manual` namespace container, its `.reset()` and destructor does
// not deallocate storage, it only calls its elements' destructors. To
// deallocate storage, call `.free(allocator)` or `.cfree(allocator)`.
//
// The `cat::raii::basic_vec` deallocates its own memory automatically.
//
// It is paramaterized by `cat::vec_flags`, which may toggle the following
// features:
//
//  `pointer_size_layout`
//     By default, the `vec` stores a head and tail pointer to its owned data,
//     like libc++ and libstdc++. This has the benefit of making `.push_back()`
//     very cheap, at the cost of making `.size()` cost an additional
//     subtraction. Instead, this flag stores a pointer and size, making
//     `.size()` free and `.push_back()` cost an additional addition.
//
//  `inline_storage(count)`
//     Store up to `count` elements inside the vector, only allocating when its
//     inline capacity is exceeded.
//
//  `fixed_size`
//     The vector has a fixed size upon allocation and no separate capacity.
//
// Convenience type aliases are provided for these configurations:
//
//  `cat::vec<T>`, a default `basic_vec`.
//  `cat::vec_fixed<T>`, a `basic_vec` with `fixed_size` flag.
//  `cat::small_vec<T, n=4>`, a `basic_vec` with `inline_storage(n)` flag.
//  `cat::small_vec_fixed<T, n=4>`, a `basic_vec` with `inline_storage(n)` and
//     `fixed_size` flag.

#include <cat/algorithm>
#include <cat/allocator>
#include <cat/allocator_parameters>
#include <cat/array>
#include <cat/container>
#include <cat/iterable>
#include <cat/math>
#include <cat/sanitizer>
#include <cat/utility>

#include "./detail/vec_storage.hpp"

namespace cat {

inline namespace manual {

template <typename T, vec_flags flags = {}>
class basic_vec;

template <typename T, vec_flags flags = {}>
using vec = basic_vec<T, flags>;

template <typename T, vec_flags flags = {}>
using vec_fixed = basic_vec<T, flags | vec_flags::fixed_size>;

template <typename T, idx inline_count = 4u, vec_flags flags = {}>
using small_vec = basic_vec<T, flags | vec_flags::inline_storage(inline_count)>;

template <typename T, idx inline_count = 4u, vec_flags flags = {}>
using small_vec_fixed = basic_vec<
   T, flags | vec_flags::inline_storage(inline_count) | vec_flags::fixed_size>;

}  // namespace manual

namespace detail {
// `maybe<vec<T>>`s are disengaged when `data() == nullptr` and `size() != 0`.
// Every `basic_vec<T>` value either has a non-null buffer or a zero
// size, so this bit pattern is unambiguously the empty state.
template <typename T, vec_flags flags>
constexpr auto
maybe_vec_has_value(basic_vec<T, flags> const& value) -> bool;

template <typename T, vec_flags flags>
constexpr auto
maybe_vec_nullopt() -> basic_vec<T, flags>;
}  // namespace detail

inline namespace manual {

template <typename T, vec_flags flags>
class [[clang::preferred_name(vec<T, flags>), gsl::Owner]]
basic_vec : public container_interface<basic_vec<T, flags>, T>,
            public random_access_stepanov_iterable_interface<T> {
   static_assert(
      is_same<remove_cvref<T>, T>, "`T` must not be cvref-qualified!"
   );

 public:
   constexpr basic_vec() = default;

   constexpr basic_vec(basic_vec&& other) {
      other.annotate_size_change(other.size(), other.capacity());
      move_from(other);
      annotate_size_change(capacity(), size());
   }

   constexpr basic_vec(basic_vec const&) =
      delete ("Implicit copying of `cat::basic_vec` is forbidden. Call "
              "`.clone()` or move instead!");

   auto
   operator=(basic_vec const&)
      -> basic_vec& = delete ("Implicit copying of `cat::basic_vec` is "
                              "forbidden. Call `.clone()` or move instead!");

   [[clang::reinitializes]]
   constexpr auto
   operator=(basic_vec&& other) -> basic_vec& {
      if (this == &other) {
         return *this;
      }
      cat::assert(
         data() == nullptr,
         "basic_vec move-assigned over while still owning storage. "
         "Call .free(allocator) first."
      );
      other.annotate_size_change(other.size(), other.capacity());
      move_from(other);
      annotate_size_change(capacity(), size());
      return *this;
   }

   // The manual `basic_vec` does not own its storage, so its destructor
   // only invokes element destructors via `.reset()`. To deallocate
   // immediately, call `.free(allocator)`. This is strongly encouraged for
   // non-trivially-destructible `T`.
   constexpr ~basic_vec() {
      idx const old_size = size();
      destroy_range(0u, size());
      annotate_size_change(old_size, capacity());
      if consteval {
         if (data() != nullptr) {
            std::allocator<T> allocator;
            allocator.deallocate(data(), capacity().raw);
         }
      } else {
         m_storage.disarm_inline();
      }
   }

   template <vec_flags other_flags>
   [[nodiscard]]
   constexpr auto
   operator==(basic_vec<T, other_flags> const& rhs) const -> bool
      requires(is_equality_comparable<T>)
   {
      return span<T const>(*this) == span<T const>(rhs);
   }

   template <vec_flags other_flags>
   [[nodiscard]]
   constexpr auto
   operator<=>(basic_vec<T, other_flags> const& rhs) const
      requires(requires(T const& left, T const& right) {
                  { left < right } -> is_convertible<bool>;
                  { right < left } -> is_convertible<bool>;
               })
   {
      return span<T const>(*this) <=> span<T const>(rhs);
   }

   constexpr void
   swap(basic_vec& other) {
      basic_vec temporary(move(*this));
      *this = move(other);
      other = move(temporary);
   }

 private:
   constexpr void
   destroy_range(idx first, idx last) {
      if (data() == nullptr) {
         return;
      }
      for (idx i = first; i < last; ++i) {
         data()[i].~T();
      }
   }

   // Move the contents of `this` into `p_destination`.
   constexpr void
   relocate_elements_to(T* _Nonnull p_destination) {
      if !consteval {
         if constexpr (is_trivially_relocatable<T>) {
            // Dynamic vectorized copy of eligible types.
            copy_memory(data(), p_destination, size() * sizeof(T));
            return;
         }
      }
      // Other types get a potentially auto-vectorized loop for one platform.
      for (idx i; i < size(); ++i) {
         if constexpr (is_move_constructible<T>) {
            new (p_destination + i) T(move(data()[i]));
         } else {
            new (p_destination + i) T(data()[i]);
         }
      }
      destroy_range(0u, size());
   }

   template <typename U>
   constexpr void
   write_growth_slot(idx index, idx old_size, U&& value) {
      if (index < old_size) {
         data()[index] = $fwd(value);
      } else {
         new (data() + index) T($fwd(value));
      }
   }

   constexpr void
   shift_tail_right(idx position, idx count, idx old_size) {
      for (idx i = old_size; i > position; i = idx(i - 1u)) {
         idx const destination = idx(i + count - 1u);
         idx const source = idx(i - 1u);
         write_growth_slot(destination, old_size, move(data()[source]));
      }
   }

   // Move the contents of `other` into `this`.
   constexpr void
   move_from(basic_vec& other) {
      if constexpr (detail::vec_storage<T, flags>::is_inline) {
         if (
            other.m_storage.m_has_handle && other.m_storage.m_handle.is_inline()
         ) {
            idx const other_size = other.size();
            idx const other_capacity = other.capacity();
            m_storage.m_handle.set_inlined(true);
            m_storage.m_handle.set_count(other_capacity);
            m_storage.m_has_handle = true;
            m_storage.set_layout(
               m_storage.m_handle.get_inline_ptr(), other_size, other_capacity
            );
            other.relocate_elements_to(data());
            other.m_storage.disarm_inline();
            other.m_storage.set_layout(nullptr, 0u, 0u);
            return;
         }
      }
      m_storage = move(other.m_storage);
   }

   template <is_allocator Allocator>
   constexpr auto
   internal_allocate(allocator_ref<Allocator> allocator, idx minimum_capacity)
      -> maybe<tuple<span<T>, idx>> {
      if constexpr (detail::vec_storage<T, flags>::is_inline) {
         auto [handle, allocation_bytes] = $prop(
            (allocator.template inline_salloc_multi_uninit<
               T, flags.inline_storage_count * sizeof(T)>(minimum_capacity))
         );
         m_storage.m_handle = move(handle);
         m_storage.m_has_handle = true;
         return tuple<span<T>, idx>{
            allocator.get(m_storage.m_handle),
            allocation_bytes,
         };
      } else {
         return allocator.template salloc_multi_uninit<T>(minimum_capacity);
      }
   }

   template <is_allocator Allocator>
   constexpr void
   free_inline_storage(allocator_ref<Allocator> allocator) {
      if (m_storage.m_has_handle) {
         allocator.free_uninit(m_storage.m_handle);
         m_storage.disarm_inline();
         m_storage.m_handle =
            typename detail::vec_storage<T, flags>::handle_type{};
      }
   }

   // Reallocate memory, or make an initial allocation.
   constexpr void
   annotate_size_change(idx old_size, idx new_size) const {
      if (data() == nullptr) {
         return;
      }
      annotate_contiguous_container(
         data(), data() + capacity(), data() + old_size, data() + new_size
      );
   }

   // Reallocate this `vec`'s memory if it is exceeded, in a non-`constexpr`
   // context.
   template <is_allocator Allocator>
   constexpr auto
   increase_storage(allocator_ref<Allocator> allocator) -> maybe<void> {
      constexpr idx initial_capacity = detail::vec_storage<T, flags>::is_inline
                                          ? flags.inline_storage_count
                                          : 4u;
      idx const minimum_capacity = max(capacity() * 2u, initial_capacity);

      return reserve(allocator, minimum_capacity);
   }

 public:
   // Returns `nullptr` when this `vec` is default-constructed or moved-from.
   [[nodiscard]]
   constexpr auto
   data() [[clang::lifetimebound]] -> T* _Nullable {
      return m_storage.data();
   }

   // Returns `nullptr` when this `vec` is default-constructed or moved-from.
   [[nodiscard]]
   constexpr auto
   data() const [[clang::lifetimebound]] -> T const* _Nullable {
      return m_storage.data();
   }

   [[nodiscard]]
   constexpr auto
   size() const -> idx {
      return m_storage.size();
   }

   [[nodiscard]]
   constexpr auto
   capacity() const -> idx {
      return m_storage.capacity();
   }

   // Destroy every element of this `vec`. Storage is left allocated, the
   // capacity is unchanged, and the size is reset to zero. Memory must be
   // deallocated separately through `.free(allocator)`.
   [[clang::reinitializes]]
   constexpr void
   reset()
      requires(!flags.is_fixed_size)
   {
      destroy_range(0u, size());
      annotate_size_change(size(), 0u);
      m_storage.set_size(0u);
   }

   // Deallocate this `vec`'s storage from `allocator`.
   template <is_allocator Allocator>
   [[clang::reinitializes]]
   constexpr void
   free(allocator_ref<Allocator> allocator) {
      idx const old_size = size();
      idx const old_capacity = capacity();
      destroy_range(0u, old_size);
      annotate_size_change(old_size, old_capacity);
      if constexpr (detail::vec_storage<T, flags>::is_inline) {
         free_inline_storage(allocator);
      } else if (data() != nullptr) {
         allocator.free_multi_uninit(span<T>(data(), old_capacity));
      }
      m_storage.set_layout(nullptr, 0u, 0u);
   }

   // Deallocate this `vec`'s storage from `allocator`.
   [[clang::reinitializes, gnu::always_inline, gnu::nodebug]]
   constexpr void
   free(dyn_allocator allocator) {
      return free<dyn_allocator>(allocator);
   }

   // Deallocate this `vec`'s storage from `allocator`.
   template <is_allocator Allocator>
   [[clang::reinitializes]]
   constexpr void
   cfree(allocator_ref<Allocator> allocator) {
      idx const old_size = size();
      idx const old_capacity = capacity();
      destroy_range(0u, old_size);
      annotate_size_change(old_size, old_capacity);
      if constexpr (detail::vec_storage<T, flags>::is_inline) {
         if (m_storage.m_has_handle) {
            allocator.cfree_uninit(m_storage.m_handle);
            m_storage.disarm_inline();
            m_storage.m_handle =
               typename detail::vec_storage<T, flags>::handle_type{};
         }
      } else if (data() != nullptr) {
         allocator.cfree_multi_uninit(span<T>(data(), old_capacity));
      }
      m_storage.set_layout(nullptr, 0u, 0u);
   }

   // Deallocate this `vec`'s storage from `allocator`.
   [[clang::reinitializes, gnu::always_inline, gnu::nodebug]]
   constexpr void
   cfree(dyn_allocator allocator) {
      return cfree<dyn_allocator>(allocator);
   }

   template <is_allocator Allocator>
   [[nodiscard]]
   constexpr auto
   initialize_fixed(allocator_ref<Allocator> allocator, idx fixed_size)
      -> maybe<void>
      requires(flags.is_fixed_size && is_default_constructible<T>)
   {
      if (data() != nullptr) {
         return nullopt;
      }

      if (fixed_size == 0u) {
         return monostate;
      }

      [[maybe_unused]] auto [alloc_span, alloc_bytes] =
         $prop(internal_allocate(allocator, fixed_size));
      m_storage.set_layout(alloc_span.data(), fixed_size, fixed_size);
      for (idx index; index < fixed_size; ++index) {
         new (data() + index) T();
      }
      return monostate;
   }

   // Try to allocate storage for at least `minimum_capacity` number of `T`s.
   template <is_allocator Allocator>
   [[nodiscard]]
   constexpr auto
   reserve(allocator_ref<Allocator> allocator, idx minimum_capacity)
      -> maybe<void>
      requires(!flags.is_fixed_size)
   {
      if (minimum_capacity > capacity()) {
         idx const old_size = size();
         idx const old_capacity = capacity();
         // Allocate manually because only `old_size` elements are live within
         // `old_capacity`, and unused capacity must remain uninitialized.
         if constexpr (detail::vec_storage<T, flags>::is_inline) {
            auto [new_handle, allocation_bytes] = $prop(
               (allocator.template inline_salloc_multi_uninit<
                  T, flags.inline_storage_count * sizeof(T)>(minimum_capacity))
            );

            T* _Nonnull const p_new = allocator.get(new_handle).data();
            annotate_size_change(old_size, old_capacity);
            relocate_elements_to(p_new);

            if (m_storage.m_has_handle) {
               free_inline_storage(allocator);
            }

            m_storage.m_handle = move(new_handle);
            m_storage.m_has_handle = true;
            m_storage.set_layout(
               allocator.get(m_storage.m_handle).data(), old_size,
               allocation_bytes / sizeof(T)
            );
         } else {
            auto [alloc_span, alloc_bytes] = $prop(
               allocator.template salloc_multi_uninit<T>(minimum_capacity)
            );

            annotate_size_change(old_size, old_capacity);
            relocate_elements_to(alloc_span.data());

            if (data() != nullptr) {
               allocator.free_multi_uninit(span<T>(data(), old_capacity));
            }

            m_storage.set_layout(
               alloc_span.data(), old_size, alloc_bytes / sizeof(T)
            );
         }
         annotate_size_change(capacity(), old_size);
      }

      // If the new capacity is not larger, do nothing.
      return monostate;
   }

   // Try to allocate storage for at least `minimum_capacity` number of `T`s.
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   reserve(dyn_allocator allocator, idx minimum_capacity) -> maybe<void>
      requires(!flags.is_fixed_size)
   {
      return reserve<dyn_allocator>(allocator, minimum_capacity);
   }

   // Try to change the size of this `vec`.
   template <is_allocator Allocator>
      requires(is_default_constructible<T>)
   [[nodiscard]]
   constexpr auto
   resize(allocator_ref<Allocator> allocator, idx size) -> maybe<void>
      requires(!flags.is_fixed_size)
   {
      if (size > capacity()) {
         // This sets `this->current_capacity` and `this->p_storage`.
         $prop(this->reserve(allocator, size));
      }

      idx const old_size = this->size();
      if (size > old_size) {
         annotate_size_change(old_size, size);
         for (idx i = old_size; i < size; ++i) {
            new (data() + i) T();
         }
      } else if (size < old_size) {
         destroy_range(size, old_size);
         annotate_size_change(old_size, size);
      }

      m_storage.set_size(size);
      return monostate;
   }

   // Try to change the size of this `vec`.
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   resize(dyn_allocator allocator, idx size) -> maybe<void>
      requires(!flags.is_fixed_size)
   {
      return resize<dyn_allocator>(allocator, size);
   }

   // Try to change the size of this `vec`, copy-constructing any new
   // elements from `value`.
   template <is_allocator Allocator>
      requires(is_copy_constructible<T>)
   [[nodiscard]]
   constexpr auto
   resize(allocator_ref<Allocator> allocator, idx size, T const& value)
      -> maybe<void>
      requires(!flags.is_fixed_size)
   {
      if (size > capacity()) {
         $prop(this->reserve(allocator, size));
      }

      if (size > this->size()) {
         annotate_size_change(this->size(), size);
         for (idx i = this->size(); i < size; ++i) {
            new (data() + i) T(value);
         }
      } else if (size < this->size()) {
         destroy_range(size, this->size());
         annotate_size_change(this->size(), size);
      }

      m_storage.set_size(size);
      return monostate;
   }

   // Try to change the size of this `vec`, copy-constructing any new
   // elements from `value`.
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   resize(dyn_allocator allocator, idx size, T const& value) -> maybe<void>
      requires(!flags.is_fixed_size)
   {
      return resize<dyn_allocator>(allocator, size, value);
   }

   // De-allocate excess storage.
   template <is_allocator Allocator>
   [[nodiscard]]
   constexpr auto
   shrink_to_fit(allocator_ref<Allocator> allocator) -> maybe<void> {
      if (capacity() == size()) {
         return monostate;
      }

      if (size() == 0u) {
         free(allocator);
         return monostate;
      }

      if constexpr (!detail::vec_storage<T, flags>::is_inline) {
         if (capacity() <= allocator.minimum_allocation_bytes() / sizeof(T)) {
            return monostate;
         }
      }

      basic_vec replacement;
      $prop(replacement.reserve(allocator, size()));
      if (replacement.capacity() >= capacity()) {
         replacement.free(allocator);
         return monostate;
      }
      idx const old_size = size();
      replacement.annotate_size_change(0u, old_size);
      replacement.m_storage.set_size(old_size);
      relocate_elements_to(replacement.data());
      m_storage.set_size(0u);
      free(allocator);
      *this = move(replacement);
      return monostate;
   }

   // De-allocate excess storage.
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   shrink_to_fit(dyn_allocator allocator) -> maybe<void> {
      return shrink_to_fit<dyn_allocator>(allocator);
   }

   // Deep-copy the contents of this `vec`.
   template <is_allocator NewAllocator>
   [[nodiscard]]
   constexpr auto
   clone(
      allocator_ref<NewAllocator> allocator
   ) const& -> maybe<basic_vec<T, flags>> {
      // TODO: When allocators gain .remap(), prefer it when allocators compare
      // equal and the allocator can do better than allocate then copy.
      basic_vec<T, flags> new_vector;
      if constexpr (flags.is_fixed_size) {
         $prop(new_vector.initialize_fixed(allocator, capacity()));
         for (idx i; i < size(); ++i) {
            new_vector[i] = data()[i];
         }
      } else {
         $prop(new_vector.reserve(allocator, max(capacity(), 4u)));
         new_vector.annotate_size_change(0u, size());
         for (idx i; i < size(); ++i) {
            new (new_vector.data() + i) T(data()[i]);
         }
         new_vector.m_storage.set_size(size());
      }

      return move(new_vector);
   }

   // Deep-copy the contents of this `vec`.
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   clone(dyn_allocator allocator) const& -> maybe<basic_vec<T, flags>> {
      return clone<dyn_allocator>(allocator);
   }

   template <is_allocator Allocator>
      requires(is_copy_constructible<T>)
   [[nodiscard]]
   constexpr auto
   push_back(allocator_ref<Allocator> allocator, T const& value) -> maybe<void>
      requires(!flags.is_fixed_size)
   {
      if (size() + 1 > capacity()) {
         $prop(this->increase_storage(allocator));
      }

      idx const old_size = size();
      annotate_size_change(old_size, old_size + 1u);
      new (data() + old_size) T(value);
      m_storage.set_size(old_size + 1u);
      return monostate;
   }

   template <is_allocator Allocator>
      requires(is_move_constructible<T>)
   [[nodiscard]]
   constexpr auto
   push_back(allocator_ref<Allocator> allocator, T&& value) -> maybe<void>
      requires(!flags.is_fixed_size)
   {
      if (size() + 1 > capacity()) {
         $prop(this->increase_storage(allocator));
      }

      idx const old_size = size();
      annotate_size_change(old_size, old_size + 1u);
      new (data() + old_size) T(move(value));
      m_storage.set_size(old_size + 1u);
      return monostate;
   }

   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   push_back(dyn_allocator allocator, T const& value) -> maybe<void>
      requires(!flags.is_fixed_size)
   {
      return push_back<dyn_allocator>(allocator, value);
   }

   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   push_back(dyn_allocator allocator, T&& value) -> maybe<void>
      requires(!flags.is_fixed_size)
   {
      return push_back<dyn_allocator>(allocator, move(value));
   }

   template <
      is_allocator Allocator, typename First, typename Second,
      typename... Remaining>
   constexpr auto
   push_back(allocator_ref<Allocator>, First&&, Second&&, Remaining&&...)
      -> maybe<void> = delete (
         "`push_back()` is not variadic! Consider either `emplace_back()` "
         "to construct an element or `append_range()` to "
         "append a range."
      );

   template <typename First, typename Second, typename... Remaining>
   constexpr auto
   push_back(dyn_allocator, First&&, Second&&, Remaining&&...) -> maybe<void> =
      delete ("`push_back()` is not variadic! Consider either `emplace_back()` "
              "to construct an element or `append_range()` to "
              "append a range.");

   template <is_allocator Allocator, typename... Args>
      requires(is_constructible<T, Args...>)
   [[nodiscard]]
   constexpr auto
   emplace_back(allocator_ref<Allocator> allocator, Args&&... arguments)
      [[clang::lifetimebound]] -> maybe<T&>
      requires(!flags.is_fixed_size)
   {
      if (size() + 1 > capacity()) {
         $prop(this->increase_storage(allocator));
      }

      idx const old_size = size();
      annotate_size_change(old_size, old_size + 1u);
      T* _Nonnull const p_slot = data() + old_size;
      new (p_slot) T($fwd(arguments)...);
      m_storage.set_size(old_size + 1u);
      return *p_slot;
   }

   template <typename... Args>
      requires(is_constructible<T, Args...>)
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   emplace_back(dyn_allocator allocator, Args&&... arguments)
      [[clang::lifetimebound]] -> maybe<T&>
      requires(!flags.is_fixed_size)
   {
      return emplace_back<dyn_allocator>(allocator, $fwd(arguments)...);
   }

   constexpr auto
   fill(T const& value) -> basic_vec&
      requires(is_copy_assignable<T>)
   {
      for (T& element : *this) {
         element = value;
      }
      return *this;
   }

   // Remove and return the last element. Returns `nullopt` when the vec
   // is empty.
   [[nodiscard]]
   constexpr auto
   pop_back() -> maybe<T>
      requires(is_move_constructible<T> && !flags.is_fixed_size)
   {
      if (size() == 0u) {
         return nullopt;
      }
      idx const new_size = idx(size() - 1u);
      m_storage.set_size(new_size);
      T result = move(data()[new_size]);
      destroy_range(new_size, new_size + 1u);
      annotate_size_change(new_size + 1u, new_size);
      return result;
   }

   // Destroy every element of this `vec`. Storage is left allocated and the
   // capacity is unchanged. Equivalent to `.reset()`, named for std parity.
   [[clang::reinitializes]]
   constexpr void
   clear()
      requires(!flags.is_fixed_size)
   {
      reset();
   }

   // Remove the element at `index`, shifting subsequent elements left.
   constexpr void
   erase(idx index)
      requires(is_assignable<T&, T &&> && !flags.is_fixed_size)
   {
      cat::assert(index < size());
      T* _Nonnull const p_dst = data() + index;
      T* _Nonnull const p_src = p_dst + 1;
      T* _Nonnull const p_end = data() + size();
      move(p_src, p_end, p_dst);
      idx const new_size = idx(size() - 1u);
      m_storage.set_size(new_size);
      destroy_range(new_size, new_size + 1u);
      annotate_size_change(new_size + 1u, new_size);
   }

   // Remove the elements in the half-open range `[start, end)`, shifting
   // subsequent elements left.
   constexpr void
   erase(idx start, idx end)
      requires(is_assignable<T&, T &&> && !flags.is_fixed_size)
   {
      cat::assert(start <= end);
      cat::assert(end <= size());
      auto const count = end - start;
      if (count == 0u) {
         return;
      }

      T* _Nonnull const p_dst = data() + start;
      T* _Nonnull const p_src = data() + end;
      T* _Nonnull const p_data_end = data() + size();
      move(p_src, p_data_end, p_dst);
      idx const old_size = size();
      idx const new_size = idx(old_size - count);
      m_storage.set_size(new_size);
      destroy_range(new_size, old_size);
      annotate_size_change(old_size, new_size);
   }

   // Append every element of `range` to the end of this `vec`.
   template <is_allocator Allocator, typename Range>
      requires(
         is_contiguous_iterable<Range>
         && is_same<remove_cvref<decltype(* declval<Range&>().data())>, T>
         && is_implicit_lifetime<T> && !flags.is_fixed_size
      )
   [[nodiscard]]
   constexpr auto
   append_range(allocator_ref<Allocator> allocator, Range&& range)
      -> maybe<void> {
      idx const count = idx(range.size());
      if (count == 0u) {
         return monostate;
      }

      idx const old_size = size();
      idx const new_size = old_size + count;
      $prop(this->reserve(allocator, new_size));
      annotate_size_change(old_size, new_size);

      // Copy `range` to the end.
      copy_memory_backward(range.data(), data() + old_size, count * sizeof(T));
      m_storage.set_size(new_size);
      return monostate;
   }

   // Append every element of `range` to the end of this `vec`.
   template <is_allocator Allocator, typename Range>
      requires(
         is_contiguous_iterable<Range>
         && is_same<remove_cvref<decltype(* declval<Range&>().data())>, T>
         && !is_implicit_lifetime<T> && !flags.is_fixed_size
      )
   [[nodiscard]]
   constexpr auto
   append_range(allocator_ref<Allocator> allocator, Range&& range)
      -> maybe<void> {
      idx const count = idx(range.size());
      if (count == 0u) {
         return monostate;
      }

      $prop(this->reserve(allocator, size() + count));

      // Move or copy `range` to the end.
      if constexpr (is_rvalue_reference<iterable_element_type<Range>>) {
         for (idx i = 0u; i < count; ++i) {
            $prop(this->push_back(allocator, move(range.data()[i])));
         }
      } else {
         for (idx i = 0u; i < count; ++i) {
            $prop(this->push_back(allocator, range.data()[i]));
         }
      }
      return monostate;
   }

   // Append every element of `range` to the end of this `vec`.
   template <is_allocator Allocator, is_iterable Iterable>
      requires(
         (!is_contiguous_iterable<Iterable>
          || !is_same<remove_cvref<decltype(* declval<Iterable&>().data())>, T>)
         && has_size<Iterable> && !flags.is_fixed_size
      )
   [[nodiscard]]
   constexpr auto
   append_range(allocator_ref<Allocator> allocator, Iterable&& range)
      -> maybe<void> {
      $prop(this->reserve(allocator, size() + idx(range.size())));

      // Append each element.
      maybe<void> result = monostate;
      auto append = [&](auto&& value) {
         if (result.has_value()) {
            result = this->push_back(allocator, $fwd(value));
         }
      };
      auto context = cat::iterate(range);
      context.run_while([&](auto&& value) -> bool {
         append($fwd(value));
         return true;
      });
      return result;
   }

   // Append every element of `range` to the end of this `vec`.
   template <is_allocator Allocator, is_iterable Iterable>
      requires(
         (!is_contiguous_iterable<Iterable>
          || !is_same<remove_cvref<decltype(* declval<Iterable&>().data())>, T>)
         && !has_size<Iterable> && !flags.is_fixed_size
      )
   [[nodiscard]]
   constexpr auto
   append_range(allocator_ref<Allocator> allocator, Iterable&& range)
      -> maybe<void> {
      // Append each element.
      maybe<void> result = monostate;
      auto append = [&](auto&& value) {
         if (result.has_value()) {
            result = this->push_back(allocator, $fwd(value));
         }
      };
      auto context = cat::iterate(range);
      context.run_while([&](auto&& value) -> bool {
         append($fwd(value));
         return true;
      });
      return result;
   }

   // Append every element of `range` to the end of this `vec`.
   template <is_iterable Iterable>
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   append_range(dyn_allocator allocator, Iterable&& range) -> maybe<void>
      requires(!flags.is_fixed_size)
   {
      return append_range<dyn_allocator>(allocator, $fwd(range));
   }

   // Insert every element of `range` before `position`.
   template <is_allocator Allocator, typename Range>
      requires(
         is_contiguous_iterable<Range>
         && is_same<remove_cvref<decltype(* declval<Range&>().data())>, T>
         && is_implicit_lifetime<T> && !flags.is_fixed_size
      )
   [[nodiscard]]
   constexpr auto
   insert_range(allocator_ref<Allocator> allocator, idx position, Range&& range)
      -> maybe<void>
      requires(is_assignable<T&, T &&>)
   {
      cat::assert(position <= size());
      idx const count = idx(range.size());
      if (count == 0u) {
         return monostate;
      }
      idx const old_size = size();
      idx const new_size = old_size + count;
      $prop(this->reserve(allocator, new_size));
      annotate_size_change(old_size, new_size);
      idx const tail_size = idx(old_size - position);

      // Move the existing tail.
      copy_memory_backward(
         data() + position, data() + position + count, tail_size * sizeof(T)
      );

      // Copy `range` into the gap.
      copy_memory_backward(range.data(), data() + position, count * sizeof(T));

      m_storage.set_size(new_size);
      return monostate;
   }

   // Insert every element of `range` before `position`.
   template <is_allocator Allocator, typename Range>
      requires(
         is_contiguous_iterable<Range>
         && is_same<remove_cvref<decltype(* declval<Range&>().data())>, T>
         && !is_implicit_lifetime<T> && !flags.is_fixed_size
      )
   [[nodiscard]]
   constexpr auto
   insert_range(allocator_ref<Allocator> allocator, idx position, Range&& range)
      -> maybe<void>
      requires(is_assignable<T&, T &&>)
   {
      cat::assert(position <= size());

      idx const range_size = idx(range.size());
      if (range_size == 0u) {
         return monostate;
      }
      idx const old_size = size();
      idx const new_size = old_size + range_size;
      $prop(this->reserve(allocator, new_size));
      annotate_size_change(old_size, new_size);

      shift_tail_right(position, range_size, old_size);

      // Move or copy `range` into the gap.
      if constexpr (is_rvalue_reference<iterable_element_type<Range>>) {
         for (idx i = 0u; i < range_size; ++i) {
            write_growth_slot(position + i, old_size, move(range.data()[i]));
         }
      } else {
         for (idx i = 0u; i < range_size; ++i) {
            write_growth_slot(position + i, old_size, range.data()[i]);
         }
      }

      m_storage.set_size(new_size);
      return monostate;
   }

   // Insert every element of `range` before `position`.
   template <is_allocator Allocator, is_iterable Iterable>
      requires(
         (!is_contiguous_iterable<Iterable>
          || !is_same<remove_cvref<decltype(* declval<Iterable&>().data())>, T>)
         && has_size<Iterable> && is_assignable<T&, T &&>
         && !flags.is_fixed_size
      )
   [[nodiscard]]
   constexpr auto
   insert_range(
      allocator_ref<Allocator> allocator, idx position, Iterable&& range
   ) -> maybe<void> {
      cat::assert(position <= size());
      idx const count = idx(range.size());
      if (count == 0u) {
         return monostate;
      }
      idx const old_size = size();
      idx const new_size = old_size + count;
      $prop(this->reserve(allocator, new_size));
      annotate_size_change(old_size, new_size);

      shift_tail_right(position, count, old_size);

      // Write `range` into the gap.
      idx i = position;
      auto insert = [&](auto&& value) {
         write_growth_slot(i, old_size, $fwd(value));
         ++i;
      };
      auto context = cat::iterate(range);
      context.run_while([&](auto&& value) -> bool {
         insert($fwd(value));
         return true;
      });
      m_storage.set_size(new_size);
      return monostate;
   }

   // Insert every element of `range` before `position`.
   template <is_allocator Allocator, is_iterable Iterable>
      requires(
         (!is_contiguous_iterable<Iterable>
          || !is_same<remove_cvref<decltype(* declval<Iterable&>().data())>, T>)
         && !has_size<Iterable> && is_assignable<T&, T &&>
         && !flags.is_fixed_size
      )
   [[nodiscard]]
   constexpr auto
   insert_range(
      allocator_ref<Allocator> allocator, idx position, Iterable&& range
   ) -> maybe<void> {
      cat::assert(position <= size());

      idx insertion_position = position;
      maybe<void> result = monostate;

      // Insert each element and grow as needed.
      auto insert = [&](auto&& value) {
         if (result.is_empty()) {
            return;
         }
         idx const old_size = size();
         if (old_size + 1u > capacity()) {
            result = this->increase_storage(allocator);
            if (result.is_empty()) {
               return;
            }
         }

         annotate_size_change(old_size, old_size + 1u);
         shift_tail_right(insertion_position, 1u, old_size);
         write_growth_slot(insertion_position, old_size, $fwd(value));
         m_storage.set_size(old_size + 1u);
         ++insertion_position;
      };

      auto context = cat::iterate(range);
      context.run_while([&](auto&& value) -> bool {
         insert($fwd(value));
         return true;
      });

      return result;
   }

   // Insert every element of `range` before `position`.
   template <is_iterable Iterable>
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   insert_range(dyn_allocator allocator, idx position, Iterable&& range)
      -> maybe<void>
      requires(is_assignable<T&, T &&> && !flags.is_fixed_size)
   {
      return insert_range<dyn_allocator>(allocator, position, $fwd(range));
   }

   // Replace `[first, last)` with every element of `range`.
   template <is_allocator Allocator, typename Range>
      requires(
         is_contiguous_iterable<Range>
         && is_same<remove_cvref<decltype(* declval<Range&>().data())>, T>
         && is_implicit_lifetime<T> && !flags.is_fixed_size
      )
   [[nodiscard]]
   constexpr auto
   replace_with_range(
      allocator_ref<Allocator> allocator, idx first, idx last, Range&& range
   ) -> maybe<void>
      requires(is_assignable<T&, T &&>)
   {
      cat::assert(first <= last);
      cat::assert(last <= size());

      idx const count = idx(range.size());
      idx const old_size = size();
      idx const removed = idx(last - first);
      idx const new_size = idx(old_size - removed + count);
      $prop(this->reserve(allocator, new_size));

      if (new_size > old_size) {
         annotate_size_change(old_size, new_size);
      }

      // Move the existing tail.
      idx const tail_size = idx(old_size - last);
      copy_memory_backward(
         data() + last, data() + first + count, tail_size * sizeof(T)
      );

      // Copy `range` into the gap.
      copy_memory_backward(range.data(), data() + first, count * sizeof(T));

      if (new_size <= old_size) {
         if (new_size < old_size) {
            destroy_range(new_size, old_size);
         }
         annotate_size_change(old_size, new_size);
      }

      m_storage.set_size(new_size);
      return monostate;
   }

   // Replace `[first, last)` with every element of `range`.
   template <is_allocator Allocator, typename Range>
      requires(
         is_contiguous_iterable<Range>
         && is_same<remove_cvref<decltype(* declval<Range&>().data())>, T>
         && !is_implicit_lifetime<T> && !flags.is_fixed_size
      )
   [[nodiscard]]
   constexpr auto
   replace_with_range(
      allocator_ref<Allocator> allocator, idx first, idx last, Range&& range
   ) -> maybe<void>
      requires(is_assignable<T&, T &&>)
   {
      cat::assert(first <= last);
      cat::assert(last <= size());
      idx const count = idx(range.size());
      idx const old_size = size();
      idx const removed = idx(last - first);
      idx const new_size = idx(old_size - removed + count);
      idx const tail_size = idx(old_size - last);
      $prop(this->reserve(allocator, new_size));

      if (new_size > old_size) {
         annotate_size_change(old_size, new_size);
      }

      // Move the existing tail.
      if (count > removed) {
         for (idx i = tail_size; i > 0u; i = idx(i - 1u)) {
            idx const destination = idx(first + count + i - 1u);
            idx const source = idx(last + i - 1u);
            write_growth_slot(destination, old_size, move(data()[source]));
         }
      } else {
         for (idx i = 0u; i < tail_size; ++i) {
            data()[first + count + i] = move(data()[last + i]);
         }
      }

      // Move or copy `range` into the gap.
      if constexpr (is_rvalue_reference<iterable_element_type<Range>>) {
         for (idx i = 0u; i < count; ++i) {
            write_growth_slot(first + i, old_size, move(range.data()[i]));
         }
      } else {
         for (idx i = 0u; i < count; ++i) {
            write_growth_slot(first + i, old_size, range.data()[i]);
         }
      }

      // Destroy removed trailing elements.
      if (new_size < old_size) {
         destroy_range(new_size, old_size);
      }

      if (new_size <= old_size) {
         annotate_size_change(old_size, new_size);
      }

      m_storage.set_size(new_size);
      return monostate;
   }

   // Replace `[first, last)` with every element of `range`.
   template <is_allocator Allocator, is_iterable Iterable>
      requires(
         (!is_contiguous_iterable<Iterable>
          || !is_same<remove_cvref<decltype(* declval<Iterable&>().data())>, T>)
         && is_assignable<T&, T &&> && !flags.is_fixed_size
      )
   [[nodiscard]]
   constexpr auto
   replace_with_range(
      allocator_ref<Allocator> allocator, idx first, idx last, Iterable&& range
   ) -> maybe<void> {
      basic_vec<T> replacement;
      maybe<void> const appended =
         replacement.append_range(allocator, $fwd(range));
      if (appended.is_empty()) {
         replacement.free(allocator);
         return nullopt;
      }
      maybe<void> const result =
         replace_with_range(allocator, first, last, move(replacement));
      replacement.free(allocator);
      return result;
   }

   // Replace `[first, last)` with every element of `range`.
   template <is_iterable Iterable>
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   replace_with_range(
      dyn_allocator allocator, idx first, idx last, Iterable&& range
   ) -> maybe<void>
      requires(is_assignable<T&, T &&> && !flags.is_fixed_size)
   {
      return replace_with_range<dyn_allocator>(
         allocator, first, last, $fwd(range)
      );
   }

   // Maximum number of elements this `vec` can theoretically hold, bounded
   // by the address space rather than any allocator's actual ceiling.
   [[nodiscard]]
   static constexpr auto
   max_size() -> idx {
      return idx::max() / sizeof(T);
   }

 private:
   template <typename U, vec_flags other_flags>
   friend constexpr auto
   detail::maybe_vec_has_value(basic_vec<U, other_flags> const&) -> bool;

   template <typename U, vec_flags other_flags>
   friend constexpr auto
   detail::maybe_vec_nullopt() -> basic_vec<U, other_flags>;

   detail::vec_storage<T, flags> m_storage;
};

}  // namespace manual

namespace detail {
template <typename T, vec_flags flags>
constexpr auto
maybe_vec_has_value(basic_vec<T, flags> const& value) -> bool {
   return value.m_storage.has_value();
}

template <typename T, vec_flags flags>
constexpr auto
maybe_vec_nullopt() -> basic_vec<T, flags> {
   basic_vec<T, flags> value;
   value.m_storage.set_niche();
   return value;
}

}  // namespace detail

template <typename T, vec_flags flags>
struct default_compact_trait<basic_vec<T, flags>>
    : identity_trait<compact<
         basic_vec<T, flags>, detail::maybe_vec_has_value<T, flags>,
         detail::maybe_vec_nullopt<T, flags>>> {};

inline namespace manual {

template <typename T, vec_flags flags = {}>
[[nodiscard]] constexpr auto make_vec() -> basic_vec<T, flags> {
   return {};
}

template <typename T, is_allocator Allocator, vec_flags flags = {}>
[[nodiscard]] constexpr auto
   make_vec(allocator_ref<Allocator> allocator, initializer_list<T> values)
      -> maybe<basic_vec<T, flags>> {
   basic_vec<T, flags> new_vector;
   if constexpr (flags.is_fixed_size) {
      $prop(new_vector.initialize_fixed(allocator, values.size()));
      idx index;
      for (T const& value : values) {
         new_vector[index] = value;
         ++index;
      }
   } else {
      $prop(new_vector.reserve(allocator, max(values.size(), 4u)));
      for (T const& value : values) {
         $prop(new_vector.push_back(allocator, value));
      }
   }
   return new_vector;
}

