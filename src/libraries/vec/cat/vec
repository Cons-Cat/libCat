[[nodiscard]] constexpr auto make_vec_filled_random(
   allocator_ref<Allocator> allocator, idx count, Generator&& generator
) -> maybe<vec<T, flags>> {
   static_assert(is_default_constructible<T>);
   static_assert(is_assignable<T&, decltype(declval<Generator&>()())>);
   vec<T, flags> new_vector;
   if constexpr (flags.is_fixed_size) {
      $prop(new_vector.initialize_fixed(allocator, count));
   } else {
      $prop(new_vector.resize(allocator, count));
   }

   detail::exception_defer guard([&] {
      new_vector.free(allocator);
   });

   new_vector.fill_random($fwd(generator));
   guard.commit();
   return new_vector;
}

