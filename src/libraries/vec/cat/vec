// -*- mode: c++ -*-
// vim: set ft=cpp:
#pragma once

// `cat::basic_vec` is a dynamically-sized contiguous owning container inspired
// by `std::vector`, `llvm::SmallVector`, `boost::small_vector`, and
// `absl::InlinedVector`.
//
// As this is a `manual` namespace container, its `.reset()` and destructor does
// not deallocate storage, it only calls its elements' destructors. To
// deallocate storage, call `.free(allocator)` or `.cfree(allocator)`.
//
// The `cat::raii::basic_vec` deallocates its own memory automatically.
//
// It is paramaterized by `cat::vec_flags`, which may toggle the following
// features:
//
//  `pointer_size_layout`
//     By default, the `vec` stores a head and tail pointer to its owned data,
//     like libc++ and libstdc++. This has the benefit of making `.push_back()`
//     very cheap, at the cost of making `.size()` cost an additional
//     subtraction. Instead, this flag stores a pointer and size, making
//     `.size()` free and `.push_back()` cost an additional addition.
//
//  `inline_storage(count)`
//     Store up to `count` elements inside the vector, only allocating when its
//     inline capacity is exceeded.
//
//  `initial_growth(count)`
//     Grow to at least `count` elements on the first heap allocation instead
//     of the default 4 elements.
//
//  `fixed_size`
//     The vector has a fixed size upon allocation and no separate capacity.
//
// Convenience type aliases are provided for these configurations:
//
//  `cat::vec<T>`, a `basic_vec` with 4 inline elements.
//  `cat::vec_fixed<T>`, a `basic_vec` with `fixed_size` flag.
//  `cat::vec_small<T, n>`, a `basic_vec` with `n` inline elements.
//  `cat::vec_small_fixed<T, n>`, with `n` inline elements and `fixed_size`.
//  `cat::vec_big<T>`, a `basic_vec` without inline storage.
//  `cat::vec_big_fixed<T>`, a `basic_vec` without inline storage and with
//     `fixed_size` flag.
//
// TODO: We should provide a clever-er default value than 4. Look at
// `llvm::SmallVector` to stay around 64 bytes by default.
//
// By default, non small-size optimized `vec`s grow from 0 to a capacity of 4
// elements in their initial allocation. Reallocations grow to double their
// current size from there.

#include <cat/detail/compact.hpp>

#include <cat/algorithm>
#include <cat/allocator>
#include <cat/allocator_parameters>
#include <cat/array>
#include <cat/container>
#include <cat/iterable>
#include <cat/math>
#include <cat/propagate>
#include <cat/sanitizer>
#include <cat/utility>

#include "./detail/vec_storage.hpp"

namespace cat {

inline namespace manual {

template <typename T, vec_flags flags = {}>
class basic_vec;

template <typename T, vec_flags flags = {}>
using vec = basic_vec<T, vec_flags::inline_storage(4u) | flags>;

template <typename T, vec_flags flags = {}>
using vec_fixed =
   basic_vec<T, vec_flags::inline_storage(4u) | vec_flags::fixed_size | flags>;

template <typename T, idx inline_count, vec_flags flags = {}>
using vec_small = basic_vec<T, vec_flags::inline_storage(inline_count) | flags>;

template <typename T, idx inline_count, vec_flags flags = {}>
using vec_small_fixed = basic_vec<
   T, vec_flags::inline_storage(inline_count) | vec_flags::fixed_size | flags>;

template <typename T, vec_flags flags = {}>
using vec_big = basic_vec<T, vec_flags::initial_growth(4u) | flags>;

template <typename T, vec_flags flags = {}>
using vec_big_fixed =
   basic_vec<T, vec_flags::initial_growth(4u) | vec_flags::fixed_size | flags>;

}  // namespace manual

namespace detail {
// `maybe<vec<T>>`s are disengaged when `data() == nullptr` and `size() != 0`.
// Every `basic_vec<T>` value either has a non-null buffer or a zero
// size, so this bit pattern is unambiguously the empty state.
template <typename T, vec_flags flags>
constexpr auto
maybe_vec_has_value(basic_vec<T, flags> const& value) noexcept(false) -> bool;

template <typename T, vec_flags flags>
constexpr auto
maybe_vec_nullopt() noexcept(false) -> basic_vec<T, flags>;
}  // namespace detail

inline namespace manual {

template <typename T, vec_flags configuration>
class [[clang::preferred_name(vec<T, configuration>), gsl::Owner]]
basic_vec : public container_interface<basic_vec<T, configuration>, T>,
            public random_access_stepanov_iterable_interface<T> {
 public:
   static constexpr vec_flags flags = configuration;

 private:
   static_assert(
      is_same<remove_cvref<T>, T>, "`T` must not be cvref-qualified!"
   );
   static_assert(
      flags.inline_storage_count == 0u || flags.initial_growth_count == 0u,
      "`inline_storage()` and `initial_growth()` cannot be combined!"
   );

   // Moving inline storage relocates the elements, which may throw.
   static constexpr bool is_nothrow_relocatable =
      !detail::vec_storage<T, flags>::is_inline
      || is_nothrow_move_constructible<T>;

 public:
   constexpr basic_vec() = default;

   // Moving a `vec` relocates its elements when they are stored inline.
   constexpr basic_vec(basic_vec&& other) noexcept(
      is_nothrow_relocatable && !__has_feature(cxx_exceptions)
   ) {
      other.annotate_size_change(other.size(), other.capacity());
      move_from(other);
      annotate_size_change(capacity(), size());
   }

   constexpr basic_vec(basic_vec const&) =
      delete ("Implicit copying of `cat::basic_vec` is forbidden. Call "
              "`.clone()` or move instead!");

   auto
   operator=(basic_vec const&) noexcept(!__has_feature(cxx_exceptions))
      -> basic_vec& = delete ("Implicit copying of `cat::basic_vec` is "
                              "forbidden. Call `.clone()` or move instead!");

   [[clang::reinitializes]]
   constexpr auto
   operator=(basic_vec&& other) noexcept(
      !__has_feature(cxx_exceptions) && is_nothrow_relocatable
   ) -> basic_vec& {
      if (this == &other) {
         return *this;
      }

      assert(
         data() == nullptr,
         "basic_vec move-assigned over while still owning storage. "
         "Call .free(allocator) first."
      );
      other.annotate_size_change(other.size(), other.capacity());
      move_from(other);
      annotate_size_change(capacity(), size());
      return *this;
   }

   // The manual `basic_vec` does not own its storage, so its destructor
   // only invokes element destructors via `.reset()`. To deallocate
   // immediately, call `.free(allocator)`. This is strongly encouraged for
   // non-trivially-destructible `T`.
   constexpr ~basic_vec() noexcept {
      idx const old_size = size();
      destroy_n_elements(data(), size());
      annotate_size_change(old_size, capacity());
      if consteval {
         if (data() != nullptr) {
            std::allocator<T> allocator;
            allocator.deallocate(data(), capacity().raw);
         }
      } else {
         m_storage.disarm_inline();
      }
   }

   template <vec_flags other_flags>
   [[nodiscard]]
   constexpr auto
   operator==(basic_vec<T, other_flags> const& rhs) const -> bool
      requires(is_equality_comparable<T>)
   {
      return span<T const>(*this) == span<T const>(rhs);
   }

   template <vec_flags other_flags>
   [[nodiscard]]
   constexpr auto
   operator<=>(basic_vec<T, other_flags> const& rhs) const
      requires(requires(T const& left, T const& right) {
                  { left < right } -> is_convertible<bool>;
                  { right < left } -> is_convertible<bool>;
               })
   {
      return span<T const>(*this) <=> span<T const>(rhs);
   }

   constexpr void
   swap(basic_vec& other) noexcept(
      is_nothrow_relocatable && !__has_feature(cxx_exceptions)
   ) {
      // Swapping elements requires assigning them.
      if constexpr (
         detail::vec_storage<T, flags>::is_inline && is_assignable<T&, T&&>
      ) {
         if (is_inline_stored() && other.is_inline_stored()) {
            swap_inline(other);
            return;
         }
      }

      basic_vec temporary(move(*this));
      {
         // Only relocating inline elements can throw. If `other`'s fail, give
         // this `vec` its heap storage back so that it does not leak. Inline
         // storage owns no allocation, so its elements are only destroyed.
         detail::exception_defer restore([&] {
            if (!temporary.is_inline_stored()) {
               *this = move(temporary);
            }
         });

         *this = move(other);
         restore.commit();
      }

      other = move(temporary);
   }

 private:
   // Swap two inline `vec`s element-wise, then relocate the longer one's
   // extra elements.
   constexpr void
   swap_inline(basic_vec& other) {
      basic_vec* _Nonnull p_short = this;
      basic_vec* _Nonnull p_long = &other;
      if (size() > other.size()) {
         p_short = &other;
         p_long = this;
      }

      idx const shared = p_short->size();
      idx const long_size = p_long->size();
      assert(long_size <= p_short->capacity());
      for (idx i; i < shared; ++i) {
         cat::swap(p_short->data()[i], p_long->data()[i]);
      }

      p_short->annotate_size_change(shared, long_size);
      detail::exception_defer guard([&] {
         p_short->annotate_size_change(long_size, shared);
      });

      relocate<true>(
         p_long->data() + shared, idx(long_size - shared),
         p_short->data() + shared
      );
      guard.commit();
      p_short->m_storage.set_size(long_size);
      p_long->m_storage.set_size(shared);
      p_long->annotate_size_change(long_size, shared);
   }

   // TODO: False positives.
#pragma clang diagnostic push
#pragma clang diagnostic ignored "-Wlifetime-safety-experimental-invalidation"

   // Destroy `count` elements from `p_first` in reverse order. `p_first` may
   // only be null when `count` is zero.
   static constexpr void
   destroy_n_elements(T* _Nullable p_first, idx count) noexcept {
      if constexpr (!is_trivially_destructible<T>) {
         while (count > 0u) {
            count = idx(count - 1u);
            p_first[count].~T();
         }
      }
   }

   // Relocate `count` elements from `p_source` into `p_destination`. Unless
   // `is_move_only`, if a constructor throws then the source is unchanged and
   // the destination is empty, because with exceptions a throwing move
   // constructor is avoided by copying instead.
   template <bool is_move_only = false>
   static constexpr void
   relocate(T* _Nonnull p_source, idx count, T* _Nonnull p_destination) {
      if !consteval {
         if constexpr (is_trivially_relocatable<T>) {
            // Dynamic vectorized copy of eligible types.
            copy_memory(p_source, p_destination, count * sizeof(T));
            return;
         }
      }

      // Other types get a potentially auto-vectorized loop for one platform.
      idx constructed;
      detail::exception_defer guard([&] {
         destroy_n_elements(p_destination, constructed);
      });

      for (; constructed < count; ++constructed) {
         T& source = p_source[constructed];
         T* _Nonnull const p_slot = p_destination + constructed;
         if constexpr (__has_feature(cxx_exceptions) && !is_move_only) {
            new (p_slot) T(move_if_noexcept(source));
         } else if constexpr (is_move_constructible<T>) {
            new (p_slot) T(move(source));
         } else {
            new (p_slot) T(as_const(source));
         }
      }

      guard.commit();
      if constexpr (!is_trivially_destructible<T>) {
         for (idx i; i < count; ++i) {
            p_source[i].~T();
         }
      }
   }

#pragma clang diagnostic pop

   // Construct `count` elements at `p_first`, the `i`th from `make(i)`. If a
   // constructor throws, the elements already built are destroyed.
   template <typename Make>
   static constexpr void
   construct_n_elements(T* _Nonnull p_first, idx count, Make&& make) {
      idx constructed;
      detail::exception_defer guard([&] {
         destroy_n_elements(p_first, constructed);
      });

      for (; constructed < count; ++constructed) {
         new (p_first + constructed) T(make(constructed));
      }

      guard.commit();
   }

   // Whether a contiguous `Range` yields r-values to move from.
   template <typename Range>
   static constexpr bool is_move_range =
      is_rvalue_reference<iterable_element_type<Range>>;

   // Read the `i`th element of `p_source`, moving it if `is_move`.
   template <bool is_move, typename Source>
   [[nodiscard]]
   static constexpr auto
   source_element(
      Source* _Nonnull p_source [[clang::lifetimebound]], idx i
   ) noexcept -> decltype(auto) {
      if constexpr (is_move) {
         return move(p_source[i]);
      } else {
         return p_source[i];
      }
   }

   template <bool is_move, typename Source>
   static constexpr void
   construct_from(
      T* _Nonnull p_destination, Source* _Nonnull p_source, idx count
   ) {
      if !consteval {
         if constexpr (is_trivially_copyable<T>) {
            copy_memory(p_source, p_destination, count * sizeof(T));
            return;
         }
      }

      construct_n_elements(p_destination, count, [&](idx i) -> decltype(auto) {
         return source_element<is_move>(p_source, i);
      });
   }

   // Whether the elements are stored inside this `vec`'s handle.
   [[nodiscard]]
   constexpr auto
   is_inline_stored() const noexcept -> bool {
      if constexpr (detail::vec_storage<T, flags>::is_inline) {
         return m_storage.m_has_handle && m_storage.m_handle.is_inline();
      } else {
         return false;
      }
   }

   // Construct one element at the end.
   template <typename... Args>
   constexpr auto
   construct_back(Args&&... arguments) -> T& {
      idx const old_size = size();
      annotate_size_change(old_size, old_size + 1u);
      detail::exception_defer guard([&] {
         annotate_size_change(old_size + 1u, old_size);
      });

      T* _Nonnull const p_slot = data() + old_size;
      new (p_slot) T($fwd(arguments)...);
      guard.commit();
      m_storage.set_size(old_size + 1u);
      return *p_slot;
   }

   // Construct elements in `[size(), new_size)` with `fill(p_first)`. If any
   // constructor throws, this `vec` is unchanged.
   template <typename Fill>
   constexpr void
   construct_tail(idx new_size, Fill&& fill) {
      idx const old_size = size();
      annotate_size_change(old_size, new_size);

      detail::exception_defer guard([&] {
         // NOLINTNEXTLINE
         annotate_size_change(new_size, old_size);
      });

      fill(data() + old_size);
      guard.commit();
      m_storage.set_size(new_size);
   }

   // Reverse `[first, last)` in place.
   constexpr void
   reverse_range(idx first, idx last) {
      while (first < last) {
         last = idx(last - 1u);
         if (first == last) {
            break;
         }

         cat::swap(data()[first], data()[last]);
         ++first;
      }
   }

   // Rotate `[first, size())` so that the elements from `middle` come first.
   // This moves elements appended at `middle` to `first`.
   constexpr void
   rotate_into_place(idx first, idx middle) {
      reverse_range(first, middle);
      reverse_range(middle, size());
      reverse_range(first, size());
   }

   template <is_allocator Allocator, typename Fill, typename Element>
   constexpr auto
   insert_n_elements(
      allocator_ref<Allocator> allocator, idx position, idx count, Fill&& fill,
      Element&& element
   ) -> maybe<void> {
      idx const old_size = size();
      auto fill_gap = [&](T* _Nonnull p_gap) {
         fill(p_gap, 0u, count);
      };

      if (count > capacity() - old_size) {
         idx const new_capacity = recommend_capacity(old_size + count);

         return reallocate(allocator, new_capacity, position, count, fill_gap);
      }

      idx const after = idx(old_size - position);
      if !consteval {
         if constexpr (is_trivially_copyable<T>) {
            annotate_size_change(old_size, old_size + count);
            copy_memory_backward(
               data() + position, data() + position + count, after * sizeof(T)
            );

            fill_gap(data() + position);
            m_storage.set_size(old_size + count);
            return monostate;
         }
      }

      // Construct the elements which land past the end first, so that every
      // constructed element is immediately owned.
      idx assigned = count;
      if (count > after) {
         construct_tail(position + count, [&](T* _Nonnull p_first) {
            fill(p_first, after, idx(count - after));
         });

         construct_tail(old_size + count, [&](T* _Nonnull p_first) {
            construct_from<true>(p_first, data() + position, after);
         });

         assigned = after;
      } else {
         // The last `count` elements move past the end, and the rest of the
         // tail is move-assigned backwards.
         construct_tail(old_size + count, [&](T* _Nonnull p_first) {
            construct_from<true>(p_first, data() + old_size - count, count);
         });

         for (idx i = idx(after - count); i > 0u; i = idx(i - 1u)) {
            data()[idx(position + count + i - 1u)] =
               move(data()[idx(position + i - 1u)]);
         }
      }

      for (idx i; i < assigned; ++i) {
         data()[position + i] = element(i);
      }

      return monostate;
   }

   // Insert `count` elements from `p_source` before `position`, moving them if
   // `is_move`. `p_source` must not point into this `vec`.
   template <bool is_move, is_allocator Allocator, typename Source>
   constexpr auto
   insert_from(
      allocator_ref<Allocator> allocator, idx position, idx count,
      Source* _Nonnull p_source
   ) -> maybe<void> {
      return insert_n_elements(
         allocator, position, count,
         [&](T* _Nonnull p_first, idx first, idx fill_count) {
            construct_from<is_move>(p_first, p_source + first, fill_count);
         },
         [&](idx i) -> decltype(auto) {
            return source_element<is_move>(p_source, i);
         }
      );
   }

   // Insert `count` elements from `p_source`, which points into this `vec`,
   // before `position`. They are appended while every element is still in
   // place, and then rotated into position, so nothing is copied twice and
   // no temporary storage is needed.
   template <bool is_move, is_allocator Allocator, typename Source>
   constexpr auto
   insert_aliased(
      allocator_ref<Allocator> allocator, idx position, idx count,
      Source* _Nonnull p_source
   ) -> maybe<void> {
      idx const old_size = size();
      auto fill = [&](T* _Nonnull p_gap) {
         construct_from<is_move>(p_gap, p_source, count);
      };

      if (count > capacity() - old_size) {
         // The gap is filled before the old storage is freed.
         $prop(reallocate(
            allocator, recommend_capacity(old_size + count), old_size, count,
            fill
         ));
      } else {
         construct_tail(old_size + count, fill);
      }

      rotate_into_place(position, old_size);
      return monostate;
   }

   template <bool is_move, is_allocator Allocator, typename Source>
   constexpr auto
   replace_n_elements(
      allocator_ref<Allocator> allocator, idx first, idx last, idx count,
      Source* _Nullable p_source
   ) -> maybe<void> {
      idx const removed = idx(last - first);

      if (count == 0u) {
         erase(first, last);
         return monostate;
      }

      // Allocate before any element changes, so that failing to allocate
      // leaves this `vec` unchanged.
      idx const old_size = size();
      idx const new_size = idx(old_size - removed + count);
      if (new_size > capacity()) {
         $prop(reserve(allocator, recommend_capacity(new_size)));
      }

      if !consteval {
         if constexpr (is_trivially_copyable<T>) {
            if (new_size > old_size) {
               annotate_size_change(old_size, new_size);
            }

            copy_memory_backward(
               data() + last, data() + first + count,
               idx(old_size - last) * sizeof(T)
            );

            construct_from<is_move>(data() + first, p_source, count);
            if (new_size < old_size) {
               annotate_size_change(old_size, new_size);
            }

            m_storage.set_size(new_size);
            return monostate;
         }
      }

      // Assign over the replaced elements, then erase or insert the rest.
      idx const overlap = min(count, removed);
      for (idx i; i < overlap; ++i) {
         data()[first + i] = source_element<is_move>(p_source, i);
      }

      if (count < removed) {
         erase(first + count, last);
         return monostate;
      }

      if (count == removed) {
         return monostate;
      }

      return insert_from<is_move>(
         allocator, last, idx(count - removed), p_source + removed
      );
   }

   // Move the contents of `other` into `this`.
   constexpr void
   move_from(basic_vec& other) {
      if constexpr (detail::vec_storage<T, flags>::is_inline) {
         if (other.is_inline_stored()) {
            idx const other_size = other.size();
            idx const other_capacity = other.capacity();
            m_storage.m_handle.set_inlined(true);
            m_storage.m_handle.set_count(other_capacity);
            m_storage.m_has_handle = true;

            // If an element fails to relocate, `other` still owns them all.
            detail::exception_defer guard([&] {
               m_storage.disarm_inline();
            });

            // Only publish the elements once they have all been relocated.
            T* _Nonnull const p_inline = m_storage.m_handle.get_inline_ptr();
            relocate<true>(other.data(), other_size, p_inline);
            guard.commit();
            m_storage.set_layout(p_inline, other_size, other_capacity);
            other.m_storage.disarm_inline();
            other.m_storage.set_layout(nullptr, 0u, 0u);
            return;
         }
      }

      m_storage = move(other.m_storage);
   }

   // Wrap over both inline and non-inline allocations.
   template <is_allocator Allocator>
   constexpr auto
   internal_allocate(allocator_ref<Allocator> allocator, idx minimum_capacity)
      -> maybe<tuple<span<T>, idx>> {
      if constexpr (detail::vec_storage<T, flags>::is_inline) {
         auto [handle, allocation_bytes] = $prop(
            (allocator.template inline_salloc_multi_uninit<
               T, flags.inline_storage_count * sizeof(T)>(minimum_capacity))
         );

         m_storage.m_handle = move(handle);
         m_storage.m_has_handle = true;

         return tuple<span<T>, idx>{
            allocator.get(m_storage.m_handle),
            allocation_bytes,
         };
      } else {
         return allocator.template salloc_multi_uninit<T>(minimum_capacity);
      }
   }

   template <is_allocator Allocator>
   constexpr void
   free_inline_storage(allocator_ref<Allocator> allocator) noexcept(
      !__has_feature(cxx_exceptions)
   ) {
      if (m_storage.m_has_handle) {
         allocator.free_uninit(m_storage.m_handle);
         m_storage.disarm_inline();
         m_storage.m_handle =
            typename detail::vec_storage<T, flags>::handle_type{};
      }
   }

   // Reallocate memory, or make an initial allocation.
   constexpr void
   annotate_size_change(idx old_size, idx new_size) const noexcept {
      if (data() == nullptr) {
         return;
      }

      annotate_contiguous_container(
         data(), data() + capacity(), data() + old_size, data() + new_size
      );
   }

   // Geometric growth to hold at least `minimum_capacity` elements.
   [[nodiscard]]
   constexpr auto
   recommend_capacity(idx minimum_capacity) const noexcept -> idx {
      constexpr idx configured_initial_capacity =
         flags.initial_growth_count == 0u ? 4u : flags.initial_growth_count;
      constexpr idx initial_capacity = detail::vec_storage<T, flags>::is_inline
                                          ? flags.inline_storage_count
                                          : configured_initial_capacity;

      return max(max(capacity() * 2u, initial_capacity), minimum_capacity);
   }

   // Relocate this `vec` into `p_new`, opening a gap of `gap_count` slots at
   // `gap_position` which `fill_gap(p_gap)` constructs.
   template <typename Fill, typename Release>
   constexpr void
   relocate_around_gap(
      T* _Nonnull p_new, idx gap_position, idx gap_count, Fill& fill_gap,
      Release const& release
   ) {
      idx const old_size = size();
      idx const old_capacity = capacity();
      idx const suffix_size = idx(old_size - gap_position);
      T* _Nonnull const p_suffix = p_new + gap_position + gap_count;

      // This is declared first so that it runs last.
      detail::exception_defer release_guard([&] {
         release();
      });

      fill_gap(p_new + gap_position);

      idx relocated_suffix = 0u;
      annotate_size_change(old_size, old_capacity);
      detail::exception_defer guard([&] {
         destroy_n_elements(p_suffix, relocated_suffix);
         destroy_n_elements(p_new + gap_position, gap_count);
         m_storage.set_size(idx(old_size - relocated_suffix));
         annotate_size_change(old_capacity, size());
      });

      if (data() != nullptr) {
         relocate(data() + gap_position, suffix_size, p_suffix);
         relocated_suffix = suffix_size;
         relocate(data(), gap_position, p_new);
      }

      guard.commit();
      release_guard.commit();
   }

   // Move this `vec` into new storage for at least `minimum_capacity`
   // elements around a gap.
   //
   // TODO: When the gap is at the end, first try the allocator's
   // address-stable `alloc_grow_feedback()`, like `folly::fbvector` does with
   // `xallocx()`.
   template <is_allocator Allocator, typename Fill>
   constexpr auto
   reallocate(
      allocator_ref<Allocator> allocator, idx minimum_capacity,
      idx gap_position, idx gap_count, Fill& fill_gap
   ) -> maybe<void> {
      idx const old_capacity = capacity();
      idx const new_size = size() + gap_count;
      // Allocate manually because unused capacity must remain uninitialized.
      if constexpr (detail::vec_storage<T, flags>::is_inline) {
         auto [new_handle, allocation_bytes] = $prop(
            (allocator.template inline_salloc_multi_uninit<
               T, flags.inline_storage_count * sizeof(T)>(minimum_capacity))
         );

         if (new_handle.is_inline()) {
            // Moving a handle copies its inline bytes, so inline elements are
            // built in this `vec`'s own handle.
            assert(!m_storage.m_has_handle);
            m_storage.m_handle = move(new_handle);
            m_storage.m_has_handle = true;

            relocate_around_gap(
               allocator.get(m_storage.m_handle).data(), gap_position,
               gap_count, fill_gap, [&] {
                  free_inline_storage(allocator);
               }
            );
         } else {
            relocate_around_gap(
               allocator.get(new_handle).data(), gap_position, gap_count,
               fill_gap, [&] {
                  allocator.free_uninit(new_handle);
               }
            );

            if (m_storage.m_has_handle) {
               free_inline_storage(allocator);
            }

            m_storage.m_handle = move(new_handle);
            m_storage.m_has_handle = true;
         }

         m_storage.set_layout(
            allocator.get(m_storage.m_handle).data(), new_size,
            allocation_bytes / sizeof(T)
         );
      } else {
         auto [alloc_span, alloc_bytes] =
            $prop(allocator.template salloc_multi_uninit<T>(minimum_capacity));

         relocate_around_gap(
            alloc_span.data(), gap_position, gap_count, fill_gap, [&] {
               allocator.free_multi_uninit(
                  span<T>(alloc_span.data(), alloc_bytes / sizeof(T))
               );
            }
         );

         if (data() != nullptr) {
            allocator.free_multi_uninit(span<T>(data(), old_capacity));
         }

         m_storage.set_layout(
            alloc_span.data(), new_size, alloc_bytes / sizeof(T)
         );
      }

      annotate_size_change(capacity(), new_size);
      return monostate;
   }

   // Construct one element at the end of a full `vec`. This is kept out of
   // line so that it does not bloat every call to `emplace_back()`.
   template <is_allocator Allocator, typename... Args>
   [[gnu::noinline]]
   constexpr auto
   grow_and_emplace_back(
      allocator_ref<Allocator> allocator, Args&&... arguments
   ) [[clang::lifetimebound]] -> maybe<T&> {
      idx const old_size = size();
      // The new element is built before relocating, because `arguments` may
      // refer to an element of this `vec`.
      auto fill = [&](T* _Nonnull p_gap) {
         new (p_gap) T($fwd(arguments)...);
      };

      $prop(reallocate(
         allocator, recommend_capacity(old_size + 1u), old_size, 1u, fill
      ));

      return data()[old_size];
   }

   // Change the size to `new_size`, building new elements with
   // `fill(p_first)`.
   template <is_allocator Allocator, typename Fill>
   constexpr auto
   resize_with(allocator_ref<Allocator> allocator, idx new_size, Fill& fill)
      -> maybe<void> {
      idx const old_size = size();
      if (new_size > capacity()) {
         return reallocate(
            allocator, recommend_capacity(new_size), old_size,
            idx(new_size - old_size), fill
         );
      }

      if (new_size > old_size) {
         construct_tail(new_size, fill);
      } else {
         truncate(new_size);
      }

      return monostate;
   }

 public:
   // Returns `nullptr` when this `vec` is default-constructed or moved-from.
   [[nodiscard]]
   constexpr auto
   data() noexcept [[clang::lifetimebound]] -> T* _Nullable {
      return m_storage.data();
   }

   // Returns `nullptr` when this `vec` is default-constructed or moved-from.
   [[nodiscard]]
   constexpr auto
   data() const noexcept [[clang::lifetimebound]] -> T const* _Nullable {
      return m_storage.data();
   }

   [[nodiscard]]
   constexpr auto
   size() const noexcept -> idx {
      return m_storage.size();
   }

   [[nodiscard]]
   constexpr auto
   capacity() const noexcept -> idx {
      return m_storage.capacity();
   }

   // Destroy every element of this `vec`. Storage is left allocated, the
   // capacity is unchanged, and the size is reset to zero. Memory must be
   // deallocated separately through `.free(allocator)`.
   [[clang::reinitializes]]
   constexpr void
   reset() noexcept
      requires(!flags.is_fixed_size)
   {
      destroy_n_elements(data(), size());
      annotate_size_change(size(), 0u);
      m_storage.set_size(0u);
   }

   // Deallocate this `vec`'s storage from `allocator`.
   template <is_allocator Allocator>
   [[clang::reinitializes]]
   constexpr void
   free(allocator_ref<Allocator> allocator) {
      idx const old_size = size();
      idx const old_capacity = capacity();
      destroy_n_elements(data(), old_size);
      annotate_size_change(old_size, old_capacity);

      if constexpr (detail::vec_storage<T, flags>::is_inline) {
         free_inline_storage(allocator);
      } else if (data() != nullptr) {
         allocator.free_multi_uninit(span<T>(data(), old_capacity));
      }

      m_storage.set_layout(nullptr, 0u, 0u);
   }

   // Deallocate this `vec`'s storage from `allocator`.
   [[clang::reinitializes, gnu::always_inline, gnu::nodebug]]
   constexpr void
   free(allocator_dyn allocator) {
      return free<allocator_dyn>(allocator);
   }

   // Deallocate this `vec`'s storage from `allocator`.
   template <is_allocator Allocator>
   [[clang::reinitializes]]
   constexpr void
   cfree(allocator_ref<Allocator> allocator) {
      idx const old_size = size();
      idx const old_capacity = capacity();
      destroy_n_elements(data(), old_size);
      annotate_size_change(old_size, old_capacity);

      if constexpr (detail::vec_storage<T, flags>::is_inline) {
         if (m_storage.m_has_handle) {
            allocator.cfree_uninit(m_storage.m_handle);
            m_storage.disarm_inline();
            m_storage.m_handle =
               typename detail::vec_storage<T, flags>::handle_type{};
         }
      } else if (data() != nullptr) {
         allocator.cfree_multi_uninit(span<T>(data(), old_capacity));
      }

      m_storage.set_layout(nullptr, 0u, 0u);
   }

   // Deallocate this `vec`'s storage from `allocator`.
   [[clang::reinitializes, gnu::always_inline, gnu::nodebug]]
   constexpr void
   cfree(allocator_dyn allocator) {
      return cfree<allocator_dyn>(allocator);
   }

   template <is_allocator Allocator>
   [[nodiscard]]
   constexpr auto
   initialize_fixed(allocator_ref<Allocator> allocator, idx fixed_size)
      -> maybe<void>
      requires(flags.is_fixed_size && is_default_constructible<T>)
   {
      return initialize_fixed(allocator, fixed_size, [&](T* _Nonnull p_first) {
         construct_n_elements(p_first, fixed_size, [](idx) {
            return T();
         });
      });
   }

 private:
   // Allocate `fixed_size` elements and construct them with `fill(p_first)`.
   // If that throws, the storage is freed.
   template <is_allocator Allocator, typename Fill>
   constexpr auto
   initialize_fixed(
      allocator_ref<Allocator> allocator, idx fixed_size, Fill&& fill
   ) -> maybe<void>
      requires(flags.is_fixed_size)
   {
      if (data() != nullptr) {
         return nullopt;
      }

      if (fixed_size == 0u) {
         return monostate;
      }

      [[maybe_unused]] auto [alloc_span, alloc_bytes] =
         $prop(internal_allocate(allocator, fixed_size));
      detail::exception_defer guard([&] {
         if constexpr (detail::vec_storage<T, flags>::is_inline) {
            free_inline_storage(allocator);
         } else {
            allocator.free_multi_uninit(
               span<T>(alloc_span.data(), alloc_bytes / sizeof(T))
            );
         }
      });

      fill(alloc_span.data());
      guard.commit();
      m_storage.set_layout(alloc_span.data(), fixed_size, fixed_size);
      return monostate;
   }

 public:
   // Try to allocate storage for at least `minimum_capacity` number of `T`s.
   template <is_allocator Allocator>
   [[nodiscard]]
   constexpr auto
   reserve(allocator_ref<Allocator> allocator, idx minimum_capacity)
      -> maybe<void>
      requires(!flags.is_fixed_size)
   {
      if (minimum_capacity > capacity()) {
         auto fill = [](T* _Nonnull) {
         };

         $prop(this->reallocate(allocator, minimum_capacity, size(), 0u, fill));
      }

      // If the new capacity is not larger, do nothing.
      return monostate;
   }

   // Try to allocate storage for at least `minimum_capacity` number of `T`s.
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   reserve(allocator_dyn allocator, idx minimum_capacity) -> maybe<void>
      requires(!flags.is_fixed_size)
   {
      return reserve<allocator_dyn>(allocator, minimum_capacity);
   }

   // Try to change the size of this `vec`.
   template <is_allocator Allocator>
      requires(is_default_constructible<T>)
   [[nodiscard]]
   constexpr auto
   resize(allocator_ref<Allocator> allocator, idx size) -> maybe<void>
      requires(!flags.is_fixed_size)
   {
      idx const old_size = this->size();
      auto fill = [&](T* _Nonnull p_gap) {
         construct_n_elements(p_gap, idx(size - old_size), [](idx) {
            return T();
         });
      };

      return resize_with(allocator, size, fill);
   }

   // Try to change the size of this `vec`.
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   resize(allocator_dyn allocator, idx size) -> maybe<void>
      requires(!flags.is_fixed_size)
   {
      return resize<allocator_dyn>(allocator, size);
   }

   // Try to change the size of this `vec`, copy-constructing any new
   // elements from `value`.
   template <is_allocator Allocator>
      requires(is_copy_constructible<T>)
   [[nodiscard]]
   constexpr auto
   resize(allocator_ref<Allocator> allocator, idx size, T const& value)
      -> maybe<void>
      requires(!flags.is_fixed_size)
   {
      idx const old_size = this->size();

      // `value` may refer to an element of this `vec`, which is still alive
      // while the new elements are built.
      auto fill = [&](T* _Nonnull p_gap) {
         construct_n_elements(
            p_gap, idx(size - old_size), [&](idx) -> T const& {
               return value;
            }
         );
      };

      return resize_with(allocator, size, fill);
   }

   // Try to change the size of this `vec`, default-initializing any new
   // elements. Trivial elements are left uninitialized, to be overwritten.
   template <is_allocator Allocator>
      requires(is_default_constructible<T>)
   [[nodiscard]]
   constexpr auto
   resize_for_overwrite(allocator_ref<Allocator> allocator, idx size)
      -> maybe<void>
      requires(!flags.is_fixed_size)
   {
      idx const old_size = this->size();
      auto fill = [&](T* _Nonnull p_gap) {
         if constexpr (!is_trivially_default_constructible<T>) {
            idx constructed;
            detail::exception_defer guard([&] {
               destroy_n_elements(p_gap, constructed);
            });

            for (; constructed < idx(size - old_size); ++constructed) {
               new (p_gap + constructed) T;
            }

            guard.commit();
         }
      };

      return resize_with(allocator, size, fill);
   }

   // Try to change the size of this `vec`, default-initializing any new
   // elements. Trivial elements are left uninitialized, to be overwritten.
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   resize_for_overwrite(allocator_dyn allocator, idx size) -> maybe<void>
      requires(!flags.is_fixed_size && is_default_constructible<T>)
   {
      return resize_for_overwrite<allocator_dyn>(allocator, size);
   }

   // Destroy the elements from `size` onwards. `size` must not exceed the
   // current size.
   constexpr void
   truncate(idx size) noexcept(!__has_feature(cxx_exceptions))
      requires(!flags.is_fixed_size)
   {
      idx const old_size = this->size();
      assert(size <= old_size);
      destroy_n_elements(data() + size, idx(old_size - size));
      annotate_size_change(old_size, size);
      m_storage.set_size(size);
   }

   // Destroy the last `count` elements, which must exist.
   constexpr void
   pop_back_n(idx count) noexcept(!__has_feature(cxx_exceptions))
      requires(!flags.is_fixed_size)
   {
      assert(count <= size());
      truncate(idx(size() - count));
   }

   // Append `count` copies of `value`, which may be an element of this `vec`.
   template <is_allocator Allocator>
      requires(is_copy_constructible<T>)
   [[nodiscard]]
   constexpr auto
   append(allocator_ref<Allocator> allocator, idx count, T const& value)
      -> maybe<void>
      requires(!flags.is_fixed_size)
   {
      return resize(allocator, size() + count, value);
   }

   // Append `count` copies of `value`, which may be an element of this `vec`.
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   append(allocator_dyn allocator, idx count, T const& value) -> maybe<void>
      requires(!flags.is_fixed_size && is_copy_constructible<T>)
   {
      return append<allocator_dyn>(allocator, count, value);
   }

   // Replace the contents with `count` copies of `value`, which may be an
   // element of this `vec`. Existing storage is reused when it is large
   // enough.
   template <is_allocator Allocator>
      requires(is_copy_constructible<T> && is_copy_assignable<T>)
   [[nodiscard]]
   constexpr auto
   assign(allocator_ref<Allocator> allocator, idx count, T const& value)
      -> maybe<void>
      requires(!flags.is_fixed_size)
   {
      if (is_pointer_in_range(&value, span(*this))) {
         T const copy = value;
         return assign(allocator, count, copy);
      }

      if (count > capacity()) {
         // Nothing needs to be relocated into the new storage.
         reset();
      } else {
         idx const overlap = min(count, size());
         for (idx i; i < overlap; ++i) {
            data()[i] = value;
         }
      }

      return resize(allocator, count, value);
   }

   // Replace the contents with `count` copies of `value`, which may be an
   // element of this `vec`. Existing storage is reused when it is large
   // enough.
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   assign(allocator_dyn allocator, idx count, T const& value) -> maybe<void>
      requires(
         !flags.is_fixed_size
         && is_copy_constructible<T> && is_copy_assignable<T>
      )
   {
      return assign<allocator_dyn>(allocator, count, value);
   }

   // Try to change the size of this `vec`, copy-constructing any new
   // elements from `value`.
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   resize(allocator_dyn allocator, idx size, T const& value) -> maybe<void>
      requires(!flags.is_fixed_size)
   {
      return resize<allocator_dyn>(allocator, size, value);
   }

   // De-allocate excess storage.
   template <is_allocator Allocator>
   [[nodiscard]]
   constexpr auto
   shrink_to_fit(allocator_ref<Allocator> allocator) -> maybe<void> {
      if (capacity() == size()) {
         return monostate;
      }

      if (size() == 0u) {
         free(allocator);
         return monostate;
      }

      if constexpr (!detail::vec_storage<T, flags>::is_inline) {
         if (capacity() <= allocator.minimum_allocation_bytes() / sizeof(T)) {
            return monostate;
         }
      }

      basic_vec replacement;
      $prop(replacement.reserve(allocator, size()));

      if (replacement.capacity() >= capacity()) {
         replacement.free(allocator);
         return monostate;
      }

      idx const old_size = size();
      replacement.annotate_size_change(0u, old_size);
      detail::exception_defer guard([&] {
         replacement.annotate_size_change(old_size, 0u);
         replacement.free(allocator);
      });

      relocate(data(), old_size, replacement.data());
      guard.commit();
      replacement.m_storage.set_size(old_size);
      m_storage.set_size(0u);
      free(allocator);

      *this = move(replacement);
      return monostate;
   }

   // De-allocate excess storage.
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   shrink_to_fit(allocator_dyn allocator) -> maybe<void> {
      return shrink_to_fit<allocator_dyn>(allocator);
   }

   // Deep-copy the contents of this `vec`.
   template <is_allocator NewAllocator>
   [[nodiscard]]
   constexpr auto
   clone(allocator_ref<NewAllocator> allocator) const& -> maybe<vec<T, flags>> {
      // TODO: When allocators gain .remap(), prefer it when allocators compare
      // equal and the allocator can do better than allocate then copy.
      vec<T, flags> new_vector;
      auto fill = [&](T* _Nonnull p_first) {
         if (size() > 0u) {
            construct_from<false>(p_first, data(), size());
         }
      };

      if constexpr (flags.is_fixed_size) {
         $prop(new_vector.initialize_fixed(allocator, size(), fill));
      } else {
         $prop(new_vector.reallocate(
            allocator, max(capacity(), 4u), 0u, size(), fill
         ));
      }

      return move(new_vector);
   }

   // Deep-copy the contents of this `vec`.
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   clone(allocator_dyn allocator) const& -> maybe<vec<T, flags>> {
      return clone<allocator_dyn>(allocator);
   }

   // Small trivially copyable elements are passed by value, which keeps them
   // in registers and cannot alias this `vec`.
   static constexpr bool takes_value_parameter =
      is_trivially_copyable<T> && sizeof(T) <= 2u * sizeof(void*);

   template <is_allocator Allocator>
   [[nodiscard]]
   constexpr auto
   push_back(allocator_ref<Allocator> allocator, T value) -> maybe<void>
      requires(!flags.is_fixed_size && takes_value_parameter)
   {
      if (this->emplace_back(allocator, value).is_empty()) {
         return nullopt;
      }

      return monostate;
   }

   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   push_back(allocator_dyn allocator, T value) -> maybe<void>
      requires(!flags.is_fixed_size && takes_value_parameter)
   {
      return push_back<allocator_dyn>(allocator, value);
   }

   template <is_allocator Allocator>
      requires(is_copy_constructible<T>)
   [[nodiscard]]
   constexpr auto
   push_back(allocator_ref<Allocator> allocator, T const& value) -> maybe<void>
      requires(!flags.is_fixed_size && !takes_value_parameter)
   {
      if (this->emplace_back(allocator, value).is_empty()) {
         return nullopt;
      }

      return monostate;
   }

   template <is_allocator Allocator>
      requires(is_move_constructible<T>)
   [[nodiscard]]
   constexpr auto
   push_back(allocator_ref<Allocator> allocator, T&& value) -> maybe<void>
      requires(!flags.is_fixed_size && !takes_value_parameter)
   {
      if (this->emplace_back(allocator, move(value)).is_empty()) {
         return nullopt;
      }

      return monostate;
   }

   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   push_back(allocator_dyn allocator, T const& value) -> maybe<void>
      requires(!flags.is_fixed_size && !takes_value_parameter)
   {
      return push_back<allocator_dyn>(allocator, value);
   }

   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   push_back(allocator_dyn allocator, T&& value) -> maybe<void>
      requires(!flags.is_fixed_size && !takes_value_parameter)
   {
      return push_back<allocator_dyn>(allocator, move(value));
   }

   template <
      is_allocator Allocator, typename First, typename Second,
      typename... Remaining>
   constexpr auto
   push_back(allocator_ref<Allocator>, First&&, Second&&, Remaining&&...)
      -> maybe<void> = delete (
         "`push_back()` is not variadic! Consider either `emplace_back()` "
         "to construct an element or `append_range()` to "
         "append a range."
      );

   template <typename First, typename Second, typename... Remaining>
   constexpr auto
   push_back(allocator_dyn, First&&, Second&&, Remaining&&...) -> maybe<void> =
      delete ("`push_back()` is not variadic! Consider either `emplace_back()` "
              "to construct an element or `append_range()` to "
              "append a range.");

   template <is_allocator Allocator, typename... Args>
      requires(is_constructible<T, Args...>)
   [[nodiscard]]
   constexpr auto
   emplace_back(allocator_ref<Allocator> allocator, Args&&... arguments)
      [[clang::lifetimebound]] -> maybe<T&>
      requires(!flags.is_fixed_size)
   {
      if (size() == capacity()) [[unlikely]] {
         return grow_and_emplace_back(allocator, $fwd(arguments)...);
      }

      return construct_back($fwd(arguments)...);
   }

   template <typename... Args>
      requires(is_constructible<T, Args...>)
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   emplace_back(allocator_dyn allocator, Args&&... arguments)
      [[clang::lifetimebound]] -> maybe<T&>
      requires(!flags.is_fixed_size)
   {
      return emplace_back<allocator_dyn>(allocator, $fwd(arguments)...);
   }

   // Construct an element before `position`. `arguments` may refer to an
   // element of this `vec`.
   template <is_allocator Allocator, typename... Args>
      requires(
         is_constructible<T, Args...> && is_move_constructible<T>
         && is_assignable<T&, T&&>
      )
   [[nodiscard]]
   constexpr auto
   emplace(
      allocator_ref<Allocator> allocator, idx position, Args&&... arguments
   ) [[clang::lifetimebound]] -> maybe<T&>
      requires(!flags.is_fixed_size)
   {
      assert(position <= size());
      if (position == size()) {
         return emplace_back(allocator, $fwd(arguments)...);
      }

      // Build the element first, because shifting may move what `arguments`
      // refer to.
      T value($fwd(arguments)...);
      $prop(insert_n_elements(
         allocator, position, 1u,
         [&](T* _Nonnull p_first, idx, idx) {
            new (p_first) T(move(value));
         },
         [&](idx) -> T&& {
            return move(value);
         }
      ));
      return data()[position];
   }

   // Construct an element before `position`. `arguments` may refer to an
   // element of this `vec`.
   template <typename... Args>
      requires(
         is_constructible<T, Args...> && is_move_constructible<T>
         && is_assignable<T&, T&&>
      )
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   emplace(allocator_dyn allocator, idx position, Args&&... arguments)
      [[clang::lifetimebound]] -> maybe<T&>
      requires(!flags.is_fixed_size)
   {
      return emplace<allocator_dyn>(allocator, position, $fwd(arguments)...);
   }

   // Insert `value` before `position`. It may be an element of this `vec`.
   template <is_allocator Allocator>
      requires(is_copy_constructible<T> && is_assignable<T&, T&&>)
   [[nodiscard]]
   constexpr auto
   insert(allocator_ref<Allocator> allocator, idx position, T const& value)
      -> maybe<void>
      requires(!flags.is_fixed_size)
   {
      if (emplace(allocator, position, value).is_empty()) {
         return nullopt;
      }

      return monostate;
   }

   // Insert `value` before `position`.
   template <is_allocator Allocator>
      requires(is_move_constructible<T> && is_assignable<T&, T&&>)
   [[nodiscard]]
   constexpr auto
   insert(allocator_ref<Allocator> allocator, idx position, T&& value)
      -> maybe<void>
      requires(!flags.is_fixed_size)
   {
      if (emplace(allocator, position, move(value)).is_empty()) {
         return nullopt;
      }

      return monostate;
   }

   // Insert `value` before `position`. It may be an element of this `vec`.
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   insert(allocator_dyn allocator, idx position, T const& value) -> maybe<void>
      requires(
         !flags.is_fixed_size
         && is_copy_constructible<T> && is_assignable<T&, T&&>
      )
   {
      return insert<allocator_dyn>(allocator, position, value);
   }

   // Insert `value` before `position`.
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   insert(allocator_dyn allocator, idx position, T&& value) -> maybe<void>
      requires(
         !flags.is_fixed_size
         && is_move_constructible<T> && is_assignable<T&, T&&>
      )
   {
      return insert<allocator_dyn>(allocator, position, move(value));
   }

   // Insert `count` copies of `value` before `position`. It may be an element
   // of this `vec`.
   template <is_allocator Allocator>
      requires(
         is_copy_constructible<T> && is_copy_assignable<T>
         && is_assignable<T&, T&&>
      )
   [[nodiscard]]
   constexpr auto
   insert(
      allocator_ref<Allocator> allocator, idx position, idx count,
      T const& value
   ) -> maybe<void>
      requires(!flags.is_fixed_size)
   {
      assert(position <= size());
      if (count == 0u) {
         return monostate;
      }

      // Shifting the tail may move `value`, so copy it first if it aliases.
      if (is_pointer_in_range(&value, span(*this))) {
         T const copy = value;
         return insert(allocator, position, count, copy);
      }

      return insert_n_elements(
         allocator, position, count,
         [&](T* _Nonnull p_first, idx, idx fill_count) {
            construct_n_elements(p_first, fill_count, [&](idx) -> T const& {
               return value;
            });
         },
         [&](idx) -> T const& {
            return value;
         }
      );
   }

   // Insert `count` copies of `value` before `position`. It may be an element
   // of this `vec`.
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   insert(allocator_dyn allocator, idx position, idx count, T const& value)
      -> maybe<void>
      requires(
         !flags.is_fixed_size && is_copy_constructible<T>
         && is_copy_assignable<T> && is_assignable<T&, T&&>
      )
   {
      return insert<allocator_dyn>(allocator, position, count, value);
   }

   // Remove and return the last element. Returns `nullopt` when the vec
   // is empty.
   [[nodiscard]]
   constexpr auto
   pop_back() -> maybe<T>
      requires(is_move_constructible<T> && !flags.is_fixed_size)
   {
      if (size() == 0u) {
         return nullopt;
      }

      idx const new_size = idx(size() - 1u);
      T result = move(data()[new_size]);
      m_storage.set_size(new_size);
      destroy_n_elements(data() + new_size, 1u);
      annotate_size_change(new_size + 1u, new_size);
      return result;
   }

   // Destroy every element of this `vec`. Storage is left allocated and the
   // capacity is unchanged. This is equivalent to `.reset()`.
   [[clang::reinitializes]]
   constexpr void
   clear() noexcept
      requires(!flags.is_fixed_size)
   {
      reset();
   }

   // Remove the element at `index`, shifting subsequent elements left.
   constexpr void
   erase(idx index) noexcept(false)
      requires(is_assignable<T&, T&&> && !flags.is_fixed_size)
   {
      assert(index < size());
      erase(index, index + 1u);
   }

   // Remove the elements in the half-open range `[start, end)`, shifting
   // subsequent elements left.
   constexpr void
   erase(idx start, idx end) noexcept(false)
      requires(is_assignable<T&, T&&> && !flags.is_fixed_size)
   {
      assert(start <= end);
      assert(end <= size());
      auto const count = end - start;
      if (count == 0u) {
         return;
      }

      idx const old_size = size();
      idx const moved = idx(old_size - end);
      if !consteval {
         if constexpr (is_trivially_copyable<T>) {
            copy_memory_backward(
               data() + end, data() + start, moved * sizeof(T)
            );
            truncate(idx(old_size - count));
            return;
         }
      }

      for (idx i; i < moved; ++i) {
         data()[start + i] = move(data()[end + i]);
      }

      truncate(idx(old_size - count));
   }

   // Append every element of `range` to the end of this `vec`.
   template <is_allocator Allocator, typename Range>
      requires(
         is_contiguous_iterable<Range>
         && is_same<remove_cvref<decltype(*declval<Range&>().data())>, T>
         && !flags.is_fixed_size
      )
   [[nodiscard]]
   constexpr auto
   append_range(allocator_ref<Allocator> allocator, Range&& range)
      -> maybe<void> {
      idx const count = idx(range.size());
      if (count == 0u) {
         return monostate;
      }

      // `range` may be part of this `vec`. It is read before the old storage
      // is freed, and appending never moves an existing element.
      idx const old_size = size();
      auto fill = [&](T* _Nonnull p_gap) {
         construct_from<is_move_range<Range>>(p_gap, range.data(), count);
      };

      if (count > capacity() - old_size) {
         return this->reallocate(
            allocator, recommend_capacity(old_size + count), old_size, count,
            fill
         );
      }

      construct_tail(old_size + count, fill);
      return monostate;
   }

   // Append every element of `range` to the end of this `vec`.
   template <is_allocator Allocator, is_iterable Iterable>
      requires(
         (!is_contiguous_iterable<Iterable>
          || !is_same<remove_cvref<decltype(*declval<Iterable&>().data())>, T>)
         && !flags.is_fixed_size
      )
   [[nodiscard]]
   constexpr auto
   append_range(allocator_ref<Allocator> allocator, Iterable&& range)
      -> maybe<void> {
      if constexpr (has_size<Iterable>) {
         idx const new_size = size() + idx(range.size());
         if (new_size > capacity()) {
            $prop(this->reserve(allocator, recommend_capacity(new_size)));
         }
      }

      // Append each element, stopping at the first failure.
      maybe<void> result = monostate;
      cat::iterate(range).run_while([&](auto&& value) -> bool {
         result = this->push_back(allocator, $fwd(value));
         return result.has_value();
      });

      return result;
   }

   // Append every element of `range` to the end of this `vec`.
   template <is_iterable Iterable>
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   append_range(allocator_dyn allocator, Iterable&& range) -> maybe<void>
      requires(!flags.is_fixed_size)
   {
      return append_range<allocator_dyn>(allocator, $fwd(range));
   }

   // Insert every element of `range` before `position`.
   template <is_allocator Allocator, typename Range>
      requires(
         is_contiguous_iterable<Range>
         && is_same<remove_cvref<decltype(*declval<Range&>().data())>, T>
         && !flags.is_fixed_size
      )
   [[nodiscard]]
   constexpr auto
   insert_range(allocator_ref<Allocator> allocator, idx position, Range&& range) noexcept(
      !__has_feature(cxx_exceptions)
      && is_nothrow_constructible<T, iterable_element_type<Range>>
      && is_nothrow_assignable<T&, iterable_element_type<Range>>
      && is_nothrow_move_constructible<T> && is_nothrow_move_assignable<T>
   ) -> maybe<void>
      requires(is_assignable<T&, T&&>)
   {
      assert(position <= size());
      idx const count = idx(range.size());
      if (count == 0u) {
         return monostate;
      }

      if (is_pointer_in_range(range.data(), span(*this))) {
         return insert_aliased<is_move_range<Range>>(
            allocator, position, count, range.data()
         );
      }

      return insert_from<is_move_range<Range>>(
         allocator, position, count, range.data()
      );
   }

   // Insert every element of `range` before `position`. A single-pass range
   // is appended and then rotated into place.
   template <is_allocator Allocator, is_iterable Iterable>
      requires(
         (!is_contiguous_iterable<Iterable>
          || !is_same<remove_cvref<decltype(*declval<Iterable&>().data())>, T>)
         && is_assignable<T&, T&&> && !flags.is_fixed_size
      )
   [[nodiscard]]
   constexpr auto
   insert_range(
      allocator_ref<Allocator> allocator, idx position, Iterable&& range
   ) noexcept(false) -> maybe<void> {
      assert(position <= size());
      idx const old_size = size();
      maybe<void> const result = this->append_range(allocator, $fwd(range));
      rotate_into_place(position, old_size);
      return result;
   }

   // Insert every element of `range` before `position`.
   template <is_iterable Iterable>
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   insert_range(allocator_dyn allocator, idx position, Iterable&& range)
      -> maybe<void>
      requires(is_assignable<T&, T&&> && !flags.is_fixed_size)
   {
      return insert_range<allocator_dyn>(allocator, position, $fwd(range));
   }

   // Replace `[first, last)` with every element of `range`.
   template <is_allocator Allocator, typename Range>
      requires(
         is_contiguous_iterable<Range>
         && is_same<remove_cvref<decltype(*declval<Range&>().data())>, T>
         && !flags.is_fixed_size
      )
   [[nodiscard]]
   constexpr auto
   replace_with_range(allocator_ref<Allocator> allocator, idx first, idx last, Range&& range) noexcept(
      !__has_feature(cxx_exceptions)
      && is_nothrow_constructible<T, iterable_element_type<Range>>
      && is_nothrow_assignable<T&, iterable_element_type<Range>>
      && is_nothrow_move_constructible<T> && is_nothrow_move_assignable<T>
   ) -> maybe<void>
      requires(is_assignable<T&, T&&>)
   {
      assert(first <= last);
      assert(last <= size());
      idx const count = idx(range.size());
      if (count != 0u && is_pointer_in_range(range.data(), span(*this))) {
         // Insert the new elements after the replaced ones, which leaves
         // those in place to be erased.
         $prop(
            insert_aliased<is_move_range<Range>>(
               allocator, last, count, range.data()
            )
         );
         erase(first, last);
         return monostate;
      }

      return replace_n_elements<is_move_range<Range>>(
         allocator, first, last, count, range.data()
      );
   }

   // Replace `[first, last)` with every element of `range`.
   template <is_allocator Allocator, is_iterable Iterable>
      requires(
         (!is_contiguous_iterable<Iterable>
          || !is_same<remove_cvref<decltype(*declval<Iterable&>().data())>, T>)
         && is_assignable<T&, T&&> && !flags.is_fixed_size
      )
   [[nodiscard]]
   constexpr auto
   replace_with_range(
      allocator_ref<Allocator> allocator, idx first, idx last, Iterable&& range
   ) -> maybe<void> {
      assert(first <= last);
      assert(last <= size());
      basic_vec replacement;
      detail::exception_defer guard([&] {
         replacement.free(allocator);
      });

      maybe<void> result = replacement.append_range(allocator, $fwd(range));
      if (result.has_value()) {
         result = replace_n_elements<true>(
            allocator, first, last, replacement.size(), replacement.data()
         );
      }

      guard.commit();
      replacement.free(allocator);
      return result;
   }

   // Replace `[first, last)` with every element of `range`.
   template <is_iterable Iterable>
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   replace_with_range(
      allocator_dyn allocator, idx first, idx last, Iterable&& range
   ) -> maybe<void>
      requires(is_assignable<T&, T&&> && !flags.is_fixed_size)
   {
      return replace_with_range<allocator_dyn>(
         allocator, first, last, $fwd(range)
      );
   }

   // Replace the contents with every element of `range`, which may be part of
   // this `vec`. Existing storage is reused when it is large enough.
   template <is_allocator Allocator, is_iterable Iterable>
   [[nodiscard]]
   constexpr auto
   assign_range(allocator_ref<Allocator> allocator, Iterable&& range)
      -> maybe<void>
      requires(is_assignable<T&, T&&> && !flags.is_fixed_size)
   {
      return replace_with_range(allocator, 0u, size(), $fwd(range));
   }

   // Replace the contents with every element of `range`, which may be part of
   // this `vec`. Existing storage is reused when it is large enough.
   template <is_iterable Iterable>
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   assign_range(allocator_dyn allocator, Iterable&& range) -> maybe<void>
      requires(is_assignable<T&, T&&> && !flags.is_fixed_size)
   {
      return assign_range<allocator_dyn>(allocator, $fwd(range));
   }

   // Maximum number of elements this `vec` can theoretically hold, bounded
   // by the address space rather than any allocator's actual ceiling.
   [[nodiscard]]
   static constexpr auto
   max_size() noexcept -> idx {
      return idx::max() / sizeof(T);
   }

 private:
   template <typename U, vec_flags other_flags>
   friend constexpr auto
   detail::maybe_vec_has_value(basic_vec<U, other_flags> const&) -> bool;

   template <typename U, vec_flags other_flags>
   friend constexpr auto
   detail::maybe_vec_nullopt() -> basic_vec<U, other_flags>;

   detail::vec_storage<T, flags> m_storage;
};

