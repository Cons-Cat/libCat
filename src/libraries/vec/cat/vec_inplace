// -*- mode: c++ -*-
// vim: set ft=cpp:
#pragma once

// `cat::vec_inplace` is a fixed-capacity contiguous owning container that
// stores its elements inline, inspired by `std::inplace_vector`. Upon
// construction, the `vec_inplace` is empty. Size exceeding `inline_capacity`
// fails because it cannot allocate.
//
// The interface is informed by the following papers:
//
// P0843R14  `inplace_vector`. A dynamically-resizable vector with fixed
//           capacity and embedded storage.
//
// P3981R2   Better return types. `emplace_back` and `push_back` return
//           `maybe<T&>` instead of `T*`. Unlike `std::inplace_vector`, its
//           failable methods are not prefixed `try_` because all `vec` family
//           methods are failable, so symmetry is preserved.
//
// TODO: We need a flag for storing size and capacity in the allocation next to
// a VLA to make a safe VLA handle container.

#include <cat/algorithm>
#include <cat/container>
#include <cat/iterable>
#include <cat/maybe>
#include <cat/propagate>
#include <cat/span>
#include <cat/utility>

namespace cat {

template <typename T, idx inline_capacity>
class [[clang::trivial_abi, gsl::Owner]]
vec_inplace : public container_interface<vec_inplace<T, inline_capacity>, T>,
              public random_access_stepanov_iterable_interface<T> {
   static_assert(
      is_same<remove_cvref<T>, T>,
      "`T` must not be cv-qualified or a reference."
   );

   template <typename U, idx other_capacity>
   friend class vec_inplace;

 public:
   constexpr vec_inplace() = default;

   constexpr vec_inplace(
      vec_inplace const& other
   ) noexcept(is_nothrow_copy_constructible<T>)
      requires(is_copy_constructible<T>)
   {
      // The destructor does not run if this constructor throws.
      detail::exception_defer guard([&] {
         clear();
      });
      for (T const& value : other) {
         construct_back(value);
      }
      guard.commit();
   }

   constexpr vec_inplace(vec_inplace const&)
      requires(!is_copy_constructible<T>)
   = delete;

   constexpr vec_inplace(
      vec_inplace&& other
   ) noexcept(is_nothrow_move_constructible<T>)
      requires(is_move_constructible<T>)
   {
      detail::exception_defer guard([&] {
         clear();
      });
      for (T& value : other) {
         construct_back(move(value));
      }
      guard.commit();
      other.clear();
   }

   constexpr vec_inplace(vec_inplace&&)
      requires(!is_move_constructible<T>)
   = delete;

   constexpr auto
   operator=(
      vec_inplace const& other
   ) noexcept(is_nothrow_copy_constructible<T>) -> vec_inplace&
      requires(is_copy_constructible<T>)
   {
      if (this == __builtin_addressof(other)) {
         return *this;
      }
      clear();
      for (T const& value : other) {
         construct_back(value);
      }
      return *this;
   }

   constexpr auto
   operator=(vec_inplace const&) -> vec_inplace&
      requires(!is_copy_constructible<T>)
   = delete;

   constexpr auto
   operator=(vec_inplace&& other) noexcept(is_nothrow_move_constructible<T>)
      -> vec_inplace&
      requires(is_move_constructible<T>)
   {
      if (this == __builtin_addressof(other)) {
         return *this;
      }
      clear();
      for (T& value : other) {
         construct_back(move(value));
      }
      other.clear();
      return *this;
   }

   constexpr auto
   operator=(vec_inplace&&) -> vec_inplace&
      requires(!is_move_constructible<T>)
   = delete;

   constexpr ~vec_inplace() {
      clear();
   }

   template <idx other_capacity>
   [[nodiscard]]
   constexpr auto
   operator==(vec_inplace<T, other_capacity> const& other) const -> bool
      requires(is_equality_comparable<T>)
   {
      if (size() != other.size()) {
         return false;
      }
      for (idx index = 0u; index < size(); ++index) {
         if (!(data()[index] == other.data()[index])) {
            return false;
         }
      }
      return true;
   }

   template <idx other_capacity>
   [[nodiscard]]
   constexpr auto
   operator<=>(vec_inplace<T, other_capacity> const& other) const
      requires(requires(T const& left, T const& right) { left <=> right; })
   {
      return lexicographical_compare_three_way(
         this->begin(), this->end(), other.begin(), other.end()
      );
   }

   [[nodiscard, gnu::returns_nonnull]]
   constexpr auto
   data() noexcept [[clang::lifetimebound]] -> T* _Nonnull {
      if constexpr (uses_preconstructed_storage) {
         return m_storage;
      } else {
         return reinterpret_cast<T*>(m_storage);
      }
   }

   [[nodiscard, gnu::returns_nonnull]]
   constexpr auto
   data() const noexcept [[clang::lifetimebound]] -> T const* _Nonnull {
      if constexpr (uses_preconstructed_storage) {
         return m_storage;
      } else {
         return reinterpret_cast<T const*>(m_storage);
      }
   }

   [[nodiscard]]
   constexpr auto
   size() const noexcept -> idx {
      return m_size;
   }

   [[nodiscard]]
   static constexpr auto
   capacity() noexcept -> idx {
      return inline_capacity;
   }

   [[nodiscard]]
   static constexpr auto
   max_size() noexcept -> idx {
      return inline_capacity;
   }

   [[nodiscard]]
   constexpr auto
   reserve(idx minimum_capacity) const -> maybe<void> {
      if (minimum_capacity > inline_capacity) {
         return nullopt;
      }
      return monostate;
   }

   template <typename... Args>
      requires(is_constructible<T, Args...>)
   [[nodiscard]]
   constexpr auto
   emplace_back(Args&&... arguments) [[clang::lifetimebound]] -> maybe<T&> {
      if (this->is_full()) {
         return nullopt;
      }
      return construct_back($fwd(arguments)...);
   }

   [[nodiscard]]
   constexpr auto
   push_back(T const& value) [[clang::lifetimebound]] -> maybe<T&>
      requires(is_copy_constructible<T>)
   {
      return emplace_back(value);
   }

   [[nodiscard]]
   constexpr auto
   push_back(T&& value) [[clang::lifetimebound]] -> maybe<T&>
      requires(is_move_constructible<T>)
   {
      return emplace_back(move(value));
   }

   template <typename... Args>
      requires(is_constructible<T, Args...>)
   constexpr auto
   unchecked_emplace_back(Args&&... arguments) noexcept(false)
      [[clang::lifetimebound]] -> T& {
      assert(!this->is_full());
      return construct_back($fwd(arguments)...);
   }

   constexpr auto
   unchecked_push_back(T const& value) [[clang::lifetimebound]] -> T&
      requires(is_copy_constructible<T>)
   {
      return unchecked_emplace_back(value);
   }

   constexpr auto
   unchecked_push_back(T&& value) [[clang::lifetimebound]] -> T&
      requires(is_move_constructible<T>)
   {
      return unchecked_emplace_back(move(value));
   }

   [[nodiscard]]
   constexpr auto
   resize(idx new_size) -> maybe<void>
      requires(is_default_constructible<T>)
   {
      if (new_size > inline_capacity) {
         return nullopt;
      }
      resize_unchecked(new_size);
      return monostate;
   }

   [[nodiscard]]
   constexpr auto
   resize(idx new_size, T const& value) -> maybe<void>
      requires(is_copy_constructible<T>)
   {
      if (new_size > inline_capacity) {
         return nullopt;
      }
      resize_unchecked(new_size, value);
      return monostate;
   }

   // Append `count` copies of `value`, which may be an element of this
   // `vec_inplace`.
   [[nodiscard]]
   constexpr auto
   append(idx count, T const& value) -> maybe<void>
      requires(is_copy_constructible<T>)
   {
      if (count > inline_capacity - size()) {
         return nullopt;
      }
      resize_unchecked(size() + count, value);
      return monostate;
   }

   // Append every element of `range`. If constructing an element throws, the
   // elements appended before it are kept.
   template <is_iterable Range>
   [[nodiscard]]
   constexpr auto
   append_range(Range&& range) -> maybe<void> {
      if constexpr (has_size<Range>) {
         idx const count = range.size();
         if (count > inline_capacity - size()) {
            return nullopt;
         }

         for (auto&& value : range) {
            construct_back($fwd(value));
         }

         return monostate;
      } else {
         // The size of a single-pass range is only known by reaching its end,
         // so roll back if it overflows.
         idx const old_size = size();
         bool does_fit = true;
         iterate(range).run_while([&](auto&& value) -> bool {
            if (this->is_full()) {
               does_fit = false;
               return false;
            }

            construct_back($fwd(value));
            return true;
         });

         if (!does_fit) {
            destroy_back_to(old_size);
            return nullopt;
         }

         return monostate;
      }
   }

   // Construct an element before `position`. `arguments` may refer to an
   // element of this `vec_inplace`.
   template <typename... Args>
      requires(
         is_constructible<T, Args...> && is_move_constructible<T>
         && is_move_assignable<T>
      )
   [[nodiscard]]
   constexpr auto
   emplace(idx position, Args&&... arguments) [[clang::lifetimebound]]
   -> maybe<T&> {
      assert(position <= size());
      if (this->is_full()) {
         return nullopt;
      }

      idx const old_size = size();
      construct_back($fwd(arguments)...);
      rotate_into_place(position, old_size);
      return data()[position];
   }

   // Insert `value` before `position`.
   [[nodiscard]]
   constexpr auto
   insert(idx position, T const& value) -> maybe<void>
      requires(is_copy_constructible<T> && is_move_assignable<T>)
   {
      if (emplace(position, value).is_empty()) {
         return nullopt;
      }
      return monostate;
   }

   // Insert `value` before `position`.
   [[nodiscard]]
   constexpr auto
   insert(idx position, T&& value) -> maybe<void>
      requires(is_move_constructible<T> && is_move_assignable<T>)
   {
      if (emplace(position, move(value)).is_empty()) {
         return nullopt;
      }
      return monostate;
   }

   // Insert `count` copies of `value` before `position`.
   [[nodiscard]]
   constexpr auto
   insert_n(idx position, idx count, T const& value) -> maybe<void>
      requires(is_copy_constructible<T> && is_move_assignable<T>)
   {
      assert(position <= size());
      idx const old_size = size();
      $prop(append(count, value));
      rotate_into_place(position, old_size);
      return monostate;
   }

   // Insert every element of `range` before `position`. They are appended and
   // then rotated into place, so `range` may be part of this `vec_inplace`.
   template <is_iterable Range>
      requires(is_move_constructible<T> && is_move_assignable<T>)
   [[nodiscard]]
   constexpr auto
   insert_range(idx position, Range&& range) -> maybe<void> {
      assert(position <= size());
      idx const old_size = size();
      $prop(append_range($fwd(range)));
      rotate_into_place(position, old_size);
      return monostate;
   }

   // Replace `[first, last)` with every element of `range`, which may be part
   // of this `vec_inplace`.
   template <is_iterable Range>
      requires(is_move_constructible<T> && is_move_assignable<T>)
   [[nodiscard]]
   constexpr auto
   replace_with_range(idx first, idx last, Range&& range) -> maybe<void> {
      assert(first <= last);
      assert(last <= size());
      if constexpr (
         is_contiguous_iterable<Range>
         && is_same<remove_cvref<decltype(*declval<Range&>().data())>, T>
      ) {
         if (!is_pointer_in_range(range.data(), span(*this))) {
            constexpr bool is_move =
               is_rvalue_reference<iterable_element_type<Range>>;
            return replace_n_elements<is_move>(
               first, last, range.size(), range.data()
            );
         }
      }

      vec_inplace replacement;
      $prop(replacement.append_range($fwd(range)));
      return replace_n_elements<true>(
         first, last, replacement.size(), replacement.data()
      );
   }

   // Replace the contents with every element of `range`.
   template <is_iterable Range>
      requires(is_move_constructible<T> && is_move_assignable<T>)
   [[nodiscard]]
   constexpr auto
   assign_range(Range&& range) -> maybe<void> {
      return replace_with_range(0u, size(), $fwd(range));
   }

   // Replace the contents with `count` copies of `value`.
   [[nodiscard]]
   constexpr auto
   assign(idx count, T const& value) -> maybe<void>
      requires(is_copy_constructible<T> && is_copy_assignable<T>)
   {
      if (count > inline_capacity) {
         return nullopt;
      }

      // If `value` is an element, it is only destroyed after its last use.
      idx const overlap = min(count, size());
      for (idx i; i < overlap; ++i) {
         data()[i] = value;
      }
      resize_unchecked(count, value);
      return monostate;
   }

   [[nodiscard]]
   constexpr auto
   pop_back() -> maybe<T>
      requires(is_move_constructible<T>)
   {
      if (this->is_empty()) {
         return nullopt;
      }
      T result = move(data()[idx(m_size - 1u)]);
      m_size = idx(m_size - 1u);
      destroy(m_size);
      return result;
   }

   [[clang::reinitializes]]
   constexpr void
   clear() noexcept {
      destroy_back_to(0u);
   }

   // Destroy the elements from `new_size` onwards. `new_size` must not exceed
   // the current size.
   constexpr void
   truncate(idx new_size) noexcept(!__has_feature(cxx_exceptions)) {
      assert(new_size <= size());
      destroy_back_to(new_size);
   }

   // Destroy the last `count` elements, which must exist.
   constexpr void
   pop_back_n(idx count) noexcept(!__has_feature(cxx_exceptions)) {
      assert(count <= size());
      destroy_back_to(idx(size() - count));
   }

   constexpr void
   erase(idx index) noexcept(false)
      requires(is_move_assignable<T>)
   {
      assert(index < size());
      for (idx source = index + 1u; source < size(); ++source) {
         data()[idx(source - 1u)] = move(data()[source]);
      }
      m_size = idx(m_size - 1u);
      destroy(m_size);
   }

   constexpr void
   erase(idx first, idx last) noexcept(false)
      requires(is_move_assignable<T>)
   {
      assert(first <= last);
      assert(last <= size());
      if (first == last) {
         return;
      }
      idx const count = idx(last - first);
      idx const old_size = size();
      for (idx source = last; source < old_size; ++source) {
         data()[idx(source - count)] = move(data()[source]);
      }
      m_size = idx(m_size - count);
      for (idx index = m_size; index < old_size; ++index) {
         destroy(index);
      }
   }

   constexpr void
   swap(vec_inplace& other) noexcept(is_nothrow_move_constructible<T>)
      requires(is_move_constructible<T>)
   {
      if (this == __builtin_addressof(other)) {
         return;
      }
      vec_inplace temporary(move(*this));
      *this = move(other);
      other = move(temporary);
   }

 private:
   template <typename... Args>
   constexpr auto
   construct_back(Args&&... arguments) -> T& {
      T* _Nonnull const p_value = data() + m_size;
      if constexpr (uses_preconstructed_storage) {
         *p_value = T($fwd(arguments)...);
      } else {
         new (p_value) T($fwd(arguments)...);
      }
      ++m_size;
      return *p_value;
   }

   constexpr void
   destroy(idx index) {
      if constexpr (!is_trivially_destructible<T>) {
         data()[index].~T();
      }
   }

   // Reverse `[first, last)` in place.
   constexpr void
   reverse_range(idx first, idx last) {
      while (first < last) {
         last = idx(last - 1u);
         if (first == last) {
            break;
         }

         cat::swap(data()[first], data()[last]);
         ++first;
      }
   }

   // Rotate `[first, size())` so that the elements from `middle` come first.
   // This moves elements appended at `middle` to `first`.
   constexpr void
   rotate_into_place(idx first, idx middle) {
      reverse_range(first, middle);
      reverse_range(middle, size());
      reverse_range(first, size());
   }

   // Destroy elements from the back until `size()` is `new_size`.
   constexpr void
   destroy_back_to(idx new_size) noexcept {
      while (m_size > new_size) {
         m_size = idx(m_size - 1u);
         destroy(m_size);
      }
   }

   // If constructing a new element throws, every new element is destroyed, so
   // this has no effects.
   template <typename... Args>
   constexpr void
   resize_unchecked(idx new_size, Args const&... arguments) {
      idx const old_size = size();
      detail::exception_defer guard([&] {
         destroy_back_to(old_size);
      });
      while (m_size < new_size) {
         construct_back(arguments...);
      }
      guard.commit();
      destroy_back_to(new_size);
   }

   // Replace `[first, last)` with `count` elements from `p_source`, moving
   // them if `is_move`. `p_source` must not point into this `vec_inplace`.
   template <bool is_move, typename Source>
   constexpr auto
   replace_n_elements(idx first, idx last, idx count, Source* _Nonnull p_source)
      -> maybe<void> {
      idx const removed = idx(last - first);
      idx const old_size = size();
      if (count > inline_capacity - idx(old_size - removed)) {
         return nullopt;
      }

      auto source = [&](idx i) -> decltype(auto) {
         if constexpr (is_move) {
            return move(p_source[i]);
         } else {
            return p_source[i];
         }
      };

      // Assign over the replaced elements, then erase or insert the rest.
      idx const overlap = min(count, removed);
      for (idx i; i < overlap; ++i) {
         data()[first + i] = source(i);
      }

      if (count < removed) {
         erase(first + count, last);
         return monostate;
      }

      for (idx i = overlap; i < count; ++i) {
         construct_back(source(i));
      }
      rotate_into_place(last, old_size);
      return monostate;
   }

   static constexpr bool uses_preconstructed_storage =
      is_trivially_copyable<T> && is_default_constructible<T>
      && is_move_assignable<T>;

   using storage_element = conditional<uses_preconstructed_storage, T, byte>;

   static constexpr __SIZE_TYPE__ storage_count =
      inline_capacity == 0u
         ? 1u
         : inline_capacity * (uses_preconstructed_storage ? 1u : sizeof(T));

   alignas(T) storage_element m_storage[storage_count]{};
   idx m_size = 0u;
};

template <typename T, idx inline_capacity>
[[nodiscard]]
constexpr auto
make_vec_inplace_filled(idx count, T const& value)
   -> maybe<vec_inplace<T, inline_capacity>> {
   vec_inplace<T, inline_capacity> result;
   $prop(result.resize(count, value));
   return result;
}

template <typename T, idx inline_capacity, typename Generator>
[[nodiscard]]
constexpr auto
make_vec_inplace_filled_random(idx count, Generator&& generator)
   -> maybe<vec_inplace<T, inline_capacity>> {
   static_assert(is_default_constructible<T>);
   static_assert(is_assignable<T&, decltype(declval<Generator&>()())>);
   vec_inplace<T, inline_capacity> result;
   $prop(result.resize(count));
   result.fill_random($fwd(generator));
   return result;
}

template <
   typename T, idx inline_capacity, typename Generator, typename Distribution>
[[nodiscard]]
constexpr auto
make_vec_inplace_filled_random(
   idx count, Generator&& generator, Distribution&& distribution
) -> maybe<vec_inplace<T, inline_capacity>> {
   static_assert(is_default_constructible<T>);
   static_assert(
      is_assignable<
         T&, decltype(declval<Distribution&>()(declval<Generator&>()))>
   );
   vec_inplace<T, inline_capacity> result;
   $prop(result.resize(count));
   result.fill_random($fwd(generator), $fwd(distribution));
   return result;
}

}  // namespace cat
