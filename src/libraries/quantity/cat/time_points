namespace detail {

inline constexpr idx leap_second_count =
   sizeof(leap_seconds) / sizeof(leap_seconds[0]);

[[nodiscard]]
constexpr auto
leap_second_transition(idx index) -> int8 {
   return leap_seconds[index].date.seconds_since_epoch();
}

[[nodiscard]]
constexpr auto
is_gregorian_leap_year(int8 year) -> bool {
   return year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
}

[[nodiscard]]
constexpr auto
days_in_month(int8 year, uint1 month) -> uint1 {
   switch (month.raw) {
      case 2:
         return uint1(is_gregorian_leap_year(year) ? 29 : 28);
      case 4:
      case 6:
      case 9:
      case 11:
         return 30;
      default:
         return 31;
   }
}

[[nodiscard]]
constexpr auto
valid_utc_fields(utc_date_time value) -> bool {
   int8 const year = value.year;
   return value.month >= 1 && value.month <= 12 && value.day >= 1
          && value.day <= days_in_month(year, value.month) && value.hour < 24
          && value.minute < 60 && value.second <= 60;
}

[[nodiscard]]
constexpr auto
days_from_civil(int8 year, uint1 month, uint1 day) -> int8 {
   year = year - int8(month <= 2);
   int8 const era = (year >= 0 ? year : year - 399) / 400;
   int8 const year_of_era = year - era * 400;
   int8 const shifted_month = int8(month) + (month > 2 ? int8(-3) : int8(9));
   int8 const day_of_year = (153 * shifted_month + 2) / 5 + int8(day) - 1;
   int8 const day_of_era =
      year_of_era * 365 + year_of_era / 4 - year_of_era / 100 + day_of_year;
   return era * 146'097 + day_of_era - 719'468;
}

[[nodiscard]]
constexpr auto
civil_from_days(int8 days) -> utc_date_time {
   days = days + 719'468;
   int8 const era = (days >= 0 ? days : days - 146'096) / 146'097;
   int8 const day_of_era = days - era * 146'097;
   int8 const year_of_era = (day_of_era - day_of_era / 1'460
                             + day_of_era / 36'524 - day_of_era / 146'096)
                            / 365;
   int8 year = year_of_era + era * 400;
   int8 const day_of_year =
      day_of_era - (365 * year_of_era + year_of_era / 4 - year_of_era / 100);
   int8 const month_prime = (5 * day_of_year + 2) / 153;
   int8 const day = day_of_year - (153 * month_prime + 2) / 5 + 1;
   int8 const month = month_prime + (month_prime < 10 ? 3 : -9);
   year = year + int8(month <= 2);
   return {
      .year = int4(year),
      .month = uint1(month),
      .day = uint1(day),
      .hour = 0,
      .minute = 0,
      .second = 0,
   };
}

[[nodiscard]]
constexpr auto
posix_seconds_from_civil(utc_date_time value) -> int8 {
   return days_from_civil(value.year, value.month, value.day) * 86'400
          + int8(value.hour) * 3'600 + int8(value.minute) * 60
          + int8(value.second);
}

[[nodiscard]]
constexpr auto
civil_from_posix_seconds(int8 seconds) -> utc_date_time {
   int8 days = seconds / 86'400;
   int8 day_seconds = seconds % 86'400;
   if (day_seconds < 0) {
      day_seconds = day_seconds + 86'400;
      days = days - 1;
   }
   utc_date_time result = civil_from_days(days);
   result.hour = uint1(day_seconds / 3'600);
   day_seconds = day_seconds % 3'600;
   result.minute = uint1(day_seconds / 60);
   result.second = uint1(day_seconds % 60);
   return result;
}

[[nodiscard]]
constexpr auto
completed_leaps_for_posix(int8 seconds) -> int8 {
   int8 result = 0;
   for (idx index = 0; index < leap_second_count; index = index + 1) {
      if (seconds < leap_second_transition(index)) {
         break;
      }
      result = result + 1;
   }
   return result;
}

[[nodiscard]]
constexpr auto
leap_index_for_transition(int8 transition) -> int8 {
   for (idx index = 0; index < leap_second_count; index = index + 1) {
      if (transition == leap_second_transition(index)) {
         return index;
      }
   }
   return -1;
}

[[nodiscard]]
constexpr auto
leap_index_for_atomic(int8 seconds) -> int8 {
   for (idx index = 0; index < leap_second_count; index = index + 1) {
      int8 const leap_second = leap_second_transition(index) + int8(index);
      if (seconds == leap_second) {
         return index;
      }
   }
   return -1;
}

[[nodiscard]]
constexpr auto
completed_leaps_for_atomic(int8 seconds) -> int8 {
   int8 result = 0;
   for (idx index = 0; index < leap_second_count; index = index + 1) {
      int8 const leap_second = leap_second_transition(index) + int8(index);
      if (seconds <= leap_second) {
         break;
      }
      result = result + 1;
   }
   return result;
}

}  // namespace detail

[[nodiscard]]
constexpr auto
is_valid_utc(utc_date_time value) -> bool {
   if (!detail::valid_utc_fields(value)) {
      return false;
   }
   if (value.second != 60) {
      return true;
   }
   if (value.hour != 23 || value.minute != 59) {
      return false;
   }
   value.second = 59;
   int8 const transition = detail::posix_seconds_from_civil(value) + 1;
   return detail::leap_index_for_transition(transition) >= 0;
}

[[nodiscard]]
constexpr auto
utc_from_date_time(utc_date_time value) -> utc_conversion {
   if (!is_valid_utc(value)) {
      return {
         .value = utc_time_point(0),
         .valid = false,
      };
   }
   if (value.second == 60) {
      value.second = 59;
      int8 const transition = detail::posix_seconds_from_civil(value) + 1;
      int8 const leap_index = detail::leap_index_for_transition(transition);
      return {
         .value = utc_time_point(transition + leap_index),
         .valid = true,
      };
   }
   int8 const posix = detail::posix_seconds_from_civil(value);
   int8 const atomic = posix + detail::completed_leaps_for_posix(posix);
   return {
      .value = utc_time_point(atomic),
      .valid = true,
   };
}

[[nodiscard]]
constexpr auto
date_time_from_utc(utc_time_point point) -> utc_date_time {
   int8 const atomic = point.seconds_since_epoch();
   int8 const leap_index = detail::leap_index_for_atomic(atomic);
   if (leap_index >= 0) {
      int8 const transition = detail::leap_second_transition(idx(leap_index));
      utc_date_time result = detail::civil_from_posix_seconds(transition - 1);
      result.second = 60;
      return result;
   }
   int8 const posix = atomic - detail::completed_leaps_for_atomic(atomic);
   return detail::civil_from_posix_seconds(posix);
}

[[nodiscard]]
constexpr auto
to_tai(utc_time_point point) -> tai_time_point {
   return tai_time_point(point.seconds_since_epoch() + duration(378'691'210));
}

[[nodiscard]]
constexpr auto
to_utc(tai_time_point point) -> utc_time_point {
   return utc_time_point(point.seconds_since_epoch() - duration(378'691'210));
}

[[nodiscard]]
constexpr auto
to_utc(unix_time_point point) -> utc_time_point {
   int8 const posix = point.seconds_since_epoch();
   int8 const atomic = posix + detail::completed_leaps_for_posix(posix);
   return utc_time_point(atomic);
}

[[nodiscard]]
constexpr auto
to_tai(unix_time_point point) -> tai_time_point {
   return to_tai(to_utc(point));
}

[[nodiscard]]
constexpr auto
to_unix(utc_time_point point, unix_leap_second_mapping leap_mapping)
   -> unix_time_point {
   int8 const atomic = point.seconds_since_epoch();
   int8 const leap_index = detail::leap_index_for_atomic(atomic);
   if (leap_index >= 0) {
      int8 const transition = detail::leap_second_transition(idx(leap_index));
      if (leap_mapping == unix_leap_second_mapping::previous_second) {
         return unix_time_point(transition - 1);
      }
      return unix_time_point(transition);
   }
   int8 const posix = atomic - detail::completed_leaps_for_atomic(atomic);
   return unix_time_point(posix);
}

[[nodiscard]]
constexpr auto
to_unix(tai_time_point point, unix_leap_second_mapping leap_mapping)
   -> unix_time_point {
   return to_unix(to_utc(point), leap_mapping);
}

[[nodiscard]]
constexpr auto
get_leap_second_info(utc_time_point point) -> leap_second_info {
   int8 const atomic = point.seconds_since_epoch();
   int8 const leap_index = detail::leap_index_for_atomic(atomic);
   if (leap_index >= 0) {
      return {
         .is_leap_second = true,
         .elapsed = leap_index + 1,
      };
   }
   return {
      .is_leap_second = false,
      .elapsed = detail::completed_leaps_for_atomic(atomic),
   };
}

