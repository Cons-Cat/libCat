template <auto quantity>
using time_int8 =
   basic_int<int8::raw_type, overflow_policies::undefined, quantity>;

using duration = time_int8<units::second>;
using nanosecond_duration = time_int8<units::nanosecond>;
using microsecond_duration = time_int8<units::microsecond>;
using millisecond_duration = time_int8<units::millisecond>;
using minute_duration = time_int8<units::minute>;
using hour_duration = time_int8<units::hour>;
using day_duration = time_int8<units::day>;

struct tai_clock;
struct utc_clock;
struct unix_clock;

template <typename Clock>
class affine_time_point {
 public:
   constexpr explicit affine_time_point(duration seconds_since_epoch)
       : m_seconds_since_epoch(seconds_since_epoch) {
   }

   [[nodiscard]]
   constexpr auto
   seconds_since_epoch() const -> duration {
      return m_seconds_since_epoch;
   }

   [[nodiscard]]
   friend constexpr auto
   operator+(affine_time_point point, duration elapsed) -> affine_time_point {
      return affine_time_point(point.m_seconds_since_epoch + elapsed);
   }

   [[nodiscard]]
   friend constexpr auto
   operator+(duration elapsed, affine_time_point point) -> affine_time_point {
      return point + elapsed;
   }

   [[nodiscard]]
   friend constexpr auto
   operator-(affine_time_point point, duration elapsed) -> affine_time_point {
      return affine_time_point(point.m_seconds_since_epoch - elapsed);
   }

   [[nodiscard]]
   friend constexpr auto
   operator-(affine_time_point left, affine_time_point right) -> duration {
      return left.m_seconds_since_epoch - right.m_seconds_since_epoch;
   }

   [[nodiscard]]
   friend constexpr auto
   operator<=>(affine_time_point, affine_time_point) = default;

 private:
   duration m_seconds_since_epoch;
};

using tai_time_point = affine_time_point<tai_clock>;
using utc_time_point = affine_time_point<utc_clock>;
using unix_time_point = affine_time_point<unix_clock>;

struct utc_date_time {
   int4 year;
   uint1 month;
   uint1 day;
   uint1 hour;
   uint1 minute;
   uint1 second;
};

struct utc_conversion {
   utc_time_point value;
   bool valid;
};

enum class unix_leap_second_mapping : uint1::raw_type {
   previous_second,
   next_second,
};

struct leap_second {
   unix_time_point date;
   duration value;
};

struct leap_second_info {
   bool is_leap_second;
   duration elapsed;
};

