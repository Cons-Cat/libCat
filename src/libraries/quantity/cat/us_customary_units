CAT_DECLARE_QUANTITY_ALIASES(us_furlong, us_furlong);
CAT_DECLARE_QUANTITY_ALIASES(us_acre, us_acre);
CAT_DECLARE_QUANTITY_ALIASES(section, section);
CAT_DECLARE_QUANTITY_ALIASES(us_gallon, us_gallon);
CAT_DECLARE_QUANTITY_ALIASES(pottle, pottle);
CAT_DECLARE_QUANTITY_ALIASES(us_quart, us_quart);
CAT_DECLARE_QUANTITY_ALIASES(us_pint, us_pint);
CAT_DECLARE_QUANTITY_ALIASES(cup, cup);
CAT_DECLARE_QUANTITY_ALIASES(us_gill, us_gill);
CAT_DECLARE_QUANTITY_ALIASES(us_fluid_ounce, us_fluid_ounce);
CAT_DECLARE_QUANTITY_ALIASES(tablespoon, tablespoon);
CAT_DECLARE_QUANTITY_ALIASES(teaspoon, teaspoon);
CAT_DECLARE_QUANTITY_ALIASES(barrel, barrel);
CAT_DECLARE_QUANTITY_ALIASES(oil_barrel, oil_barrel);
CAT_DECLARE_QUANTITY_ALIASES(bushel, bushel);
CAT_DECLARE_QUANTITY_ALIASES(peck, peck);
CAT_DECLARE_QUANTITY_ALIASES(dry_gallon, dry_gallon);
CAT_DECLARE_QUANTITY_ALIASES(dry_quart, dry_quart);
CAT_DECLARE_QUANTITY_ALIASES(dry_pint, dry_pint);
CAT_DECLARE_QUANTITY_ALIASES(short_hundredweight, short_hundredweight);
CAT_DECLARE_QUANTITY_ALIASES(us_ton, us_ton);
CAT_DECLARE_QUANTITY_ALIASES(pennyweight, pennyweight);
CAT_DECLARE_QUANTITY_ALIASES(troy_ounce, troy_ounce);
CAT_DECLARE_QUANTITY_ALIASES(troy_pound, troy_pound);
CAT_DECLARE_QUANTITY_ALIASES(inch_of_mercury, inch_of_mercury);

}  // namespace cat::units
