namespace cat {

template <typename T>
concept is_duration =
   is_same_quantity_dimension<arithmetic_quantity<T>, units::seconds>;

// Forward declare clocks for use in `time_point` unit conversions.
struct clock_gps;
struct clock_tai;
struct clock_utc;
struct clock_unix;

// Unlike the clocks above, `local_t` is a pseudo-clock. It cannot be read,
// and it only tags a `time_point` as a local time of some time zone which has
// not been specified yet.
struct local_t;

// TODO: We should support rich time formatting, as per p13148
// https://open-std.org/jtc1/sc22/wg21/docs/papers/2025/p3148r1.pdf

template <typename Clock, is_duration Duration = units::second_int8>
class time_point {
 public:
   using clock = Clock;
   using duration = Duration;

   constexpr time_point() = default;

   constexpr explicit time_point(Duration elapsed) : m_elapsed(elapsed) {
   }

   // Convert from another `time_point` of this clock, so long as its duration
   // converts into `Duration` implicitly.
   template <is_duration OtherDuration>
      requires(is_convertible<OtherDuration, Duration>)
   constexpr time_point(time_point<Clock, OtherDuration> point)
       : m_elapsed(point.time_since_epoch()) {
   }

   [[nodiscard]]
   static constexpr auto
   min() -> time_point {
      return time_point(Duration::min());
   }

   [[nodiscard]]
   static constexpr auto
   max() -> time_point {
      return time_point(Duration::max());
   }

   [[nodiscard]]
   constexpr auto
   time_since_epoch() const -> Duration {
      return m_elapsed;
   }

   constexpr auto
   operator+=(Duration elapsed) -> time_point& {
      m_elapsed = m_elapsed + elapsed;
      return *this;
   }

   constexpr auto
   operator-=(Duration elapsed) -> time_point& {
      m_elapsed = m_elapsed - elapsed;
      return *this;
   }

   // Stepping a `time_point` moves it by one tick of its own duration.
   constexpr auto
   operator++() -> time_point& {
      m_elapsed = m_elapsed + Duration(1);
      return *this;
   }

   constexpr auto
   operator++(int) -> time_point {
      time_point const old = *this;
      ++*this;
      return old;
   }

   constexpr auto
   operator--() -> time_point& {
      m_elapsed = m_elapsed - Duration(1);
      return *this;
   }

   constexpr auto
   operator--(int) -> time_point {
      time_point const old = *this;
      --*this;
      return old;
   }

   [[nodiscard]]
   friend constexpr auto
   operator+(time_point point, Duration elapsed) -> time_point {
      return time_point(point.m_elapsed + elapsed);
   }

   [[nodiscard]]
   friend constexpr auto
   operator+(Duration elapsed, time_point point) -> time_point {
      return point + elapsed;
   }

   [[nodiscard]]
   friend constexpr auto
   operator-(time_point point, Duration elapsed) -> time_point {
      return time_point(point.m_elapsed - elapsed);
   }

   [[nodiscard]]
   friend constexpr auto
   operator-(time_point left, time_point right) -> Duration {
      return left.m_elapsed - right.m_elapsed;
   }

   [[nodiscard]]
   friend constexpr auto
   operator<=>(time_point, time_point) = default;

 private:
   Duration m_elapsed{};
};

using gps_time_point = time_point<clock_gps>;
using tai_time_point = time_point<clock_tai>;
using utc_time_point = time_point<clock_utc>;
using unix_time_point = time_point<clock_unix>;
using local_time_point = time_point<local_t>;

struct utc_date_time {
   int4 year;
   uint1 month;
   uint1 day;
   uint1 hour;
   uint1 minute;
   uint1 second;
};

struct utc_conversion {
   utc_time_point value;
   bool valid;
};

enum class unix_leap_second_mapping : uint1::raw_type {
   previous_second,
   next_second,
};

