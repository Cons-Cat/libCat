#pragma once

#include <cat/arithmetic>
#include <cat/physical_constants>

namespace cat::units {

namespace detail {

template <auto reference>
inline constexpr basic_float<
   float8::raw_type, precision_policies::precise, reference>
   astronomical_constant_value(1.0);

}  // namespace detail

inline constexpr auto nominal_solar_radius =
   detail::astronomical_constant_value<
      mag_ratio<6'957, 1'000> * mag_power<10, 8> * metre>;

inline constexpr auto nominal_total_solar_irradiance =
   detail::astronomical_constant_value<mag<1'361> * watt / pow<2>(metre)>;

inline constexpr auto nominal_solar_luminosity =
   detail::astronomical_constant_value<
      mag_ratio<3'828, 1'000> * mag_power<10, 26> * watt>;

inline constexpr auto nominal_solar_effective_temperature =
   detail::astronomical_constant_value<mag<5'772> * kelvin>;

inline constexpr auto nominal_solar_mass_parameter =
   detail::astronomical_constant_value<
      mag_ratio<13'271'244, 10'000'000> * mag_power<10, 20>
      * pow<3>(metre) / pow<2>(second)>;

inline constexpr auto nominal_terrestrial_equatorial_radius =
   detail::astronomical_constant_value<
      mag_ratio<63'781, 10'000> * mag_power<10, 6> * metre>;

inline constexpr auto nominal_terrestrial_polar_radius =
   detail::astronomical_constant_value<
      mag_ratio<63'568, 10'000> * mag_power<10, 6> * metre>;

inline constexpr auto nominal_jovian_equatorial_radius =
   detail::astronomical_constant_value<
      mag_ratio<71'492, 10'000> * mag_power<10, 7> * metre>;

inline constexpr auto nominal_jovian_polar_radius =
   detail::astronomical_constant_value<
      mag_ratio<66'854, 10'000> * mag_power<10, 7> * metre>;

inline constexpr auto nominal_terrestrial_mass_parameter =
   detail::astronomical_constant_value<
      mag_ratio<3'986'004, 1'000'000> * mag_power<10, 14>
      * pow<3>(metre) / pow<2>(second)>;

inline constexpr auto nominal_jovian_mass_parameter =
   detail::astronomical_constant_value<
      mag_ratio<12'668'653, 10'000'000> * mag_power<10, 17>
      * pow<3>(metre) / pow<2>(second)>;

inline constexpr struct parsec
    : named_unit<"pc", astronomical_unit / (mag_ratio<1, 3'600> * degree)> {
} parsec;

inline constexpr struct solar_mass
    : named_unit<
         symbol_text{u8"M_☉", "M_SUN"},
         nominal_solar_mass_parameter.quantity_reference
            / newtonian_constant_of_gravitation.quantity_reference> {
} solar_mass;

inline constexpr struct terrestrial_mass
    : named_unit<
         symbol_text{u8"M_⊕", "M_EARTH"},
         nominal_terrestrial_mass_parameter.quantity_reference
            / newtonian_constant_of_gravitation.quantity_reference> {
} terrestrial_mass;

inline constexpr struct jovian_mass
    : named_unit<
         symbol_text{u8"M_♃", "M_JUP"},
         nominal_jovian_mass_parameter.quantity_reference
            / newtonian_constant_of_gravitation.quantity_reference> {
} jovian_mass;

using parsecs = reference_quantity<parsec>;
using solar_masses = reference_quantity<solar_mass>;
using terrestrial_masses = reference_quantity<terrestrial_mass>;
using jovian_masses = reference_quantity<jovian_mass>;

CAT_DECLARE_QUANTITY_ALIASES(parsec, parsec);
CAT_DECLARE_QUANTITY_ALIASES(solar_mass, solar_mass);
CAT_DECLARE_QUANTITY_ALIASES(terrestrial_mass, terrestrial_mass);
CAT_DECLARE_QUANTITY_ALIASES(jovian_mass, jovian_mass);

}  // namespace cat::units
