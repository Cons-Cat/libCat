// -*- mode: c++ -*-
// vim: set ft=cpp:
#pragma once

#include <cat/british_imperial_units>
#include <cat/metric_units>

namespace cat::units {

inline constexpr struct pound
    : named_unit<"lb", mag_ratio<45'359'237, 100'000'000> * kilogram> {
} pound;

inline constexpr auto pound_mass = pound;

inline constexpr struct ounce : named_unit<"oz", mag_ratio<1, 16> * pound> {
} ounce;

inline constexpr struct dram : named_unit<"dr", mag_ratio<1, 16> * ounce> {
} dram;

inline constexpr struct grain : named_unit<"gr", mag_ratio<1, 7'000> * pound> {
} grain;

inline constexpr struct yard
    : named_unit<"yd", mag_ratio<9'144, 10'000> * metre> {
} yard;

inline constexpr struct foot : named_unit<"ft", mag_ratio<1, 3> * yard> {
} foot;

inline constexpr struct inch : named_unit<"in", mag_ratio<1, 12> * foot> {
} inch;

inline constexpr struct pica : named_unit<"P", mag_ratio<1, 6> * inch> {
} pica;

inline constexpr struct point : named_unit<"p", mag_ratio<1, 12> * pica> {
} point;

inline constexpr struct mil : named_unit<"mil", mag_ratio<1, 1'000> * inch> {
} mil;

inline constexpr struct twip : named_unit<"twip", mag_ratio<1, 20> * point> {
} twip;

inline constexpr struct mile : named_unit<"mi", mag<1'760> * yard> {
} mile;

inline constexpr struct league : named_unit<"lea", mag<3> * mile> {
} league;

inline constexpr struct fathom : named_unit<"ftm", mag<6> * foot> {
} fathom;

inline constexpr struct mile_per_hour : named_unit<"mph", mile / hour> {
} mile_per_hour;

inline constexpr struct poundal
    : named_unit<"pdl", pound * foot / pow<2>(second)> {
} poundal;

inline constexpr struct pound_force
    : named_unit<
         "lbf", pound * mag_ratio<196'133, 20'000> * metre / pow<2>(second)> {
} pound_force;

inline constexpr auto kip = kilo<pound_force>;

inline constexpr struct psi : named_unit<"psi", pound_force / (inch * inch)> {
} psi;

inline constexpr struct mechanical_horsepower
    : named_unit<"hp(I)", mag<33'000> * foot * pound_force / minute> {
} mechanical_horsepower;

using pounds = reference_quantity<pound>;
using ounces = reference_quantity<ounce>;
using drams = reference_quantity<dram>;
using grains = reference_quantity<grain>;
using yards = reference_quantity<yard>;
using feet = reference_quantity<foot>;
using inches = reference_quantity<inch>;
using picas = reference_quantity<pica>;
using points = reference_quantity<point>;
using mils = reference_quantity<mil>;
using twips = reference_quantity<twip>;
using miles = reference_quantity<mile>;
using leagues = reference_quantity<league>;
using fathoms = reference_quantity<fathom>;
using miles_per_hour = reference_quantity<mile_per_hour>;
using poundals = reference_quantity<poundal>;
using pounds_force = reference_quantity<pound_force>;
using kips = reference_quantity<kip>;
using pounds_per_square_inch = reference_quantity<psi>;
using mechanical_horsepowers = reference_quantity<mechanical_horsepower>;

CAT_DECLARE_QUANTITY_ALIASES(pound, pound);
CAT_DECLARE_QUANTITY_ALIASES(ounce, ounce);
CAT_DECLARE_QUANTITY_ALIASES(dram, dram);
CAT_DECLARE_QUANTITY_ALIASES(grain, grain);
CAT_DECLARE_QUANTITY_ALIASES(yard, yard);
CAT_DECLARE_QUANTITY_ALIASES(foot, foot);
CAT_DECLARE_QUANTITY_ALIASES(inch, inch);
CAT_DECLARE_QUANTITY_ALIASES(pica, pica);
CAT_DECLARE_QUANTITY_ALIASES(point, point);
CAT_DECLARE_QUANTITY_ALIASES(mil, mil);
CAT_DECLARE_QUANTITY_ALIASES(twip, twip);
CAT_DECLARE_QUANTITY_ALIASES(mile, mile);
CAT_DECLARE_QUANTITY_ALIASES(league, league);
CAT_DECLARE_QUANTITY_ALIASES(fathom, fathom);
CAT_DECLARE_QUANTITY_ALIASES(mile_per_hour, mile_per_hour);
CAT_DECLARE_QUANTITY_ALIASES(poundal, poundal);
CAT_DECLARE_QUANTITY_ALIASES(pound_force, pound_force);
CAT_DECLARE_QUANTITY_ALIASES(kip, kip);
CAT_DECLARE_QUANTITY_ALIASES(psi, psi);
CAT_DECLARE_QUANTITY_ALIASES(mechanical_horsepower, mechanical_horsepower);

}  // namespace cat::units
