#ifndef CAT_NO_STACKTRACE
// Tail call optimization puts `cat::fmt()` calls into the stack trace.
[[clang::disable_tail_calls]]
#endif
void
default_assert_handler(source_location const& callsite);

// Get the assert handler at the caller's scope.
[[nodiscard]]
auto
current_assert_handler() -> assert_handler;

// This changes the process-wide fallback handler. This operation is atomic, but
// not thread-safe. It's susceptible to data races, but will always store a
// valid function pointer.
void
set_global_assert_handler(assert_handler p_handler);

// This changes the calling thread's handler, which takes precedence over the
// global handler.
void
set_thread_local_assert_handler(assert_handler p_handler);

// The calling thread inherits the global handler again.
void
reset_thread_local_assert_handler();

// RAII block-scope guard for setting an assert handler.
class [[nodiscard]] scoped_assert_handler {
 public:
   explicit scoped_assert_handler(assert_handler p_handler);

   scoped_assert_handler(scoped_assert_handler const&) = delete;
   scoped_assert_handler(scoped_assert_handler&&) = delete;

   auto
   operator=(scoped_assert_handler const&) -> scoped_assert_handler& = delete;
   auto
   operator=(scoped_assert_handler&&) -> scoped_assert_handler& = delete;

   ~scoped_assert_handler();

 private:
   detail::assert_handler_frame m_frame;
};

