namespace std {

// Declaring `std::source_location` is unfortunate, but it's the best way to
// implement the feature. `__builtin_source_location()` requires it, and
// `_M_function_name` is populated by the contents of `__PRETTY_FUNCTION__`,
// which is the only way to do that. `__builtin_FUNCSIG()` is an alternative
// similar intrinsic, in the MSVC style, but GCC/Clang style is nicer and we
// would need to evaluate a `consteval` parser to make the output equivalent.

class source_location {
 private:
   // Clang requires these variables be declared at the top, not the bottom.

   // Clang requires these names be exactly what they are. Nullability
   // annotations are suppressed because they violate the standard-layout
   // requirement that the compiler imposes on this builtin type.
#pragma clang diagnostic push
#pragma clang diagnostic ignored "-Wnullability-completeness"

   struct __impl {
      char const* _M_file_name;
      char const* _M_function_name;
      unsigned long _M_line;
      unsigned long _M_column;
   };

#pragma clang diagnostic pop

   __impl const* _Nullable m_p_location = nullptr;

 public:
   static constexpr auto
   current(
      decltype(__builtin_source_location()) _Nonnull p_call_site_location =
         __builtin_source_location()
   ) -> source_location {
      source_location current_location;
      current_location.m_p_location =
         static_cast<__impl const*>(p_call_site_location);
      return current_location;
   }

   [[nodiscard]]
   constexpr auto
   line() const -> unsigned long {
      return (this->m_p_location != nullptr) ? this->m_p_location->_M_line : 0u;
   }

   [[nodiscard]]
   constexpr auto
   column() const -> unsigned long {
      return (this->m_p_location != nullptr) ? this->m_p_location->_M_column
                                             : 0u;
   }

   [[nodiscard, gnu::returns_nonnull]]
   constexpr auto
   file_name() const -> char const* _Nonnull {
      return (this->m_p_location != nullptr) ? this->m_p_location->_M_file_name
                                             : "";
   }

   [[nodiscard, gnu::returns_nonnull]]
   constexpr auto
   function_name() const -> char const* _Nonnull {
      return (this->m_p_location != nullptr)
                ? this->m_p_location->_M_function_name
                : "";
   }
};

}  // namespace std

// NOLINTEND(bugprone-std-namespace-modification)

