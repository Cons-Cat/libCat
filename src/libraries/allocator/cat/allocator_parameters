   }

 public:
   using basic_dyn_allocator_tag = void;

   basic_dyn_allocator() =
      delete ("`basic_dyn_allocator` cannot be default-constructed! Pass an "
              "allocator l-value instead.");

   template <is_allocator Allocator>
      requires(!requires { typename Allocator::basic_dyn_allocator_tag; })
   [[gnu::always_inline, gnu::nodebug]] constexpr basic_dyn_allocator(
      Allocator& allocator [[clang::lifetimebound]]
   )
       : m_p_allocator(__builtin_addressof(allocator)) {
   }

   basic_dyn_allocator(basic_dyn_allocator const&) = default;

   template <typename... Superset>
      requires(
         sizeof...(Superset) != sizeof...(Methods)
         && detail::is_subset_impl<
            type_list<Methods...>, type_list<Superset...>>
      )
   [[gnu::always_inline, gnu::nodebug]]
   constexpr basic_dyn_allocator(basic_dyn_allocator<Superset...> other)
       : m_p_allocator(other.m_p_allocator) {
   }

   // Value equality between two `dyn_allocator` handles. Two handles compare
   // equal when they erase the same concrete allocator type AND that type's
   // `is_equivalent` hook reports equivalence between the held instances.
   // The type-id pointers are compared first as a cheap early-out, since the
   // `dyn_equals` shim assumes both arguments share the same erased type.
   //
   // `operator==` is provided by `allocator_interface<dyn_allocator>`'s
   // hidden friend, which forwards to `is_equivalent`.
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   auto
   is_equivalent(basic_dyn_allocator const& other) const -> bool
