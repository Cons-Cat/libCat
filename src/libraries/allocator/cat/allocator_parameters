// `dyn_equals` is the type-erased value-equality hook. Callers must guarantee
// that `p_other` points to a `T`, which is checked at the `dyn_allocator`
// equality entry point via type-id comparison.
struct dyn_equals {
   using signature = auto(void const* _Nonnull) const -> bool;

   template <typename T>
   [[gnu::always_inline, gnu::nodebug]]
   static auto
   do_invoke(
      [[maybe_unused]] T const& self,
      [[maybe_unused]] void const* _Nonnull p_other
   ) -> bool {
      [[maybe_unused]]
      T const& other = *static_cast<T const*>(p_other);
      if constexpr (detail::has_is_equivalent<T>) {
         return dyn_allocator_friend::is_equivalent(self, other);
      } else if constexpr (__is_empty(T)) {
         return true;
      } else {
         return __builtin_addressof(self) == __builtin_addressof(other);
      }
   }
};

struct dyn_name {
   using signature = auto() const -> str_view;

   template <typename T>
   [[gnu::always_inline, gnu::nodebug]]
   static auto
   do_invoke([[maybe_unused]] T const& self) -> str_view {
      if constexpr (detail::has_name<T>) {
         return dyn_allocator_friend::name(self);
      } else {
         return str_view{};
      }
   }
};

// Non-owning, dynamic-dispatch handle to an `Allocator`. This erases the type
// of underlying allocators to minimize code generation.
template <typename... Methods>
class [[gsl::Owner]] basic_dyn_allocator
    : public allocator_interface<basic_dyn_allocator<Methods...>> {
   friend allocator_interface<basic_dyn_allocator>;
   friend struct dyn_allocator_friend;
   template <typename>
   friend class allocator_ref;
   template <typename...>
   friend class basic_dyn_allocator;

 private:
   dyn_ptr<dyn_allocate, dyn_deallocate, Methods...> m_p_allocator;

   [[gnu::always_inline, gnu::nodebug]]
   auto
   allocate(idx allocation_bytes) -> maybe_ptr<void> {
      return dyn_invoke<dyn_allocate>(*m_p_allocator, allocation_bytes);
   }

   [[gnu::always_inline, gnu::nodebug, clang::ownership_takes(libcat, 2)]]
   void
   deallocate(void const* _Nonnull p_storage, idx allocation_bytes) {
      dyn_invoke<dyn_deallocate>(*m_p_allocator, p_storage, allocation_bytes);
   }

   [[gnu::always_inline, gnu::nodebug]]
   auto
   aligned_allocate(ualign alignment, idx allocation_bytes) -> maybe_ptr<void>
      requires(detail::contains_method<dyn_aligned_allocate, Methods...>)
   {
      return dyn_invoke<dyn_aligned_allocate>(
         *m_p_allocator, alignment, allocation_bytes
      );
   }

   [[gnu::always_inline, gnu::nodebug]]
   auto
   allocate_feedback(idx allocation_bytes) -> maybe_sized_allocation<void*>
      requires(detail::contains_method<dyn_allocate_feedback, Methods...>)
   {
      return dyn_invoke<dyn_allocate_feedback>(
         *m_p_allocator, allocation_bytes
      );
   }

   [[gnu::always_inline, gnu::nodebug]]
   auto
   aligned_allocate_feedback(ualign alignment, idx allocation_bytes)
      -> maybe_sized_allocation<void*>
      requires(
         detail::contains_method<dyn_aligned_allocate_feedback, Methods...>
      )
   {
      return dyn_invoke<dyn_aligned_allocate_feedback>(
         *m_p_allocator, alignment, allocation_bytes
      );
   }

   [[gnu::always_inline, gnu::nodebug]]
   auto
   resize(idx minimum_bytes) -> maybe_non_zero<idx>
      requires(detail::contains_method<dyn_resize, Methods...>)
   {
      return dyn_invoke<dyn_resize>(*m_p_allocator, minimum_bytes);
   }

   [[gnu::always_inline, gnu::nodebug]]
   auto
   grow(span<byte> allocation, idx new_bytes) -> maybe<void>
      requires(detail::contains_method<dyn_grow, Methods...>)
   {
      return dyn_invoke<dyn_grow>(*m_p_allocator, allocation, new_bytes);
   }

   [[gnu::always_inline, gnu::nodebug]]
   auto
   grow_feedback(span<byte> allocation, idx new_bytes) -> maybe_non_zero<idx>
      requires(detail::contains_method<dyn_grow_feedback, Methods...>)
   {
      return dyn_invoke<dyn_grow_feedback>(
         *m_p_allocator, allocation, new_bytes
      );
   }

   [[gnu::always_inline, gnu::nodebug]]
   auto
   reallocate(span<byte> allocation, idx new_bytes) -> maybe_ptr<void>
      requires(detail::contains_method<dyn_reallocate, Methods...>)
   {
      return dyn_invoke<dyn_reallocate>(*m_p_allocator, allocation, new_bytes);
   }

   [[gnu::always_inline, gnu::nodebug]]
   auto
   reallocate_feedback(span<byte> allocation, idx new_bytes)
      -> maybe_sized_allocation<void*>
      requires(detail::contains_method<dyn_reallocate_feedback, Methods...>)
   {
      return dyn_invoke<dyn_reallocate_feedback>(
         *m_p_allocator, allocation, new_bytes
