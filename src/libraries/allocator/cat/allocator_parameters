// Reference-like static-dispatch handle to an `Allocator`. Functions are
// encouraged to consume this type rather than `Allocator&` to reduce
// `.template alloc<>()` syntactic noise and to bias overload resolution
// towards `dyn_allocator` when not explicitly specified.
//
// For zero-size (stateless / "global") allocators, the ref carries no instance
// pointer. The wrapped type has no observable state, so dispatch through a
// default-constructed instance is equivalent and free. `[[no_unique_address]]`
// collapses that storage so the ref folds to zero size when embedded into an
// outer aggregate.
template <typename Allocator>
class [[gsl::Pointer]] allocator_ref
    : public allocator_interface<allocator_ref<Allocator>>,
      detail::max_allocation_bytes_storage<Allocator> {
