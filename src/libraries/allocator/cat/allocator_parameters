   // storage lets this stay non-const-correct in the same way the raw
   // `Allocator*`-through-const-pointer access did before, so const methods
   // on the ref can still reach non-const allocator methods.
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   constexpr auto
   get_allocator() const -> Allocator& {
      if constexpr (__is_empty(Allocator)) {
         return m_storage;
      } else {
         return *m_storage;
      }
   }

