// -*- mode: c++ -*-
// vim: set ft=cpp:
#pragma once

#include <cat/allocator>

// TODO: Should we remove deriving from `allocator_interface` and require
// wrapping in `allocator_ref` to reduce template monomorphization?

namespace cat {

class [[clang::trivial_abi]] allocator_null
    : public allocator_interface<allocator_null> {
 private:
   friend allocator_interface<allocator_null>;
   template <typename>
   friend class allocator_ref;

 public:
   constexpr allocator_null() = default;
   constexpr allocator_null(allocator_null const&) = default;
   constexpr allocator_null(allocator_null&&) = default;

   // `allocator_null` never hands out memory, so it can claim the strongest
   // possible static alignment guarantee without ever being wrong. Use
   // `page_size` since that is the strongest alignment any allocator in the
   // library produces.
   static constexpr ualign min_alignment = page_size;

   // `allocator_null` is a global allocator with no instance state, so all
   // dispatch hooks are `static`. `cat::allocator_ref<allocator_null>` folds
   // to zero size as a result.

   // This allocation always fails.
   [[gnu::malloc, clang::ownership_returns(libcat)]]
   static auto
   allocate(idx /*unused*/) noexcept -> void* _Nullable {
      return nullptr;
   }

   // Deallocation is no-op.
   [[clang::ownership_takes(libcat, 1)]]
   static void
   deallocate(void const* _Nullable /*unused*/, idx /*unused*/) noexcept {
   }

   // `allocator_null` never hands out memory, so it holds and manages nothing.
   [[nodiscard]]
   static auto
   bytes_used() noexcept -> idx {
      return 0u;
   }

   [[nodiscard]]
   static auto
   bytes_capacity() noexcept -> idx {
      return 0u;
   }

   // `.reset()` is a no-op provided by `allocator_interface`.
};

[[nodiscard]]
constexpr auto
make_allocator_null() noexcept -> allocator_null {
   return {};
}

}  // namespace cat
