// -*- mode: c++ -*-
// vim: set ft=cpp:
#pragma once

#include <cat/allocator>

// TODO: Should we remove deriving from `allocator_interface` and require
// wrapping in `allocator_ref` to reduce template monomorphization?

namespace cat {

// A one-shot fixed buffer allocator. It holds `arena_bytes` of storage inside
// its own stack frame and hands that whole buffer out as a single allocation.
// A second allocation fails until this is `free()`d or `reset()`.
template <idx arena_bytes>
class [[clang::trivial_abi]]
allocator_inplace : public allocator_interface<allocator_inplace<arena_bytes>> {
 private:
   friend allocator_interface<allocator_inplace>;
   friend struct allocator_dyn_friend;
   template <typename>
   friend class allocator_ref;
   template <is_allocator, is_allocator, idx, idx>
   friend class allocator_resizeable;

 public:
   constexpr allocator_inplace() noexcept {
      poison_memory_region(m_storage.data(), arena_bytes);
   }

   constexpr allocator_inplace(allocator_inplace const&) = delete (
      "`allocator_inplace` owns an on-stack buffer that must not alias. "
      "Create allocators through `make_allocator_inplace` instead of copying."
   );
   constexpr allocator_inplace(allocator_inplace&&) = default;

   // Clear any leftover poison so the buffer's stack storage does not stay
   // poisoned after this allocator dies and its stack slot is reused.
   constexpr ~allocator_inplace() noexcept {
      unpoison_memory_region(m_storage.data(), arena_bytes);
   }

   // Release the outstanding allocation, making the buffer available again.
   constexpr void
   reset() noexcept {
      poison_memory_region(m_storage.data(), arena_bytes);
      m_is_allocated = false;
   }

 private:
   // The buffer's tail is the only allocation this can produce. A request that
   // fits after over-alignment padding settles on whatever remains of the
   // buffer past that padding.
   auto
   allocation_bytes(ualign alignment, idx allocation_bytes) noexcept
      -> maybe_non_zero<idx> {
      if (m_is_allocated) {
         // Over-allocated.
         return nullopt;
      }

      // Get padding from the buffer's base to the first `alignment`-aligned
      // address.
      byte const* p_aligned = align_up(m_storage.data(), alignment);
      idx const offset = idx(p_aligned - m_storage.data());

      if (offset + allocation_bytes <= arena_bytes) {
         return idx(arena_bytes - offset);
      }

      // Not enough room for this alignment.
      return nullopt;
   }

   [[gnu::malloc, clang::ownership_returns(libcat)]]
   auto
   allocate(idx allocation_bytes) noexcept -> void* _Nullable {
      if (!m_is_allocated && allocation_bytes <= arena_bytes) {
         // Mark future over-allocation.
         m_is_allocated = true;
         return static_cast<void*>(m_storage.data());
      }

      // Over-allocated.
      return nullptr;
   }

   // Over-align by handing out a pointer aligned up within the buffer, so long
   // as the request still fits past that padding.
   [[gnu::malloc, clang::ownership_returns(libcat)]]
   auto
   aligned_allocate(ualign alignment, idx allocation_bytes) noexcept
      -> void* _Nullable {
      if (m_is_allocated) {
         // Future over-allocation.
         return nullptr;
      }

      byte* p_aligned = align_up(m_storage.data(), alignment);
      idx const offset = idx(p_aligned - m_storage.data());

      if (offset + allocation_bytes <= arena_bytes) {
         // Mark future over-allocation.
         m_is_allocated = true;
         return static_cast<void*>(p_aligned);
      }

      // Not enough room for this alignment.
      return nullptr;
   }

   [[clang::ownership_takes(libcat, 2)]]
   void
   deallocate(void const* _Nonnull /*unused*/, uword /*unused*/) noexcept {
      m_is_allocated = false;
   }

   // Resize the one outstanding allocation in place. The buffer is already
   // reserved, so this keeps the same address when the new size still fits.
   auto
   reallocate(span<byte> allocation, idx new_bytes) noexcept
      -> void* _Nullable {
      if (!m_is_allocated) {
         return nullptr;
      }

      byte* const p_allocation = allocation.data();
      byte* const p_begin = m_storage.data();
      byte* const p_end = p_begin + arena_bytes.raw;
      if (p_allocation < p_begin || p_allocation > p_end) {
         return nullptr;
      }

      idx const offset = idx(p_allocation - p_begin);
      if (offset + new_bytes > arena_bytes) {
         return nullptr;
      }

      unpoison_memory_region(p_allocation, new_bytes);
      return p_allocation;
   }

 public:
   // The buffer is aligned strongly enough for any scalar type.
   static constexpr ualign min_alignment = __BIGGEST_ALIGNMENT__;

   [[nodiscard]]
   constexpr auto
   bytes_used() const noexcept -> idx {
      return m_is_allocated ? arena_bytes : 0u;
   }

   [[nodiscard]]
   constexpr auto
   bytes_capacity() const noexcept -> idx {
      return arena_bytes;
   }

 private:
   alignas(min_alignment.raw) array<byte, arena_bytes> m_storage;
   bool m_is_allocated = false;
};

template <idx arena_bytes>
[[nodiscard]]
constexpr auto
make_allocator_inplace() noexcept -> allocator_inplace<arena_bytes> {
   return {};
}

}  // namespace cat
