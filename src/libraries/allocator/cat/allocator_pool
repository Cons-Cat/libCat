// -*- mode: c++ -*-
// vim: set ft=cpp:
#pragma once

#include <cat/allocator>

// TODO: Should we remove deriving from `allocator_interface` and require
// wrapping in `allocator_ref` to reduce template monomorphization?

namespace cat {

template <idx max_node_bytes>
class [[clang::trivial_abi]]
allocator_pool : public allocator_interface<allocator_pool<max_node_bytes>> {
 private:
   friend allocator_interface<allocator_pool>;
   friend struct allocator_dyn_friend;
   template <typename>
   friend class allocator_ref;
   template <is_allocator, is_allocator, idx, idx>
   friend class allocator_resizeable;

   // Friend factory functions.
   template <idx in_max_node_bytes>
   friend constexpr auto
   make_allocator_pool(uintptr<void> p_address, idx arena_bytes) noexcept
      -> allocator_pool<in_max_node_bytes>;

   template <idx in_max_node_bytes>
   friend constexpr auto
   make_allocator_pool(span<byte>& span [[clang::lifetimebound]]) noexcept
      -> allocator_pool<in_max_node_bytes>;

   // Initialize a `allocator_pool`. This should only be called from
   // `cat::make_allocator_pool`.
   constexpr allocator_pool(uintptr<void> p_address, idx arena_bytes) noexcept(
      !__has_feature(cxx_exceptions)
   )
       : m_nodes(
            span<node_union>(
               // Pun the opaque `p_address` to the internal `node_union` type.
               __builtin_bit_cast(node_union*, p_address.raw),
               arena_bytes / sizeof(node_union)
            )
         ) {
      // Initialize the free list.
      this->reset();
   }

 public:
   // `allocator_pool` is move-only.
   constexpr allocator_pool(allocator_pool const&) =
      delete ("`cat::allocator_pool` should be constructed using "
              "`cat::make_allocator_pool`.");
   constexpr allocator_pool(allocator_pool&&) = default;

   // Reset the bumped pointer to the beginning of this arena.
   constexpr void
   reset() {
      for (idx i; i < m_nodes.size() - 1u; ++i) {
         m_nodes[i].p_next = &(m_nodes[i + 1u]);
      }
      // Mark the final node.
      m_nodes.back().p_next = nullptr;
      m_p_head = &m_nodes.front();
   }

 private:
   auto
   allocation_bytes(ualign, idx) noexcept -> maybe_non_zero<idx> {
      return max_node_bytes;
   }

   [[gnu::malloc, clang::ownership_returns(libcat)]]
   auto
   allocate(idx /*unused*/) noexcept -> void* _Nullable {
      // If there is a next node in the free list, make that the head and
      // allocate the current head to the user. Otherwise, do not allocate
      // anything.
      if (m_p_head == nullptr) {
         return nullptr;
      }

      node_union* p_alloc = m_p_head;
      m_p_head = m_p_head->p_next;

      return static_cast<void*>(p_alloc);
   }

   [[clang::ownership_takes(libcat, 2)]]
   void
   deallocate(void const* _Nonnull p_allocation, idx /*unused*/) noexcept {
      // Swap the head for this newly freed allocation.
      node_union* p_new_head = __builtin_bit_cast(node_union*, p_allocation);
      p_new_head->p_next = m_p_head;
      m_p_head = p_new_head;
   }

 public:
   // Do not allocate larger than this size of one node.
   static constexpr idx min_allocation_bytes = max_node_bytes;
   static constexpr idx max_allocation_bytes = max_node_bytes;

   union node_union {
      node_union* _Nullable p_next = nullptr;
      array<byte, max_node_bytes> storage;
   };

   static constexpr ualign min_alignment = alignof(node_union);

   [[nodiscard]]
   auto
   bytes_used() const noexcept -> idx {
      idx free_nodes = 0u;
      for (node_union const* p_walk = m_p_head; p_walk != nullptr;
           p_walk = p_walk->p_next) {
         ++free_nodes;
      }
      idx const used_nodes = idx(m_nodes.size() - free_nodes);
      return used_nodes * max_node_bytes;
   }

   [[nodiscard]]
   auto
   bytes_capacity() const noexcept -> idx {
      return m_nodes.size() * max_node_bytes;
   }

   // Two pools are equivalent when they alias the same memory.
   [[nodiscard]]
   auto
   is_equivalent(allocator_pool const& other) const noexcept -> bool {
      return m_nodes.data() == other.m_nodes.data()
             && m_nodes.size() == other.m_nodes.size();
   }

 private:
   span<node_union> m_nodes;
   node_union* _Nullable m_p_head;
};

template <idx max_node_bytes>
[[nodiscard]]
constexpr auto
make_allocator_pool(uintptr<void> p_address, idx arena_bytes) noexcept
   -> allocator_pool<max_node_bytes> {
   return allocator_pool<max_node_bytes>(p_address, arena_bytes);
}

template <idx max_node_bytes>
[[nodiscard]]
constexpr auto
make_allocator_pool(span<byte>& span [[clang::lifetimebound]]) noexcept
   -> allocator_pool<max_node_bytes> {
   return allocator_pool<max_node_bytes>(span.data(), span.size());
}

template <idx max_node_bytes>
[[nodiscard,
  deprecated(
     "Creating a `cat::allocator_pool` with a pr-value may "
     "unintentionally leak memory. Copy an l-value `cat::span` instead."
  )]]
constexpr auto
make_allocator_pool(span<byte>&& span) noexcept
   -> allocator_pool<max_node_bytes> {
   return make_allocator_pool<max_node_bytes>(span);
}

}  // namespace cat
