// -*- mode: c++ -*-
// vim: set ft=cpp:
#pragma once

// `allocator_musl` and `allocator_musl_shared` are libCat shaped
// implementations of the musl "mallocng" slab allocator. It is a relatively
// lightweight allocator that has reasonable heap fragmentation, lock
// contention, and security hardening.
// https://www.openwall.com/lists/musl/2019/10/22/3/1
//
// It does not automatically insert thread-local arenas, because double-free and
// use-after-free are less reliably detectable in those cases. A secret 8-byte
// PRNG value is placed in its pages to validate the provenance of its own
// allocations, it inserts overflow sentinel bytes to detect out-of-bounds
// accesses,  and validates the alignment and size of its allocations.
//
// libCat's integrates asan checks, provides separates thread-safe shared and
// non-thread-safe unshared implementations, and propagates size feedback for
// 16-byte heap quanta,

#include <cat/allocator>
#include <cat/atomic>
#include <cat/random>

namespace cat {

namespace detail {
template <bool is_shared>
struct musl_context;
}  // namespace detail

template <bool is_shared>
class basic_allocator_musl
    : public allocator_interface<basic_allocator_musl<is_shared>> {
 private:
   using self_type = basic_allocator_musl;
   using context = detail::musl_context<is_shared>;

   friend allocator_interface<self_type>;
   friend struct allocator_dyn_friend;
   friend auto
   make_allocator_musl() -> basic_allocator_musl<false>;
   friend auto
   make_allocator_musl_shared() -> basic_allocator_musl<true>;

   template <is_uniform_random_bit_generator Generator>
   friend auto
   make_allocator_musl(Generator& generator) -> basic_allocator_musl<false>;

   template <is_uniform_random_bit_generator Generator>
   friend auto
   make_allocator_musl_shared(Generator& generator)
      -> basic_allocator_musl<true>;

   template <typename>
   friend class allocator_ref;

   // TODO: This should be non-atomic when `is_shared` is false.
   atomic<context*> m_p_context{nullptr};
   uint8 m_secret = 0u;

   explicit basic_allocator_musl(uint8 secret) : m_secret(secret) {
      verify(secret != 0u);
   }

   auto
   ensure_context() -> context* _Nullable;

   auto
   allocation_bytes(ualign alignment, idx requested_bytes)
      -> maybe_non_zero<idx>;

   [[gnu::malloc, clang::ownership_returns(libcat)]]
   auto
   allocate(idx requested_bytes) -> void* _Nullable;

   [[gnu::malloc, clang::ownership_returns(libcat)]]
   auto
   aligned_allocate(ualign alignment, idx requested_bytes) -> void* _Nullable;

   auto
   allocate_feedback(idx requested_bytes) -> maybe_sized_allocation<void*>;

   auto
   aligned_allocate_feedback(ualign alignment, idx requested_bytes)
      -> maybe_sized_allocation<void*>;

   [[gnu::malloc, clang::ownership_returns(libcat)]]
   auto
   allocate_zeroed(idx requested_bytes) -> void* _Nullable;

   auto
   allocate_zeroed_feedback(idx requested_bytes)
      -> maybe_sized_allocation<void*>;

   [[gnu::malloc, clang::ownership_returns(libcat)]]
   auto
   aligned_allocate_zeroed(ualign alignment, idx requested_bytes)
      -> void* _Nullable;

   auto
   aligned_allocate_zeroed_feedback(ualign alignment, idx requested_bytes)
      -> maybe_sized_allocation<void*>;

   [[clang::ownership_takes(libcat, 2)]]
   void
   deallocate(void const* _Nonnull p_storage, idx allocation_bytes);

   [[clang::ownership_takes(libcat, 3)]]
   friend void
   deallocate_release_customization(
      [[maybe_unused]] detail::allocator_release_tag release_tag,
      self_type& allocator, void const* _Nonnull p_storage, idx allocation_bytes
   ) {
      allocator.deallocate(p_storage, allocation_bytes);
   }

   auto
   grow(span<byte> allocation, idx new_bytes) -> maybe<void>;

   auto
   grow_feedback(span<byte> allocation, idx new_bytes) -> maybe_non_zero<idx>;

   auto
   reallocate_memory(
      span<byte> allocation, idx new_bytes, uword* _Nullable p_feedback_bytes
   ) -> void* _Nullable;

   auto
   reallocate(span<byte> allocation, idx new_bytes) -> void* _Nullable;

   auto
   reallocate_feedback(span<byte> allocation, idx new_bytes)
      -> maybe_sized_allocation<void*>;

 public:
   static constexpr ualign min_alignment = 16u;
   static constexpr idx min_allocation_bytes = 1u;

   constexpr basic_allocator_musl() = default;
   basic_allocator_musl(basic_allocator_musl const&) =
      delete ("`basic_allocator_musl` owns an independent mallocng context.");
   auto
   operator=(basic_allocator_musl const&) -> basic_allocator_musl& = delete;

   basic_allocator_musl(basic_allocator_musl&& other) noexcept;
   auto
   operator=(basic_allocator_musl&& other) noexcept -> basic_allocator_musl&;
   ~basic_allocator_musl();

   void
   reset();

   [[nodiscard]]
   auto
   bytes_used() const -> idx;

   [[nodiscard]]
   auto
   bytes_capacity() const -> idx;

   [[nodiscard]]
   auto
   is_equivalent(basic_allocator_musl const& other) const -> bool;
};

using allocator_musl = basic_allocator_musl<false>;
using allocator_musl_shared = basic_allocator_musl<true>;

template <is_uniform_random_bit_generator Generator>
[[nodiscard]]
inline auto
make_allocator_musl(Generator& generator) -> allocator_musl {
   while (true) {
      uint8 const secret = uniform_int_distribution<uint8>{}(generator);
      if (secret != 0u) {
         return allocator_musl(secret);
      }
   }
}

template <is_uniform_random_bit_generator Generator>
[[nodiscard]]
inline auto
make_allocator_musl_shared(Generator& generator) -> allocator_musl_shared {
   while (true) {
      uint8 const secret = uniform_int_distribution<uint8>{}(generator);
      if (secret != 0u) {
         return allocator_musl_shared(secret);
      }
   }
}

[[nodiscard]]
inline auto
make_allocator_musl() -> allocator_musl {
   nix::sys_urandom_engine generator;
   return make_allocator_musl(generator);
}

[[nodiscard]]
inline auto
make_allocator_musl_shared() -> allocator_musl_shared {
   nix::sys_urandom_engine generator;
   return make_allocator_musl_shared(generator);
}

}  // namespace cat
