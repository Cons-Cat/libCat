// -*- mode: c++ -*-
// vim: set ft=cpp:
#pragma once

// `cat::mutex_spin` is inspired by the Intel Thread Building Blocks
// `tbb::spin_mutex`. It is an exponential-backoff "TTAS" (test-test-and-set)
// spin lock primarily intended for implementing other synchronization
// primitives. TTAS mutexes are useful for very short wait timespans, spanning
// only a few microseconds.

#include <cat/atomic>
#include <cat/chrono>
#include <cat/mutex>
#include <cat/sanitizer>
#include <cat/thread>

namespace cat {

class mutex_spin {
 public:
   constexpr mutex_spin() = default;

   mutex_spin(mutex_spin const&) = delete;
   auto
   operator=(mutex_spin const&) noexcept -> mutex_spin& = delete;

   void
   lock() noexcept(!__has_feature(cxx_exceptions)) {
      __tsan_mutex_pre_lock(this, 0u);
      uint1 count = 1;
      while (m_flag.test(memory_order::relaxed)
             || m_flag.test_and_set(memory_order::acquire)) {
         backoff(count);
      }
      __tsan_mutex_post_lock(this, 0u, 0);
   }

   [[nodiscard]]
   auto
   try_lock() noexcept(!__has_feature(cxx_exceptions)) -> bool {
      __tsan_mutex_pre_lock(this, __tsan_mutex_try_lock);
      bool const is_locked = try_acquire();
      __tsan_mutex_post_lock(
         this,
         is_locked ? __tsan_mutex_try_lock
                   : __tsan_mutex_try_lock | __tsan_mutex_try_lock_failed,
         0
      );
      return is_locked;
   }

   template <is_duration Duration>
   [[nodiscard]]
   auto
   try_lock_for(Duration timeout) noexcept(!__has_feature(cxx_exceptions))
      -> bool {
      clock_steady::time_point const now = clock_steady::now().assert();
      return try_lock_until(now + clock_steady::duration(timeout));
   }

   template <is_clock Clock, is_duration Duration>
   [[nodiscard]]
   auto
   try_lock_until(time_point<Clock, Duration> timeout) noexcept(
      !__has_feature(cxx_exceptions)
   ) -> bool {
      typename Clock::duration const deadline = timeout.time_since_epoch();
      __tsan_mutex_pre_lock(this, __tsan_mutex_try_lock);
      bool is_locked = true;
      uint1 count = 1;
      while (!try_acquire()) {
         typename Clock::duration const now =
            Clock::now().assert().time_since_epoch();
         if (now >= deadline) {
            is_locked = false;
            break;
         }
         backoff(count);
      }
      __tsan_mutex_post_lock(
         this,
         is_locked ? __tsan_mutex_try_lock
                   : __tsan_mutex_try_lock | __tsan_mutex_try_lock_failed,
         0
      );
      return is_locked;
   }

   void
   unlock() noexcept(!__has_feature(cxx_exceptions)) {
      auto _ = __tsan_mutex_pre_unlock(this, 0u);
      m_flag.clear(memory_order::release);
      __tsan_mutex_post_unlock(this, 0u);
   }

 private:
   // `try_lock()` without its TSan annotations.
   [[nodiscard]]
   auto
   try_acquire() noexcept -> bool {
      return !m_flag.test(memory_order::relaxed)
             && !m_flag.test_and_set(memory_order::acquire);
   }

   static void
   backoff(uint1& count) noexcept(!__has_feature(cxx_exceptions)) {
      // 16 spins is the limit used by Intel Thread Building Blocks.
      if (count <= 16u) {
         machine_pause(count);
         count = count * 2u;
      } else {
         // Yield to the kernel once spinning too long.
         this_thread::yield();
      }
   }

   atomic_flag m_flag;
};

}  // namespace cat
