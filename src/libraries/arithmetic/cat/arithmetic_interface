      return $fwd(self).bit_and($fwd(other));
   }
}

template <typename D, typename T>
concept has_bit_or_noncommutative =
   requires {
      declval<remove_cvref<D> const>().bit_or_noncommutative(declval<T>());
   };

template <typename D, typename T>
concept has_reverse_binary_bit_or =
   has_bit_or_noncommutative<D, T> || has_binary_bit_or<D, T>;

template <typename D, typename T>
consteval auto
is_nothrow_reverse_bit_or() -> bool {
   if constexpr (has_bit_or_noncommutative<D, T>) {
      return noexcept(declval<D>().bit_or_noncommutative(declval<T>()));
