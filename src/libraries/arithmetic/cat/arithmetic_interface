// -*- mode: c++ -*-
// vim: set ft=cpp:
#pragma once

#include <cat/meta>

// We generate arithmetic operators by finding implementations of the
// corresponding member functions in a CRTP derived `class`. These include:
//
//    `.add()`
//    `.add_noncommutative()`
//    `.bit_and()`
//    `.bit_and_noncommutative()`
//    `.bit_complement()`
//    `.bit_not()`
//    `.bit_or()`
//    `.bit_or_noncommutative()`
//    `.bit_xor()`
//    `.bit_xor_noncommutative()`
//    `.divide_by()`
//    `.divide_into()`
//    `.modulo_by()`
//    `.modulo_into()`
//    `.multiply()`
//    `.multiply_noncommutative()`
//    `.negate()`
//    `.shift_left_by()`
//    `.shift_left_into()`
//    `.shift_right_by()`
//    `.shift_right_into()`
//    `.subtract_by()`
//    `.subtract_from()`
//
// These are each wrapped by conventional operator overloading, so to add an
// overload of both `operator+` and `operator+=` simultaneously, you need only
// implement an overload or template specialization of `.add()`. If any are
// absent, they are gracefully ignored and corresponding operators are not
// generated.
//
// `+`, `*`, `&`, `|`, and `^` are commutative by default. `other @ self` can
// call `self.add(other)`, `self.multiply(other)`, etc. A `Derived` whose
// operator should be non-commutative instead implements the matching
// `operator_noncommutative()` method. Then, `other @ self` never resolves to
// this operator, only `self @ operator` can be resolved.
//
// These are all aggregated by the `arithmetic_interface` template, but they may
// be selected granularly by the smaller CRTP classes:
//
//     `plus_interface`
//     `minus_interface`
//     `multiply_interface`
//     `divide_interface`
//     `modulo_interface`
//     `bitwise_interface`
//
// Before deducing operands, operators follow overload resolution rules to
// attempt implicit constructing them to `Derived`.
//
// This is actually not handled implicitly by simple type deduction, due to
// attribute `enable_if`. These overloads supercede type deduction, so they
// cannot take a forwarding reference, therefore we handle both r-value and
// l-value `const` reference parameters in separate bodies for each operator.
// Supporting attribute `enable_if` in this way allows, for example,
// `cat::basic_idx` to handle `+= 1` without special casing any operators.

namespace cat {

template <typename T>
struct arithmetic_interface;

template <typename T>
struct bitwise_interface;

namespace detail {

template <typename T, typename U>
concept has_add_interface = requires(T lhs, U rhs) { lhs.add(rhs); };

template <typename T, typename U>
concept has_subtract_by_interface =
   requires(T lhs, U rhs) { lhs.subtract_by(rhs); };

template <typename T>
concept has_negate_interface = requires(T lhs) { lhs.negate(lhs); };

// Unary `-` calls `.negate()`, or subtracts from zero.
template <typename D>
consteval auto
is_nothrow_negation() -> bool;

template <typename T, typename U>
concept has_multiply_interface = requires(T lhs, U rhs) { lhs.multiply(rhs); };

template <typename T, typename U>
concept has_divide_by_interface =
   requires(T lhs, U rhs) { lhs.divide_by(rhs); };

template <typename T, typename U>
concept has_modulo_by_interface =
   requires(T lhs, U rhs) { lhs.modulo_by(rhs); };

template <typename T, typename U>
concept has_shift_left_by_interface =
   requires(T lhs, U rhs) { lhs.shift_left_by(rhs); };

template <typename T, typename U>
concept has_shift_right_by_interface =
   requires(T lhs, U rhs) { lhs.shift_right_by(rhs); };

template <typename T, typename U>
concept has_bit_and_interface = requires(T lhs, U rhs) { lhs.bit_and(rhs); };

template <typename T, typename U>
concept has_bit_or_interface = requires(T lhs, U rhs) { lhs.bit_or(rhs); };

template <typename T, typename U>
concept has_bit_xor_interface = requires(T lhs, U rhs) { lhs.bit_xor(rhs); };

template <typename T, typename U>
concept has_bit_not_interface = requires(T lhs, U rhs) { lhs.bit_not(rhs); };

template <typename T>
concept has_bit_complement = requires(T lhs) { lhs.bit_complement(); };

// `operator++`/`operator--` assign `add(1)`/`subtract_by(1)` back to the
// operand. They exist only when those calls preserve the operand type (for
// example `cat::basic_idx` subtraction against another `basic_idx` widens to
// `cat::iword`, so decrement is not generated).
template <typename D>
concept has_unary_increment = is_same<
   remove_cvref<D>,
   __typeof_unqual(declval<remove_cvref<D> const&>().add(remove_cvref<D>(1)))>;

template <typename D>
concept has_unary_decrement = is_same<
   remove_cvref<D>,
   __typeof_unqual(declval<remove_cvref<D> const&>()
                      .subtract_by(static_cast<remove_cvref<D>::raw_type>(1)))>;

// Left-hand compound assignments exist only when the corresponding member
// (`add`, `subtract_by`, ...) returns the same type as the operand, matching
// the binary operator result type.
template <typename D, typename T>
concept has_plus_assign = is_same<
   remove_cvref<D>,
   __typeof_unqual(declval<remove_cvref<D>&>().add(declval<T>()))>;

template <typename D, typename T>
concept has_minus_assign = is_same<
   remove_cvref<D>,
   __typeof_unqual(declval<remove_cvref<D>&>().subtract_by(declval<T>()))>;

template <typename D, typename T>
concept has_multiply_assign = is_same<
   remove_cvref<D>,
   __typeof_unqual(declval<remove_cvref<D>&>().multiply(declval<T>()))>;

template <typename D, typename T>
concept has_divide_assign = is_same<
   remove_cvref<D>,
   __typeof_unqual(declval<remove_cvref<D>&>().divide_by(declval<T>()))>;

template <typename D, typename T>
concept has_modulo_assign = is_same<
   remove_cvref<D>,
   __typeof_unqual(declval<remove_cvref<D>&>().modulo_by(declval<T>()))>;

template <typename D, typename T>
concept has_bit_and_assign = is_same<
   remove_cvref<D>,
   __typeof_unqual(declval<remove_cvref<D>&>().bit_and(declval<T>()))>;

template <typename D, typename T>
concept has_bit_or_assign = is_same<
   remove_cvref<D>,
   __typeof_unqual(declval<remove_cvref<D>&>().bit_or(declval<T>()))>;

template <typename D, typename T>
concept has_bit_xor_assign = is_same<
   remove_cvref<D>,
   __typeof_unqual(declval<remove_cvref<D>&>().bit_xor(declval<T>()))>;

template <typename D, typename T>
concept has_shift_left_assign = is_same<
   remove_cvref<D>,
   __typeof_unqual(declval<remove_cvref<D>&>().shift_left_by(declval<T>()))>;

template <typename D, typename T>
concept has_shift_right_assign = is_same<
   remove_cvref<D>,
   __typeof_unqual(declval<remove_cvref<D>&>().shift_right_by(declval<T>()))>;

template <typename D, typename T>
concept has_binary_plus =
   requires { declval<remove_cvref<D> const>().add(declval<T>()); };

template <typename D, typename T>
concept has_binary_subtract_by =
   requires { declval<remove_cvref<D> const>().subtract_by(declval<T>()); };

template <typename D, typename T>
concept has_binary_multiply =
   requires { declval<remove_cvref<D> const>().multiply(declval<T>()); };

template <typename D, typename T>
concept has_binary_divide_by =
   requires { declval<remove_cvref<D> const>().divide_by(declval<T>()); };

template <typename D, typename T>
concept has_binary_bit_and =
   requires { declval<remove_cvref<D> const>().bit_and(declval<T>()); };

template <typename D, typename T>
concept has_binary_bit_or =
   requires { declval<remove_cvref<D> const>().bit_or(declval<T>()); };

template <typename D, typename T>
concept has_binary_bit_xor =
   requires { declval<remove_cvref<D> const>().bit_xor(declval<T>()); };

template <typename D, typename T>
concept has_binary_modulo_by =
   requires { declval<remove_cvref<D> const>().modulo_by(declval<T>()); };

template <typename D, typename T>
concept has_shift_left_by =
   requires { declval<remove_cvref<D> const>().shift_left_by(declval<T>()); };

template <typename D, typename T>
concept has_shift_right_by =
   requires { declval<remove_cvref<D> const>().shift_right_by(declval<T>()); };

// Reverse-order friends compute `other @ self`. For a commutative operator,
// that is `self.foo_noncommutative(other)`, otherwise `self.foo(other)`.
template <typename D, typename T>
concept has_add_noncommutative =
   requires {
      declval<remove_cvref<D> const>().add_noncommutative(declval<T>());
   };

template <typename D, typename T>
concept has_reverse_binary_plus =
   has_add_noncommutative<D, T> || has_binary_plus<D, T>;

template <typename D, typename T>
consteval auto
is_nothrow_reverse_add() -> bool {
   if constexpr (has_add_noncommutative<D, T>) {
      return noexcept(declval<D>().add_noncommutative(declval<T>()));
   } else {
      return noexcept(declval<D>().add(declval<T>()));
   }
}

template <typename D, typename T>
[[nodiscard, gnu::always_inline, gnu::nodebug]]
constexpr auto
reverse_add(D&& self, T&& other) noexcept(is_nothrow_reverse_add<D, T>())
   -> decltype(auto) {
   if constexpr (has_add_noncommutative<D, T>) {
      return $fwd(self).add_noncommutative($fwd(other));
   } else {
      return $fwd(self).add($fwd(other));
   }
}

template <typename D, typename T>
concept has_multiply_noncommutative =
   requires {
      declval<remove_cvref<D> const>().multiply_noncommutative(declval<T>());
   };

template <typename D, typename T>
concept has_reverse_binary_multiply =
   has_multiply_noncommutative<D, T> || has_binary_multiply<D, T>;

template <typename D, typename T>
consteval auto
is_nothrow_reverse_multiply() -> bool {
   if constexpr (has_multiply_noncommutative<D, T>) {
      return noexcept(declval<D>().multiply_noncommutative(declval<T>()));
   } else {
      return noexcept(declval<D>().multiply(declval<T>()));
   }
}

template <typename D, typename T>
[[nodiscard, gnu::always_inline, gnu::nodebug]]
constexpr auto
reverse_multiply(D&& self, T&& other) noexcept(
   is_nothrow_reverse_multiply<D, T>()
) -> decltype(auto) {
   if constexpr (has_multiply_noncommutative<D, T>) {
      return $fwd(self).multiply_noncommutative($fwd(other));
   } else {
      return $fwd(self).multiply($fwd(other));
   }
}

template <typename D, typename T>
concept has_bit_and_noncommutative =
   requires {
      declval<remove_cvref<D> const>().bit_and_noncommutative(declval<T>());
   };

template <typename D, typename T>
concept has_reverse_binary_bit_and =
   has_bit_and_noncommutative<D, T> || has_binary_bit_and<D, T>;

template <typename D, typename T>
consteval auto
is_nothrow_reverse_bit_and() -> bool {
   if constexpr (has_bit_and_noncommutative<D, T>) {
      return noexcept(declval<D>().bit_and_noncommutative(declval<T>()));
   } else {
      return noexcept(declval<D>().bit_and(declval<T>()));
   }
}

template <typename D, typename T>
[[nodiscard, gnu::always_inline, gnu::nodebug]]
constexpr auto
reverse_bit_and(D&& self, T&& other) noexcept(
   is_nothrow_reverse_bit_and<D, T>()
) -> decltype(auto) {
   if constexpr (has_bit_and_noncommutative<D, T>) {
      return $fwd(self).bit_and_noncommutative($fwd(other));
