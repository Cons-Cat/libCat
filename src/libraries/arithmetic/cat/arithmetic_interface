   [[gnu::always_inline, gnu::nodebug]]
   constexpr auto
   self() noexcept {
      return static_cast<Derived>(*this);
   }

   [[gnu::always_inline, gnu::nodebug]]
   constexpr auto
   self() const noexcept {
      return static_cast<Derived>(*this);
   }
