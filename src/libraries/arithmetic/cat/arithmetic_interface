template <typename D, typename T>
[[nodiscard, gnu::always_inline, gnu::nodebug]]
constexpr auto
reverse_bit_or(D&& self, T&& other) noexcept(is_nothrow_reverse_bit_or<D, T>())
   -> decltype(auto) {
   if constexpr (has_bit_or_noncommutative<D, T>) {
      return $fwd(self).bit_or_noncommutative($fwd(other));
   } else {
      return $fwd(self).bit_or($fwd(other));
   }
}

template <typename D, typename T>
concept has_bit_xor_noncommutative =
   requires {
      declval<remove_cvref<D> const>().bit_xor_noncommutative(declval<T>());
   };

template <typename D, typename T>
concept has_reverse_binary_bit_xor =
   has_bit_xor_noncommutative<D, T> || has_binary_bit_xor<D, T>;

template <typename D, typename T>
consteval auto
is_nothrow_reverse_bit_xor() -> bool {
   if constexpr (has_bit_xor_noncommutative<D, T>) {
      return noexcept(declval<D>().bit_xor_noncommutative(declval<T>()));
