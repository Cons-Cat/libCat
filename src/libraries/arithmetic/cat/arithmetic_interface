   }
}

template <typename D, typename T>
[[nodiscard, gnu::always_inline, gnu::nodebug]]
constexpr auto
reverse_bit_xor(D&& self, T&& other) noexcept(
   is_nothrow_reverse_bit_xor<D, T>()
) -> decltype(auto) {
   if constexpr (has_bit_xor_noncommutative<D, T>) {
      return $fwd(self).bit_xor_noncommutative($fwd(other));
   } else {
      return $fwd(self).bit_xor($fwd(other));
   }
}

// `subtract_from`, `divide_into`, `modulo_into`, and `shift_*_into` are the
// reverse hooks when the left operand of `operator@` is not `Derived`.
template <typename D, typename T>
concept has_reverse_binary_minus = requires {
                                      requires(requires(remove_cvref<D> const& self, T&& x) {
      { self.subtract_from(static_cast<T&&>(x)) };
   }
   || requires(remove_cvref<D>&& self, T&& x) {
         { self.subtract_from(static_cast<T&&>(x)) };
      });
                                   };

template <typename D, typename T>
concept has_reverse_binary_divide =
   requires { declval<remove_cvref<D> const>().divide_into(declval<T>()); };

template <typename D, typename T>
concept has_reverse_binary_modulo =
   requires { declval<remove_cvref<D> const>().modulo_into(declval<T>()); };

template <typename D, typename T>
concept has_reverse_shift_left =
   requires { declval<remove_cvref<D> const>().shift_left_into(declval<T>()); };

template <typename D, typename T>
concept has_reverse_shift_right =
   requires {
      declval<remove_cvref<D> const>().shift_right_into(declval<T>());
   };

template <typename D>
consteval auto
is_nothrow_negation() -> bool {
   if constexpr (has_negate_interface<D>) {
      return noexcept(declval<D const&>().negate());
   } else {
      return noexcept(static_cast<D>(0) - declval<D const&>());
   }
}

}  // namespace detail

// CRTP class for generating a commutative + operator.
template <typename Derived>
struct plus_interface {
 private:
   constexpr plus_interface() = default;
   friend Derived;
   friend struct arithmetic_interface<Derived>;

 public:
   using decay_derived = remove_cvref<Derived>;

   // Same-type + where the RHS may implicitly construct `decay_derived`.
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   friend constexpr auto
   operator+(Derived const& self, decay_derived const& other) noexcept(
      noexcept(self.add(other))
   ) -> decltype(auto)
      requires(
         detail::has_binary_plus<Derived, decay_derived const&>
         && is_constructible<Derived, decay_derived const&>
      )
   {
      return self.add(other);
   }

   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   friend constexpr auto
   operator+(Derived const& self, decay_derived&& other) noexcept(
      noexcept(self.add(move(other)))
   ) -> decltype(auto)
      requires(
         detail::has_binary_plus<Derived, decay_derived&&>
         && is_constructible<Derived, decay_derived&&>
      )
   {
      return self.add(move(other));
   }

   // + operator where this is a left-hand-side operand.
   template <typename Self, typename T>
      requires(
         is_base_of<decay_derived, remove_cvref<Self>>
         && detail::has_binary_plus<Derived, T>
         && !is_same<remove_cvref<T>, decay_derived>
      )
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   friend constexpr auto
   operator+(Self&& self, T&& other) noexcept(
      noexcept($fwd(self).add($fwd(other)))
   ) -> decltype(auto) {
      return $fwd(self).add($fwd(other));
   }

   // + operators where this is a right-hand-side operand.

   // `this` is an l-value.
   template <typename T>
   // If this operator's left operand can add `Derived` as its right-hand
   // operand, this overload is ambiguous.
      requires(
         !detail::has_add_interface<T, Derived>
         && !is_same<remove_cvref<T>, decay_derived>
         && detail::has_reverse_binary_plus<Derived, T>
      )
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   friend constexpr auto
   operator+(T&& other, decay_derived const& self) noexcept(
      noexcept(detail::reverse_add(self, $fwd(other)))
   ) -> decltype(auto) {
      return detail::reverse_add(self, $fwd(other));
   }

   // `this` is an r-value.
   template <typename T>
   // If this operator's left operand can add `Derived` as its right-hand
   // operand, this overload is ambiguous.
      requires(
         !detail::has_add_interface<T, Derived>
         && !is_same<remove_cvref<T>, decay_derived>
         && detail::has_reverse_binary_plus<Derived, T>
      )
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   friend constexpr auto
   operator+(T&& other, Derived&& self) noexcept(
      noexcept(detail::reverse_add($fwd(self), $fwd(other)))
   ) -> decltype(auto) {
      return detail::reverse_add($fwd(self), $fwd(other));
   }

   [[gnu::always_inline, gnu::nodebug]]
   friend constexpr auto
   operator+=(
      Derived& self [[clang::lifetimebound]], decay_derived const& rhs
   ) noexcept(noexcept(self = self.add(rhs))) -> Derived&
      requires(
         detail::has_plus_assign<decay_derived, decay_derived>
         && is_constructible<Derived, decay_derived const&>
      )
   {
      self = self.add(rhs);
      return self;
   }

   [[gnu::always_inline, gnu::nodebug]]
   friend constexpr auto
   operator+=(
      Derived& self [[clang::lifetimebound]], decay_derived&& rhs
   ) noexcept(noexcept(self = self.add(move(rhs)))) -> Derived&
      requires(
         detail::has_plus_assign<decay_derived, decay_derived>
         && is_constructible<Derived, decay_derived&&>
      )
   {
      self = self.add(move(rhs));
      return self;
   }

   // += operator where this is a left-hand-side operand.
   template <typename T>
      requires(
         detail::has_plus_assign<decay_derived, T>
         && !is_same<remove_cvref<T>, decay_derived>
      )
   [[gnu::always_inline, gnu::nodebug]]
   friend constexpr auto
   operator+=(Derived& self [[clang::lifetimebound]], T&& other) noexcept(
      noexcept(self = self.add($fwd(other)))
   ) -> Derived& {
      self = self.add($fwd(other));
      return self;
   }

   // += for types whose `add` never yields their own type, such as the
   // proxy that `.wrap()` returns. This assigns the result back, so a
   // promoting result is rejected by `Derived`'s assignment.
   template <typename Self, typename T>
      requires(
         is_same<remove_cvref<Self>, Derived>
         && !detail::has_plus_assign<decay_derived, decay_derived>
         && detail::has_add_interface<Derived, T>
         && is_assignable<Self, decltype(declval<Self&>().add(declval<T>()))>
      )
   [[gnu::always_inline, gnu::nodebug]]
   friend constexpr auto
   operator+=(Self&& self, T&& other) noexcept(
      noexcept(self = self.add($fwd(other)))
   ) -> Self&& {
      self = self.add($fwd(other));
      return $fwd(self);
   }

   // += operators where this is a right-hand-side operand.

   // `this` is an l-value.
   template <typename T>
   // If this operator's left operand can add `Derived` as its right-hand
   // operand, this overload is ambiguous.
      requires(
         !detail::has_add_interface<T, Derived>
         && detail::has_reverse_binary_plus<Derived, T>
         // Assigning the result back to `other` must be valid.
         && requires(
            T& other, Derived const& self
         ) { other = detail::reverse_add(self, other); }
      )
   [[gnu::always_inline, gnu::nodebug]]
   friend constexpr auto
   operator+=(T& other, Derived const& self) noexcept(
      noexcept(other = detail::reverse_add(self, other))
   ) -> T& {
      other = detail::reverse_add(self, other);
      return other;
   }

   // `this` is an r-value.
   template <typename T>
   // If this operator's left operand can add `Derived` as its right-hand
   // operand, this overload is ambiguous.
      requires(
         !detail::has_add_interface<T, Derived>
         && detail::has_reverse_binary_plus<Derived, T>
         // Assigning the result back to `other` must be valid.
         && requires(
            T& other, Derived&& self
         ) { other = detail::reverse_add(move(self), other); }
      )
   [[gnu::always_inline, gnu::nodebug]]
   friend constexpr auto
   operator+=(T& other, Derived&& self) noexcept(
      noexcept(other = detail::reverse_add(move(self), other))
   ) -> T& {
      other = detail::reverse_add(move(self), other);
      return other;
   }

   // Unary ++ operators. These mirror the built-in integer operators, so they
   // only apply to l-values, prefix yields the new value as an l-value, and
   // postfix yields a copy of the old value as a prvalue.

   [[gnu::always_inline, gnu::nodebug]]
   friend constexpr auto
   operator++(Derived& self [[clang::lifetimebound]]) noexcept(
      noexcept(self = self.add(Derived(1)))
   ) -> Derived&
      requires(detail::has_unary_increment<Derived>)
   {
      self = self.add(Derived(1));
      return self;
   }

   [[gnu::always_inline, gnu::nodebug]]
   friend constexpr auto
   operator++(Derived& self, int) noexcept(
      noexcept(++self) && is_nothrow_copy_constructible<Derived>
   ) -> Derived
      requires(detail::has_unary_increment<Derived>)
   {
      Derived const old = self;
      ++self;
      return old;
   }
};

// CRTP class for generating a commutative - operator.
template <typename Derived>
struct minus_interface {
 private:
   constexpr minus_interface() = default;
   friend Derived;
   friend struct arithmetic_interface<Derived>;

 public:
   using decay_derived = remove_cvref<Derived>;

   // Same-type - where the RHS may implicitly construct `decay_derived`.
   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   friend constexpr auto
   operator-(Derived const& lhs, decay_derived const& other) noexcept(
      noexcept(lhs.subtract_by(other))
   ) -> decltype(auto)
      requires(
         detail::has_binary_subtract_by<Derived, decay_derived const&>
         && is_constructible<Derived, decay_derived const&>
      )
   {
      return lhs.subtract_by(other);
   }

   [[nodiscard, gnu::always_inline, gnu::nodebug]]
   friend constexpr auto
   operator-(Derived const& lhs, decay_derived&& other) noexcept(
      noexcept(lhs.subtract_by(move(other)))
   ) -> decltype(auto)
      requires(
         detail::has_binary_subtract_by<Derived, decay_derived&&>
         && is_constructible<Derived, decay_derived&&>
      )
   {
      return lhs.subtract_by(move(other));
   }

   // - operator where this is a left-hand-side operand.
   template <typename Self, typename T>
