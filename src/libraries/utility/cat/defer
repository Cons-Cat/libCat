#pragma once

#include <cat/meta>

namespace cat::detail {

template <typename Callback>
class deferrer_callback {
 private:
   Callback m_callback;

 public:
   deferrer_callback(Callback&& f) : m_callback(f) {  // NOLINT
   }

   ~deferrer_callback() noexcept(noexcept(declval<Callback&>()())) {
      m_callback();
   }
};

inline constinit struct {
   template <typename Callback>
   auto
   operator<<(Callback&& callback) const -> deferrer_callback<Callback> {
      return deferrer_callback<Callback>(forward<Callback>(callback));
   }
} const deferrer [[maybe_unused]];

}  // namespace cat::detail

#define CAT_DEFER auto _ = ::cat::detail::deferrer << [&]->void
#pragma clang final(CAT_DEFER)
#define $defer CAT_DEFER
